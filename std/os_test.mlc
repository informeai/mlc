import "std/os"
import "std/str"
import "std/testing"

fn test_args() {
    testing.eq_int(os.arg_count(), 1) // only the program's name
    buf := alloc([]byte, 4096)
    match os.arg(0, &buf) {
        Ok(n) => testing.check(n > 0, "arg(0) is the program's path")
        Err(code) => testing.eq_int(code, 0)
    }
    match os.arg(1, &buf) {
        Ok(_) => testing.fail("arg(1) doesn't exist")
        Err(code) => testing.eq_int(code, os.NOT_FOUND)
    }
    free(buf)
}

fn test_getenv() {
    buf := alloc([]byte, 4096)
    match os.getenv("MLC_VARIABLE_THAT_DOES_NOT_EXIST", &buf) {
        Ok(_) => testing.fail("the variable doesn't exist")
        Err(code) => testing.eq_int(code, os.NOT_FOUND)
    }
    match os.getenv("PATH", &buf[:1]) {
        Ok(_) => testing.fail("PATH doesn't fit in 1 byte")
        Err(code) => testing.eq_int(code, os.TOO_LONG)
    }
    match os.getenv("PATH", &buf) {
        Ok(n) => testing.check(n > 1, "PATH has content")
        Err(code) => testing.eq_int(code, 0)
    }
    free(buf)
}

fn test_setenv() {
    var v [16]byte
    n := str.copy(&v, "value-mlc")
    match os.setenv("MLC_TESTE_SETENV", &v[:n]) {
        Ok(_) => {}
        Err(code) => testing.eq_int(code, 0)
    }
    var out [32]byte
    match os.getenv("MLC_TESTE_SETENV", &out) {
        Ok(k) => testing.eq_str(&out[:k], "value-mlc")
        Err(code) => testing.eq_int(code, 0)
    }
}

fn test_cwd_chdir() {
    var p [8]byte
    n := str.copy(&p, "/tmp")
    match os.chdir(&p[:n]) {
        Ok(_) => {}
        Err(code) => testing.eq_int(code, 0)
    }
    var out [4096]byte
    match os.cwd(&out) {
        Ok(k) => testing.check(k >= 4, "cwd has the path") // on macOS, /tmp is /private/tmp
        Err(code) => testing.eq_int(code, 0)
    }
}

fn test_error_text() {
    var msg [160]byte
    n := os.error_text(os.NOT_FOUND, &msg)
    testing.eq_str(&msg[:n], "doesn't exist")
    n = os.error_text(os.TOO_LONG, &msg)
    testing.eq_str(&msg[:n], "too long for the buffer")
    n = os.error_text(1003, &msg) // io.EOF
    testing.eq_str(&msg[:n], "end of the data")
    n = os.error_text(2001, &msg) // net.REFUSED
    testing.eq_str(&msg[:n], "connection refused: nobody listens on that port")
    n = os.error_text(99999, &msg)
    testing.eq_str(&msg[:n], "unknown error (99999)")
    n = os.error_text(-5, &msg)
    testing.eq_str(&msg[:n], "unknown error (-5)")
}

fn test_error_text_small_buffer() {
    testing.expect_panic()
    var msg [4]byte
    os.error_text(os.NOT_FOUND, &msg)
}
