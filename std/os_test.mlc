import "std/os"
import "std/str"
import "std/testing"

fn test_args() {
    testing.eq_int(os.arg_count(), 1) // só o nome do programa
    buf := alloc([]byte, 4096)
    match os.arg(0, &buf) {
        Ok(n) => testing.check(n > 0, "arg(0) é o caminho do programa")
        Err(code) => testing.eq_int(code, 0)
    }
    match os.arg(1, &buf) {
        Ok(_) => testing.fail("arg(1) não existe")
        Err(code) => testing.eq_int(code, os.NOT_FOUND)
    }
    free(buf)
}

fn test_getenv() {
    buf := alloc([]byte, 4096)
    match os.getenv("MLC_VARIAVEL_QUE_NAO_EXISTE", &buf) {
        Ok(_) => testing.fail("a variável não existe")
        Err(code) => testing.eq_int(code, os.NOT_FOUND)
    }
    match os.getenv("PATH", &buf[:1]) {
        Ok(_) => testing.fail("PATH não cabe em 1 byte")
        Err(code) => testing.eq_int(code, os.TOO_LONG)
    }
    match os.getenv("PATH", &buf) {
        Ok(n) => testing.check(n > 1, "PATH tem conteúdo")
        Err(code) => testing.eq_int(code, 0)
    }
    free(buf)
}

fn test_setenv() {
    var v [16]byte
    n := str.copy(&v, "valor-mlc")
    match os.setenv("MLC_TESTE_SETENV", &v[:n]) {
        Ok(_) => {}
        Err(code) => testing.eq_int(code, 0)
    }
    var out [32]byte
    match os.getenv("MLC_TESTE_SETENV", &out) {
        Ok(k) => testing.eq_str(&out[:k], "valor-mlc")
        Err(code) => testing.eq_int(code, 0)
    }
}

fn test_cwd_chdir() {
    var p [8]byte
    n := str.copy(&p, "/tmp")
    match os.chdir(&p[:n]) {
        Ok(_) => {}
        Err(code) => testing.eq_int(code, 0)
    }
    var out [4096]byte
    match os.cwd(&out) {
        Ok(k) => testing.check(k >= 4, "cwd tem o caminho") // no macOS, /tmp é /private/tmp
        Err(code) => testing.eq_int(code, 0)
    }
}

fn test_error_text() {
    var msg [160]byte
    n := os.error_text(os.NOT_FOUND, &msg)
    testing.eq_str(&msg[:n], "não existe")
    n = os.error_text(os.TOO_LONG, &msg)
    testing.eq_str(&msg[:n], "longo demais para o buffer")
    n = os.error_text(1003, &msg) // io.EOF
    testing.eq_str(&msg[:n], "fim dos dados")
    n = os.error_text(2001, &msg) // net.REFUSED
    testing.eq_str(&msg[:n], "conexão recusada: ninguém escuta nessa porta")
    n = os.error_text(99999, &msg)
    testing.eq_str(&msg[:n], "erro desconhecido (99999)")
    n = os.error_text(-5, &msg)
    testing.eq_str(&msg[:n], "erro desconhecido (-5)")
}

fn test_error_text_small_buffer() {
    testing.expect_panic()
    var msg [4]byte
    os.error_text(os.NOT_FOUND, &msg)
}
