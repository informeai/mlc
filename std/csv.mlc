// CSV (RFC 4180): reading and writing spreadsheets as text. The reader streams,
// from any io.Reader (a gigabyte file goes through with fixed memory): one
// record at a time, with the fields in a 16 KB buffer inside it. The
// writer builds lines in a 16 KB buffer, with quotes where needed.
//
//     r := csv.new[fs.File]()
//     r.sep = ';'                        // spreadsheets in some locales use ;
//     for {
//         match r.next(&f) {
//             Ok(n) => {
//                 var name [128]byte
//                 k := r.field(0, &name)
//                 price := 0
//                 r.int(2, &price)
//                 ...
//             }
//             Err(code) => break             // io.EOF at the end; BAD_QUOTE, TOO_LONG
//         }
//     }
//
//     var w csv.Writer
//     w.sep = ','
//     w.add_str("name")
//     w.add_str("description, with a comma") // becomes "description, with a comma"
//     w.add_int(1250)
//     w.end()                                // end of the line
//     f.write(&w.buf[:w.n])
//     w.reset()
//
// Quoted fields can contain the separator, line breaks and quotes
// (written as ""). Empty lines are skipped. \r\n and \n end a
// record.
import "std/bufio"
import "std/io"
import "std/result"
import "std/str"

// BAD_QUOTE is the error of a quoted field whose quotes don't close, or with something
// after the closing quote (Reader.line says the line).
pub const BAD_QUOTE = 3301

// TOO_LONG is the error of a record that doesn't fit in 16 KB or has more than
// MAX_FIELDS fields.
pub const TOO_LONG = 1002

// MAX_FIELDS is how many fields a record can have.
pub const MAX_FIELDS = 256

// Reader reads records from a source R.
pub struct Reader[R ref + io.Reader] {
    input bufio.Reader[R]
    sep byte // the separator (',' in new)
    buf [16384]byte
    n int
    at [256]int
    size [256]int
    count int
    line int // the current record's line (the first is 1)
}

// new creates a reader with the separator ','.
pub fn new[R ref + io.Reader]() Reader[R] {
    r := Reader[R]{}
    r.sep = ','
    return r
}

// next reads the next record and returns how many fields it has; Err(io.EOF)
// at the end of the data.
pub fn (r &Reader[R]) next(src &R) result.Result[int, int] {
    r.n = 0
    r.count = 0
    started := false
    quoted := false // inside a quoted field
    after := false  // right after the quote that closes a field
    field_at := 0
    for {
        c := byte(0)
        eof := false
        match r.input.read_byte(src) {
            Ok(b) => c = b
            Err(code) => {
                if code != io.EOF {
                    return result.Result.Err(code)
                }
                eof = true
            }
        }
        if eof {
            if quoted {
                return result.Result.Err(BAD_QUOTE)
            }
            if !started {
                return result.Result.Err(io.EOF)
            }
            return r.finish(field_at)
        }
        if !started {
            r.line++
            if c == '\n' || c == '\r' {
                continue // empty line
            }
            started = true
        }
        if quoted {
            if c == '"' {
                quoted = false
                after = true
                continue
            }
            if !r.put(c) {
                return result.Result.Err(TOO_LONG)
            }
            if c == '\n' {
                r.line++
            }
            continue
        }
        if c == '"' {
            if after {
                // "" inside the field: one quote
                if !r.put('"') {
                    return result.Result.Err(TOO_LONG)
                }
                quoted = true
                after = false
                continue
            }
            if r.n != field_at {
                return result.Result.Err(BAD_QUOTE) // quote in the middle of an unquoted field
            }
            quoted = true
            continue
        }
        if c == r.sep {
            if !r.end_field(field_at) {
                return result.Result.Err(TOO_LONG)
            }
            field_at = r.n
            after = false
            continue
        }
        if c == '\r' {
            continue // the \n that comes next ends the record
        }
        if c == '\n' {
            return r.finish(field_at)
        }
        if after {
            return result.Result.Err(BAD_QUOTE) // text after the closing quote
        }
        if !r.put(c) {
            return result.Result.Err(TOO_LONG)
        }
    }
}

fn (r &Reader[R]) put(c byte) bool {
    if r.n == len(r.buf) {
        return false
    }
    r.buf[r.n] = c
    r.n++
    return true
}

fn (r &Reader[R]) end_field(field_at int) bool {
    if r.count == MAX_FIELDS {
        return false
    }
    r.at[r.count] = field_at
    r.size[r.count] = r.n - field_at
    r.count++
    return true
}

fn (r &Reader[R]) finish(field_at int) result.Result[int, int] {
    if !r.end_field(field_at) {
        return result.Result.Err(TOO_LONG)
    }
    return result.Result.Ok(r.count)
}

// len returns how many fields the current record has.
pub fn (r &Reader[R]) len() int {
    return r.count
}

// field copies field i (the first is 0) into dst; -1 if the record doesn't
// have that field.
pub fn (r &Reader[R]) field(i int, dst &[]byte) int {
    if i < 0 || i >= r.count {
        return -1
    }
    return str.copy_bytes(dst, &r.buf[r.at[i]:r.at[i] + r.size[i]])
}

// is says whether field i is equal to s.
pub fn (r &Reader[R]) is(i int, s string) bool {
    return i >= 0 && i < r.count && str.eq(&r.buf[r.at[i]:r.at[i] + r.size[i]], s)
}

// int reads field i as an integer; false (leaving out alone) if it doesn't exist
// or isn't a number.
pub fn (r &Reader[R]) int(i int, out &int) bool {
    if i < 0 || i >= r.count {
        return false
    }
    v := 0
    if !str.parse_int(&r.buf[r.at[i]:r.at[i] + r.size[i]], &v) {
        return false
    }
    *out = v
    return true
}

// float reads field i as a real (with a decimal point).
pub fn (r &Reader[R]) float(i int, out &float64) bool {
    if i < 0 || i >= r.count {
        return false
    }
    v := 0.0
    if !str.parse_float(&r.buf[r.at[i]:r.at[i] + r.size[i]], &v) {
        return false
    }
    *out = v
    return true
}

// ---------- writing ----------

// Writer builds CSV lines: the text is &w.buf[:w.n]. The zero value uses ','
// as the separator and \n at the end of the line (crlf = true uses \r\n, as the
// RFC asks).
pub struct Writer {
    buf [16384]byte
    n int
    sep byte
    crlf bool
    fields int // fields in the current line
}

// add appends a field, with quotes if it contains the separator, quotes,
// a line break or spaces at the ends.
pub fn (w &Writer) add(s &[]byte) {
    sep := w.sep
    if sep == 0 {
        sep = ','
    }
    if w.fields > 0 {
        w.put(sep)
    }
    w.fields++
    quote := len(s) > 0 && (s[0] == ' ' || s[len(s) - 1] == ' ')
    for i := 0; i < len(s) && !quote; i++ {
        quote = s[i] == sep || s[i] == '"' || s[i] == '\n' || s[i] == '\r'
    }
    if !quote {
        for i := 0; i < len(s); i++ {
            w.put(s[i])
        }
        return
    }
    w.put('"')
    for i := 0; i < len(s); i++ {
        if s[i] == '"' {
            w.put('"')
        }
        w.put(s[i])
    }
    w.put('"')
}

// add_str appends a field fixed in the program.
pub fn (w &Writer) add_str(s string) {
    var b [1024]byte
    if len(s) > len(b) {
        fail("csv.Writer.add_str: text larger than 1 KB; use add with a buffer of yours")
    }
    n := str.copy(&b, s)
    w.add(&b[:n])
}

// add_int appends an integer.
pub fn (w &Writer) add_int(v int) {
    var b [24]byte
    n := str.put_int(&b, v)
    w.add(&b[:n])
}

// add_float appends a real (the shortest text that represents it).
pub fn (w &Writer) add_float(v float64) {
    var b [40]byte
    n := str.put_float(&b, v)
    w.add(&b[:n])
}

// end ends the line.
pub fn (w &Writer) end() {
    if w.crlf {
        w.put('\r')
    }
    w.put('\n')
    w.fields = 0
}

// reset empties the buffer (after writing the text somewhere).
pub fn (w &Writer) reset() {
    w.n = 0
    w.fields = 0
}

fn (w &Writer) put(c byte) {
    if w.n == len(w.buf) {
        fail("csv.Writer: the 16 KB buffer is full; write it out and call reset first")
    }
    w.buf[w.n] = c
    w.n++
}

extern fn fail(msg string)
