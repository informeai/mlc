// Números aleatórios. Dois tipos, para usos diferentes:
//
//   - Rand (splitmix64): rápido e previsível. A mesma semente dá a mesma
//     sequência, o que serve para simulações, jogos e testes. Não serve
//     para segurança: quem vê alguns números adivinha os próximos.
//
//         r := rand.new(uint64(time.now_ms()))
//         dado := r.range(1, 7)
//
//   - secure: os bytes vêm do sistema operacional (a fonte criptográfica do
//     kernel). É o que se usa para tokens, chaves, senhas temporárias e
//     identificadores que não podem ser adivinhados (std/uuid).
//
//         var token [32]byte
//         rand.secure(&token)            // depois: encoding.hex ou base64_url

// Rand é um gerador: um estado de 64 bits, sem alocação.
pub struct Rand {
    state uint64
}

// new cria um gerador a partir da semente (a mesma semente dá a mesma sequência).
pub fn new(seed uint64) Rand {
    return Rand{state: seed}
}

// next devolve um uint64 qualquer (splitmix64: as contas dão a volta de
// propósito, com +% e *%).
pub fn (r &Rand) next() uint64 {
    r.state +%= 0x9E37_79B9_7F4A_7C15
    z := r.state
    z = (z ^ (z >> 30)) *% 0xBF58_476D_1CE4_E5B9
    z = (z ^ (z >> 27)) *% 0x94D0_49BB_1331_11EB
    return z ^ (z >> 31)
}

// int_n devolve um inteiro em [0, n). n precisa ser maior que zero.
pub fn (r &Rand) int_n(n int) int {
    return int(r.next() % uint64(n))
}

// range devolve um inteiro em [lo, hi).
pub fn (r &Rand) range(lo int, hi int) int {
    return lo + r.int_n(hi - lo)
}

// float devolve um float64 em [0, 1).
pub fn (r &Rand) float() float64 {
    return float64(r.next() >> 11) / 9007199254740992.0 // 53 bits / 2^53
}

// ---------- aleatório seguro ----------

// secure preenche dst com bytes aleatórios do sistema operacional, próprios
// para criptografia. Se o sistema não entregar (não acontece nos sistemas
// suportados), é panic: não existe alternativa segura.
pub extern fn secure(dst &[]byte)

// secure_u64 devolve um uint64 aleatório seguro.
pub fn secure_u64() uint64 {
    var b [8]byte
    secure(&b)
    var v uint64 = 0
    for i := 0; i < 8; i++ {
        v = (v << 8) | uint64(b[i])
    }
    return v
}

// secure_int_n devolve um inteiro seguro em [0, n), sem viés: os valores do
// fim do intervalo de uint64 que fariam alguns restos saírem mais vezes são
// sorteados de novo. n precisa ser maior que zero.
pub fn secure_int_n(n int) int {
    if n <= 0 {
        fail("rand.secure_int_n: n precisa ser maior que zero")
    }
    m := uint64(n)
    limit := 0xFFFF_FFFF_FFFF_FFFF - (0xFFFF_FFFF_FFFF_FFFF % m + 1) % m
    for {
        v := secure_u64()
        if v <= limit {
            return int(v % m)
        }
    }
}

// seeded cria um Rand com semente segura: rápido como o Rand, mas com uma
// sequência diferente a cada execução.
pub fn seeded() Rand {
    return new(secure_u64())
}

extern fn fail(msg string)
