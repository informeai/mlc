// Random numbers. Two kinds, for different uses:
//
//   - Rand (splitmix64): fast and predictable. The same seed gives the same
//     sequence, which suits simulations, games and tests. It doesn't suit
//     security: whoever sees a few numbers can guess the next ones.
//
//         r := rand.new(uint64(time.now_ms()))
//         die := r.range(1, 7)
//
//   - secure: the bytes come from the operating system (the kernel's
//     cryptographic source). It's what you use for tokens, keys, temporary
//     passwords and identifiers that must not be guessable (std/uuid).
//
//         var token [32]byte
//         rand.secure(&token)            // then: encoding.hex or base64_url

// Rand is a generator: 64 bits of state, without allocation.
pub struct Rand {
    state uint64
}

// new creates a generator from the seed (the same seed gives the same sequence).
pub fn new(seed uint64) Rand {
    return Rand{state: seed}
}

// next returns any uint64 (splitmix64: the arithmetic wraps around on
// purpose, with +% and *%).
pub fn (r &Rand) next() uint64 {
    r.state +%= 0x9E37_79B9_7F4A_7C15
    z := r.state
    z = (z ^ (z >> 30)) *% 0xBF58_476D_1CE4_E5B9
    z = (z ^ (z >> 27)) *% 0x94D0_49BB_1331_11EB
    return z ^ (z >> 31)
}

// int_n returns an integer in [0, n). n must be greater than zero.
pub fn (r &Rand) int_n(n int) int {
    return int(r.next() % uint64(n))
}

// range returns an integer in [lo, hi).
pub fn (r &Rand) range(lo int, hi int) int {
    return lo + r.int_n(hi - lo)
}

// float returns a float64 in [0, 1).
pub fn (r &Rand) float() float64 {
    return float64(r.next() >> 11) / 9007199254740992.0 // 53 bits / 2^53
}

// ---------- secure randomness ----------

// secure fills dst with random bytes from the operating system, fit for
// cryptography. If the system doesn't deliver (it doesn't happen on the
// supported systems), it panics: there's no safe alternative.
pub extern fn secure(dst &[]byte)

// secure_u64 returns a secure random uint64.
pub fn secure_u64() uint64 {
    var b [8]byte
    secure(&b)
    var v uint64 = 0
    for i := 0; i < 8; i++ {
        v = (v << 8) | uint64(b[i])
    }
    return v
}

// secure_int_n returns a secure integer in [0, n), without bias: the values
// at the end of the uint64 range that would make some remainders come out more
// often are drawn again. n must be greater than zero.
pub fn secure_int_n(n int) int {
    if n <= 0 {
        fail("rand.secure_int_n: n must be greater than zero")
    }
    m := uint64(n)
    limit := 0xFFFF_FFFF_FFFF_FFFF - (0xFFFF_FFFF_FFFF_FFFF % m + 1) % m
    for {
        v := secure_u64()
        if v <= limit {
            return int(v % m)
        }
    }
}

// seeded creates a Rand with a secure seed: fast like Rand, but with a
// different sequence on each run.
pub fn seeded() Rand {
    return new(secure_u64())
}

extern fn fail(msg string)
