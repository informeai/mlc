// The result of an operation that can fail: the value, or the error.
//
//     match fs.read_file(&path, &buf) {
//         Ok(n) => ...
//         Err(code) => ...
//     }
//
// The error can be a code (Result[int, int], as in fs and os) or an enum
// with content, including owners (a message allocated by whoever creates the error):
// whoever consumes the Result with match receives ownership and must free it.
pub enum Result[T owned, E owned] {
    Ok(value T)
    Err(err E)
}
