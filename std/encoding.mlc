// Hex e base64: bytes em texto e de volta, em buffers de quem chama.
//
//     var digest [32]byte
//     hash.sha256_sum(&dados, &digest)
//     var txt [64]byte
//     n := encoding.hex(&txt, &digest)          // "ba7816bf..."
//
//     m := encoding.base64_len(len(dados))      // para alocar o tamanho exato
//     b := alloc([]byte, m)
//     encoding.base64(&b, &dados)
//
// As funções que escrevem dão panic se dst for pequeno demais; as que leem
// devolvem -1 para texto inválido.

const HEX = "0123456789abcdef"
const B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
const B64URL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

// hex escreve src em hexadecimal minúsculo (2 bytes de texto por byte) e
// devolve quantos bytes usou.
pub fn hex(dst &[]byte, src &[]byte) int {
    need(dst, 2 * len(src))
    for i := 0; i < len(src); i++ {
        dst[2 * i] = byte(HEX[int(src[i] >> 4)])
        dst[2 * i + 1] = byte(HEX[int(src[i] & 0x0F)])
    }
    return 2 * len(src)
}

// unhex lê hexadecimal (maiúsculo ou minúsculo) e devolve quantos bytes
// escreveu, ou -1 se o texto não for hex (ou tiver tamanho ímpar).
pub fn unhex(dst &[]byte, src &[]byte) int {
    if len(src) % 2 != 0 {
        return -1
    }
    need(dst, len(src) / 2)
    for i := 0; i < len(src) / 2; i++ {
        hi := hex_digit(src[2 * i])
        lo := hex_digit(src[2 * i + 1])
        if hi < 0 || lo < 0 {
            return -1
        }
        dst[i] = byte(hi * 16 + lo)
    }
    return len(src) / 2
}

fn hex_digit(c byte) int {
    if c >= '0' && c <= '9' {
        return int(c) - int('0')
    }
    if c >= 'a' && c <= 'f' {
        return int(c) - int('a') + 10
    }
    if c >= 'A' && c <= 'F' {
        return int(c) - int('A') + 10
    }
    return -1
}

// base64_len diz quantos bytes o base64 (com =) de n bytes ocupa.
pub fn base64_len(n int) int {
    return (n + 2) / 3 * 4
}

// base64 escreve src em base64 padrão (com + / e o enchimento =) e devolve
// quantos bytes usou.
pub fn base64(dst &[]byte, src &[]byte) int {
    return encode64(dst, src, B64, true)
}

// base64_url escreve em base64 para URLs e nomes de arquivo (- e _ no lugar
// de + e /, sem enchimento) e devolve quantos bytes usou.
pub fn base64_url(dst &[]byte, src &[]byte) int {
    return encode64(dst, src, B64URL, false)
}

fn encode64(dst &[]byte, src &[]byte, alphabet string, pad bool) int {
    need(dst, base64_len(len(src)))
    n := 0
    i := 0
    for i + 3 <= len(src) {
        v := int(src[i]) << 16 | int(src[i + 1]) << 8 | int(src[i + 2])
        dst[n] = byte(alphabet[(v >> 18) & 63])
        dst[n + 1] = byte(alphabet[(v >> 12) & 63])
        dst[n + 2] = byte(alphabet[(v >> 6) & 63])
        dst[n + 3] = byte(alphabet[v & 63])
        n += 4
        i += 3
    }
    rest := len(src) - i
    if rest > 0 {
        v := int(src[i]) << 16
        if rest == 2 {
            v = v | int(src[i + 1]) << 8
        }
        dst[n] = byte(alphabet[(v >> 18) & 63])
        dst[n + 1] = byte(alphabet[(v >> 12) & 63])
        n += 2
        if rest == 2 {
            dst[n] = byte(alphabet[(v >> 6) & 63])
            n++
        }
        if pad {
            for n % 4 != 0 {
                dst[n] = '='
                n++
            }
        }
    }
    return n
}

// unbase64 lê base64, padrão ou para URLs, com ou sem enchimento, e devolve
// quantos bytes escreveu, ou -1 se o texto for inválido. Um dst de
// len(src) * 3 / 4 bytes sempre basta.
pub fn unbase64(dst &[]byte, src &[]byte) int {
    end := len(src)
    for end > 0 && src[end - 1] == '=' {
        end--
    }
    if len(src) - end > 2 || (end % 4 == 1) {
        return -1
    }
    need(dst, end * 3 / 4)
    n := 0
    acc := 0
    bits := 0
    for i := 0; i < end; i++ {
        d := b64_digit(src[i])
        if d < 0 {
            return -1
        }
        acc = (acc << 6 | d) & 0xFFFFFF
        bits += 6
        if bits >= 8 {
            bits -= 8
            dst[n] = byte((acc >> bits) & 0xFF)
            n++
        }
    }
    return n
}

fn b64_digit(c byte) int {
    if c >= 'A' && c <= 'Z' {
        return int(c) - int('A')
    }
    if c >= 'a' && c <= 'z' {
        return int(c) - int('a') + 26
    }
    if c >= '0' && c <= '9' {
        return int(c) - int('0') + 52
    }
    if c == '+' || c == '-' {
        return 62
    }
    if c == '/' || c == '_' {
        return 63
    }
    return -1
}

fn need(dst &[]byte, n int) {
    if len(dst) < n {
        fail("o destino é pequeno demais para o texto")
    }
}

extern fn fail(msg string)
