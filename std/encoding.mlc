// Hex and base64: bytes to text and back, in the caller's buffers.
//
//     var digest [32]byte
//     hash.sha256_sum(&data, &digest)
//     var txt [64]byte
//     n := encoding.hex(&txt, &digest)          // "ba7816bf..."
//
//     m := encoding.base64_len(len(data))       // to allocate the exact size
//     b := alloc([]byte, m)
//     encoding.base64(&b, &data)
//
// The functions that write panic if dst is too small; the ones that read
// return -1 for invalid text.

const HEX = "0123456789abcdef"
const B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
const B64URL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

// hex writes src in lowercase hexadecimal (2 bytes of text per byte) and
// returns how many bytes it used.
pub fn hex(dst &[]byte, src &[]byte) int {
    need(dst, 2 * len(src))
    for i := 0; i < len(src); i++ {
        dst[2 * i] = byte(HEX[int(src[i] >> 4)])
        dst[2 * i + 1] = byte(HEX[int(src[i] & 0x0F)])
    }
    return 2 * len(src)
}

// unhex reads hexadecimal (upper- or lowercase) and returns how many bytes
// it wrote, or -1 if the text isn't hex (or has an odd length).
pub fn unhex(dst &[]byte, src &[]byte) int {
    if len(src) % 2 != 0 {
        return -1
    }
    need(dst, len(src) / 2)
    for i := 0; i < len(src) / 2; i++ {
        hi := hex_digit(src[2 * i])
        lo := hex_digit(src[2 * i + 1])
        if hi < 0 || lo < 0 {
            return -1
        }
        dst[i] = byte(hi * 16 + lo)
    }
    return len(src) / 2
}

fn hex_digit(c byte) int {
    if c >= '0' && c <= '9' {
        return int(c) - int('0')
    }
    if c >= 'a' && c <= 'f' {
        return int(c) - int('a') + 10
    }
    if c >= 'A' && c <= 'F' {
        return int(c) - int('A') + 10
    }
    return -1
}

// base64_len says how many bytes the base64 (with =) of n bytes takes.
pub fn base64_len(n int) int {
    return (n + 2) / 3 * 4
}

// base64 writes src in standard base64 (with + / and the = padding) and
// returns how many bytes it used.
pub fn base64(dst &[]byte, src &[]byte) int {
    return encode64(dst, src, B64, true)
}

// base64_url writes base64 for URLs and file names (- and _ instead of
// + and /, without padding) and returns how many bytes it used.
pub fn base64_url(dst &[]byte, src &[]byte) int {
    return encode64(dst, src, B64URL, false)
}

fn encode64(dst &[]byte, src &[]byte, alphabet string, pad bool) int {
    need(dst, base64_len(len(src)))
    n := 0
    i := 0
    for i + 3 <= len(src) {
        v := int(src[i]) << 16 | int(src[i + 1]) << 8 | int(src[i + 2])
        dst[n] = byte(alphabet[(v >> 18) & 63])
        dst[n + 1] = byte(alphabet[(v >> 12) & 63])
        dst[n + 2] = byte(alphabet[(v >> 6) & 63])
        dst[n + 3] = byte(alphabet[v & 63])
        n += 4
        i += 3
    }
    rest := len(src) - i
    if rest > 0 {
        v := int(src[i]) << 16
        if rest == 2 {
            v = v | int(src[i + 1]) << 8
        }
        dst[n] = byte(alphabet[(v >> 18) & 63])
        dst[n + 1] = byte(alphabet[(v >> 12) & 63])
        n += 2
        if rest == 2 {
            dst[n] = byte(alphabet[(v >> 6) & 63])
            n++
        }
        if pad {
            for n % 4 != 0 {
                dst[n] = '='
                n++
            }
        }
    }
    return n
}

// unbase64 reads base64, standard or for URLs, with or without padding, and
// returns how many bytes it wrote, or -1 if the text is invalid. A dst of
// len(src) * 3 / 4 bytes is always enough.
pub fn unbase64(dst &[]byte, src &[]byte) int {
    end := len(src)
    for end > 0 && src[end - 1] == '=' {
        end--
    }
    if len(src) - end > 2 || (end % 4 == 1) {
        return -1
    }
    need(dst, end * 3 / 4)
    n := 0
    acc := 0
    bits := 0
    for i := 0; i < end; i++ {
        d := b64_digit(src[i])
        if d < 0 {
            return -1
        }
        acc = (acc << 6 | d) & 0xFFFFFF
        bits += 6
        if bits >= 8 {
            bits -= 8
            dst[n] = byte((acc >> bits) & 0xFF)
            n++
        }
    }
    return n
}

fn b64_digit(c byte) int {
    if c >= 'A' && c <= 'Z' {
        return int(c) - int('A')
    }
    if c >= 'a' && c <= 'z' {
        return int(c) - int('a') + 26
    }
    if c >= '0' && c <= '9' {
        return int(c) - int('0') + 52
    }
    if c == '+' || c == '-' {
        return 62
    }
    if c == '/' || c == '_' {
        return 63
    }
    return -1
}

fn need(dst &[]byte, n int) {
    if len(dst) < n {
        fail("the destination is too small for the text")
    }
}

extern fn fail(msg string)
