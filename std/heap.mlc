// Priority queue: pop always returns the smallest element (or the largest, with
// new_max), in O(log n). It's a binary heap in a slice, and the allocation is
// visible here as in vec: new allocates, push calls grow when room runs out,
// and grow doubles the capacity with realloc.
//
// The order is cmp.Ord's: numbers, string, slices and structs with impl cmp.Ord
// (written by hand, to order by a field, or impl auto). The elements
// can be owners: push moves the value inside, pop returns ownership, and
// free frees each element (drop) and the heap.
//
//     struct Timer {
//         due int
//         id int
//     }
//     fn (t &Timer) cmp(o &Timer) int {
//         return t.due.cmp(&o.due)
//     }
//     impl cmp.Ord for Timer
//
//     timers := heap.new[Timer](16)
//     timers.push(Timer{due: 30, id: 1})
//     timers.push(Timer{due: 10, id: 2})
//     next := timers.pop()            // the one with due 10
//     timers.free()
//
// Equivalent elements (cmp == 0) come out in any order among themselves: to
// break ties, compare one more field (an arrival counter, for example).
//
// For items with owners (a Job with an allocated name), the heap keeps only the key
// and the index (Timer above, with id being the position in a vec.Vec[?*Job]): a
// ?*Job pointer doesn't implement cmp.Ord in this version.
import "std/cmp"

// Heap is the priority queue, a binary heap in a slice.
pub struct Heap[T owned + cmp.Ord] {
    items []T
    count int
    max bool // true: the largest comes out first
}

extern fn fail(msg string)

// new creates a heap where the smallest element comes out first.
pub fn new[T owned + cmp.Ord](cap int) *Heap[T] {
    return alloc(Heap[T]{items: alloc([]T, cap), count: 0, max: false})
}

// new_max creates a heap where the largest element comes out first.
pub fn new_max[T owned + cmp.Ord](cap int) *Heap[T] {
    return alloc(Heap[T]{items: alloc([]T, cap), count: 0, max: true})
}

// push puts x in the heap (x is moved inside).
pub fn (h &Heap[T]) push(x T) {
    if h.count == len(h.items) {
        h.grow()
    }
    old := replace(&h.items[h.count], x)
    drop(old) // the position after the end was empty
    h.count++
    h.up(h.count - 1)
}

// pop takes out the first element (the smallest, or the largest with new_max) and returns
// its ownership.
pub fn (h &Heap[T]) pop() T {
    if h.count == 0 {
        fail("heap.pop: heap vazio")
    }
    h.count--
    h.swap(0, h.count)
    x := take(&h.items[h.count])
    h.down(0)
    return x
}

// replace_top replaces the first element with x and returns the old one: the same
// as pop followed by push, in a single pass. It's the step of a top-K: with a
// heap of the K largest (new, the smallest on top), each value larger than the top
// takes its place.
pub fn (h &Heap[T]) replace_top(x T) T {
    if h.count == 0 {
        fail("heap.replace_top: heap vazio")
    }
    old := replace(&h.items[0], x)
    h.down(0)
    return old
}

// peek borrows the first element, without taking it out. While the borrow is
// used, the heap stays frozen.
pub fn (h &Heap[T]) peek() &T {
    if h.count == 0 {
        fail("heap.peek: heap vazio")
    }
    return &h.items[0]
}

// len returns how many elements there are in the heap.
pub fn (h &Heap[T]) len() int {
    return h.count
}

// cap returns how many elements fit before growing.
pub fn (h &Heap[T]) cap() int {
    return len(h.items)
}

// grow doubles the capacity (realloc).
pub fn (h &Heap[T]) grow() {
    h.items = realloc(h.items, len(h.items) * 2 + 1)
}

// clear frees the elements (drop) and leaves the heap empty, with the same
// capacity.
pub fn (h &Heap[T]) clear() {
    for i := 0; i < h.count; i++ {
        x := take(&h.items[i])
        drop(x)
    }
    h.count = 0
}

// free frees each element (drop) and the heap.
pub fn (h *Heap[T]) free() {
    for x in drain(h.items) {
        drop(x)
    }
    free(h.items)
    free(h)
}

// before says whether element i must come out before j.
fn (h &Heap[T]) before(i int, j int) bool {
    c := h.items[i].cmp(&h.items[j])
    if h.max {
        return c > 0
    }
    return c < 0
}

// up moves element i up while it must come out before its parent.
fn (h &Heap[T]) up(i int) {
    for i > 0 {
        parent := (i - 1) / 2
        if !h.before(i, parent) {
            return
        }
        h.swap(i, parent)
        i = parent
    }
}

// down moves element i down while one of its children must come out before it.
fn (h &Heap[T]) down(i int) {
    for {
        first := i
        l := 2 * i + 1
        r := l + 1
        if l < h.count && h.before(l, first) {
            first = l
        }
        if r < h.count && h.before(r, first) {
            first = r
        }
        if first == i {
            return
        }
        h.swap(i, first)
        i = first
    }
}

// swap swaps elements i and j, by ownership.
fn (h &Heap[T]) swap(i int, j int) {
    if i == j {
        return
    }
    a := take(&h.items[i])
    b := replace(&h.items[j], a)
    old := replace(&h.items[i], b)
    drop(old) // the zero left by the take
}
