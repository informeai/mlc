// Thread group: several threads waited for at once, instead of one
// thread.join per handle.
//
//     g := sync.group(8)                         // up to 8 threads at a time (allocates)
//     for i := 0; i < 100; i++ {
//         g.add(thread.spawn(worker, ctx(i), thread.STACK_64KB))
//     }
//     g.wait()                                   // waits for all and frees the group
//
// The capacity is the limit of live threads in the group: when it's full,
// add first collects the ones already finished (reap) and, if none has
// finished, waits for the oldest. In a server, sync.group(64) is "at most 64
// connections at a time", and the accept loop waits for a slot.
//
// The group owns the threads it receives, and the checker requires the
// wait, as it requires each thread's join. Only threads without a result
// (*thread.Thread) go in: results come back through a channel, a mutex or
// an atomic, or use thread.join, which returns each one's result.
import "std/thread"

// Group keeps the threads until the wait.
pub extern "C" type Group

// group creates a group with room for cap threads.
pub extern fn group(cap int) *Group

extern fn add_raw(g &Group, t *thread.Thread)
extern fn len_raw(g &Group) int
extern fn reap_raw(g &Group) int
extern fn wait_raw(g *Group)

// add puts the thread in the group (the handle is moved). With the group
// full, it collects the finished ones or waits for the oldest, to open a slot.
pub fn (g &Group) add(t *thread.Thread) {
    add_raw(g, t)
}

// reap waits for the group's threads that already finished (without blocking
// on the ones still running), frees their slots and returns how many.
pub fn (g &Group) reap() int {
    return reap_raw(g)
}

// len says how many threads are in the group (finished ones count until a
// reap, an add with the group full, or the wait).
pub fn (g &Group) len() int {
    return len_raw(g)
}

// wait waits for all the threads, in the order they joined, and frees the group.
pub fn (g *Group) wait() {
    wait_raw(g)
}
