// Grupo de threads: várias threads esperadas de uma vez, em vez de um
// thread.join para cada handle.
//
//     g := sync.group(8)                         // até 8 threads ao mesmo tempo (aloca)
//     for i := 0; i < 100; i++ {
//         g.add(thread.spawn(worker, ctx(i), thread.STACK_64KB))
//     }
//     g.wait()                                   // espera todas e libera o grupo
//
// A capacidade é o limite de threads vivas no grupo: com ele cheio, add
// primeiro recolhe as que já terminaram (reap) e, se nenhuma terminou,
// espera a mais antiga. Num servidor, sync.group(64) é "no máximo 64
// conexões ao mesmo tempo", e o laço do accept espera uma vaga.
//
// O grupo é dono das threads que recebe, e o verificador cobra o wait,
// como cobra o join de cada thread. Só entram threads sem resultado
// (*thread.Thread): os resultados voltam por um canal, um mutex ou um
// atomic, ou use thread.join, que devolve o resultado de cada uma.
import "std/thread"

// Group guarda as threads até o wait.
pub extern "C" type Group

// group cria um grupo com espaço para cap threads.
pub extern fn group(cap int) *Group

extern fn add_raw(g &Group, t *thread.Thread)
extern fn len_raw(g &Group) int
extern fn reap_raw(g &Group) int
extern fn wait_raw(g *Group)

// add põe a thread no grupo (o handle é movido). Com o grupo cheio,
// recolhe as que terminaram ou espera a mais antiga, para abrir uma vaga.
pub fn (g &Group) add(t *thread.Thread) {
    add_raw(g, t)
}

// reap espera as threads do grupo que já terminaram (sem bloquear nas que
// ainda rodam), libera as vagas delas e devolve quantas foram.
pub fn (g &Group) reap() int {
    return reap_raw(g)
}

// len diz quantas threads estão no grupo (as que terminaram contam até um
// reap, um add com o grupo cheio ou o wait).
pub fn (g &Group) len() int {
    return len_raw(g)
}

// wait espera todas as threads, na ordem em que entraram, e libera o grupo.
pub fn (g *Group) wait() {
    wait_raw(g)
}
