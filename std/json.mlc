// JSON without allocation: a reader that walks the text and returns one token at a
// time, and functions to remove and add escapes. There's no tree: the reader decides
// what to keep and where to allocate.
//
//     r := json.reader()
//     for {
//         match r.next(&doc) {
//             Key(a, b) => {
//                 if str.eq(&doc[a:b], "name") { ... the next token is the value ... }
//                 else { r.skip(&doc) }              // ignores this key's value
//             }
//             String(a, b) => {
//                 n := json.unescape(&buf, &doc[a:b]) // removes the escapes (\n, \u00e9)
//             }
//             Number(a, b) => str.parse_int(&doc[a:b], &v)
//             End => break
//             Error(pos) => { ... invalid text at pos ... }
//             _ => {}
//         }
//     }
//
// The reader checks the structure (alternating keys and values, commas,
// closings) and the grammar of numbers, strings and literals. The depth
// goes up to 64 levels.
import "std/io"
import "std/str"
import "std/utf8"

// Token is what the reader finds. The (a, b) pairs are positions in the text:
// &doc[a:b] is the content of a string (without the quotes and with the escapes as
// they are) or the text of a number.
pub enum Token {
    ObjectStart
    ObjectEnd
    ArrayStart
    ArrayEnd
    Key(a int, b int)
    String(a int, b int)
    Number(a int, b int)
    True
    False
    Null
    End           // the document ended
    Error(at int) // invalid text at position at
}

impl auto io.Display for Token

const VALUE = 0       // expects a value
const ARRAY_FIRST = 1 // after [: a value or ]
const KEY_FIRST = 2   // after {: a key or }
const KEY = 3         // after a comma in an object: a key
const AFTER = 4       // after a value: a comma or a closing
const DONE = 5        // the document's value ended
const FAILED = 6

// Reader is the reading state (on the caller's stack).
pub struct Reader {
    pos int
    stack [64]byte // { or [ of each open level
    depth int
    state int
}

// reader starts reading a document.
pub fn reader() Reader {
    var r Reader
    return r
}

// next returns the next token of s (always the same text, from start to
// end). After End or Error, it keeps returning the same.
pub fn (r &Reader) next(s &[]byte) Token {
    for {
        r.skip_space(s)
        if r.state == FAILED {
            return Token.Error(r.pos)
        }
        if r.state == DONE {
            if r.pos < len(s) {
                return r.fail()
            }
            return Token.End
        }
        if r.state == AFTER {
            if r.depth == 0 {
                r.state = DONE
                continue
            }
            if r.pos == len(s) {
                return r.fail()
            }
            c := s[r.pos]
            top := r.stack[r.depth - 1]
            if c == ',' {
                r.pos++
                if top == '{' {
                    r.state = KEY
                } else {
                    r.state = VALUE
                }
                continue
            }
            return r.close(c, top)
        }
        if r.pos == len(s) {
            return r.fail()
        }
        c := s[r.pos]
        if r.state == ARRAY_FIRST && c == ']' {
            return r.close(c, '[')
        }
        if r.state == KEY_FIRST && c == '}' {
            return r.close(c, '{')
        }
        if r.state == KEY_FIRST || r.state == KEY {
            return r.read_key(s)
        }
        return r.value(s)
    }
}

// skip skips the whole next value (with everything inside, if it's an
// object or array). Useful after a key you don't care about. Returns
// false if the text is invalid.
pub fn (r &Reader) skip(s &[]byte) bool {
    depth := r.depth
    first := true
    for first || r.depth > depth {
        first = false
        match r.next(s) {
            Error(_) => return false
            End => return false
            _ => {}
        }
    }
    return true
}

fn (r &Reader) fail() Token {
    r.state = FAILED
    return Token.Error(r.pos)
}

fn (r &Reader) skip_space(s &[]byte) {
    for r.pos < len(s) && (s[r.pos] == ' ' || s[r.pos] == '\t' || s[r.pos] == '\n' || s[r.pos] == '\r') {
        r.pos++
    }
}

// close handles } and ] against the open level (top).
fn (r &Reader) close(c byte, top byte) Token {
    if c == '}' && top == '{' {
        r.pos++
        r.depth--
        r.state = AFTER
        return Token.ObjectEnd
    }
    if c == ']' && top == '[' {
        r.pos++
        r.depth--
        r.state = AFTER
        return Token.ArrayEnd
    }
    return r.fail()
}

fn (r &Reader) open(c byte) bool {
    if r.depth == len(r.stack) {
        return false
    }
    r.stack[r.depth] = c
    r.depth++
    r.pos++
    return true
}

fn (r &Reader) read_key(s &[]byte) Token {
    if s[r.pos] != '"' {
        return r.fail()
    }
    a := r.pos + 1
    b := scan_string(s, a)
    if b < 0 {
        return r.fail()
    }
    r.pos = b + 1
    r.skip_space(s)
    if r.pos == len(s) || s[r.pos] != ':' {
        return r.fail()
    }
    r.pos++
    r.state = VALUE
    return Token.Key(a, b)
}

fn (r &Reader) value(s &[]byte) Token {
    c := s[r.pos]
    if c == '{' {
        if !r.open(c) {
            return r.fail()
        }
        r.state = KEY_FIRST
        return Token.ObjectStart
    }
    if c == '[' {
        if !r.open(c) {
            return r.fail()
        }
        r.state = ARRAY_FIRST
        return Token.ArrayStart
    }
    if c == '"' {
        a := r.pos + 1
        b := scan_string(s, a)
        if b < 0 {
            return r.fail()
        }
        r.pos = b + 1
        r.state = AFTER
        return Token.String(a, b)
    }
    if c == '-' || (c >= '0' && c <= '9') {
        a := r.pos
        b := scan_number(s, a)
        if b < 0 {
            return r.fail()
        }
        r.pos = b
        r.state = AFTER
        return Token.Number(a, b)
    }
    if r.literal(s, "true") {
        return Token.True
    }
    if r.literal(s, "false") {
        return Token.False
    }
    if r.literal(s, "null") {
        return Token.Null
    }
    return r.fail()
}

fn (r &Reader) literal(s &[]byte, word string) bool {
    if r.pos + len(word) > len(s) || !str.eq(&s[r.pos:r.pos + len(word)], word) {
        return false
    }
    r.pos += len(word)
    r.state = AFTER
    return true
}

// scan_string finds the quote that closes the string starting at a (after the
// opening quote), checking the escapes; -1 if it's invalid.
fn scan_string(s &[]byte, a int) int {
    i := a
    for i < len(s) {
        c := s[i]
        if c == '"' {
            return i
        }
        if c < 0x20 {
            return -1 // control character without an escape
        }
        if c == '\\' {
            i++
            if i == len(s) {
                return -1
            }
            e := s[i]
            if e == 'u' {
                if i + 4 >= len(s) {
                    return -1
                }
                for k := 1; k <= 4; k++ {
                    if hex(s[i + k]) < 0 {
                        return -1
                    }
                }
                i += 4
            } else if e != '"' && e != '\\' && e != '/' && e != 'b' && e != 'f' && e != 'n' && e != 'r' && e != 't' {
                return -1
            }
        }
        i++
    }
    return -1
}

// scan_number checks the grammar of a number starting at a and returns
// where it ends; -1 if it's invalid.
fn scan_number(s &[]byte, a int) int {
    i := a
    if s[i] == '-' {
        i++
    }
    if i == len(s) || s[i] < '0' || s[i] > '9' {
        return -1
    }
    if s[i] == '0' {
        i++ // no leading zeros
    } else {
        i = skip_digits(s, i)
    }
    if i < len(s) && s[i] == '.' {
        i++
        if i == len(s) || s[i] < '0' || s[i] > '9' {
            return -1
        }
        i = skip_digits(s, i)
    }
    if i < len(s) && (s[i] == 'e' || s[i] == 'E') {
        i++
        if i < len(s) && (s[i] == '+' || s[i] == '-') {
            i++
        }
        if i == len(s) || s[i] < '0' || s[i] > '9' {
            return -1
        }
        i = skip_digits(s, i)
    }
    return i
}

fn skip_digits(s &[]byte, i int) int {
    for i < len(s) && s[i] >= '0' && s[i] <= '9' {
        i++
    }
    return i
}

fn hex(c byte) int {
    if c >= '0' && c <= '9' {
        return int(c) - int('0')
    }
    if c >= 'a' && c <= 'f' {
        return int(c) - int('a') + 10
    }
    if c >= 'A' && c <= 'F' {
        return int(c) - int('A') + 10
    }
    return -1
}

fn hex4(s &[]byte, i int) int {
    return (hex(s[i]) << 12) | (hex(s[i + 1]) << 8) | (hex(s[i + 2]) << 4) | hex(s[i + 3])
}

// unescape copies the content of a string (from a String or Key token) into
// dst, replacing the escapes with the characters (\u00e9 becomes é, with the
// surrogate pairs joined). Returns how many bytes it used. The text never grows,
// so a dst the size of raw is always enough. A lone surrogate becomes
// U+FFFD.
pub fn unescape(dst &[]byte, raw &[]byte) int {
    n := 0
    i := 0
    for i < len(raw) {
        c := raw[i]
        if c != '\\' {
            dst[n] = c
            n++
            i++
            continue
        }
        e := raw[i + 1]
        i += 2
        if e == 'u' {
            code := hex4(raw, i)
            i += 4
            if code >= 0xD800 && code <= 0xDBFF && i + 5 < len(raw) && raw[i] == '\\' && raw[i + 1] == 'u' {
                low := hex4(raw, i + 2)
                if low >= 0xDC00 && low <= 0xDFFF {
                    code = 0x10000 + ((code - 0xD800) << 10) + (low - 0xDC00)
                    i += 6
                }
            }
            n += utf8.encode(&dst[n:], code)
            continue
        }
        b := e
        if e == 'b' {
            b = 8
        } else if e == 'f' {
            b = 12
        } else if e == 'n' {
            b = '\n'
        } else if e == 'r' {
            b = '\r'
        } else if e == 't' {
            b = '\t'
        }
        dst[n] = b
        n++
    }
    return n
}

// escape_len says how many bytes escape will use for s.
pub fn escape_len(s &[]byte) int {
    n := 0
    for c in s {
        if c == '"' || c == '\\' || c == '\n' || c == '\r' || c == '\t' || c == 8 || c == 12 {
            n += 2
        } else if c < 0x20 {
            n += 6
        } else {
            n++
        }
    }
    return n
}

// escape writes s into dst with JSON's escapes (without the surrounding quotes) and
// returns how many bytes it used. To build a document, combine it with
// str.format: str.format(&out, "{{\"name\": \"{:s}\"}}", &esc[:n]).
pub fn escape(dst &[]byte, s &[]byte) int {
    n := 0
    for c in s {
        if c == '"' || c == '\\' {
            dst[n] = '\\'
            dst[n + 1] = c
            n += 2
        } else if c == '\n' {
            n += str.copy(&dst[n:], "\\n")
        } else if c == '\r' {
            n += str.copy(&dst[n:], "\\r")
        } else if c == '\t' {
            n += str.copy(&dst[n:], "\\t")
        } else if c == 8 {
            n += str.copy(&dst[n:], "\\b")
        } else if c == 12 {
            n += str.copy(&dst[n:], "\\f")
        } else if c < 0x20 {
            n += str.format(&dst[n:], "\\u{:04x}", int(c))
        } else {
            dst[n] = c
            n++
        }
    }
    return n
}

// ---------- writing ----------

// MAX_DEPTH is how many objects and arrays a Writer nests.
pub const MAX_DEPTH = 32

// Writer builds a JSON document with the right commas, quotes and escapes.
// The text is in &w.buf[:w.n]. The buffer is an owner that grows
// (realloc, visible in grow): create the Writer once, use reset between one
// document and the next, and free at the end.
//
//     w := json.writer(4096)
//     w.object()
//     w.field_int("id", 7)
//     w.field_str("name", "café")
//     w.key("tags")
//     w.array()
//     w.str("hot")
//     w.str("strong")
//     w.end()
//     w.field_bool("active", true)
//     w.end()
//     // &w.buf[:w.n] is {"id":7,"name":"café","tags":["hot","strong"],"active":true}
//     http.respond(&c, 200, "application/json", &w.buf[:w.n])
//     w.reset()
//     ...
//     w.free()
//
// Wrong use (a value without a key inside an object, a key in an array, end
// with nothing open, two values at the root) is a program error and panics.
// NaN and infinity, which JSON doesn't have, become null.
pub struct Writer {
    buf []byte
    n int
    kind [32]byte // 'o' (object) or 'a' (array), per level
    count [32]int // items already written at each level
    depth int
    after_key bool // in an object, the key was written and the value is missing
    roots int      // values written at the root (a document has one)
}

// writer allocates a Writer with cap bytes (it grows if needed).
pub fn writer(cap int) *Writer {
    if cap < 16 {
        cap = 16
    }
    return alloc(Writer{buf: alloc([]byte, cap), n: 0, kind: [32]byte{}, count: [32]int{}, depth: 0, after_key: false, roots: 0})
}

// free frees the Writer.
pub fn (w *Writer) free() {
    free(w.buf)
    free(w)
}

// reset empties the Writer for the next document (the buffer stays).
pub fn (w &Writer) reset() {
    w.n = 0
    w.depth = 0
    w.after_key = false
    w.roots = 0
}

// done says whether the document is complete: one value at the root and everything closed.
pub fn (w &Writer) done() bool {
    return w.roots == 1 && w.depth == 0
}

// object opens an object ({).
pub fn (w &Writer) object() {
    w.open('o', '{')
}

// array opens an array ([).
pub fn (w &Writer) array() {
    w.open('a', '[')
}

// end closes the object or array opened last.
pub fn (w &Writer) end() {
    if w.depth == 0 {
        fail("json.Writer.end: there's no open object or array")
    }
    if w.after_key {
        fail("json.Writer.end: the last key was left without a value")
    }
    w.depth--
    if w.kind[w.depth] == 'o' {
        w.put('}')
    } else {
        w.put(']')
    }
}

// key writes the key of the next value, in an object.
pub fn (w &Writer) key(name string) {
    var b [256]byte
    if len(name) > len(b) {
        fail("json.Writer.key: key longer than 256 bytes; use key_bytes")
    }
    n := str.copy(&b, name)
    w.key_bytes(&b[:n])
}

// key_bytes is key with the key built at run time.
pub fn (w &Writer) key_bytes(name &[]byte) {
    if w.depth == 0 || w.kind[w.depth - 1] != 'o' {
        fail("json.Writer.key: key only exists inside an object")
    }
    if w.after_key {
        fail("json.Writer.key: the previous key was left without a value")
    }
    if w.count[w.depth - 1] > 0 {
        w.put(',')
    }
    w.count[w.depth - 1]++
    w.quoted(name)
    w.put(':')
    w.after_key = true
}

// str writes a fixed text from the program (with quotes and escapes).
pub fn (w &Writer) str(s string) {
    var b [1024]byte
    if len(s) > len(b) {
        fail("json.Writer.str: text larger than 1 KB; use text")
    }
    n := str.copy(&b, s)
    w.text(&b[:n])
}

// text writes a text (with quotes and escapes).
pub fn (w &Writer) text(s &[]byte) {
    w.before()
    w.quoted(s)
}

// int writes an integer.
pub fn (w &Writer) int(v int) {
    w.before()
    w.reserve(24)
    w.n += str.put_int(&w.buf[w.n:w.n + 24], v)
}

// float writes a real (the shortest text that represents it; NaN and infinity
// become null).
pub fn (w &Writer) float(v float64) {
    w.before()
    if v != v || v - v != 0.0 {
        w.literal("null")
        return
    }
    w.reserve(40)
    w.n += str.put_float(&w.buf[w.n:w.n + 40], v)
}

// bool writes true or false.
pub fn (w &Writer) bool(v bool) {
    w.before()
    if v {
        w.literal("true")
    } else {
        w.literal("false")
    }
}

// null writes null.
pub fn (w &Writer) null() {
    w.before()
    w.literal("null")
}

// raw writes a piece that's already valid JSON (it isn't checked).
pub fn (w &Writer) raw(s &[]byte) {
    w.before()
    w.reserve(len(s))
    for i := 0; i < len(s); i++ {
        w.buf[w.n + i] = s[i]
    }
    w.n += len(s)
}

// field_str writes "key": "text" in an object.
pub fn (w &Writer) field_str(key string, v string) {
    w.key(key)
    w.str(v)
}

// field_text writes "key": text in an object.
pub fn (w &Writer) field_text(key string, v &[]byte) {
    w.key(key)
    w.text(v)
}

// field_int writes "key": integer in an object.
pub fn (w &Writer) field_int(key string, v int) {
    w.key(key)
    w.int(v)
}

// field_float writes "key": real in an object.
pub fn (w &Writer) field_float(key string, v float64) {
    w.key(key)
    w.float(v)
}

// field_bool writes "key": true or false in an object.
pub fn (w &Writer) field_bool(key string, v bool) {
    w.key(key)
    w.bool(v)
}

// field_null writes "key": null in an object.
pub fn (w &Writer) field_null(key string) {
    w.key(key)
    w.null()
}

// before checks where a value can go and writes the comma.
fn (w &Writer) before() {
    if w.depth == 0 {
        if w.roots > 0 {
            fail("json.Writer: the document already has a value at the root (use reset to start another)")
        }
        w.roots++
        return
    }
    d := w.depth - 1
    if w.kind[d] == 'o' {
        if !w.after_key {
            fail("json.Writer: inside an object, each value needs a key first")
        }
        w.after_key = false
        return
    }
    if w.count[d] > 0 {
        w.put(',')
    }
    w.count[d]++
}

fn (w &Writer) open(kind byte, c byte) {
    w.before()
    if w.depth == MAX_DEPTH {
        fail("json.Writer: too much nesting (the maximum is 32)")
    }
    w.kind[w.depth] = kind
    w.count[w.depth] = 0
    w.depth++
    w.put(c)
}

fn (w &Writer) quoted(s &[]byte) {
    k := escape_len(s)
    w.reserve(k + 2)
    w.buf[w.n] = '"'
    w.n++
    w.n += escape(&w.buf[w.n:w.n + k], s)
    w.buf[w.n] = '"'
    w.n++
}

fn (w &Writer) literal(s string) {
    w.reserve(len(s))
    w.n += str.copy(&w.buf[w.n:], s)
}

fn (w &Writer) put(c byte) {
    w.reserve(1)
    w.buf[w.n] = c
    w.n++
}

// reserve guarantees k free bytes, growing the buffer (realloc).
fn (w &Writer) reserve(k int) {
    if w.n + k <= len(w.buf) {
        return
    }
    size := len(w.buf) * 2
    if size < w.n + k {
        size = w.n + k
    }
    w.buf = realloc(w.buf, size)
}

extern fn fail(msg string)
