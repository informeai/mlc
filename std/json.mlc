// JSON sem alocação: um leitor que percorre o texto e devolve um token por
// vez, e funções para tirar e pôr escapes. Não há árvore: quem lê decide o
// que guardar e onde alocar.
//
//     r := json.reader()
//     for {
//         match r.next(&doc) {
//             Key(a, b) => {
//                 if str.eq(&doc[a:b], "name") { ... o próximo token é o valor ... }
//                 else { r.skip(&doc) }              // ignora o valor desta chave
//             }
//             String(a, b) => {
//                 n := json.unescape(&buf, &doc[a:b]) // tira os escapes (\n, é)
//             }
//             Number(a, b) => str.parse_int(&doc[a:b], &v)
//             End => break
//             Error(pos) => { ... texto inválido em pos ... }
//             _ => {}
//         }
//     }
//
// O leitor confere a estrutura (chaves e valores alternados, vírgulas,
// fechamentos) e a gramática dos números, strings e literais. A profundidade
// vai até 64 níveis.
import "std/io"
import "std/str"
import "std/utf8"

// Token é o que o leitor encontra. Os pares (a, b) são posições no texto:
// &doc[a:b] é o conteúdo de uma string (sem as aspas e com os escapes como
// estão) ou o texto de um número.
pub enum Token {
    ObjectStart
    ObjectEnd
    ArrayStart
    ArrayEnd
    Key(a int, b int)
    String(a int, b int)
    Number(a int, b int)
    True
    False
    Null
    End           // o documento acabou
    Error(at int) // texto inválido na posição at
}

impl auto io.Display for Token

const VALUE = 0       // espera um valor
const ARRAY_FIRST = 1 // depois de [: um valor ou ]
const KEY_FIRST = 2   // depois de {: uma chave ou }
const KEY = 3         // depois de uma vírgula num objeto: uma chave
const AFTER = 4       // depois de um valor: vírgula ou fechamento
const DONE = 5        // o valor do documento acabou
const FAILED = 6

// Reader é o estado da leitura (na pilha de quem chama).
pub struct Reader {
    pos int
    stack [64]byte // { ou [ de cada nível aberto
    depth int
    state int
}

// reader começa a ler um documento.
pub fn reader() Reader {
    var r Reader
    return r
}

// next devolve o próximo token de s (sempre o mesmo texto, do começo ao
// fim). Depois de End ou Error, continua devolvendo o mesmo.
pub fn (r &Reader) next(s &[]byte) Token {
    for {
        r.skip_space(s)
        if r.state == FAILED {
            return Token.Error(r.pos)
        }
        if r.state == DONE {
            if r.pos < len(s) {
                return r.fail()
            }
            return Token.End
        }
        if r.state == AFTER {
            if r.depth == 0 {
                r.state = DONE
                continue
            }
            if r.pos == len(s) {
                return r.fail()
            }
            c := s[r.pos]
            top := r.stack[r.depth - 1]
            if c == ',' {
                r.pos++
                if top == '{' {
                    r.state = KEY
                } else {
                    r.state = VALUE
                }
                continue
            }
            return r.close(c, top)
        }
        if r.pos == len(s) {
            return r.fail()
        }
        c := s[r.pos]
        if r.state == ARRAY_FIRST && c == ']' {
            return r.close(c, '[')
        }
        if r.state == KEY_FIRST && c == '}' {
            return r.close(c, '{')
        }
        if r.state == KEY_FIRST || r.state == KEY {
            return r.read_key(s)
        }
        return r.value(s)
    }
}

// skip pula o próximo valor inteiro (com tudo que houver dentro, se for um
// objeto ou array). Serve depois de uma chave que não interessa. Devolve
// false se o texto for inválido.
pub fn (r &Reader) skip(s &[]byte) bool {
    depth := r.depth
    first := true
    for first || r.depth > depth {
        first = false
        match r.next(s) {
            Error(_) => return false
            End => return false
            _ => {}
        }
    }
    return true
}

fn (r &Reader) fail() Token {
    r.state = FAILED
    return Token.Error(r.pos)
}

fn (r &Reader) skip_space(s &[]byte) {
    for r.pos < len(s) && (s[r.pos] == ' ' || s[r.pos] == '\t' || s[r.pos] == '\n' || s[r.pos] == '\r') {
        r.pos++
    }
}

// close trata } e ] contra o nível aberto (top).
fn (r &Reader) close(c byte, top byte) Token {
    if c == '}' && top == '{' {
        r.pos++
        r.depth--
        r.state = AFTER
        return Token.ObjectEnd
    }
    if c == ']' && top == '[' {
        r.pos++
        r.depth--
        r.state = AFTER
        return Token.ArrayEnd
    }
    return r.fail()
}

fn (r &Reader) open(c byte) bool {
    if r.depth == len(r.stack) {
        return false
    }
    r.stack[r.depth] = c
    r.depth++
    r.pos++
    return true
}

fn (r &Reader) read_key(s &[]byte) Token {
    if s[r.pos] != '"' {
        return r.fail()
    }
    a := r.pos + 1
    b := scan_string(s, a)
    if b < 0 {
        return r.fail()
    }
    r.pos = b + 1
    r.skip_space(s)
    if r.pos == len(s) || s[r.pos] != ':' {
        return r.fail()
    }
    r.pos++
    r.state = VALUE
    return Token.Key(a, b)
}

fn (r &Reader) value(s &[]byte) Token {
    c := s[r.pos]
    if c == '{' {
        if !r.open(c) {
            return r.fail()
        }
        r.state = KEY_FIRST
        return Token.ObjectStart
    }
    if c == '[' {
        if !r.open(c) {
            return r.fail()
        }
        r.state = ARRAY_FIRST
        return Token.ArrayStart
    }
    if c == '"' {
        a := r.pos + 1
        b := scan_string(s, a)
        if b < 0 {
            return r.fail()
        }
        r.pos = b + 1
        r.state = AFTER
        return Token.String(a, b)
    }
    if c == '-' || (c >= '0' && c <= '9') {
        a := r.pos
        b := scan_number(s, a)
        if b < 0 {
            return r.fail()
        }
        r.pos = b
        r.state = AFTER
        return Token.Number(a, b)
    }
    if r.literal(s, "true") {
        return Token.True
    }
    if r.literal(s, "false") {
        return Token.False
    }
    if r.literal(s, "null") {
        return Token.Null
    }
    return r.fail()
}

fn (r &Reader) literal(s &[]byte, word string) bool {
    if r.pos + len(word) > len(s) || !str.eq(&s[r.pos:r.pos + len(word)], word) {
        return false
    }
    r.pos += len(word)
    r.state = AFTER
    return true
}

// scan_string acha as aspas que fecham a string que começa em a (depois das
// aspas de abertura), conferindo os escapes; -1 se for inválida.
fn scan_string(s &[]byte, a int) int {
    i := a
    for i < len(s) {
        c := s[i]
        if c == '"' {
            return i
        }
        if c < 0x20 {
            return -1 // caractere de controle sem escape
        }
        if c == '\\' {
            i++
            if i == len(s) {
                return -1
            }
            e := s[i]
            if e == 'u' {
                if i + 4 >= len(s) {
                    return -1
                }
                for k := 1; k <= 4; k++ {
                    if hex(s[i + k]) < 0 {
                        return -1
                    }
                }
                i += 4
            } else if e != '"' && e != '\\' && e != '/' && e != 'b' && e != 'f' && e != 'n' && e != 'r' && e != 't' {
                return -1
            }
        }
        i++
    }
    return -1
}

// scan_number confere a gramática de um número que começa em a e devolve
// onde ele termina; -1 se for inválido.
fn scan_number(s &[]byte, a int) int {
    i := a
    if s[i] == '-' {
        i++
    }
    if i == len(s) || s[i] < '0' || s[i] > '9' {
        return -1
    }
    if s[i] == '0' {
        i++ // sem zeros à esquerda
    } else {
        i = skip_digits(s, i)
    }
    if i < len(s) && s[i] == '.' {
        i++
        if i == len(s) || s[i] < '0' || s[i] > '9' {
            return -1
        }
        i = skip_digits(s, i)
    }
    if i < len(s) && (s[i] == 'e' || s[i] == 'E') {
        i++
        if i < len(s) && (s[i] == '+' || s[i] == '-') {
            i++
        }
        if i == len(s) || s[i] < '0' || s[i] > '9' {
            return -1
        }
        i = skip_digits(s, i)
    }
    return i
}

fn skip_digits(s &[]byte, i int) int {
    for i < len(s) && s[i] >= '0' && s[i] <= '9' {
        i++
    }
    return i
}

fn hex(c byte) int {
    if c >= '0' && c <= '9' {
        return int(c) - int('0')
    }
    if c >= 'a' && c <= 'f' {
        return int(c) - int('a') + 10
    }
    if c >= 'A' && c <= 'F' {
        return int(c) - int('A') + 10
    }
    return -1
}

fn hex4(s &[]byte, i int) int {
    return (hex(s[i]) << 12) | (hex(s[i + 1]) << 8) | (hex(s[i + 2]) << 4) | hex(s[i + 3])
}

// unescape copia o conteúdo de uma string (de um token String ou Key) para
// dst, trocando os escapes pelos caracteres (é vira é, com os pares de
// surrogates juntados). Devolve quantos bytes usou. O texto nunca cresce,
// então um dst do tamanho de raw sempre basta. Um surrogate sozinho vira
// U+FFFD.
pub fn unescape(dst &[]byte, raw &[]byte) int {
    n := 0
    i := 0
    for i < len(raw) {
        c := raw[i]
        if c != '\\' {
            dst[n] = c
            n++
            i++
            continue
        }
        e := raw[i + 1]
        i += 2
        if e == 'u' {
            code := hex4(raw, i)
            i += 4
            if code >= 0xD800 && code <= 0xDBFF && i + 5 < len(raw) && raw[i] == '\\' && raw[i + 1] == 'u' {
                low := hex4(raw, i + 2)
                if low >= 0xDC00 && low <= 0xDFFF {
                    code = 0x10000 + ((code - 0xD800) << 10) + (low - 0xDC00)
                    i += 6
                }
            }
            n += utf8.encode(&dst[n:], code)
            continue
        }
        b := e
        if e == 'b' {
            b = 8
        } else if e == 'f' {
            b = 12
        } else if e == 'n' {
            b = '\n'
        } else if e == 'r' {
            b = '\r'
        } else if e == 't' {
            b = '\t'
        }
        dst[n] = b
        n++
    }
    return n
}

// escape_len diz quantos bytes escape vai usar para s.
pub fn escape_len(s &[]byte) int {
    n := 0
    for c in s {
        if c == '"' || c == '\\' || c == '\n' || c == '\r' || c == '\t' || c == 8 || c == 12 {
            n += 2
        } else if c < 0x20 {
            n += 6
        } else {
            n++
        }
    }
    return n
}

// escape escreve s em dst com os escapes de JSON (sem as aspas em volta) e
// devolve quantos bytes usou. Para montar um documento, junte com
// str.format: str.format(&out, "{{\"name\": \"{:s}\"}}", &esc[:n]).
pub fn escape(dst &[]byte, s &[]byte) int {
    n := 0
    for c in s {
        if c == '"' || c == '\\' {
            dst[n] = '\\'
            dst[n + 1] = c
            n += 2
        } else if c == '\n' {
            n += str.copy(&dst[n:], "\\n")
        } else if c == '\r' {
            n += str.copy(&dst[n:], "\\r")
        } else if c == '\t' {
            n += str.copy(&dst[n:], "\\t")
        } else if c == 8 {
            n += str.copy(&dst[n:], "\\b")
        } else if c == 12 {
            n += str.copy(&dst[n:], "\\f")
        } else if c < 0x20 {
            n += str.format(&dst[n:], "\\u{:04x}", int(c))
        } else {
            dst[n] = c
            n++
        }
    }
    return n
}

// ---------- escrita ----------

// MAX_DEPTH é quantos objetos e arrays um Writer aninha.
pub const MAX_DEPTH = 32

// Writer monta um documento JSON com as vírgulas, as aspas e os escapes
// certos. O texto fica em &w.buf[:w.n]. O buffer é um dono que cresce
// (realloc, à vista em grow): crie o Writer uma vez, use reset entre um
// documento e outro, e free no fim.
//
//     w := json.writer(4096)
//     w.object()
//     w.field_int("id", 7)
//     w.field_str("nome", "café")
//     w.key("tags")
//     w.array()
//     w.str("quente")
//     w.str("forte")
//     w.end()
//     w.field_bool("ativo", true)
//     w.end()
//     // &w.buf[:w.n] é {"id":7,"nome":"café","tags":["quente","forte"],"ativo":true}
//     http.respond(&c, 200, "application/json", &w.buf[:w.n])
//     w.reset()
//     ...
//     w.free()
//
// Um uso errado (um valor sem key dentro de um objeto, key num array, end
// sem nada aberto, dois valores na raiz) é um erro do programa e dá panic.
// NaN e infinito, que o JSON não tem, viram null.
pub struct Writer {
    buf []byte
    n int
    kind [32]byte // 'o' (objeto) ou 'a' (array), por nível
    count [32]int // itens já escritos em cada nível
    depth int
    after_key bool // num objeto, a key foi escrita e falta o valor
    roots int      // valores escritos na raiz (um documento tem um)
}

// writer aloca um Writer com cap bytes (ele cresce se precisar).
pub fn writer(cap int) *Writer {
    if cap < 16 {
        cap = 16
    }
    return alloc(Writer{buf: alloc([]byte, cap), n: 0, kind: [32]byte{}, count: [32]int{}, depth: 0, after_key: false, roots: 0})
}

// free libera o Writer.
pub fn (w *Writer) free() {
    free(w.buf)
    free(w)
}

// reset esvazia o Writer para o próximo documento (o buffer fica).
pub fn (w &Writer) reset() {
    w.n = 0
    w.depth = 0
    w.after_key = false
    w.roots = 0
}

// done diz se o documento está completo: um valor na raiz e tudo fechado.
pub fn (w &Writer) done() bool {
    return w.roots == 1 && w.depth == 0
}

// object abre um objeto ({).
pub fn (w &Writer) object() {
    w.open('o', '{')
}

// array abre um array ([).
pub fn (w &Writer) array() {
    w.open('a', '[')
}

// end fecha o objeto ou o array aberto por último.
pub fn (w &Writer) end() {
    if w.depth == 0 {
        fail("json.Writer.end: não há objeto nem array aberto")
    }
    if w.after_key {
        fail("json.Writer.end: a última key ficou sem valor")
    }
    w.depth--
    if w.kind[w.depth] == 'o' {
        w.put('}')
    } else {
        w.put(']')
    }
}

// key escreve a chave do próximo valor, num objeto.
pub fn (w &Writer) key(name string) {
    var b [256]byte
    if len(name) > len(b) {
        fail("json.Writer.key: chave maior que 256 bytes; use key_bytes")
    }
    n := str.copy(&b, name)
    w.key_bytes(&b[:n])
}

// key_bytes é key com a chave montada em tempo de execução.
pub fn (w &Writer) key_bytes(name &[]byte) {
    if w.depth == 0 || w.kind[w.depth - 1] != 'o' {
        fail("json.Writer.key: key só existe dentro de um objeto")
    }
    if w.after_key {
        fail("json.Writer.key: a key anterior ficou sem valor")
    }
    if w.count[w.depth - 1] > 0 {
        w.put(',')
    }
    w.count[w.depth - 1]++
    w.quoted(name)
    w.put(':')
    w.after_key = true
}

// str escreve um texto fixo do programa (com aspas e escapes).
pub fn (w &Writer) str(s string) {
    var b [1024]byte
    if len(s) > len(b) {
        fail("json.Writer.str: texto maior que 1 KB; use text")
    }
    n := str.copy(&b, s)
    w.text(&b[:n])
}

// text escreve um texto (com aspas e escapes).
pub fn (w &Writer) text(s &[]byte) {
    w.before()
    w.quoted(s)
}

// int escreve um inteiro.
pub fn (w &Writer) int(v int) {
    w.before()
    w.reserve(24)
    w.n += str.put_int(&w.buf[w.n:w.n + 24], v)
}

// float escreve um real (o menor texto que o representa; NaN e infinito
// viram null).
pub fn (w &Writer) float(v float64) {
    w.before()
    if v != v || v - v != 0.0 {
        w.literal("null")
        return
    }
    w.reserve(40)
    w.n += str.put_float(&w.buf[w.n:w.n + 40], v)
}

// bool escreve true ou false.
pub fn (w &Writer) bool(v bool) {
    w.before()
    if v {
        w.literal("true")
    } else {
        w.literal("false")
    }
}

// null escreve null.
pub fn (w &Writer) null() {
    w.before()
    w.literal("null")
}

// raw escreve um pedaço que já é JSON válido (não é conferido).
pub fn (w &Writer) raw(s &[]byte) {
    w.before()
    w.reserve(len(s))
    for i := 0; i < len(s); i++ {
        w.buf[w.n + i] = s[i]
    }
    w.n += len(s)
}

// field_str escreve "key": "texto" num objeto.
pub fn (w &Writer) field_str(key string, v string) {
    w.key(key)
    w.str(v)
}

// field_text escreve "key": texto num objeto.
pub fn (w &Writer) field_text(key string, v &[]byte) {
    w.key(key)
    w.text(v)
}

// field_int escreve "key": inteiro num objeto.
pub fn (w &Writer) field_int(key string, v int) {
    w.key(key)
    w.int(v)
}

// field_float escreve "key": real num objeto.
pub fn (w &Writer) field_float(key string, v float64) {
    w.key(key)
    w.float(v)
}

// field_bool escreve "key": true ou false num objeto.
pub fn (w &Writer) field_bool(key string, v bool) {
    w.key(key)
    w.bool(v)
}

// field_null escreve "key": null num objeto.
pub fn (w &Writer) field_null(key string) {
    w.key(key)
    w.null()
}

// before confere onde um valor pode entrar e escreve a vírgula.
fn (w &Writer) before() {
    if w.depth == 0 {
        if w.roots > 0 {
            fail("json.Writer: o documento já tem um valor na raiz (use reset para começar outro)")
        }
        w.roots++
        return
    }
    d := w.depth - 1
    if w.kind[d] == 'o' {
        if !w.after_key {
            fail("json.Writer: dentro de um objeto, cada valor precisa de uma key antes")
        }
        w.after_key = false
        return
    }
    if w.count[d] > 0 {
        w.put(',')
    }
    w.count[d]++
}

fn (w &Writer) open(kind byte, c byte) {
    w.before()
    if w.depth == MAX_DEPTH {
        fail("json.Writer: aninhamento demais (o máximo é 32)")
    }
    w.kind[w.depth] = kind
    w.count[w.depth] = 0
    w.depth++
    w.put(c)
}

fn (w &Writer) quoted(s &[]byte) {
    k := escape_len(s)
    w.reserve(k + 2)
    w.buf[w.n] = '"'
    w.n++
    w.n += escape(&w.buf[w.n:w.n + k], s)
    w.buf[w.n] = '"'
    w.n++
}

fn (w &Writer) literal(s string) {
    w.reserve(len(s))
    w.n += str.copy(&w.buf[w.n:], s)
}

fn (w &Writer) put(c byte) {
    w.reserve(1)
    w.buf[w.n] = c
    w.n++
}

// reserve garante k bytes livres, crescendo o buffer (realloc).
fn (w &Writer) reserve(k int) {
    if w.n + k <= len(w.buf) {
        return
    }
    size := len(w.buf) * 2
    if size < w.n + k {
        size = w.n + k
    }
    w.buf = realloc(w.buf, size)
}

extern fn fail(msg string)
