import "std/process"
import "std/testing"

fn test_capture_output() {
    c := process.cmd("echo")
    c.arg("née")
    c.arg("world")
    var out [64]byte
    status := -1
    match c.run(&out, &status) {
        Ok(n) => testing.eq_str(&out[:n], "née world\n")
        Err(code) => testing.eq_int(code, 0)
    }
    testing.eq_int(status, 0)
}

fn test_exit_status() {
    c := process.cmd("sh")
    c.arg("-c")
    c.arg("exit 7")
    status := 0
    match c.run_inherit(&status) {
        Ok(_) => testing.eq_int(status, 7)
        Err(code) => testing.eq_int(code, 0)
    }
}

fn test_arguments_are_not_shell() {
    c := process.cmd("echo")
    c.arg("$HOME *") // no shell: arrives as is
    var out [32]byte
    status := 0
    match c.run(&out, &status) {
        Ok(n) => testing.eq_str(&out[:n], "$HOME *\n")
        Err(code) => testing.eq_int(code, 0)
    }
}

fn test_arg_bytes() {
    var b [8]byte
    b[0] = 'x'
    b[1] = 'y'
    c := process.cmd("echo")
    c.arg_bytes(&b[:2])
    var out [8]byte
    status := 0
    match c.run(&out, &status) {
        Ok(n) => testing.eq_str(&out[:n], "xy\n")
        Err(code) => testing.eq_int(code, 0)
    }
}

fn test_not_found() {
    c := process.cmd("program-that-does-not-exist-mlc")
    status := 0
    match c.run_inherit(&status) {
        Ok(_) => testing.fail("the program doesn't exist")
        Err(code) => testing.eq_int(code, process.NOT_FOUND)
    }
}

fn test_output_too_big() {
    c := process.cmd("echo")
    c.arg("a text larger than the buffer")
    var out [4]byte
    status := 0
    match c.run(&out, &status) {
        Ok(_) => testing.fail("the output doesn't fit")
        Err(code) => testing.eq_int(code, process.TOO_BIG)
    }
    testing.eq_int(status, 0) // the program ran to the end
}
