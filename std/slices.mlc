// Operations on slices (and arrays, via &a), without allocating. They use
// cmp.Eq's equality and cmp.Ord's order, so they work for numbers, string,
// slices ([]byte) and structs with impl cmp.Eq / cmp.Ord (or impl auto).
// Elements are compared by borrow, without copies, and can be owners.
//
//     if slices.contains(&names, &wanted) { ... }
//     i := slices.binary_search(&sorted, &x)       // in a sorted slice
//     m := slices.max_index(&scores)
import "std/cmp"
import "std/sort"

// index returns the position of the first element equal to x, or -1.
pub fn index[T owned + cmp.Eq](s &[]T, x &T) int {
    for i := 0; i < len(s); i++ {
        if s[i].eq(x) {
            return i
        }
    }
    return -1
}

// contains says whether some element is equal to x.
pub fn contains[T owned + cmp.Eq](s &[]T, x &T) bool {
    return index(s, x) >= 0
}

// count says how many elements are equal to x.
pub fn count[T owned + cmp.Eq](s &[]T, x &T) int {
    n := 0
    for i := 0; i < len(s); i++ {
        if s[i].eq(x) {
            n++
        }
    }
    return n
}

// equal says whether a and b have the same length and the same elements, in
// the same order.
pub fn equal[T owned + cmp.Eq](a &[]T, b &[]T) bool {
    if len(a) != len(b) {
        return false
    }
    for i := 0; i < len(a); i++ {
        if !a[i].eq(&b[i]) {
            return false
        }
    }
    return true
}

// search returns the first position of a sorted slice whose element isn't
// less than x: where x is, or where it would go (len(s) if it's larger than
// all).
pub fn search[T owned + cmp.Ord](s &[]T, x &T) int {
    lo := 0
    hi := len(s)
    for lo < hi {
        mid := lo + (hi - lo) / 2
        if s[mid].cmp(x) < 0 {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo
}

// binary_search returns the position of x in a sorted slice, or -1.
pub fn binary_search[T owned + cmp.Ord](s &[]T, x &T) int {
    i := search(s, x)
    if i < len(s) && s[i].cmp(x) == 0 {
        return i
    }
    return -1
}

// min_index returns the position of the smallest element (the first one, on
// a tie), or -1 in an empty slice.
pub fn min_index[T owned + cmp.Ord](s &[]T) int {
    if len(s) == 0 {
        return -1
    }
    m := 0
    for i := 1; i < len(s); i++ {
        if s[i].cmp(&s[m]) < 0 {
            m = i
        }
    }
    return m
}

// max_index returns the position of the largest element (the first one, on
// a tie), or -1 in an empty slice.
pub fn max_index[T owned + cmp.Ord](s &[]T) int {
    if len(s) == 0 {
        return -1
    }
    m := 0
    for i := 1; i < len(s); i++ {
        if s[i].cmp(&s[m]) > 0 {
            m = i
        }
    }
    return m
}

// dedup gathers at the start of a sorted slice one element of each value and
// returns how many there are: the unique ones are in s[:n] and the repeats after.
// Nothing is freed (the elements only swap places), so, with owners, the
// whole slice still needs to be freed as before.
pub fn dedup[T owned + cmp.Eq](s &[]T) int {
    if len(s) == 0 {
        return 0
    }
    w := 1
    for i := 1; i < len(s); i++ {
        if !s[i].eq(&s[w - 1]) {
            sort.swap(s, w, i)
            w++
        }
    }
    return w
}

// index_by returns the position of the first element for which pred returns
// true, or -1. pred also receives the context ctx (what to look for, a limit).
pub fn index_by[T owned, C ref](s &[]T, ctx &C, pred fn(&C, &T) bool) int {
    for i := 0; i < len(s); i++ {
        if pred(ctx, &s[i]) {
            return i
        }
    }
    return -1
}

// count_by says for how many elements pred returns true.
pub fn count_by[T owned, C ref](s &[]T, ctx &C, pred fn(&C, &T) bool) int {
    n := 0
    for i := 0; i < len(s); i++ {
        if pred(ctx, &s[i]) {
            n++
        }
    }
    return n
}

// fill puts x in every position (only for copyable T).
pub fn fill[T any](s &[]T, x T) {
    for i := 0; i < len(s); i++ {
        s[i] = x
    }
}
