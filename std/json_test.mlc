import "std/io"
import "std/json"
import "std/math"
import "std/str"
import "std/testing"
import "std/utf8"

fn doc(dst &[]byte, s string) int {
    return str.copy(dst, s)
}

// tokens writes the document's tokens, one per line, into a buffer.
fn tokens(s &[]byte, out &[]byte) int {
    r := json.reader()
    n := 0
    for {
        t := r.next(s)
        n += str.format(&out[n:], "{} ", t)
        match t {
            End => return n
            Error(_) => return n
            _ => {}
        }
    }
}

fn test_tokens() {
    var d [128]byte
    k := doc(&d, "{\"a\": [1, -2.5e3, true, null], \"b\": {\"c\": \"x\"}, \"d\": false}")
    var out [512]byte
    n := tokens(&d[:k], &out)
    testing.eq_str(&out[:n], "ObjectStart Key(2, 3) ArrayStart Number(7, 8) Number(10, 16) True Null ArrayEnd Key(32, 33) ObjectStart Key(38, 39) String(43, 44) ObjectEnd Key(49, 50) False ObjectEnd End ")
}

fn test_scalars_at_top_level() {
    var d [32]byte
    var out [128]byte
    k := doc(&d, "  42  ")
    n := tokens(&d[:k], &out)
    testing.eq_str(&out[:n], "Number(2, 4) End ")
    k = doc(&d, "\"hi\"")
    n = tokens(&d[:k], &out)
    testing.eq_str(&out[:n], "String(1, 3) End ")
    k = doc(&d, "[]")
    n = tokens(&d[:k], &out)
    testing.eq_str(&out[:n], "ArrayStart ArrayEnd End ")
    k = doc(&d, "{}")
    n = tokens(&d[:k], &out)
    testing.eq_str(&out[:n], "ObjectStart ObjectEnd End ")
}

fn is_error(s string) bool {
    var d [64]byte
    k := doc(&d, s)
    r := json.reader()
    for {
        match r.next(&d[:k]) {
            End => return false
            Error(_) => return true
            _ => {}
        }
    }
}

fn test_invalid_documents() {
    testing.check(is_error(""), "empty")
    testing.check(is_error("{"), "unclosed object")
    testing.check(is_error("[1,]"), "extra comma")
    testing.check(is_error("[1 2]"), "missing comma")
    testing.check(is_error("{\"a\" 1}"), "missing colon")
    testing.check(is_error("{1: 2}"), "key that isn't a string")
    testing.check(is_error("[1}"), "mismatched closing")
    testing.check(is_error("01"), "leading zero")
    testing.check(is_error("1."), "point without decimals")
    testing.check(is_error("-"), "just the sign")
    testing.check(is_error("tru"), "truncated literal")
    testing.check(is_error("\"a\\x\""), "unknown escape")
    testing.check(is_error("\"a\\u12g4\""), "\\u with an invalid letter")
    testing.check(is_error("\"no end"), "unterminated string")
    testing.check(is_error("1 2"), "two values at the top")
    testing.check(!is_error("[1, {\"a\": [true]}]"), "valid")
}

fn test_error_position() {
    var d [16]byte
    k := doc(&d, "[1, x]")
    r := json.reader()
    r.next(&d[:k])
    r.next(&d[:k])
    match r.next(&d[:k]) {
        Error(at) => testing.eq_int(at, 4)
        _ => testing.fail("expected an error")
    }
}

fn test_depth_limit() {
    var d [80]byte
    for i := 0; i < 65; i++ {
        d[i] = '['
    }
    testing.check(is_error_bytes(&d[:65]), "65 levels go past the limit")
}

fn is_error_bytes(s &[]byte) bool {
    r := json.reader()
    for {
        match r.next(s) {
            End => return false
            Error(_) => return true
            _ => {}
        }
    }
}

fn test_skip_unwanted_values() {
    var d [128]byte
    k := doc(&d, "{\"skip\": {\"x\": [1, 2, {\"y\": 3}]}, \"id\": 7, \"also\": [4]}")
    s := &d[:k]
    r := json.reader()
    id := 0
    keys := 0
    r.next(s) // ObjectStart
    for {
        match r.next(s) {
            Key(a, b) => {
                keys++
                if str.eq(&s[a:b], "id") {
                    match r.next(s) {
                        Number(x, y) => str.parse_int(&s[x:y], &id)
                        _ => testing.fail("id should be a number")
                    }
                } else {
                    testing.check(r.skip(s), "skip of a valid value")
                }
            }
            ObjectEnd => break
            _ => {
                testing.fail("unexpected token")
                break
            }
        }
    }
    testing.eq_int(id, 7)
    testing.eq_int(keys, 3)
}

fn test_unescape() {
    var d [64]byte
    k := doc(&d, "a\\n\\\"b\\\\c\\u00e9\\ud83d\\ude00\\/")
    var out [64]byte
    n := json.unescape(&out, &d[:k])
    testing.eq_str(&out[:n], "a\n\"b\\cé😀/")
    k = doc(&d, "\\ud800x") // lone surrogate
    n = json.unescape(&out, &d[:k])
    testing.eq_int(n, 4) // U+FFFD (3 bytes) and x
    testing.eq_int(utf8.decode(&out[:n], 0).code, utf8.INVALID)
    testing.eq_int(int(out[3]), int('x'))
}

fn test_escape_round_trip() {
    var s [32]byte
    k := doc(&s, "says \"hi\"\n\ttab\\")
    var e [64]byte
    n := json.escape(&e, &s[:k])
    testing.eq_int(n, json.escape_len(&s[:k]))
    testing.eq_str(&e[:n], "says \\\"hi\\\"\\n\\ttab\\\\")
    var back [32]byte
    m := json.unescape(&back, &e[:n])
    testing.eq_bytes(&back[:m], &s[:k])
    s[0] = 1 // a control character becomes \u0001
    n = json.escape(&e, &s[:1])
    testing.eq_str(&e[:n], "\\u0001")
}

fn test_build_document_with_format() {
    var name [16]byte
    k := doc(&name, "Ann \"A\"")
    var esc [32]byte
    n := json.escape(&esc, &name[:k])
    var out [64]byte
    m := str.format(&out, "{{\"name\": \"{:s}\", \"age\": {}}}", &esc[:n], 30)
    testing.eq_str(&out[:m], "{\"name\": \"Ann \\\"A\\\"\", \"age\": 30}")
    testing.check(!is_error_bytes(&out[:m]), "the assembled document is valid")
    io.print("") // uses io (the tokens' Display)
}

// ---------- writing ----------

fn test_writer_document() {
    w := json.writer(16) // small on purpose: it grows
    w.object()
    w.field_int("id", 7)
    w.field_str("name", "café \"strong\"\n")
    w.key("tags")
    w.array()
    w.str("hot")
    w.int(-3)
    w.float(2.5)
    w.bool(false)
    w.null()
    w.object()
    w.end()
    w.array()
    w.end()
    w.end()
    w.field_bool("active", true)
    w.field_null("owner")
    w.field_float("nan", math.sqrt(-1.0))
    var raw [16]byte
    k := str.copy(&raw, "{\"x\":1}")
    w.key("raw")
    w.raw(&raw[:k])
    w.end()
    testing.check(w.done(), "complete document")
    testing.eq_str(&w.buf[:w.n], "{\"id\":7,\"name\":\"café \\\"strong\\\"\\n\",\"tags\":[\"hot\",-3,2.5,false,null,{},[]],\"active\":true,\"owner\":null,\"nan\":null,\"raw\":{\"x\":1}}")
    // what the Writer writes, the Reader reads
    var out [1024]byte
    n := tokens(&w.buf[:w.n], &out)
    testing.check(n > 4 && str.eq(&out[n - 4:n], "End "), "read back without errors")
    w.reset()
    w.array()
    w.end()
    testing.eq_str(&w.buf[:w.n], "[]")
    w.free()
}

fn test_writer_value_without_key() {
    testing.expect_panic()
    w := json.writer(64)
    w.object()
    w.int(1) // the key is missing
    w.free()
}

fn test_writer_key_in_array() {
    testing.expect_panic()
    w := json.writer(64)
    w.array()
    w.key("x")
    w.free()
}

fn test_writer_two_roots() {
    testing.expect_panic()
    w := json.writer(64)
    w.int(1)
    w.int(2)
    w.free()
}

fn test_writer_unbalanced_end() {
    testing.expect_panic()
    w := json.writer(64)
    w.end()
    w.free()
}
