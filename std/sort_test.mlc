import "std/cmp"
import "std/map"
import "std/rand"
import "std/sort"
import "std/str"
import "std/testing"

fn test_sort_small() {
    a := [5]int{5, 1, 4, 2, 3}
    sort.sort(&a)
    testing.check(a == [5]int{1, 2, 3, 4, 5}, "ordenado")
    testing.check(sort.is_sorted(&a), "is_sorted")
}

fn test_sort_large_random() {
    r := rand.new(7)
    s := alloc([]int, 1000)
    for i := 0; i < len(s); i++ {
        s[i] = r.range(-50, 50) // with repeats
    }
    sort.sort(&s)
    testing.check(sort.is_sorted(&s), "1000 números ordenados")
    free(s)
}

fn test_sort_already_sorted() {
    s := alloc([]int, 500)
    for i := 0; i < len(s); i++ {
        s[i] = len(s) - i
    }
    sort.sort(&s)
    testing.eq_int(s[0], 1)
    testing.eq_int(s[499], 500)
    sort.sort(&s)
    testing.check(sort.is_sorted(&s), "ordenar de novo")
    free(s)
}

fn test_sort_floats() {
    f := [3]float64{2.5, -1.0, 0.5}
    sort.sort(&f)
    testing.check(f == [3]float64{-1.0, 0.5, 2.5}, "floats")
}

fn test_is_sorted() {
    a := [4]int{1, 2, 2, 3}
    testing.check(sort.is_sorted(&a), "com repetidos")
    b := [3]int{1, 3, 2}
    testing.check(!sort.is_sorted(&b), "fora de ordem")
    testing.check(sort.is_sorted(&b[:0]), "vazio")
}

fn test_swap_reverse() {
    a := [4]int{1, 2, 3, 4}
    sort.swap(&a, 0, 3)
    testing.check(a == [4]int{4, 2, 3, 1}, "swap")
    sort.reverse(&a)
    testing.check(a == [4]int{1, 3, 2, 4}, "reverse")
}

struct Person {
    name string
    age int
}

fn by_age(a &Person, b &Person) bool {
    return a.age < b.age
}

fn test_sort_by() {
    p := alloc([]Person, 20)
    for i := 0; i < len(p); i++ {
        p[i] = Person{name: "x", age: (i * 7) % 20}
    }
    sort.sort_by(&p, by_age)
    testing.check(sort.is_sorted_by(&p, by_age), "por idade")
    testing.eq_int(p[0].age, 0)
    testing.eq_int(p[19].age, 19)
    free(p)
}

fn bench_sort_1000(b &testing.B) {
    r := rand.new(1)
    s := alloc([]int, 1000)
    for i := 0; i < b.n; i++ {
        for j := 0; j < len(s); j++ {
            s[j] = r.range(0, 1_000_000)
        }
        sort.sort(&s)
    }
    free(s)
}

struct Item {
    price int
    name string
}

impl auto cmp.Ord for Item

fn test_sort_structs() {
    items := [4]Item{Item{price: 30, name: "c"}, Item{price: 10, name: "b"}, Item{price: 10, name: "a"}, Item{price: 20, name: "d"}}
    sort.sort(&items)
    testing.check(sort.is_sorted(&items), "ordenado")
    testing.eq_int(items[0].price, 10)
    testing.check(items[0].name == "a" && items[1].name == "b", "empate no preço: o nome decide")
    testing.eq_int(items[3].price, 30)
}

fn test_sort_strings() {
    w := [4]string{"pera", "abacaxi", "maçã", "banana"}
    sort.sort(&w)
    testing.check(w == [4]string{"abacaxi", "banana", "maçã", "pera"}, "strings")
}

fn line(s string) []byte {
    b := alloc([]byte, len(s))
    str.copy(&b, s)
    return b
}

fn test_sort_owned_lines() {
    lines := alloc([][]byte, 40)
    for i := 0; i < len(lines); i++ {
        k := (i * 17) % 40
        b := alloc([]byte, 2)
        b[0] = byte(int('a') + k / 10)
        b[1] = byte(int('0') + k % 10)
        old := replace(&lines[i], b)
        free(old)
    }
    sort.sort(&lines) // owners swapped by ownership (more than 16: uses quicksort)
    testing.check(sort.is_sorted(&lines), "linhas ordenadas")
    testing.eq_str(&lines[0], "a0")
    testing.eq_str(&lines[39], "d9")
    sort.reverse(&lines)
    testing.eq_str(&lines[0], "d9")
    for l in drain(lines) {
        free(l)
    }
    free(lines)
}

fn test_sort_floats_with_negative() {
    f := [5]float64{0.5, -3.0, 2.25, -0.5, 1.0}
    sort.sort(&f)
    testing.check(f == [5]float64{-3.0, -0.5, 0.5, 1.0, 2.25}, "floats")
}

fn by_priority(prio &map.Map[int, int], a &int, b &int) bool {
    return prio.get_or(a, 0) > prio.get_or(b, 0) // highest priority first
}

fn test_sort_by_with_context() {
    prio := map.new[int, int](32)
    ids := alloc([]int, 40)
    for i := 0; i < len(ids); i++ {
        ids[i] = i
        prio.put(i, (i * 7) % 40)
    }
    sort.sort_by_with(&ids, &prio, by_priority) // more than 16: uses quicksort
    for i := 1; i < len(ids); i++ {
        testing.check(prio.get_or(&ids[i - 1], 0) >= prio.get_or(&ids[i], 0), "em ordem de prioridade")
    }
    testing.eq_int(prio.get_or(&ids[0], 0), 39)
    free(ids)
    prio.free()
}
