import "std/rand"
import "std/sort"
import "std/testing"

fn test_sort_small() {
    a := [5]int{5, 1, 4, 2, 3}
    sort.sort(&a)
    testing.check(a == [5]int{1, 2, 3, 4, 5}, "ordenado")
    testing.check(sort.is_sorted(&a), "is_sorted")
}

fn test_sort_large_random() {
    r := rand.new(7)
    s := alloc([]int, 1000)
    for i := 0; i < len(s); i++ {
        s[i] = r.range(-50, 50) // com repetidos
    }
    sort.sort(&s)
    testing.check(sort.is_sorted(&s), "1000 números ordenados")
    free(s)
}

fn test_sort_already_sorted() {
    s := alloc([]int, 500)
    for i := 0; i < len(s); i++ {
        s[i] = len(s) - i
    }
    sort.sort(&s)
    testing.eq_int(s[0], 1)
    testing.eq_int(s[499], 500)
    sort.sort(&s)
    testing.check(sort.is_sorted(&s), "ordenar de novo")
    free(s)
}

fn test_sort_floats() {
    f := [3]float64{2.5, -1.0, 0.5}
    sort.sort(&f)
    testing.check(f == [3]float64{-1.0, 0.5, 2.5}, "floats")
}

fn test_is_sorted() {
    a := [4]int{1, 2, 2, 3}
    testing.check(sort.is_sorted(&a), "com repetidos")
    b := [3]int{1, 3, 2}
    testing.check(!sort.is_sorted(&b), "fora de ordem")
    testing.check(sort.is_sorted(&b[:0]), "vazio")
}

fn test_swap_reverse() {
    a := [4]int{1, 2, 3, 4}
    sort.swap(&a, 0, 3)
    testing.check(a == [4]int{4, 2, 3, 1}, "swap")
    sort.reverse(&a)
    testing.check(a == [4]int{1, 3, 2, 4}, "reverse")
}

struct Person {
    name string
    age int
}

fn by_age(a &Person, b &Person) bool {
    return a.age < b.age
}

fn test_sort_by() {
    p := alloc([]Person, 20)
    for i := 0; i < len(p); i++ {
        p[i] = Person{name: "x", age: (i * 7) % 20}
    }
    sort.sort_by(&p, by_age)
    testing.check(sort.is_sorted_by(&p, by_age), "por idade")
    testing.eq_int(p[0].age, 0)
    testing.eq_int(p[19].age, 19)
    free(p)
}
