// Text functions over bytes. None allocates: they search, compare or change
// in place.

// is_space says whether b is a space, tab, \n or \r.
pub fn is_space(b byte) bool {
    return b == ' ' || b == '\t' || b == '\n' || b == '\r'
}

// is_digit says whether b is a digit from 0 to 9.
pub fn is_digit(b byte) bool {
    return b >= '0' && b <= '9'
}

// is_letter says whether b is an ASCII letter (a-z or A-Z).
pub fn is_letter(b byte) bool {
    return (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')
}

// index_byte returns the position of the first b in s, or -1.
pub fn index_byte(s &[]byte, b byte) int {
    for i := 0; i < len(s); i++ {
        if s[i] == b {
            return i
        }
    }
    return -1
}

// index_of returns the position of the first occurrence of sub in s, or -1.
pub fn index_of(s &[]byte, sub string) int {
    for i := 0; i + len(sub) <= len(s); i++ {
        if matches(s, i, sub) {
            return i
        }
    }
    return -1
}

// contains says whether sub appears in s.
pub fn contains(s &[]byte, sub string) bool {
    return index_of(s, sub) >= 0
}

// starts_with says whether s starts with prefix.
pub fn starts_with(s &[]byte, prefix string) bool {
    return len(prefix) <= len(s) && matches(s, 0, prefix)
}

// ends_with says whether s ends with suffix.
pub fn ends_with(s &[]byte, suffix string) bool {
    return len(suffix) <= len(s) && matches(s, len(s) - len(suffix), suffix)
}

fn matches(s &[]byte, at int, sub string) bool {
    for j := 0; j < len(sub); j++ {
        if s[at + j] != sub[j] {
            return false
        }
    }
    return true
}

// count_byte counts how many times b appears in s.
pub fn count_byte(s &[]byte, b byte) int {
    n := 0
    for c in s {
        if c == b {
            n++
        }
    }
    return n
}

// trim_start returns the position of the first byte that isn't a space.
pub fn trim_start(s &[]byte) int {
    i := 0
    for i < len(s) && is_space(s[i]) {
        i++
    }
    return i
}

// trim_end returns the (exclusive) end of the text without the trailing spaces:
// &s[trim_start(s):trim_end(s)] is the trimmed text.
pub fn trim_end(s &[]byte) int {
    j := len(s)
    for j > 0 && is_space(s[j - 1]) {
        j--
    }
    return j
}

// field_end returns where the field that starts at start ends, separated by
// sep: the index of the next sep, or len(s). To walk the fields:
//
//     i := 0
//     for i <= len(line) {
//         end := text.field_end(&line, ',', i)
//         ... field in &line[i:end] ...
//         i = end + 1
//     }
pub fn field_end(s &[]byte, sep byte, start int) int {
    for i := start; i < len(s); i++ {
        if s[i] == sep {
            return i
        }
    }
    return len(s)
}

// to_upper turns the ASCII letters of s into uppercase, in place.
pub fn to_upper(s &[]byte) {
    for i := 0; i < len(s); i++ {
        if s[i] >= 'a' && s[i] <= 'z' {
            s[i] -= 32
        }
    }
}

// to_lower turns the ASCII letters of s into lowercase, in place.
pub fn to_lower(s &[]byte) {
    for i := 0; i < len(s); i++ {
        if s[i] >= 'A' && s[i] <= 'Z' {
            s[i] += 32
        }
    }
}

// Span is a piece of a text: &s[span.start:span.end].
pub struct Span {
    start int
    end int
}

// split_next returns the next field of s separated by sep, starting at
// *pos, and advances *pos past the separator. Empty fields count
// ("a,,b" has three). When *pos goes past len(s), it's over:
//
//     pos := 0
//     for pos <= len(line) {
//         f := text.split_next(&line, ',', &pos)
//         ... &line[f.start:f.end] ...
//     }
pub fn split_next(s &[]byte, sep byte, pos &int) Span {
    start := *pos
    end := field_end(s, sep, start)
    *pos = end + 1
    return Span{start: start, end: end}
}

// word_next returns the next word (separated by spaces, tabs or line
// breaks) starting at *pos, and advances *pos. With no more words, returns an
// empty Span with start == len(s):
//
//     pos := 0
//     for {
//         w := text.word_next(&line, &pos)
//         if w.start == w.end { break }
//         ... &line[w.start:w.end] ...
//     }
pub fn word_next(s &[]byte, pos &int) Span {
    i := *pos
    for i < len(s) && is_space(s[i]) {
        i++
    }
    j := i
    for j < len(s) && !is_space(s[j]) {
        j++
    }
    *pos = j
    return Span{start: i, end: j}
}
