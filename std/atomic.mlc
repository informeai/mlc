// Atomic integers and bools, for counters and flags between threads without
// a mutex.
//
//     n := atomic.new_int(0)
//     t := thread.spawn(count, n.clone(), thread.STACK_64KB)   // another handle, for the thread
//     n.add(1)
//     thread.join(t)
//     io.print(n.load())
//     n.close()
//
// new_int and new_bool allocate the value; each handle (the clones too)
// needs a close(), and the last close frees it. Every operation is
// sequentially consistent. add panics on overflow, like MLC's
// arithmetic.

// Int is an atomic integer, shared between threads through the handles.
pub extern "C" type Int

// Bool is an atomic bool, shared between threads through the handles.
pub extern "C" type Bool

// new_int allocates an atomic integer with the value v.
pub extern fn new_int(v int) *Int

// new_bool allocates an atomic bool with the value v.
pub extern fn new_bool(v bool) *Bool

extern fn clone_int(a &Int) *Int
extern fn close_int(a *Int)
extern fn load_int(a &Int) int
extern fn store_int(a &Int, v int)
extern fn add_int(a &Int, n int) int
extern fn swap_int(a &Int, v int) int
extern fn cas_int(a &Int, expected int, v int) bool

extern fn clone_bool(a &Bool) *Bool
extern fn close_bool(a *Bool)
extern fn load_bool(a &Bool) bool
extern fn store_bool(a &Bool, v bool)
extern fn swap_bool(a &Bool, v bool) bool
extern fn cas_bool(a &Bool, expected bool, v bool) bool

// clone returns another handle to the same value (for another thread).
pub fn (a &Int) clone() *Int {
    return clone_int(a)
}

// close closes the handle; the last one frees the value.
pub fn (a *Int) close() {
    close_int(a)
}

// load reads the value.
pub fn (a &Int) load() int {
    return load_int(a)
}

// store replaces the value with v.
pub fn (a &Int) store(v int) {
    store_int(a, v)
}

// add adds n and returns the new value.
pub fn (a &Int) add(n int) int {
    return add_int(a, n)
}

// swap replaces it with the value v and returns the old one.
pub fn (a &Int) swap(v int) int {
    return swap_int(a, v)
}

// compare_swap replaces it with v only if the value is expected, and says whether it did.
pub fn (a &Int) compare_swap(expected int, v int) bool {
    return cas_int(a, expected, v)
}

// clone creates another handle to the same value (for another thread).
pub fn (a &Bool) clone() *Bool {
    return clone_bool(a)
}

// close closes the handle; the last one frees the value.
pub fn (a *Bool) close() {
    close_bool(a)
}

// load reads the value.
pub fn (a &Bool) load() bool {
    return load_bool(a)
}

// store replaces the value with v.
pub fn (a &Bool) store(v bool) {
    store_bool(a, v)
}

// swap replaces the value with v and returns the old one.
pub fn (a &Bool) swap(v bool) bool {
    return swap_bool(a, v)
}

// compare_swap replaces the value with v only if it is expected, and says whether it did.
pub fn (a &Bool) compare_swap(expected bool, v bool) bool {
    return cas_bool(a, expected, v)
}
