// Arena: memória de rascunho para uma tarefa (um pedido HTTP, um arquivo,
// um lote). Um alloc no começo; os pedaços saem dela em sequência, sem um
// alloc cada; reset devolve tudo de uma vez para a próxima tarefa; free no
// fim. O custo de alocação fica constante, e esquecer de liberar um pedaço
// não existe: o reset leva todos.
//
//     a := arena.new(64 * 1024)                 // o único alloc
//     for ... cada pedido ... {
//         nome := a.copy(&campo)                // pedaços da arena
//         var tmp [64]byte
//         k := str.format(&tmp, "{}-{}", id, 7)
//         chave := a.copy(&tmp[:k])
//         ...
//         a.reset()                             // tudo de volta; o buffer fica
//     }
//     a.free()
//
// Um pedaço é uma Span: a posição, o tamanho e a geração da arena quando
// ele foi feito. Não é um empréstimo, então a arena pode crescer (realloc)
// sem invalidar nada. Cada reset muda a geração: usar uma Span de antes do
// reset dá panic (é o uso depois de liberar, pego na execução, em vez de
// ler os dados de outra tarefa).
//
// Para ler ou escrever direto, confira a Span e use o buffer:
//
//     a.check(s)
//     io.printf("{:s}\n", &a.buf[s.at:s.at + s.n])
//
// A arena cresce dobrando (realloc, à vista em grow) quando falta espaço;
// com limit > 0, passar do limite dá panic em vez de crescer.

// Arena é a memória de rascunho.
pub struct Arena {
    buf []byte
    used int
    peak int  // o máximo de used desde o new (para dimensionar)
    gen int   // muda a cada reset
    limit int // 0: cresce à vontade; > 0: o tamanho máximo do buffer
}

// Span é um pedaço da arena.
pub struct Span {
    at int
    n int
    gen int
}

// new aloca uma arena com cap bytes (ela cresce se precisar).
pub fn new(cap int) *Arena {
    if cap < 1 {
        cap = 1
    }
    return alloc(Arena{buf: alloc([]byte, cap), used: 0, peak: 0, gen: 1, limit: 0})
}

// new_fixed aloca uma arena de cap bytes que nunca cresce: passar disso dá
// panic (para quem quer um teto rígido de memória).
pub fn new_fixed(cap int) *Arena {
    a := new(cap)
    a.limit = cap
    return a
}

// free libera a arena.
pub fn (a *Arena) free() {
    free(a.buf)
    free(a)
}

// alloc separa n bytes zerados e devolve o pedaço.
pub fn (a &Arena) alloc(n int) Span {
    if n < 0 {
        fail("arena.alloc: tamanho negativo")
    }
    a.reserve(n)
    for i := 0; i < n; i++ {
        a.buf[a.used + i] = 0 // depois de um reset, o buffer tem dados velhos
    }
    return a.commit(n)
}

// copy copia src para a arena e devolve o pedaço.
pub fn (a &Arena) copy(src &[]byte) Span {
    a.reserve(len(src))
    for i := 0; i < len(src); i++ {
        a.buf[a.used + i] = src[i]
    }
    return a.commit(len(src))
}

// copy_str copia um texto fixo do programa para a arena.
pub fn (a &Arena) copy_str(s string) Span {
    a.reserve(len(s))
    for i := 0; i < len(s); i++ {
        a.buf[a.used + i] = s[i]
    }
    return a.commit(len(s))
}

// reserve garante n bytes livres depois de used, crescendo se preciso.
// Junto com commit, serve para escrever direto na arena:
//
//     a.reserve(64)
//     k := str.format(&a.buf[a.used:a.used + 64], "id={}", id)
//     s := a.commit(k)
pub fn (a &Arena) reserve(n int) {
    for a.used + n > len(a.buf) {
        a.grow(a.used + n)
    }
}

// commit transforma os n bytes depois de used (já escritos) num pedaço.
pub fn (a &Arena) commit(n int) Span {
    if n < 0 || a.used + n > len(a.buf) {
        fail("arena.commit: o pedaço passa do que foi reservado")
    }
    s := Span{at: a.used, n: n, gen: a.gen}
    a.used += n
    if a.used > a.peak {
        a.peak = a.used
    }
    return s
}

// grow dobra o buffer até caber need bytes (realloc).
pub fn (a &Arena) grow(need int) {
    size := len(a.buf) * 2
    if size < need {
        size = need
    }
    if a.limit > 0 && size > a.limit {
        if need > a.limit {
            fail("arena: passou do limite de new_fixed")
        }
        size = a.limit
    }
    a.buf = realloc(a.buf, size)
}

// reset devolve tudo: os pedaços de antes deixam de valer (usar um dá
// panic), e o buffer fica para a próxima tarefa.
pub fn (a &Arena) reset() {
    a.used = 0
    a.gen++
}

// check dá panic se o pedaço é de antes de um reset (ou de outra arena,
// maior que ela). Use antes de ler o buffer direto.
pub fn (a &Arena) check(s Span) {
    if s.gen != a.gen {
        fail("arena: pedaço usado depois de um reset (ele não vale mais)")
    }
    if s.at < 0 || s.n < 0 || s.at + s.n > a.used {
        fail("arena: pedaço fora da arena")
    }
}

// len devolve o tamanho do pedaço.
pub fn (a &Arena) len(s Span) int {
    a.check(s)
    return s.n
}

// text copia o pedaço para dst e devolve o tamanho.
pub fn (a &Arena) text(s Span, dst &[]byte) int {
    a.check(s)
    if s.n > len(dst) {
        fail("arena.text: o destino é pequeno demais")
    }
    for i := 0; i < s.n; i++ {
        dst[i] = a.buf[s.at + i]
    }
    return s.n
}

// eq diz se o pedaço é igual ao texto s.
pub fn (a &Arena) eq(sp Span, s string) bool {
    a.check(sp)
    if sp.n != len(s) {
        return false
    }
    for i := 0; i < sp.n; i++ {
        if a.buf[sp.at + i] != s[i] {
            return false
        }
    }
    return true
}

// get lê o byte i do pedaço.
pub fn (a &Arena) get(s Span, i int) byte {
    a.check(s)
    if i < 0 || i >= s.n {
        fail("arena.get: índice fora do pedaço")
    }
    return a.buf[s.at + i]
}

// set escreve o byte i do pedaço.
pub fn (a &Arena) set(s Span, i int, b byte) {
    a.check(s)
    if i < 0 || i >= s.n {
        fail("arena.set: índice fora do pedaço")
    }
    a.buf[s.at + i] = b
}

// in_use devolve quantos bytes estão em uso desde o último reset.
pub fn (a &Arena) in_use() int {
    return a.used
}

// capacity devolve o tamanho do buffer.
pub fn (a &Arena) capacity() int {
    return len(a.buf)
}

// high_water devolve o máximo em uso desde o new: o tamanho certo para o
// new de uma próxima vez (e não crescer).
pub fn (a &Arena) high_water() int {
    return a.peak
}

extern fn fail(msg string)
