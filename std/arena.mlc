// Arena: scratch memory for a task (an HTTP request, a file,
// a batch). One alloc at the start; the pieces come out of it in sequence, without an
// alloc each; reset gives everything back at once for the next task; free at the
// end. The cost of allocation stays constant, and forgetting to free a piece
// doesn't exist: reset takes them all.
//
//     a := arena.new(64 * 1024)                 // the only alloc
//     for ... each request ... {
//         name := a.copy(&field)                // pieces of the arena
//         var tmp [64]byte
//         k := str.format(&tmp, "{}-{}", id, 7)
//         key := a.copy(&tmp[:k])
//         ...
//         a.reset()                             // everything back; the buffer stays
//     }
//     a.free()
//
// A piece is a Span: the position, the size and the arena's generation when
// it was made. It isn't a borrow, so the arena can grow (realloc)
// without invalidating anything. Each reset changes the generation: using a Span from before the
// reset panics (it's a use after free, caught at run time, instead of
// reading another task's data).
//
// To read or write directly, check the Span and use the buffer:
//
//     a.check(s)
//     io.printf("{:s}\n", &a.buf[s.at:s.at + s.n])
//
// The arena grows by doubling (realloc, visible in grow) when room runs out;
// with limit > 0, going past the limit panics instead of growing.

// Arena is the scratch memory.
pub struct Arena {
    buf []byte
    used int
    peak int  // the most used since new (for sizing)
    gen int   // changes on each reset
    limit int // 0: grows freely; > 0: the buffer's maximum size
}

// Span is a piece of the arena.
pub struct Span {
    at int
    n int
    gen int
}

// new allocates an arena with cap bytes (it grows if needed).
pub fn new(cap int) *Arena {
    if cap < 1 {
        cap = 1
    }
    return alloc(Arena{buf: alloc([]byte, cap), used: 0, peak: 0, gen: 1, limit: 0})
}

// new_fixed allocates an arena of cap bytes that never grows: going past it
// panics (for those who want a hard memory ceiling).
pub fn new_fixed(cap int) *Arena {
    a := new(cap)
    a.limit = cap
    return a
}

// free frees the arena.
pub fn (a *Arena) free() {
    free(a.buf)
    free(a)
}

// alloc sets aside n zeroed bytes and returns the piece.
pub fn (a &Arena) alloc(n int) Span {
    if n < 0 {
        fail("arena.alloc: tamanho negativo")
    }
    a.reserve(n)
    for i := 0; i < n; i++ {
        a.buf[a.used + i] = 0 // after a reset, the buffer has old data
    }
    return a.commit(n)
}

// copy copies src into the arena and returns the piece.
pub fn (a &Arena) copy(src &[]byte) Span {
    a.reserve(len(src))
    for i := 0; i < len(src); i++ {
        a.buf[a.used + i] = src[i]
    }
    return a.commit(len(src))
}

// copy_str copies a fixed text from the program into the arena.
pub fn (a &Arena) copy_str(s string) Span {
    a.reserve(len(s))
    for i := 0; i < len(s); i++ {
        a.buf[a.used + i] = s[i]
    }
    return a.commit(len(s))
}

// reserve guarantees n free bytes after used, growing if needed.
// Together with commit, it serves to write directly into the arena:
//
//     a.reserve(64)
//     k := str.format(&a.buf[a.used:a.used + 64], "id={}", id)
//     s := a.commit(k)
pub fn (a &Arena) reserve(n int) {
    for a.used + n > len(a.buf) {
        a.grow(a.used + n)
    }
}

// commit turns the n bytes after used (already written) into a piece.
pub fn (a &Arena) commit(n int) Span {
    if n < 0 || a.used + n > len(a.buf) {
        fail("arena.commit: the piece goes past what was reserved")
    }
    s := Span{at: a.used, n: n, gen: a.gen}
    a.used += n
    if a.used > a.peak {
        a.peak = a.used
    }
    return s
}

// grow doubles the buffer until need bytes fit (realloc).
pub fn (a &Arena) grow(need int) {
    size := len(a.buf) * 2
    if size < need {
        size = need
    }
    if a.limit > 0 && size > a.limit {
        if need > a.limit {
            fail("arena: went past the new_fixed limit")
        }
        size = a.limit
    }
    a.buf = realloc(a.buf, size)
}

// reset gives everything back: the earlier pieces stop being valid (using one
// panics), and the buffer stays for the next task.
pub fn (a &Arena) reset() {
    a.used = 0
    a.gen++
}

// check panics if the piece is from before a reset (or from another arena,
// larger than this one). Use it before reading the buffer directly.
pub fn (a &Arena) check(s Span) {
    if s.gen != a.gen {
        fail("arena: piece used after a reset (it's no longer valid)")
    }
    if s.at < 0 || s.n < 0 || s.at + s.n > a.used {
        fail("arena: piece outside the arena")
    }
}

// len returns the piece's size.
pub fn (a &Arena) len(s Span) int {
    a.check(s)
    return s.n
}

// text copies the piece into dst and returns the size.
pub fn (a &Arena) text(s Span, dst &[]byte) int {
    a.check(s)
    if s.n > len(dst) {
        fail("arena.text: the destination is too small")
    }
    for i := 0; i < s.n; i++ {
        dst[i] = a.buf[s.at + i]
    }
    return s.n
}

// eq says whether the piece is equal to the text s.
pub fn (a &Arena) eq(sp Span, s string) bool {
    a.check(sp)
    if sp.n != len(s) {
        return false
    }
    for i := 0; i < sp.n; i++ {
        if a.buf[sp.at + i] != s[i] {
            return false
        }
    }
    return true
}

// get reads byte i of the piece.
pub fn (a &Arena) get(s Span, i int) byte {
    a.check(s)
    if i < 0 || i >= s.n {
        fail("arena.get: index outside the piece")
    }
    return a.buf[s.at + i]
}

// set writes byte i of the piece.
pub fn (a &Arena) set(s Span, i int, b byte) {
    a.check(s)
    if i < 0 || i >= s.n {
        fail("arena.set: index outside the piece")
    }
    a.buf[s.at + i] = b
}

// in_use returns how many bytes are in use since the last reset.
pub fn (a &Arena) in_use() int {
    return a.used
}

// capacity returns the buffer's size.
pub fn (a &Arena) capacity() int {
    return len(a.buf)
}

// high_water returns the most in use since new: the right size for the
// next new (so it doesn't grow).
pub fn (a &Arena) high_water() int {
    return a.peak
}

extern fn fail(msg string)
