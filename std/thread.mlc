// Operating-system threads, with ownership guaranteeing that two threads
// never touch the same memory.
//
//     fn sum(part []int) int {
//         t := 0
//         for x in part { t += x }
//         free(part)
//         return t
//     }
//
//     t := thread.spawn(sum, half, thread.STACK_64KB)      // half is moved
//     r := thread.join(t)                                  // the result comes back
//
// thread.spawn(f, ctx, stack) and thread.join(t) are built into the compiler:
//
// - f is a function fn(C) or fn(C) R (no closure). It receives the context
//   by ownership and can't receive borrows: everything the thread uses goes
//   in the context (gather several things in a struct).
// - ctx is moved to the thread; after the spawn, the caller no longer has it.
// - stack is the size of the thread's stack, in bytes (at least 16 KB): the
//   stack memory is chosen by whoever creates the thread, like everything else.
// - spawn returns a *thread.Thread[R] (*thread.Thread if f returns
//   nothing). The handle doesn't accept free: the checker requires it to go to
//   thread.join, which waits for the thread, returns the result (ownership
//   comes back) and frees the thread's record.
//
// A panic in any thread ends the whole program.

pub const STACK_16KB = 16384
pub const STACK_64KB = 65536
pub const STACK_256KB = 262144
pub const STACK_1MB = 1048576
pub const STACK_8MB = 8388608

// cpu_count says how many processors the system has available.
pub extern fn cpu_count() int
