import "std/hash"
import "std/map"
import "std/str"
import "std/testing"
import "std/vec"

fn text(s string) []byte {
    b := alloc([]byte, len(s))
    str.copy(&b, s)
    return b
}

fn test_put_get() {
    m := map.new[int, int](4)
    for i := 0; i < 1000; i++ {
        m.put(i, i * 2) // cresce várias vezes
    }
    testing.eq_int(m.len(), 1000)
    k := 777
    testing.check(m.has(&k), "tem 777")
    testing.eq_int(*m.get(&k), 1554)
    testing.eq_int(m.get_or(&k, -1), 1554)
    k = 1000
    testing.check(!m.has(&k), "não tem 1000")
    testing.eq_int(m.get_or(&k, -1), -1)
    testing.eq_int(m.index(&k), -1)
    m.free()
}

fn test_put_replaces() {
    m := map.new[int, int](4)
    m.put(1, 10)
    m.put(1, 20)
    testing.eq_int(m.len(), 1)
    k := 1
    testing.eq_int(m.get_or(&k, 0), 20)
    testing.check(m.set(&k, 30), "set numa chave que existe")
    k = 2
    testing.check(!m.set(&k, 40), "set numa chave nova não insere")
    testing.eq_int(m.len(), 1)
    m.free()
}

fn test_get_missing() {
    testing.expect_panic()
    m := map.new[int, int](4)
    k := 5
    x := m.get(&k)
    testing.eq_int(*x, 0)
    m.free()
}

fn test_remove_and_reinsert() {
    m := map.new[int, int](4)
    for i := 0; i < 100; i++ {
        m.put(i, i)
    }
    for i := 0; i < 100; i += 2 {
        k := i
        testing.check(m.remove(&k), "remove existente")
    }
    k := 0
    testing.check(!m.remove(&k), "remove de novo")
    testing.eq_int(m.len(), 50)
    for i := 0; i < 100; i++ {
        k = i
        testing.eq_bool(m.has(&k), i % 2 == 1)
    }
    m.put(0, 7) // reaproveita uma posição apagada
    testing.eq_int(m.len(), 51)
    k = 0
    testing.eq_int(m.get_or(&k, 0), 7)
    m.free()
}

fn test_iterate() {
    m := map.new[int, int](4)
    for i := 1; i <= 10; i++ {
        m.put(i, i * i)
    }
    keys := 0
    vals := 0
    count := 0
    for i := m.next(0); i >= 0; i = m.next(i + 1) {
        keys += m.key_at(i)
        vals += m.value_at(i)
        count++
    }
    testing.eq_int(count, 10)
    testing.eq_int(keys, 55)
    testing.eq_int(vals, 385)
    m.clear()
    testing.eq_int(m.len(), 0)
    testing.eq_int(m.next(0), -1)
    m.free()
}

fn test_owned_keys_and_values() {
    m := map.new[[]byte, []byte](2)
    m.put(text("um"), text("one"))
    m.put(text("dois"), text("two"))
    m.put(text("um"), text("uno")) // substitui: a chave e o valor antigos são liberados
    testing.eq_int(m.len(), 2)
    k := text("um")
    testing.eq_str(m.get(&k), "uno")
    i := m.index(&k)
    testing.eq_str(m.key_ref(i), "um")
    v := m.take_or(&k, text("nada"))
    testing.eq_str(&v, "uno")
    free(v)
    w := m.take_or(&k, text("nada"))
    testing.eq_str(&w, "nada")
    free(w)
    free(k)
    testing.eq_int(m.len(), 1)
    m.free()
}

fn sum(k &int, v &int) {
    if *k < 0 || *v < 0 {
        // nunca acontece: só confere que each passa a chave e o valor
        testing.fail("negativo")
    }
}

fn test_each() {
    m := map.new[int, int](4)
    m.put(1, 2)
    m.put(3, 4)
    m.each(sum)
    m.free()
}

fn bench_map_put_get_1000(b &testing.B) {
    for i := 0; i < b.n; i++ {
        m := map.new[int, int](16)
        for k := 0; k < 1000; k++ {
            m.put(k, k)
        }
        total := 0
        for k := 0; k < 1000; k++ {
            total += m.get_or(&k, 0)
        }
        if total != 499500 {
            testing.fail("soma errada")
        }
        m.free()
    }
}

struct Point {
    x int
    y int
}

impl auto hash.Hash for Point

fn test_struct_keys() {
    m := map.new[Point, int](4)
    for x := 0; x < 20; x++ {
        for y := 0; y < 20; y++ {
            m.put(Point{x: x, y: y}, x * 100 + y)
        }
    }
    testing.eq_int(m.len(), 400)
    k := Point{x: 7, y: 13}
    testing.eq_int(m.get_or(&k, -1), 713)
    m.put(Point{x: 7, y: 13}, 0) // a mesma chave: substitui
    testing.eq_int(m.len(), 400)
    testing.eq_int(m.get_or(&k, -1), 0)
    k = Point{x: 20, y: 0}
    testing.check(!m.has(&k), "chave que não existe")
    m.free()
}

enum Cell {
    Wall
    Floor(cost int)
}

impl auto hash.Hash for Cell

fn test_enum_keys() {
    m := map.new[Cell, int](4)
    m.put(Cell.Wall, 1)
    m.put(Cell.Floor(3), 2)
    m.put(Cell.Floor(4), 3)
    f := Cell.Floor(4)
    testing.eq_int(m.get_or(&f, 0), 3)
    w := Cell.Wall
    testing.eq_int(m.get_or(&w, 0), 1)
    testing.eq_int(m.len(), 3)
    m.free()
}

struct Totals {
    sum int
    count int
}

fn add_total(t &Totals, k &int, v &int) {
    t.sum += *v
    t.count++
}

fn test_each_with() {
    m := map.new[int, int](4)
    for i := 1; i <= 10; i++ {
        m.put(i, i * i)
    }
    var t Totals
    m.each_with(&t, add_total)
    testing.eq_int(t.count, 10)
    testing.eq_int(t.sum, 385)
    m.free()
}

// um contexto com donos: as chaves vão para um vec
fn collect_keys(out &vec.Vec[int], k &int, v &int) {
    if *v > 50 {
        out.push(*k)
    }
}

fn test_each_with_owner_context() {
    m := map.new[int, int](4)
    for i := 1; i <= 10; i++ {
        m.put(i, i * i)
    }
    keys := vec.new[int](2)
    m.each_with(&keys, collect_keys)
    testing.eq_int(keys.len(), 3) // 8, 9 e 10 têm quadrado maior que 50
    keys.free()
    m.free()
}
