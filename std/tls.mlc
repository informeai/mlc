// TLS (HTTPS): conexões cifradas, de cliente e de servidor, com o OpenSSL do
// sistema. A biblioteca é carregada na primeira chamada (não precisa de
// flags de ligação); available diz se ela existe. No macOS, instale com
// brew install openssl@3; no Linux, ela costuma vir com o sistema.
//
// Cliente: connect abre o TCP e faz o aperto de mão, conferindo o
// certificado do servidor (a cadeia até uma autoridade do sistema, a
// validade e o nome do host). Um certificado que não vale é recusado:
// não há como desligar a conferência. Para uma autoridade própria (um
// servidor interno, os testes), aponte MLC_TLS_CA para o arquivo dela.
//
//     err := 0
//     c := tls.connect_str("api.exemplo.com", 443, &err)
//     if c == nil {
//         var msg [256]byte
//         n := tls.last_error(&msg)       // por que falhou, em detalhe
//         return
//     }
//     c.write(&pedido)
//     c.read(&resposta)
//     c.close()
//
// Servidor: new_server carrega o certificado (a cadeia, em PEM) e a chave;
// accept faz o aperto de mão numa conexão aceita por um net.Listener:
//
//     srv := tls.new_server_str("cert.pem", "chave.pem", &err)
//     ...
//     c := l.accept(&err)                 // net.Conn
//     if c != nil {
//         t := srv.accept(c, &err)        // a net.Conn passa a ser do TLS
//         if t != nil {
//             http.serve_conn(&t, &router, &app)
//             t.close()
//         }
//     }
//     srv.close()
//
// Conn implementa io.Reader e http.Stream (pelo impl no módulo http):
// bufio, http.Message, Builder e Router funcionam sobre ela como sobre uma
// net.Conn. TLS 1.2 no mínimo.
import "std/io"
import "std/net"
import "std/result"
import "std/str"

// códigos de erro
pub const HANDSHAKE = 5001    // o aperto de mão falhou
pub const BAD_CERT = 5002     // o certificado do servidor não vale
pub const UNAVAILABLE = 5003  // a libssl não foi encontrada
pub const BROKEN = 5004       // erro na conexão TLS
pub const SERVER_FILES = 5005 // o certificado ou a chave do servidor não carregaram

// Conn é uma conexão TLS.
pub extern "C" type Conn

// Server é a configuração de um servidor TLS (o certificado e a chave).
pub extern "C" type Server

// available diz se a biblioteca de TLS foi achada.
pub extern fn available() bool

// connect abre uma conexão TLS com host:port e confere o certificado. Se
// não conseguir, devolve nil e põe o código em err (BAD_CERT, HANDSHAKE,
// UNAVAILABLE, ou os de net.connect); last_error explica.
pub extern fn connect(host &[]byte, port int, err &int) ?*Conn

// last_error copia a explicação do último erro de TLS desta thread (o
// motivo de um certificado recusado, por exemplo).
pub extern fn last_error(dst &[]byte) int

extern fn server_raw(cert &[]byte, key &[]byte, err &int) ?*Server
extern fn server_close(s *Server)
extern fn accept_raw(c *net.Conn, s &Server, err &int) ?*Conn
extern fn read_raw(c &Conn, dst &[]byte) int
extern fn write_raw(c &Conn, data &[]byte) int
extern fn timeout_raw(c &Conn, ms int) int
extern fn close_raw(c *Conn)

// connect_str é connect com o host fixo no programa.
pub fn connect_str(host string, port int, err &int) ?*Conn {
    var b [256]byte
    n := str.copy(&b, host)
    return connect(&b[:n], port, err)
}

// read lê o que chegar, até len(dst) bytes; Ok(0) quer dizer que o outro
// lado fechou.
pub fn (c &Conn) read(dst &[]byte) result.Result[int, int] {
    return wrap(read_raw(c, dst))
}

// write manda todos os bytes de data.
pub fn (c &Conn) write(data &[]byte) result.Result[int, int] {
    return wrap(write_raw(c, data))
}

// set_timeout limita, em milissegundos, quanto read e write esperam (0: sem
// limite). Passado o tempo, o erro é net.TIMEOUT.
pub fn (c &Conn) set_timeout(ms int) result.Result[int, int] {
    return wrap(timeout_raw(c, ms))
}

// close avisa o outro lado, fecha a conexão e libera o handle.
pub fn (c *Conn) close() {
    close_raw(c)
}

impl io.Reader for Conn

// new_server carrega o certificado (a cadeia, em PEM) e a chave privada.
// Se não conseguir, devolve nil e põe o código em err (SERVER_FILES,
// UNAVAILABLE).
pub fn new_server(cert &[]byte, key &[]byte, err &int) ?*Server {
    return server_raw(cert, key, err)
}

// new_server_str é new_server com os caminhos fixos no programa.
pub fn new_server_str(cert string, key string, err &int) ?*Server {
    var c [1024]byte
    var k [1024]byte
    cn := str.copy(&c, cert)
    kn := str.copy(&k, key)
    return server_raw(&c[:cn], &k[:kn], err)
}

// accept faz o aperto de mão do servidor na conexão c, aceita por um
// net.Listener. A conexão passa a ser do TLS: se o aperto de mão falhar,
// ela é fechada aqui, e accept devolve nil com o código em err.
pub fn (s &Server) accept(c *net.Conn, err &int) ?*Conn {
    return accept_raw(c, s, err)
}

// close libera a configuração do servidor.
pub fn (s *Server) close() {
    server_close(s)
}

fn wrap(n int) result.Result[int, int] {
    if n < 0 {
        return result.Result.Err(-n)
    }
    return result.Result.Ok(n)
}
