// Logging with level, time and whole lines even with several
// threads. The logger is an object: whoever creates it passes it along (borrowed, or
// a clone for another thread) and closes it. There's no global logger.
//
//     lg := log.new(log.STDERR, log.INFO)
//     lg.info("server listening on port {}", port)
//     lg.warn("slow connection: {} ms", ms)
//     lg.debug("not printed: below the INFO level")
//     t := thread.spawn(worker, lg.clone(), thread.STACK_64KB)   // another handle
//     ...
//     lg.close()
//
// Each line comes out as
//
//     2026-10-19T14:03:22.123-03:00 INFO  server listening on port 8080
//
// debug, info, warn and error have io.printf's format (checked at compile
// time) and are written by the compiler like w.printf: the values
// are always computed, left to right, but only formatted
// if the level is enabled. The line is assembled in a per-thread buffer (2048
// bytes; whatever goes past is left out) and written at once, under the
// logger's lock. Nothing allocates per line.
import "std/io"

// levels
pub const DEBUG = 0
pub const INFO = 1
pub const WARN = 2
pub const ERROR = 3

// destinations of new
pub const STDOUT = 1
pub const STDERR = 2

// Logger is a counted handle: each handle (the clones too) needs a
// close, and the last one closes the file.
pub extern "C" type Logger

extern fn new_raw(fd int, level int) *Logger
extern fn open_raw(path &[]byte, level int, err &int) ?*Logger
extern fn clone_raw(l &Logger) *Logger
extern fn close_raw(l *Logger)
extern fn level_raw(l &Logger) int
extern fn set_level_raw(l &Logger, level int)
extern fn set_time_raw(l &Logger, on bool)
extern fn emit_raw(l &Logger, level int, msg &[]byte)

// new creates a logger on standard output (STDOUT) or standard error (STDERR),
// which logs from level up.
pub fn new(dest int, level int) *Logger {
    return new_raw(dest, level)
}

// open creates a logger in a file, appending at the end (creates the file if
// needed). On error it returns nil, with the code in err.
pub fn open(path &[]byte, level int, err &int) ?*Logger {
    return open_raw(path, level, err)
}

// clone returns another handle to the same logger (for another thread).
pub fn (l &Logger) clone() *Logger {
    return clone_raw(l)
}

// close closes this handle; the last one closes the file.
pub fn (l *Logger) close() {
    close_raw(l)
}

// level returns the minimum level logged.
pub fn (l &Logger) level() int {
    return level_raw(l)
}

// set_level changes the minimum level (applies to all handles).
pub fn (l &Logger) set_level(level int) {
    set_level_raw(l, level)
}

// enabled says whether a line of level level would be logged.
pub fn (l &Logger) enabled(level int) bool {
    return level >= level_raw(l)
}

// set_time turns the time at the start of lines on or off (off, the
// output is the same on every run, good for tests).
pub fn (l &Logger) set_time(on bool) {
    set_time_raw(l, on)
}

// write logs a ready-made line (without the \n), if the level is enabled.
pub fn (l &Logger) write(level int, msg &[]byte) {
    if level >= level_raw(l) {
        emit_raw(l, level, msg)
    }
}
