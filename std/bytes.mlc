// Growing text (or bytes). It's one of the parts of the library that
// allocates, and the allocation is visible here: new allocates, and reserve
// doubles the capacity with realloc when room runs out.
//
//     b := bytes.new(64)
//     b.push_str("total: ")
//     b.push_int(42)
//     b.reserve(str.format_len(" ({:.1}%)", p))          // format directly into the Buf
//     b.len += str.format(&b.data[b.len:], " ({:.1}%)", p)
//     io.write_line(&b.data[:b.len])                     // the text is &b.data[:b.len]
//     b.free()
import "std/str"

// Buf is a growing text: the bytes are in data[:len], and the capacity
// is len(data). Growing (reserve, push_*) is a visible realloc.
pub struct Buf {
    data []byte // the capacity is len(data); the text is data[:len]
    len int
}

// new allocates an empty Buf with room for cap bytes.
pub fn new(cap int) *Buf {
    return alloc(Buf{data: alloc([]byte, cap), len: 0})
}

// reserve guarantees room for n more bytes, doubling the capacity (realloc)
// until it fits.
pub fn (b &Buf) reserve(n int) {
    need := b.len + n
    if need <= len(b.data) {
        return
    }
    size := len(b.data) * 2
    if size < 16 {
        size = 16
    }
    for size < need {
        size = size * 2
    }
    b.data = realloc(b.data, size)
}

// push_byte appends a byte (grows if needed).
pub fn (b &Buf) push_byte(c byte) {
    b.reserve(1)
    b.data[b.len] = c
    b.len++
}

// push_str appends the text of s (grows if needed).
pub fn (b &Buf) push_str(s string) {
    b.reserve(len(s))
    b.len += str.copy(&b.data[b.len:], s)
}

// push_bytes appends the bytes of s (grows if needed).
pub fn (b &Buf) push_bytes(s &[]byte) {
    b.reserve(len(s))
    b.len += str.copy_bytes(&b.data[b.len:], s)
}

// push_int appends n in decimal (grows if needed).
pub fn (b &Buf) push_int(n int) {
    b.reserve(str.int_len(n))
    b.len += str.put_int(&b.data[b.len:], n)
}

// truncate shortens the text to n bytes (n <= len).
pub fn (b &Buf) truncate(n int) {
    if n < 0 || n > b.len {
        fail("bytes.Buf.truncate: tamanho fora do texto")
    }
    b.len = n
}

// clear empties the text, keeping the capacity.
pub fn (b &Buf) clear() {
    b.len = 0
}

// eq says whether the text is s.
pub fn (b &Buf) eq(s string) bool {
    return str.eq(&b.data[:b.len], s)
}

// free frees the text and the Buf.
pub fn (b *Buf) free() {
    free(b.data)
    free(b)
}

extern fn fail(msg string)
