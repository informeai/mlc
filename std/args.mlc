// Command-line arguments: options (-v, --verbose, -o file,
// --out=file) and positional arguments. The current argument stays in a fixed
// buffer inside Args, on the caller's stack; the values are copied into
// the caller's buffers. Nothing allocates.
//
//     a := args.new()
//     verbose := false
//     var out [256]byte
//     out_n := 0
//     for a.next() {
//         if a.is("-v", "--verbose") {
//             verbose = true
//         } else if a.value("-o", "--out", &out, &out_n) {
//             if out_n < 0 { ... the value is missing ... }
//         } else if a.is_option() {
//             ... unknown option: a.text(&buf) ...
//         } else {
//             n := a.text(&file)            // positional
//         }
//     }
//
// After "--", everything is positional (for names that start with -).
import "std/os"
import "std/result"
import "std/str"

// Args walks the command-line arguments, one at a time, with the current one
// copied into a fixed buffer (up to 4 KB).
pub struct Args {
    cur [4096]byte // the current argument
    n int
    i int     // the index of the next argument
    rest bool // already past the "--"
    used bool // the current one was already recognized (is, value)
}

// new starts reading the program's arguments (0, its name, is left out).
pub fn new() Args {
    var a Args
    a.i = 1
    return a
}

// next advances to the next argument and says whether there is one. A "--" is skipped and
// makes the rest positional.
pub fn (a &Args) next() bool {
    for {
        if !a.load(a.i) {
            return false
        }
        a.i++
        a.used = false
        if !a.rest && str.eq(&a.cur[:a.n], "--") {
            a.rest = true
            continue
        }
        return true
    }
}

fn (a &Args) load(i int) bool {
    match os.arg(i, &a.cur) {
        Ok(n) => {
            a.n = n
            return true
        }
        Err(code) => {
            if code == os.TOO_LONG {
                fail("args: an argument is longer than 4096 bytes")
            }
            return false
        }
    }
}

// is says whether the current argument is the option short or long ("" to omit one
// of the forms).
pub fn (a &Args) is(short string, long string) bool {
    if a.rest {
        return false
    }
    if a.matches(short, long) {
        a.used = true
        return true
    }
    return false
}

// matches says whether the current argument is exactly short or long.
fn (a &Args) matches(short string, long string) bool {
    return (len(short) > 0 && str.eq(&a.cur[:a.n], short)) || (len(long) > 0 && str.eq(&a.cur[:a.n], long))
}

// value recognizes an option with a value: "-o file", "--out file" or
// "--out=file". If it's this one, copies the value into dst, puts the length in n (-1 if
// the value is missing) and returns true. A value larger than dst panics.
pub fn (a &Args) value(short string, long string, dst &[]byte, n &int) bool {
    if a.rest {
        return false
    }
    if len(long) > 0 && a.n > len(long) && a.cur[len(long)] == '=' && str.eq(&a.cur[:len(long)], long) {
        *n = str.copy_bytes(dst, &a.cur[len(long) + 1:a.n])
        a.used = true
        return true
    }
    if !a.matches(short, long) {
        return false
    }
    a.used = true
    *n = -1
    if a.i < os.arg_count() {
        match os.arg(a.i, dst) {
            Ok(k) => {
                *n = k
                a.i++
            }
            Err(_) => fail("args: the option's value doesn't fit in the buffer")
        }
    }
    return true
}

// is_option says whether the current argument looks like an option (starts with - and isn't
// just "-"), not yet recognized by is or value.
pub fn (a &Args) is_option() bool {
    return !a.rest && !a.used && a.n > 1 && a.cur[0] == '-'
}

// text copies the current argument into dst and returns the length.
pub fn (a &Args) text(dst &[]byte) int {
    return str.copy_bytes(dst, &a.cur[:a.n])
}

// int_value is value for a number: puts the value in v and returns true if the
// option is this one. ok becomes false if the value is missing or isn't an integer.
pub fn (a &Args) int_value(short string, long string, v &int, ok &bool) bool {
    var buf [32]byte
    n := 0
    if !a.value(short, long, &buf, &n) {
        return false
    }
    *ok = n >= 0 && str.parse_int(&buf[:n], v)
    return true
}

extern fn fail(msg string)
