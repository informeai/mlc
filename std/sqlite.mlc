// SQLite: a database in a file, with SQL and transactions. The system
// library is loaded on the first call (no link flags
// needed); available says whether it exists.
//
// The database (DB) and the prepared statement (Stmt) are handles: the checker
// requires the close of each one, and a Stmt must be closed before the database.
// Nothing allocates on the MLC side: text goes in borrowed (SQLite copies it) and
// comes out copied into the caller's buffers.
//
//     err := 0
//     db := sqlite.open_str("shop.db", &err)
//     if db == nil {
//         io.printf("error {:s}\n", ...)      // os.error_text(err, &buf)
//         return
//     }
//     db.exec_str("CREATE TABLE IF NOT EXISTS item (id INTEGER PRIMARY KEY, name TEXT, price INTEGER)")
//
//     st := db.prepare_str("INSERT INTO item (name, price) VALUES (?, ?)", &err)
//     if st != nil {
//         st.bind_str(1, "coffee")
//         st.bind_int(2, 1250)                // money in cents
//         st.run()
//         st.close()
//     }
//
//     q := db.prepare_str("SELECT id, name, price FROM item WHERE price > ?", &err)
//     if q != nil {
//         q.bind_int(1, 1000)
//         var name [256]byte
//         for q.next() {                      // one row per iteration
//             n := q.text(1, &name)
//             io.printf("{} {:s} {}\n", q.int(0), &name[:n], q.int(2))
//         }
//         q.close()
//     }
//     db.close()
//
// Parameters (?) start at 1, columns at 0, as in SQLite. Always use
// parameters for values, never SQL built from outside text
// (SQL injection). The errors are 4000 + SQLite's code (CONSTRAINT,
// BUSY...); os.error_text gives the text, and db.error(&buf) SQLite's
// message about the last error.
import "std/str"

// error codes (4000 + SQLite's primary code)
pub const ERROR = 4001       // SQL or usage error
pub const BUSY = 4005        // another process has the database locked (after waiting 5 s)
pub const CANTOPEN = 4014    // the file couldn't be opened
pub const CONSTRAINT = 4019  // UNIQUE, NOT NULL, FOREIGN KEY or CHECK violated
pub const MISUSE = 4021      // wrong use of the API (like empty SQL)
pub const UNAVAILABLE = 4900 // the SQLite library doesn't exist on this system

// what step returns besides the errors
const ROW = 100
const DONE = 101

// the column types
pub const INTEGER = 1
pub const FLOAT = 2
pub const TEXT = 3
pub const BLOB = 4
pub const NULL = 5

// open modes
pub const READ_ONLY = 1
pub const READ_WRITE = 2
pub const CREATE = 4

// DB is an open database.
pub extern "C" type DB

// Stmt is a prepared statement.
pub extern "C" type Stmt

// available says whether the SQLite library was found on this system.
pub extern fn available() bool

extern fn version_raw(dst &[]byte) int
extern fn open_raw(path &[]byte, flags int, err &int) ?*DB
extern fn close_raw(db *DB)
extern fn exec_raw(db &DB, sql &[]byte, msg &[]byte, msg_n &int) int
extern fn errmsg_raw(db &DB, dst &[]byte) int
extern fn prepare_raw(db &DB, sql &[]byte, err &int) ?*Stmt
extern fn finalize_raw(st *Stmt)
extern fn step_raw(st &Stmt) int
extern fn reset_raw(st &Stmt) int
extern fn bind_int_raw(st &Stmt, i int, v int) int
extern fn bind_float_raw(st &Stmt, i int, v float64) int
extern fn bind_text_raw(st &Stmt, i int, s &[]byte) int
extern fn bind_blob_raw(st &Stmt, i int, s &[]byte) int
extern fn bind_null_raw(st &Stmt, i int) int
extern fn column_count_raw(st &Stmt) int
extern fn column_type_raw(st &Stmt, i int) int
extern fn column_int_raw(st &Stmt, i int) int
extern fn column_float_raw(st &Stmt, i int) float64
extern fn column_text_raw(st &Stmt, i int, dst &[]byte) int
extern fn column_blob_raw(st &Stmt, i int, dst &[]byte) int
extern fn column_name_raw(st &Stmt, i int, dst &[]byte) int
extern fn changes_raw(db &DB) int
extern fn last_insert_id_raw(db &DB) int
extern fn fail(msg string)

// version copies the library's version (3.43.2, for example); -1 if it
// doesn't exist.
pub fn version(dst &[]byte) int {
    return version_raw(dst)
}

// ---------- database ----------

// open opens (or creates) the database in the file path, for reading and writing.
// ":memory:" is an in-memory database, which vanishes on close. If it can't,
// returns nil and puts the code in err (CANTOPEN, UNAVAILABLE...).
pub fn open(path &[]byte, err &int) ?*DB {
    return open_raw(path, READ_WRITE | CREATE, err)
}

// open_str is open with the path fixed in the program.
pub fn open_str(path string, err &int) ?*DB {
    var b [1024]byte
    if len(path) > len(b) {
        fail("sqlite.open_str: path too long")
    }
    n := str.copy(&b, path)
    return open(&b[:n], err)
}

// open_read_only opens a database that already exists, read-only.
pub fn open_read_only(path &[]byte, err &int) ?*DB {
    return open_raw(path, READ_ONLY, err)
}

// close closes the database. Its Stmts must have been closed before (if
// they weren't, SQLite only closes the database when they close).
pub fn (db *DB) close() {
    close_raw(db)
}

// exec runs one or more SQL statements without a result (CREATE, INSERT without
// parameters, BEGIN, COMMIT...). Returns 0 or the error code.
pub fn (db &DB) exec(sql &[]byte) int {
    var msg [1]byte
    n := 0
    return exec_raw(db, sql, &msg, &n)
}

// exec_str is exec with the SQL fixed in the program.
pub fn (db &DB) exec_str(sql string) int {
    var b [8192]byte
    if len(sql) > len(b) {
        fail("sqlite.exec_str: SQL larger than 8 KB; use exec with a buffer of yours")
    }
    n := str.copy(&b, sql)
    return db.exec(&b[:n])
}

// error copies SQLite's message about the database's last error.
pub fn (db &DB) error(dst &[]byte) int {
    return errmsg_raw(db, dst)
}

// changes returns how many rows the last INSERT, UPDATE or DELETE changed.
pub fn (db &DB) changes() int {
    return changes_raw(db)
}

// last_insert_id returns the rowid (the INTEGER PRIMARY KEY) of the last INSERT.
pub fn (db &DB) last_insert_id() int {
    return last_insert_id_raw(db)
}

// begin, commit and rollback control a transaction: between begin and commit,
// the changes apply all or none (and get much faster in a batch).
pub fn (db &DB) begin() int {
    return db.exec_str("BEGIN")
}

// commit confirms the transaction.
pub fn (db &DB) commit() int {
    return db.exec_str("COMMIT")
}

// rollback undoes the transaction.
pub fn (db &DB) rollback() int {
    return db.exec_str("ROLLBACK")
}

// prepare compiles an SQL statement (with ? for the parameters). If it
// can't, returns nil and puts the code in err (db.error has the message).
pub fn (db &DB) prepare(sql &[]byte, err &int) ?*Stmt {
    return prepare_raw(db, sql, err)
}

// prepare_str is prepare with the SQL fixed in the program.
pub fn (db &DB) prepare_str(sql string, err &int) ?*Stmt {
    var b [8192]byte
    if len(sql) > len(b) {
        fail("sqlite.prepare_str: SQL larger than 8 KB; use prepare with a buffer of yours")
    }
    n := str.copy(&b, sql)
    return db.prepare(&b[:n], err)
}

// ---------- prepared statement ----------

// close frees the statement.
pub fn (st *Stmt) close() {
    finalize_raw(st)
}

// bind_int puts an integer in parameter i (the first ? is 1).
pub fn (st &Stmt) bind_int(i int, v int) int {
    return bind_int_raw(st, i, v)
}

// bind_float puts a real in parameter i.
pub fn (st &Stmt) bind_float(i int, v float64) int {
    return bind_float_raw(st, i, v)
}

// bind_text puts a text in parameter i (SQLite keeps a copy).
pub fn (st &Stmt) bind_text(i int, s &[]byte) int {
    return bind_text_raw(st, i, s)
}

// bind_str puts a fixed text from the program in parameter i.
pub fn (st &Stmt) bind_str(i int, s string) int {
    var b [4096]byte
    if len(s) > len(b) {
        fail("sqlite.bind_str: text larger than 4 KB; use bind_text with a buffer of yours")
    }
    n := str.copy(&b, s)
    return bind_text_raw(st, i, &b[:n])
}

// bind_blob puts bytes in parameter i.
pub fn (st &Stmt) bind_blob(i int, s &[]byte) int {
    return bind_blob_raw(st, i, s)
}

// bind_null puts NULL in parameter i.
pub fn (st &Stmt) bind_null(i int) int {
    return bind_null_raw(st, i)
}

// next advances to the next row of the result: true if there's a row,
// false at the end (or on an error: check with last_error). After the end, the
// statement can be used again with other parameters (reset).
pub fn (st &Stmt) next() bool {
    rc := step_raw(st)
    if rc == ROW {
        return true
    }
    return false
}

// run runs a statement without a result (INSERT, UPDATE, DELETE) and returns 0
// or the error code (CONSTRAINT, for example). The statement goes back to the start
// (reset), ready for other parameters.
pub fn (st &Stmt) run() int {
    rc := step_raw(st)
    if rc == ROW || rc == DONE {
        rc = 0
    }
    r := reset_raw(st)
    if rc == 0 {
        return r
    }
    return rc
}

// reset takes the statement back to the start and clears the parameters, to run it
// again. Returns the error of the last step, if there was one.
pub fn (st &Stmt) reset() int {
    return reset_raw(st)
}

// columns returns how many columns the result has.
pub fn (st &Stmt) columns() int {
    return column_count_raw(st)
}

// column_name copies the name of column i.
pub fn (st &Stmt) column_name(i int, dst &[]byte) int {
    n := column_name_raw(st, i, dst)
    if n < 0 {
        fail("sqlite.column_name: the name doesn't fit in the destination")
    }
    return n
}

// kind returns the type of the value in column i of the current row (INTEGER,
// FLOAT, TEXT, BLOB or NULL).
pub fn (st &Stmt) kind(i int) int {
    return column_type_raw(st, i)
}

// is_null says whether column i of the current row is NULL.
pub fn (st &Stmt) is_null(i int) bool {
    return column_type_raw(st, i) == NULL
}

// int reads column i as an integer (NULL becomes 0).
pub fn (st &Stmt) int(i int) int {
    return column_int_raw(st, i)
}

// float reads column i as a real.
pub fn (st &Stmt) float(i int) float64 {
    return column_float_raw(st, i)
}

// text copies column i, as text, into dst and returns the length (NULL
// becomes empty text). Panics if it doesn't fit: use text_len first to know the
// size.
pub fn (st &Stmt) text(i int, dst &[]byte) int {
    n := column_text_raw(st, i, dst)
    if n < 0 {
        fail("sqlite.Stmt.text: the text doesn't fit in the destination (see text_len)")
    }
    return n
}

// blob copies column i, as bytes, into dst.
pub fn (st &Stmt) blob(i int, dst &[]byte) int {
    n := column_blob_raw(st, i, dst)
    if n < 0 {
        fail("sqlite.Stmt.blob: the bytes don't fit in the destination (see text_len)")
    }
    return n
}

// text_len returns the size, in bytes, of the text (or blob) of column i.
pub fn (st &Stmt) text_len(i int) int {
    var none [1]byte
    n := column_text_raw(st, i, &none[:0])
    if n < 0 {
        return -1000 - n
    }
    return n
}
