// Configuração em arquivo: .env e INI. Nada aloca: o texto fica num buffer
// de 16 KB dentro da Config, com até 256 entradas, e os valores são
// copiados para buffers de quem chama.
//
//     # .env                          ; app.ini
//     PORT=8080                       [db]
//     DATABASE_URL="sqlite:loja.db"   path = loja.db
//     export DEBUG=true               timeout = 5    ; segundos
//
//     var cfg config.Config
//     match config.load_str(".env", &cfg) {
//         Ok(_) => {}
//         Err(code) => ...                  // cfg.bad_line diz a linha ruim
//     }
//     porta := 8080
//     cfg.int("PORT", &porta)               // fica o padrão se não existe
//     var path [256]byte
//     n := cfg.get("db.path", &path)        // numa seção: "seção.chave"
//     n = cfg.env("DATABASE_URL", &path)    // a variável de ambiente, se existir, ganha
//
// O formato: uma chave=valor por linha, com espaços em volta ignorados;
// linhas vazias e as que começam com # ou ; são comentários; "export " antes
// da chave é aceito (.env de shell); [seção] começa uma seção (INI). Um
// valor entre aspas duplas aceita \n \t \\ \" e pode ter # dentro; entre
// aspas simples, fica como está; sem aspas, " #" ou " ;" começa um
// comentário. Uma
// chave repetida vale pela última vez.
import "std/fs"
import "std/os"
import "std/result"
import "std/str"

// BAD_LINE é o erro de uma linha que não é chave=valor (Config.bad_line diz
// qual).
pub const BAD_LINE = 3201

// MAX_ENTRIES é quantas chaves cabem numa Config.
pub const MAX_ENTRIES = 256

// Config é um arquivo de configuração lido.
pub struct Config {
    buf [16384]byte
    n int
    sec_at [256]int // a seção de cada entrada (n = 0: sem seção)
    sec_n [256]int
    key_at [256]int
    key_n [256]int
    val_at [256]int
    val_n [256]int
    count int
    bad_line int // a primeira linha inválida (0: nenhuma)
}

// load lê e interpreta o arquivo path. Devolve quantas chaves leu, ou Err
// com o código do fs (fs.NOT_FOUND...), TOO_BIG (o arquivo passa de 16 KB)
// ou BAD_LINE.
pub fn load(path &[]byte, c &Config) result.Result[int, int] {
    c.count = 0
    c.bad_line = 0
    match fs.read_file(path, &c.buf) {
        Ok(n) => c.n = n
        Err(code) => return result.Result.Err(code)
    }
    return c.scan()
}

// load_str é load com o caminho fixo no programa.
pub fn load_str(path string, c &Config) result.Result[int, int] {
    var b [1024]byte
    n := str.copy(&b, path)
    return load(&b[:n], c)
}

// parse interpreta o texto de uma configuração que já está na memória.
pub fn (c &Config) parse(text &[]byte) result.Result[int, int] {
    if len(text) > len(c.buf) {
        return result.Result.Err(fs.TOO_BIG)
    }
    c.n = str.copy_bytes(&c.buf, text)
    c.count = 0
    c.bad_line = 0
    return c.scan()
}

// scan lê as linhas de buf[:n].
fn (c &Config) scan() result.Result[int, int] {
    sec_at := 0
    sec_n := 0
    line := 0
    at := 0
    for at < c.n {
        line++
        end := at
        for end < c.n && c.buf[end] != '\n' {
            end++
        }
        next := end + 1
        if end > at && c.buf[end - 1] == '\r' {
            end--
        }
        a := skip_space(&c.buf, at, end)
        b := trim_end(&c.buf, a, end)
        if a == b || c.buf[a] == '#' || c.buf[a] == ';' {
            at = next
            continue
        }
        if c.buf[a] == '[' {
            if c.buf[b - 1] != ']' {
                return c.bad(line)
            }
            sec_at = skip_space(&c.buf, a + 1, b - 1)
            sec_n = trim_end(&c.buf, sec_at, b - 1) - sec_at
            at = next
            continue
        }
        if b - a > 7 && str.eq(&c.buf[a:a + 7], "export ") {
            a = skip_space(&c.buf, a + 7, b)
        }
        eq := a
        for eq < b && c.buf[eq] != '=' {
            eq++
        }
        if eq == b || eq == a {
            return c.bad(line)
        }
        if c.count == MAX_ENTRIES {
            return c.bad(line)
        }
        k := c.count
        c.sec_at[k] = sec_at
        c.sec_n[k] = sec_n
        c.key_at[k] = a
        c.key_n[k] = trim_end(&c.buf, a, eq) - a
        v := skip_space(&c.buf, eq + 1, b)
        if !c.value(k, v, b) {
            return c.bad(line)
        }
        c.count++
        at = next
    }
    return result.Result.Ok(c.count)
}

// value lê o valor em buf[v:b] para a entrada k, tirando as aspas e
// trocando os escapes no lugar.
fn (c &Config) value(k int, v int, b int) bool {
    c.val_at[k] = v
    if v < b && c.buf[v] == '\'' {
        close := v + 1
        for close < b && c.buf[close] != '\'' {
            close++
        }
        if close == b {
            return false
        }
        c.val_at[k] = v + 1
        c.val_n[k] = close - v - 1
        return true
    }
    if v < b && c.buf[v] == '"' {
        w := v // escreve por cima, a partir da aspa (o valor encolhe ou fica igual)
        i := v + 1
        for i < b && c.buf[i] != '"' {
            ch := c.buf[i]
            if ch == '\\' && i + 1 < b {
                i++
                ch = c.buf[i]
                if ch == 'n' {
                    ch = '\n'
                } else if ch == 't' {
                    ch = '\t'
                } else if ch == 'r' {
                    ch = '\r'
                }
            }
            c.buf[w] = ch
            w++
            i++
        }
        if i == b {
            return false
        }
        c.val_n[k] = w - v
        return true
    }
    // sem aspas: " #" ou " ;" começa um comentário
    e := v
    for e < b {
        if (c.buf[e] == '#' || c.buf[e] == ';') && e > v && (c.buf[e - 1] == ' ' || c.buf[e - 1] == '\t') {
            break
        }
        e++
    }
    c.val_n[k] = trim_end(&c.buf, v, e) - v
    return true
}

fn (c &Config) bad(line int) result.Result[int, int] {
    c.bad_line = line
    return result.Result.Err(BAD_LINE)
}

// find devolve a entrada de key ("chave", ou "seção.chave"), a última se
// ela se repete; -1 se não existe.
fn (c &Config) find(key string) int {
    for k := c.count - 1; k >= 0; k-- {
        sn := c.sec_n[k]
        kn := c.key_n[k]
        if sn == 0 {
            if kn == len(key) && same(&c.buf, c.key_at[k], key, 0, kn) {
                return k
            }
            continue
        }
        if sn + 1 + kn == len(key) && same(&c.buf, c.sec_at[k], key, 0, sn) && key[sn] == '.' && same(&c.buf, c.key_at[k], key, sn + 1, kn) {
            return k
        }
    }
    return -1
}

// has diz se a chave existe.
pub fn (c &Config) has(key string) bool {
    return c.find(key) >= 0
}

// get copia o valor da chave para dst; -1 se ela não existe.
pub fn (c &Config) get(key string, dst &[]byte) int {
    k := c.find(key)
    if k < 0 {
        return -1
    }
    return str.copy_bytes(dst, &c.buf[c.val_at[k]:c.val_at[k] + c.val_n[k]])
}

// is diz se o valor da chave é s.
pub fn (c &Config) is(key string, s string) bool {
    k := c.find(key)
    return k >= 0 && str.eq(&c.buf[c.val_at[k]:c.val_at[k] + c.val_n[k]], s)
}

// int lê a chave como inteiro em out. Devolve false (e não mexe em out) se
// ela não existe ou não é um número: out pode trazer o valor padrão.
pub fn (c &Config) int(key string, out &int) bool {
    k := c.find(key)
    if k < 0 {
        return false
    }
    v := 0
    if !str.parse_int(&c.buf[c.val_at[k]:c.val_at[k] + c.val_n[k]], &v) {
        return false
    }
    *out = v
    return true
}

// bool lê a chave como true/false (também 1/0, yes/no, on/off, sem
// diferenciar maiúsculas). Como int, só mexe em out se der certo.
pub fn (c &Config) bool(key string, out &bool) bool {
    k := c.find(key)
    if k < 0 {
        return false
    }
    return parse_flag(&c.buf[c.val_at[k]:c.val_at[k] + c.val_n[k]], out)
}

// env copia a variável de ambiente key, se existir; senão, o valor da
// chave no arquivo; -1 se nenhum dos dois. É a ordem de costume: o
// ambiente (do servidor, do contêiner) ganha do arquivo.
pub fn (c &Config) env(key string, dst &[]byte) int {
    match os.getenv(key, dst) {
        Ok(n) => return n
        Err(_) => {}
    }
    return c.get(key, dst)
}

// len devolve quantas entradas foram lidas (repetidas contam de novo).
pub fn (c &Config) len() int {
    return c.count
}

// key copia a chave da entrada i (de 0 a len() - 1), com a seção na frente
// ("seção.chave"), para listar tudo.
pub fn (c &Config) key(i int, dst &[]byte) int {
    n := 0
    if c.sec_n[i] > 0 {
        n = str.copy_bytes(dst, &c.buf[c.sec_at[i]:c.sec_at[i] + c.sec_n[i]])
        n += str.copy(&dst[n:], ".")
    }
    return n + str.copy_bytes(&dst[n:], &c.buf[c.key_at[i]:c.key_at[i] + c.key_n[i]])
}

// value_at copia o valor da entrada i.
pub fn (c &Config) value_at(i int, dst &[]byte) int {
    return str.copy_bytes(dst, &c.buf[c.val_at[i]:c.val_at[i] + c.val_n[i]])
}

// parse_flag lê true/false, 1/0, yes/no, on/off.
pub fn parse_flag(s &[]byte, out &bool) bool {
    var low [8]byte
    if len(s) > len(low) {
        return false
    }
    for i := 0; i < len(s); i++ {
        ch := s[i]
        if ch >= 'A' && ch <= 'Z' {
            ch += 32
        }
        low[i] = ch
    }
    t := &low[:len(s)]
    if str.eq(t, "true") || str.eq(t, "1") || str.eq(t, "yes") || str.eq(t, "on") {
        *out = true
        return true
    }
    if str.eq(t, "false") || str.eq(t, "0") || str.eq(t, "no") || str.eq(t, "off") {
        *out = false
        return true
    }
    return false
}

fn same(b &[]byte, at int, s string, from int, n int) bool {
    for i := 0; i < n; i++ {
        if b[at + i] != s[from + i] {
            return false
        }
    }
    return true
}

fn skip_space(b &[]byte, at int, end int) int {
    for at < end && (b[at] == ' ' || b[at] == '\t') {
        at++
    }
    return at
}

fn trim_end(b &[]byte, at int, end int) int {
    for end > at && (b[end - 1] == ' ' || b[end - 1] == '\t') {
        end--
    }
    return end
}
