// File paths with slashes (/), as on Linux and macOS. The functions
// work only with the text (they don't look at the disk) and write the result
// into a buffer of the caller's, returning how many bytes they used; they
// panic if it doesn't fit. The result is never larger than the input (one byte
// more, when "" becomes "."), so a buffer the size of the input (or the sum of
// both, in join) is enough.
//
//     var out [4096]byte
//     n := path.join(&out, &dir[:k], &name[:m])      // "docs" + "a.txt" → "docs/a.txt"
//     e := path.ext(&ext, &out[:n])                  // ".txt"
import "std/str"

// clean puts the path in the shortest equivalent form, by text only:
// merges repeated slashes, removes the ".", resolves the ".." (which, at the
// start of a relative path, stay; in an absolute one, vanish: "/.." is "/") and
// removes the trailing slash. An empty path becomes ".".
//
//     "a//b/./c/../d/" → "a/b/d"
pub fn clean(dst &[]byte, p &[]byte) int {
    if len(p) == 0 {
        return str.copy(dst, ".")
    }
    n := str.copy_bytes(dst, p)
    return clean_in_place(dst, n)
}

// join joins a and b with a slash and cleans the result (clean). If b is
// absolute, the result is b.
pub fn join(dst &[]byte, a &[]byte, b &[]byte) int {
    if is_abs(b) || len(a) == 0 {
        return clean(dst, b)
    }
    n := str.copy_bytes(dst, a)
    n += str.copy(&dst[n:], "/")
    n += str.copy_bytes(&dst[n:], b)
    return clean_in_place(dst, n)
}

// join_str is join with the second piece written in the program:
// path.join_str(&out, &dir, "config.json").
pub fn join_str(dst &[]byte, a &[]byte, b string) int {
    if (len(b) > 0 && b[0] == '/') || len(a) == 0 {
        n := str.copy(dst, b)
        if n == 0 {
            return str.copy(dst, ".")
        }
        return clean_in_place(dst, n)
    }
    n := str.copy_bytes(dst, a)
    n += str.copy(&dst[n:], "/")
    n += str.copy(&dst[n:], b)
    return clean_in_place(dst, n)
}

// is_abs says whether the path starts at the root (/).
pub fn is_abs(p &[]byte) bool {
    return len(p) > 0 && p[0] == '/'
}

// base writes the last element of the path: "a/b/c.txt" → "c.txt",
// "a/b/" → "b", "/" → "/", "" → ".".
pub fn base(dst &[]byte, p &[]byte) int {
    if len(p) == 0 {
        return str.copy(dst, ".")
    }
    end := len(p)
    for end > 0 && p[end - 1] == '/' {
        end--
    }
    if end == 0 {
        return str.copy(dst, "/")
    }
    start := end
    for start > 0 && p[start - 1] != '/' {
        start--
    }
    return str.copy_bytes(dst, &p[start:end])
}

// dir writes everything but the last element, cleaned: "a/b/c.txt" → "a/b",
// "c.txt" → ".", "/c" → "/".
pub fn dir(dst &[]byte, p &[]byte) int {
    k := len(p)
    for k > 0 && p[k - 1] != '/' {
        k--
    }
    if k == 0 {
        return str.copy(dst, ".")
    }
    return clean(dst, &p[:k])
}

// ext writes the extension of the last element, with the dot: "a/b.tar.gz" →
// ".gz", "a/b" → "" (returns 0), ".bashrc" → ".bashrc".
pub fn ext(dst &[]byte, p &[]byte) int {
    for i := len(p) - 1; i >= 0 && p[i] != '/'; i-- {
        if p[i] == '.' {
            return str.copy_bytes(dst, &p[i:])
        }
    }
    return 0
}

// clean_in_place cleans b[:n] in the buffer itself: the writer never passes
// the reader, so reading and writing in the same place is safe.
fn clean_in_place(b &[]byte, n int) int {
    rooted := b[0] == '/'
    r := 0      // next byte to read
    w := 0      // next byte to write
    dotdot := 0 // how far back a ".." can go
    if rooted {
        r = 1
        w = 1
        dotdot = 1
    }
    for r < n {
        if b[r] == '/' {
            r++ // repeated slash
        } else if b[r] == '.' && (r + 1 == n || b[r + 1] == '/') {
            r++ // "."
        } else if b[r] == '.' && b[r + 1] == '.' && (r + 2 == n || b[r + 2] == '/') {
            r += 2 // "..": go back one element, if possible
            if w > dotdot {
                w--
                for w > dotdot && b[w] != '/' {
                    w--
                }
            } else if !rooted {
                // can't go back in a relative path: the ".." stays
                if w > 0 {
                    b[w] = '/'
                    w++
                }
                b[w] = '.'
                b[w + 1] = '.'
                w += 2
                dotdot = w
            }
        } else {
            // an element: the slash before it (if it isn't the first) and the bytes
            if (rooted && w != 1) || (!rooted && w != 0) {
                b[w] = '/'
                w++
            }
            for r < n && b[r] != '/' {
                b[w] = b[r]
                w++
                r++
            }
        }
    }
    if w == 0 {
        b[0] = '.'
        w = 1
    }
    return w
}
