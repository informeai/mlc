// Tests, run with mlc test. A name_test.mlc file declares functions
// fn test_name(), without parameters; mlc test runs each one in a separate
// process, so a panic or a leak stays in the test that caused it.
//
//     import "std/testing"
//     import "std/vec"
//
//     fn test_push() {
//         v := vec.new[int](2)
//         v.push(7)
//         testing.eq_int(v.len(), 1)
//         vec.free(v)
//     }
//
// A failing check shows its line and the test goes on. Nothing
// here allocates: texts are compared where they are.

// check fails with msg if ok is false.
pub extern fn check(ok bool, msg string)

// fail fails with msg.
pub extern fn fail(msg string)

// eq_int compares integers (got: what came; want: the expected).
pub extern fn eq_int(got int, want int)

// eq_uint compares unsigned integers (hashes, bit masks).
pub extern fn eq_uint(got uint64, want uint64)

// eq_bool compares bools.
pub extern fn eq_bool(got bool, want bool)

// eq_float compares floats exactly; for arithmetic with rounding, near.
pub extern fn eq_float(got float64, want float64)

// near accepts a difference of up to tol.
pub extern fn near(got float64, want float64, tol float64)

// eq_str compares a text in a buffer with the expected one.
pub extern fn eq_str(got &[]byte, want string)

// eq_bytes compares two buffers.
pub extern fn eq_bytes(got &[]byte, want &[]byte)

// B is a benchmark's state: fn bench_name(b &testing.B) repeats the
// measured section b.n times, and mlc test -bench picks b.n until the measurement
// lasts long enough.
//
//     fn bench_sort(b &testing.B) {
//         s := alloc([]int, 1000)
//         for i := 0; i < b.n; i++ {
//             fill(&s)
//             sort.sort(&s)
//         }
//         free(s)
//     }
pub struct B {
    n int
}

// expect_panic says the test must end in a panic (for example, an
// out-of-bounds index); ending without a panic is a failure.
pub extern fn expect_panic()
