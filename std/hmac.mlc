// HMAC-SHA256 (RFC 2104): a assinatura de uma mensagem com uma chave
// secreta. É o que confere um webhook (Stripe, GitHub), assina um token
// (JWT com HS256) ou um cookie de sessão. Nada aloca: o estado são dois
// SHA-256 na pilha de quem chama.
//
//     var mac [32]byte
//     hmac.sha256(&chave, &corpo, &mac)
//     ...
//     if !hmac.verify(&chave, &corpo, &recebido) {
//         // assinatura errada: recusa
//     }
//
// Para conferir uma assinatura, use verify (ou equal): uma comparação
// comum para no primeiro byte diferente, e o tempo que ela leva diz a quem
// ataca quantos bytes ele já acertou.
import "std/hash"

// SIZE é o tamanho de um HMAC-SHA256, em bytes.
pub const SIZE = 32

// Hmac calcula um HMAC-SHA256 com dados entregues em pedaços.
pub struct Hmac {
    inner hash.Sha256
    outer hash.Sha256
}

// new começa um HMAC com a chave (de qualquer tamanho; uma chave maior que
// 64 bytes é trocada pelo SHA-256 dela, como manda a RFC).
pub fn new(key &[]byte) Hmac {
    var k [64]byte
    if len(key) > 64 {
        hash.sha256_sum(key, &k[:32])
    } else {
        for i := 0; i < len(key); i++ {
            k[i] = key[i]
        }
    }
    var ipad [64]byte
    var opad [64]byte
    for i := 0; i < 64; i++ {
        ipad[i] = k[i] ^ 0x36
        opad[i] = k[i] ^ 0x5C
    }
    h := Hmac{inner: hash.sha256(), outer: hash.sha256()}
    h.inner.write(&ipad)
    h.outer.write(&opad)
    return h
}

// write acrescenta os bytes de data à mensagem.
pub fn (h &Hmac) write(data &[]byte) {
    h.inner.write(data)
}

// sum escreve o HMAC (SIZE bytes) em dst. Depois de sum, o Hmac não serve
// mais: comece outro com new.
pub fn (h &Hmac) sum(dst &[]byte) {
    var d [32]byte
    h.inner.sum(&d)
    h.outer.write(&d)
    h.outer.sum(dst)
}

// sha256 calcula o HMAC-SHA256 de data com a chave, de uma vez, em dst
// (SIZE bytes).
pub fn sha256(key &[]byte, data &[]byte, dst &[]byte) {
    h := new(key)
    h.write(data)
    h.sum(dst)
}

// verify diz se mac é o HMAC-SHA256 de data com a chave, comparando em
// tempo constante.
pub fn verify(key &[]byte, data &[]byte, mac &[]byte) bool {
    var want [32]byte
    sha256(key, data, &want)
    return equal(&want, mac)
}

// equal compara a e b em tempo constante: o tempo depende só do tamanho,
// não de onde está a primeira diferença. Use para comparar assinaturas,
// tokens e hashes de senha.
pub fn equal(a &[]byte, b &[]byte) bool {
    if len(a) != len(b) {
        return false
    }
    var diff byte = 0
    for i := 0; i < len(a); i++ {
        diff |= a[i] ^ b[i]
    }
    return diff == 0
}

// ---------- PBKDF2 ----------

// pbkdf2 deriva uma chave de uma senha (PBKDF2-HMAC-SHA256, RFC 8018): o
// HMAC repetido iterations vezes sobre a senha e o sal, para que testar
// cada palpite de senha custe caro. dst recebe len(dst) bytes de chave.
// Para guardar senhas de usuários, use std/password, que escolhe o sal e o
// número de iterações e confere em tempo constante.
pub fn pbkdf2(password &[]byte, salt &[]byte, iterations int, dst &[]byte) {
    if iterations < 1 {
        fail("hmac.pbkdf2: iterations precisa ser pelo menos 1")
    }
    keyed := new(password) // o HMAC já com a chave: copiado a cada passo
    block := 1
    done := 0
    for done < len(dst) {
        // U1 = HMAC(senha, sal || número do bloco, em big-endian)
        h := keyed
        h.write(salt)
        var idx [4]byte
        idx[0] = byte((block >> 24) & 0xFF)
        idx[1] = byte((block >> 16) & 0xFF)
        idx[2] = byte((block >> 8) & 0xFF)
        idx[3] = byte(block & 0xFF)
        h.write(&idx)
        var u [32]byte
        h.sum(&u)
        var t [32]byte
        for i := 0; i < 32; i++ {
            t[i] = u[i]
        }
        // U2..Uc, cada um o HMAC do anterior, somados (xor) em t
        for k := 1; k < iterations; k++ {
            h2 := keyed
            h2.write(&u)
            h2.sum(&u)
            for i := 0; i < 32; i++ {
                t[i] ^= u[i]
            }
        }
        for i := 0; i < 32 && done < len(dst); i++ {
            dst[done] = t[i]
            done++
        }
        block++
    }
}

extern fn fail(msg string)
