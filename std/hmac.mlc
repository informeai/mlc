// HMAC-SHA256 (RFC 2104): the signature of a message with a secret
// key. It's what checks a webhook (Stripe, GitHub), signs a token
// (JWT with HS256) or a session cookie. Nothing allocates: the state is two
// SHA-256s on the caller's stack.
//
//     var mac [32]byte
//     hmac.sha256(&key, &body, &mac)
//     ...
//     if !hmac.verify(&key, &body, &received) {
//         // wrong signature: refuse
//     }
//
// To check a signature, use verify (or equal): an ordinary comparison
// stops at the first different byte, and the time it takes tells an
// attacker how many bytes they already got right.
import "std/hash"

// SIZE is the size of an HMAC-SHA256, in bytes.
pub const SIZE = 32

// Hmac computes an HMAC-SHA256 with data delivered in pieces.
pub struct Hmac {
    inner hash.Sha256
    outer hash.Sha256
}

// new starts an HMAC with the key (of any size; a key longer than
// 64 bytes is replaced by its SHA-256, as the RFC says).
pub fn new(key &[]byte) Hmac {
    var k [64]byte
    if len(key) > 64 {
        hash.sha256_sum(key, &k[:32])
    } else {
        for i := 0; i < len(key); i++ {
            k[i] = key[i]
        }
    }
    var ipad [64]byte
    var opad [64]byte
    for i := 0; i < 64; i++ {
        ipad[i] = k[i] ^ 0x36
        opad[i] = k[i] ^ 0x5C
    }
    h := Hmac{inner: hash.sha256(), outer: hash.sha256()}
    h.inner.write(&ipad)
    h.outer.write(&opad)
    return h
}

// write appends the bytes of data to the message.
pub fn (h &Hmac) write(data &[]byte) {
    h.inner.write(data)
}

// sum writes the HMAC (SIZE bytes) into dst. After sum, the Hmac is no longer
// usable: start another one with new.
pub fn (h &Hmac) sum(dst &[]byte) {
    var d [32]byte
    h.inner.sum(&d)
    h.outer.write(&d)
    h.outer.sum(dst)
}

// sha256 computes the HMAC-SHA256 of data with the key, in one go, into dst
// (SIZE bytes).
pub fn sha256(key &[]byte, data &[]byte, dst &[]byte) {
    h := new(key)
    h.write(data)
    h.sum(dst)
}

// verify says whether mac is the HMAC-SHA256 of data with the key, comparing in
// constant time.
pub fn verify(key &[]byte, data &[]byte, mac &[]byte) bool {
    var want [32]byte
    sha256(key, data, &want)
    return equal(&want, mac)
}

// equal compares a and b in constant time: the time depends only on the length,
// not on where the first difference is. Use it to compare signatures,
// tokens and password hashes.
pub fn equal(a &[]byte, b &[]byte) bool {
    if len(a) != len(b) {
        return false
    }
    var diff byte = 0
    for i := 0; i < len(a); i++ {
        diff |= a[i] ^ b[i]
    }
    return diff == 0
}

// ---------- PBKDF2 ----------

// pbkdf2 derives a key from a password (PBKDF2-HMAC-SHA256, RFC 8018): the
// HMAC repeated iterations times over the password and the salt, so that testing
// each password guess is expensive. dst receives len(dst) bytes of key.
// To store user passwords, use std/password, which picks the salt and the
// number of iterations and checks in constant time.
pub fn pbkdf2(password &[]byte, salt &[]byte, iterations int, dst &[]byte) {
    if iterations < 1 {
        fail("hmac.pbkdf2: iterations precisa ser pelo menos 1")
    }
    keyed := new(password) // the HMAC already keyed: copied at each step
    block := 1
    done := 0
    for done < len(dst) {
        // U1 = HMAC(password, salt || block number, big-endian)
        h := keyed
        h.write(salt)
        var idx [4]byte
        idx[0] = byte((block >> 24) & 0xFF)
        idx[1] = byte((block >> 16) & 0xFF)
        idx[2] = byte((block >> 8) & 0xFF)
        idx[3] = byte(block & 0xFF)
        h.write(&idx)
        var u [32]byte
        h.sum(&u)
        var t [32]byte
        for i := 0; i < 32; i++ {
            t[i] = u[i]
        }
        // U2..Uc, each the HMAC of the previous one, combined (xor) into t
        for k := 1; k < iterations; k++ {
            h2 := keyed
            h2.write(&u)
            h2.sum(&u)
            for i := 0; i < 32; i++ {
                t[i] ^= u[i]
            }
        }
        for i := 0; i < 32 && done < len(dst); i++ {
            dst[done] = t[i]
            done++
        }
        block++
    }
}

extern fn fail(msg string)
