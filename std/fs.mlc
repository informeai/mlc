// Arquivos e diretórios. O conteúdo é lido e escrito em buffers de quem
// chama: para ler um arquivo inteiro, pergunte o tamanho (file_size) e aloque
// o buffer; para arquivos grandes, abra com open e leia em pedaços.
// Os caminhos são []byte (por exemplo, vindos de os.arg); para um literal,
// copie-o antes com str.copy.
import "std/io"
import "std/os"
import "std/rand"
import "std/result"
import "std/str"

// códigos de erro (os números são os do sistema, errno, menos os que mudam
// entre sistemas, que ganham um número do MLC)
pub const NOT_FOUND = 2    // ENOENT
pub const DENIED = 13      // EACCES
pub const EXISTS = 17      // EEXIST
pub const NOT_DIR = 20     // ENOTDIR
pub const IS_DIR = 21      // EISDIR
pub const TOO_BIG = 1000   // o arquivo não cabe no buffer
pub const NOT_EMPTY = 1001 // o diretório não está vazio

// modos de open
pub const READ = 0       // só leitura
pub const WRITE = 1      // cria ou esvazia, e escreve
pub const APPEND = 2     // cria se preciso, e escreve no fim
pub const READ_WRITE = 3 // cria se preciso, lê e escreve (sem esvaziar)

extern fn size_raw(path &[]byte) int
extern fn read_raw(path &[]byte, dst &[]byte) int
extern fn write_raw(path &[]byte, data &[]byte, append bool) int
extern fn remove_raw(path &[]byte) int

// exists diz se há um arquivo ou diretório em path.
pub extern fn exists(path &[]byte) bool

// file_size devolve o tamanho do arquivo em bytes.
pub fn file_size(path &[]byte) result.Result[int, int] {
    return wrap(size_raw(path))
}

// read_file lê o arquivo inteiro para o começo de dst e devolve o tamanho.
// Se o arquivo for maior que dst, nada é lido e o erro é TOO_BIG.
pub fn read_file(path &[]byte, dst &[]byte) result.Result[int, int] {
    return wrap(read_raw(path, dst))
}

// write_file cria (ou substitui) o arquivo com o conteúdo de data.
pub fn write_file(path &[]byte, data &[]byte) result.Result[int, int] {
    return wrap(write_raw(path, data, false))
}

// append_file acrescenta data ao fim do arquivo (criando-o, se preciso).
pub fn append_file(path &[]byte, data &[]byte) result.Result[int, int] {
    return wrap(write_raw(path, data, true))
}

// remove_file apaga o arquivo.
pub fn remove_file(path &[]byte) result.Result[int, int] {
    return wrap(remove_raw(path))
}

fn wrap(n int) result.Result[int, int] {
    if n < 0 {
        return result.Result.Err(-n)
    }
    return result.Result.Ok(n)
}

// ---------- arquivos abertos ----------

// File é um arquivo aberto (um handle): precisa de close().
//
//     err := 0
//     f := fs.open(&path, fs.READ, &err)
//     if f == nil { ... err tem o código ... }
//     var buf [4096]byte
//     for {
//         match f.read(&buf) {
//             Ok(n) => { if n == 0 { break }  ... &buf[:n] ... }
//             Err(code) => break
//         }
//     }
//     f.close()
pub extern "C" type File

// open abre o arquivo no modo dado (READ, WRITE, APPEND, READ_WRITE). Se não
// conseguir, devolve nil e põe o código de erro em err.
pub extern fn open(path &[]byte, mode int, err &int) ?*File

extern fn file_read(f &File, dst &[]byte) int
extern fn file_write(f &File, data &[]byte) int
extern fn file_seek(f &File, pos int) int
extern fn file_close(f *File)

// read lê até len(dst) bytes no começo de dst; Ok(0) é o fim do arquivo.
pub fn (f &File) read(dst &[]byte) result.Result[int, int] {
    return wrap(file_read(f, dst))
}

// write escreve todos os bytes de data.
pub fn (f &File) write(data &[]byte) result.Result[int, int] {
    return wrap(file_write(f, data))
}

// seek vai para a posição pos (em bytes, do começo); com pos negativo, vai
// para o fim. Devolve a posição nova.
pub fn (f &File) seek(pos int) result.Result[int, int] {
    return wrap(file_seek(f, pos))
}

// close fecha o arquivo.
pub fn (f *File) close() {
    file_close(f)
}

// um arquivo aberto é um io.Reader: std/bufio lê linhas dele
impl io.Reader for File

// ---------- diretórios ----------

// Dir é um diretório aberto (um handle): precisa de close().
//
//     d := fs.open_dir(&path, &err)
//     var name [256]byte
//     for {
//         n := d.next(&name)
//         if n < 0 { break }
//         ... &name[:n] ...
//     }
//     d.close()
pub extern "C" type Dir

// open_dir abre o diretório para listar. Se não conseguir, devolve nil e
// põe o código de erro em err.
pub extern fn open_dir(path &[]byte, err &int) ?*Dir

extern fn dir_next(d &Dir, dst &[]byte) int
extern fn dir_close(d *Dir)

// next copia o próximo nome (sem . e ..) para name e devolve o tamanho, ou
// -1 quando acabam. A ordem é a do sistema. Um [256]byte sempre basta.
pub fn (d &Dir) next(name &[]byte) int {
    return dir_next(d, name)
}

// close fecha o diretório aberto com open_dir.
pub fn (d *Dir) close() {
    dir_close(d)
}

// ---------- informações e operações ----------

// Info descreve um arquivo ou diretório.
pub struct Info {
    size int
    is_dir bool
    modified_ms int // data de modificação, em milissegundos desde 1970
    is_link bool    // link simbólico (preenchido por walk e glob)
}

extern fn stat_raw(path &[]byte, size &int, is_dir &bool, modified &int) int
extern fn mkdir_raw(path &[]byte) int
extern fn remove_dir_raw(path &[]byte) int
extern fn rename_raw(from &[]byte, to &[]byte) int

// stat preenche info com os dados do caminho.
pub fn stat(path &[]byte, info &Info) result.Result[int, int] {
    return wrap(stat_raw(path, &info.size, &info.is_dir, &info.modified_ms))
}

// mkdir cria o diretório (o pai precisa existir).
pub fn mkdir(path &[]byte) result.Result[int, int] {
    return wrap(mkdir_raw(path))
}

// remove_dir apaga o diretório, que precisa estar vazio (senão, NOT_EMPTY).
pub fn remove_dir(path &[]byte) result.Result[int, int] {
    return wrap(remove_dir_raw(path))
}

// rename muda o nome (ou o lugar) de um arquivo ou diretório.
pub fn rename(from &[]byte, to &[]byte) result.Result[int, int] {
    return wrap(rename_raw(from, to))
}

// ---------- árvores de diretórios ----------

// TOO_DEEP: diretórios aninhados demais (mais de MAX_DEPTH níveis).
pub const TOO_DEEP = 1004

// MAX_DEPTH é quantos níveis walk, glob e remove_all descem.
pub const MAX_DEPTH = 64

// o que a função de walk devolve
pub const CONTINUE = 0 // segue (e entra no diretório)
pub const SKIP = 1     // não entra neste diretório
pub const STOP = 2     // para tudo

// is_link diz se path é um link simbólico.
pub extern fn is_link(path &[]byte) bool

// walk visita root e tudo dentro dele, em profundidade: visit recebe o
// caminho (root/sub/arquivo) e as informações de cada um, e devolve
// CONTINUE, SKIP (não entra num diretório) ou STOP. Links simbólicos são
// visitados mas não seguidos (um link para um diretório não é percorrido:
// nada de ciclos). A ordem dentro de um diretório é a do sistema. O estado
// vai em ctx, como nos callbacks da biblioteca:
//
//     struct Total {
//         bytes int
//     }
//     fn soma(t &Total, path &[]byte, info &fs.Info) int {
//         if !info.is_dir {
//             t.bytes += info.size
//         }
//         return fs.CONTINUE
//     }
//     var t Total
//     fs.walk(&dir, &t, soma)
//
// Devolve Ok(0), ou Err com o código do primeiro erro (fs.NOT_FOUND,
// DENIED, TOO_DEEP...).
pub fn walk[C any](root &[]byte, ctx &C, visit fn(&C, &[]byte, &Info) int) result.Result[int, int] {
    var p [4096]byte
    if len(root) > len(p) {
        return result.Result.Err(TOO_BIG)
    }
    n := str.copy_bytes(&p, root)
    var info Info
    match stat(&p[:n], &info) {
        Ok(_) => {}
        Err(code) => return result.Result.Err(code)
    }
    info.is_link = is_link(&p[:n])
    action := visit(ctx, &p[:n], &info)
    if action != CONTINUE || !info.is_dir || info.is_link {
        return result.Result.Ok(0)
    }
    var none [1]byte
    r := walk_dir(&p, n, 0, &none[:0], ctx, visit)
    if r > 0 {
        return result.Result.Err(r)
    }
    return result.Result.Ok(0)
}

// glob visita os arquivos e diretórios dentro de root cujo caminho, a
// partir de root, casa com pattern (veja glob_match): "*.json",
// "src/**/*.mlc", "dados/202?-*.csv". visit é como em walk.
pub fn glob[C any](root &[]byte, pattern string, ctx &C, visit fn(&C, &[]byte, &Info) int) result.Result[int, int] {
    var p [4096]byte
    if len(root) > len(p) {
        return result.Result.Err(TOO_BIG)
    }
    var pat [1024]byte
    if len(pattern) > len(pat) {
        return result.Result.Err(TOO_BIG)
    }
    k := str.copy(&pat, pattern)
    n := str.copy_bytes(&p, root)
    r := walk_dir(&p, n, 0, &pat[:k], ctx, visit)
    if r > 0 {
        return result.Result.Err(r)
    }
    return result.Result.Ok(0)
}

// walk_dir visita o que está dentro de p[:n]. Com pattern, só visita quem
// casa (o caminho relativo a p[:root]) mas entra em todos os diretórios.
// Devolve 0, -1 (STOP) ou o código de um erro.
fn walk_dir[C any](p &[]byte, n int, depth int, pattern &[]byte, ctx &C, visit fn(&C, &[]byte, &Info) int) int {
    return walk_rec(p, n, n, depth, pattern, ctx, visit)
}

fn walk_rec[C any](p &[]byte, root int, n int, depth int, pattern &[]byte, ctx &C, visit fn(&C, &[]byte, &Info) int) int {
    if depth >= MAX_DEPTH {
        return TOO_DEEP
    }
    err := 0
    d := open_dir(&p[:n], &err)
    if d == nil {
        return err
    }
    var name [256]byte
    outcome := 0
    for {
        k := d.next(&name)
        if k < 0 {
            break
        }
        m := n
        if m > 0 && p[m - 1] != '/' {
            p[m] = '/'
            m++
        }
        if m + k > len(p) {
            outcome = TOO_BIG
            break
        }
        for i := 0; i < k; i++ {
            p[m + i] = name[i]
        }
        end := m + k
        var info Info
        match stat(&p[:end], &info) {
            Ok(_) => {}
            Err(_) => {
                // um link quebrado: visitado como arquivo de tamanho zero
                info = Info{}
            }
        }
        info.is_link = is_link(&p[:end])
        action := CONTINUE
        rel := root
        if rel < end && p[rel] == '/' {
            rel++
        }
        if len(pattern) == 0 || glob_match_bytes(pattern, &p[rel:end]) {
            action = visit(ctx, &p[:end], &info)
        }
        if action == STOP {
            outcome = -1
            break
        }
        if action == CONTINUE && info.is_dir && !info.is_link {
            r := walk_rec(p, root, end, depth + 1, pattern, ctx, visit)
            if r != 0 {
                outcome = r
                break
            }
        }
    }
    d.close()
    return outcome
}

// glob_match diz se path casa com pattern: * casa com qualquer texto sem
// /, ? com um caractere, [abc], [a-z] e [!abc] com um caractere da classe
// (ou fora dela), ** com qualquer texto, inclusive / (e **/ com zero ou mais
// diretórios). O resto casa consigo mesmo.
pub fn glob_match(pattern string, path &[]byte) bool {
    var pat [1024]byte
    if len(pattern) > len(pat) {
        return false
    }
    k := str.copy(&pat, pattern)
    return glob_match_bytes(&pat[:k], path)
}

// glob_match_bytes é glob_match com o padrão montado em tempo de execução.
pub fn glob_match_bytes(pattern &[]byte, path &[]byte) bool {
    return gmatch(pattern, 0, path, 0)
}

fn gmatch(p &[]byte, pi int, s &[]byte, si int) bool {
    for pi < len(p) {
        c := p[pi]
        if c == '*' {
            if pi + 1 < len(p) && p[pi + 1] == '*' {
                // **: qualquer coisa, inclusive /; **/ também casa com nada
                rest := pi + 2
                if rest < len(p) && p[rest] == '/' {
                    if gmatch(p, rest + 1, s, si) {
                        return true
                    }
                }
                for k := si; k <= len(s); k++ {
                    if gmatch(p, rest, s, k) {
                        return true
                    }
                }
                return false
            }
            for k := si; k <= len(s); k++ {
                if gmatch(p, pi + 1, s, k) {
                    return true
                }
                if k < len(s) && s[k] == '/' {
                    return false // * não passa de um diretório
                }
            }
            return false
        }
        if si == len(s) {
            return false
        }
        if c == '?' {
            if s[si] == '/' {
                return false
            }
            pi++
            si++
            continue
        }
        if c == '[' {
            end := pi + 1
            if end < len(p) && (p[end] == '!' || p[end] == '^') {
                end++
            }
            if end < len(p) && p[end] == ']' {
                end++ // ] logo no começo é um caractere
            }
            for end < len(p) && p[end] != ']' {
                end++
            }
            if end == len(p) {
                // sem ]: o [ é um caractere comum
                if s[si] != '[' {
                    return false
                }
                pi++
                si++
                continue
            }
            if !in_class(p, pi + 1, end, s[si]) {
                return false
            }
            pi = end + 1
            si++
            continue
        }
        if c != s[si] {
            return false
        }
        pi++
        si++
    }
    return si == len(s)
}

// in_class diz se ch está na classe p[from:to] (sem os colchetes).
fn in_class(p &[]byte, from int, to int, ch byte) bool {
    neg := false
    i := from
    if i < to && (p[i] == '!' || p[i] == '^') {
        neg = true
        i++
    }
    hit := false
    first := true
    for i < to {
        lo := p[i]
        hi := lo
        if i + 2 < to && p[i + 1] == '-' {
            hi = p[i + 2]
            i += 3
        } else {
            i++
        }
        if ch >= lo && ch <= hi && (lo != ']' || first || hi != ']') {
            hit = true
        }
        first = false
    }
    return hit != neg
}

// mkdir_all cria o diretório e os pais que faltarem (como mkdir -p). Um
// diretório que já existe não é erro.
pub fn mkdir_all(path &[]byte) result.Result[int, int] {
    var p [4096]byte
    if len(path) > len(p) {
        return result.Result.Err(TOO_BIG)
    }
    n := str.copy_bytes(&p, path)
    for i := 1; i <= n; i++ {
        if i < n && p[i] != '/' {
            continue
        }
        var info Info
        match stat(&p[:i], &info) {
            Ok(_) => {
                if !info.is_dir {
                    return result.Result.Err(NOT_DIR)
                }
            }
            Err(_) => {
                match mkdir(&p[:i]) {
                    Ok(_) => {}
                    Err(code) => {
                        if code != EXISTS {
                            return result.Result.Err(code)
                        }
                    }
                }
            }
        }
    }
    return result.Result.Ok(0)
}

// remove_all apaga path e tudo dentro dele (como rm -r). Links simbólicos
// são apagados, não seguidos: o que eles apontam fica. Um caminho que não
// existe não é erro.
pub fn remove_all(path &[]byte) result.Result[int, int] {
    var p [4096]byte
    if len(path) > len(p) {
        return result.Result.Err(TOO_BIG)
    }
    n := str.copy_bytes(&p, path)
    var info Info
    match stat(&p[:n], &info) {
        Ok(_) => {}
        Err(code) => {
            if code == NOT_FOUND && !is_link(&p[:n]) {
                return result.Result.Ok(0)
            }
            info = Info{}
        }
    }
    if !info.is_dir || is_link(&p[:n]) {
        return remove_file(&p[:n])
    }
    r := remove_rec(&p, n, 0)
    if r != 0 {
        return result.Result.Err(r)
    }
    return result.Result.Ok(0)
}

fn remove_rec(p &[]byte, n int, depth int) int {
    if depth >= MAX_DEPTH {
        return TOO_DEEP
    }
    err := 0
    d := open_dir(&p[:n], &err)
    if d == nil {
        return err
    }
    var name [256]byte
    code := 0
    for code == 0 {
        k := d.next(&name)
        if k < 0 {
            break
        }
        m := n
        if p[m - 1] != '/' {
            p[m] = '/'
            m++
        }
        if m + k > len(p) {
            code = TOO_BIG
            break
        }
        for i := 0; i < k; i++ {
            p[m + i] = name[i]
        }
        end := m + k
        var info Info
        dir := false
        match stat(&p[:end], &info) {
            Ok(_) => dir = info.is_dir && !is_link(&p[:end])
            Err(_) => {}
        }
        if dir {
            code = remove_rec(p, end, depth + 1)
        } else {
            match remove_file(&p[:end]) {
                Ok(_) => {}
                Err(c) => code = c
            }
        }
    }
    d.close()
    if code != 0 {
        return code
    }
    match remove_dir(&p[:n]) {
        Ok(_) => return 0
        Err(c) => return c
    }
}

// temp_dir copia a pasta de arquivos temporários (TMPDIR, ou /tmp).
pub fn temp_dir(dst &[]byte) int {
    match os.getenv("TMPDIR", dst) {
        Ok(n) => {
            for n > 1 && dst[n - 1] == '/' {
                n--
            }
            if n > 0 {
                return n
            }
        }
        Err(_) => {}
    }
    return str.copy(dst, "/tmp")
}

// temp_path escreve em dst um caminho novo na pasta temporária: o prefixo
// seguido de 16 dígitos hex aleatórios (rand.secure), como
// /tmp/relatorio-3f9a0c1e5b7d2a64. Para criar o arquivo, use open com
// WRITE; para um diretório, mkdir.
pub fn temp_path(prefix string, dst &[]byte) int {
    n := temp_dir(dst)
    n += str.copy(&dst[n:], "/")
    n += str.copy(&dst[n:], prefix)
    var r [8]byte
    rand.secure(&r)
    digits := "0123456789abcdef"
    if n + 16 > len(dst) {
        fail("fs.temp_path: o destino é pequeno demais")
    }
    for i := 0; i < 8; i++ {
        dst[n] = digits[int(r[i] >> 4)]
        dst[n + 1] = digits[int(r[i] & 0x0F)]
        n += 2
    }
    return n
}

extern fn fail(msg string)
