// Files and directories. Content is read and written in the caller's
// buffers: to read a whole file, ask for its size (file_size) and allocate
// the buffer; for large files, open with open and read in pieces.
// Paths are []byte (for example, coming from os.arg); for a literal,
// copy it first with str.copy.
import "std/io"
import "std/os"
import "std/rand"
import "std/result"
import "std/str"

// error codes (the numbers are the system's, errno, except those that change
// between systems, which get an MLC number)
pub const NOT_FOUND = 2    // ENOENT
pub const DENIED = 13      // EACCES
pub const EXISTS = 17      // EEXIST
pub const NOT_DIR = 20     // ENOTDIR
pub const IS_DIR = 21      // EISDIR
pub const TOO_BIG = 1000   // the file doesn't fit in the buffer
pub const NOT_EMPTY = 1001 // the directory isn't empty

// open modes
pub const READ = 0       // read only
pub const WRITE = 1      // creates or truncates, and writes
pub const APPEND = 2     // creates if needed, and writes at the end
pub const READ_WRITE = 3 // creates if needed, reads and writes (without truncating)

extern fn size_raw(path &[]byte) int
extern fn read_raw(path &[]byte, dst &[]byte) int
extern fn write_raw(path &[]byte, data &[]byte, append bool) int
extern fn remove_raw(path &[]byte) int

// exists says whether there's a file or directory at path.
pub extern fn exists(path &[]byte) bool

// file_size returns the file's size in bytes.
pub fn file_size(path &[]byte) result.Result[int, int] {
    return wrap(size_raw(path))
}

// read_file reads the whole file into the start of dst and returns the size.
// If the file is larger than dst, nothing is read and the error is TOO_BIG.
pub fn read_file(path &[]byte, dst &[]byte) result.Result[int, int] {
    return wrap(read_raw(path, dst))
}

// write_file creates (or replaces) the file with the content of data.
pub fn write_file(path &[]byte, data &[]byte) result.Result[int, int] {
    return wrap(write_raw(path, data, false))
}

// append_file appends data at the end of the file (creating it, if needed).
pub fn append_file(path &[]byte, data &[]byte) result.Result[int, int] {
    return wrap(write_raw(path, data, true))
}

// remove_file deletes the file.
pub fn remove_file(path &[]byte) result.Result[int, int] {
    return wrap(remove_raw(path))
}

fn wrap(n int) result.Result[int, int] {
    if n < 0 {
        return result.Result.Err(-n)
    }
    return result.Result.Ok(n)
}

// ---------- open files ----------

// File is an open file (a handle): it needs a close().
//
//     err := 0
//     f := fs.open(&path, fs.READ, &err)
//     if f == nil { ... err has the code ... }
//     var buf [4096]byte
//     for {
//         match f.read(&buf) {
//             Ok(n) => { if n == 0 { break }  ... &buf[:n] ... }
//             Err(code) => break
//         }
//     }
//     f.close()
pub extern "C" type File

// open opens the file in the given mode (READ, WRITE, APPEND, READ_WRITE). If it
// can't, returns nil and puts the error code in err.
pub extern fn open(path &[]byte, mode int, err &int) ?*File

extern fn file_read(f &File, dst &[]byte) int
extern fn file_write(f &File, data &[]byte) int
extern fn file_seek(f &File, pos int) int
extern fn file_close(f *File)

// read reads up to len(dst) bytes into the start of dst; Ok(0) is the end of the file.
pub fn (f &File) read(dst &[]byte) result.Result[int, int] {
    return wrap(file_read(f, dst))
}

// write writes all the bytes of data.
pub fn (f &File) write(data &[]byte) result.Result[int, int] {
    return wrap(file_write(f, data))
}

// seek goes to position pos (in bytes, from the start); with a negative pos, goes
// to the end. Returns the new position.
pub fn (f &File) seek(pos int) result.Result[int, int] {
    return wrap(file_seek(f, pos))
}

// close closes the file.
pub fn (f *File) close() {
    file_close(f)
}

// an open file is an io.Reader: std/bufio reads lines from it
impl io.Reader for File

// ---------- directories ----------

// Dir is an open directory (a handle): it needs a close().
//
//     d := fs.open_dir(&path, &err)
//     var name [256]byte
//     for {
//         n := d.next(&name)
//         if n < 0 { break }
//         ... &name[:n] ...
//     }
//     d.close()
pub extern "C" type Dir

// open_dir opens the directory for listing. If it can't, returns nil and
// puts the error code in err.
pub extern fn open_dir(path &[]byte, err &int) ?*Dir

extern fn dir_next(d &Dir, dst &[]byte) int
extern fn dir_close(d *Dir)

// next copies the next name (without . and ..) into name and returns the length, or
// -1 when they run out. The order is the system's. A [256]byte is always enough.
pub fn (d &Dir) next(name &[]byte) int {
    return dir_next(d, name)
}

// close closes the directory opened with open_dir.
pub fn (d *Dir) close() {
    dir_close(d)
}

// ---------- information and operations ----------

// Info describes a file or directory.
pub struct Info {
    size int
    is_dir bool
    modified_ms int // modification date, in milliseconds since 1970
    is_link bool    // symbolic link (filled by walk and glob)
}

extern fn stat_raw(path &[]byte, size &int, is_dir &bool, modified &int) int
extern fn mkdir_raw(path &[]byte) int
extern fn remove_dir_raw(path &[]byte) int
extern fn rename_raw(from &[]byte, to &[]byte) int

// stat fills info with the path's data.
pub fn stat(path &[]byte, info &Info) result.Result[int, int] {
    return wrap(stat_raw(path, &info.size, &info.is_dir, &info.modified_ms))
}

// mkdir creates the directory (the parent must exist).
pub fn mkdir(path &[]byte) result.Result[int, int] {
    return wrap(mkdir_raw(path))
}

// remove_dir deletes the directory, which must be empty (otherwise, NOT_EMPTY).
pub fn remove_dir(path &[]byte) result.Result[int, int] {
    return wrap(remove_dir_raw(path))
}

// rename changes the name (or the place) of a file or directory.
pub fn rename(from &[]byte, to &[]byte) result.Result[int, int] {
    return wrap(rename_raw(from, to))
}

// ---------- directory trees ----------

// TOO_DEEP: directories nested too deep (more than MAX_DEPTH levels).
pub const TOO_DEEP = 1004

// MAX_DEPTH is how many levels walk, glob and remove_all descend.
pub const MAX_DEPTH = 64

// what walk's function returns
pub const CONTINUE = 0 // continues (and enters the directory)
pub const SKIP = 1     // doesn't enter this directory
pub const STOP = 2     // stops everything

// is_link says whether path is a symbolic link.
pub extern fn is_link(path &[]byte) bool

// walk visits root and everything inside it, depth first: visit receives the
// path (root/sub/file) and the information of each one, and returns
// CONTINUE, SKIP (doesn't enter a directory) or STOP. Symbolic links are
// visited but not followed (a link to a directory isn't walked:
// no cycles). The order inside a directory is the system's. The state
// goes in ctx, as in the library's callbacks:
//
//     struct Total {
//         bytes int
//     }
//     fn add(t &Total, path &[]byte, info &fs.Info) int {
//         if !info.is_dir {
//             t.bytes += info.size
//         }
//         return fs.CONTINUE
//     }
//     var t Total
//     fs.walk(&dir, &t, add)
//
// Returns Ok(0), or Err with the code of the first error (fs.NOT_FOUND,
// DENIED, TOO_DEEP...).
pub fn walk[C any](root &[]byte, ctx &C, visit fn(&C, &[]byte, &Info) int) result.Result[int, int] {
    var p [4096]byte
    if len(root) > len(p) {
        return result.Result.Err(TOO_BIG)
    }
    n := str.copy_bytes(&p, root)
    var info Info
    match stat(&p[:n], &info) {
        Ok(_) => {}
        Err(code) => return result.Result.Err(code)
    }
    info.is_link = is_link(&p[:n])
    action := visit(ctx, &p[:n], &info)
    if action != CONTINUE || !info.is_dir || info.is_link {
        return result.Result.Ok(0)
    }
    var none [1]byte
    r := walk_dir(&p, n, 0, &none[:0], ctx, visit)
    if r > 0 {
        return result.Result.Err(r)
    }
    return result.Result.Ok(0)
}

// glob visits the files and directories inside root whose path, from
// root, matches pattern (see glob_match): "*.json",
// "src/**/*.mlc", "data/202?-*.csv". visit is as in walk.
pub fn glob[C any](root &[]byte, pattern string, ctx &C, visit fn(&C, &[]byte, &Info) int) result.Result[int, int] {
    var p [4096]byte
    if len(root) > len(p) {
        return result.Result.Err(TOO_BIG)
    }
    var pat [1024]byte
    if len(pattern) > len(pat) {
        return result.Result.Err(TOO_BIG)
    }
    k := str.copy(&pat, pattern)
    n := str.copy_bytes(&p, root)
    r := walk_dir(&p, n, 0, &pat[:k], ctx, visit)
    if r > 0 {
        return result.Result.Err(r)
    }
    return result.Result.Ok(0)
}

// walk_dir visits what's inside p[:n]. With pattern, it only visits what
// matches (the path relative to p[:root]) but enters every directory.
// Returns 0, -1 (STOP) or an error code.
fn walk_dir[C any](p &[]byte, n int, depth int, pattern &[]byte, ctx &C, visit fn(&C, &[]byte, &Info) int) int {
    return walk_rec(p, n, n, depth, pattern, ctx, visit)
}

fn walk_rec[C any](p &[]byte, root int, n int, depth int, pattern &[]byte, ctx &C, visit fn(&C, &[]byte, &Info) int) int {
    if depth >= MAX_DEPTH {
        return TOO_DEEP
    }
    err := 0
    d := open_dir(&p[:n], &err)
    if d == nil {
        return err
    }
    var name [256]byte
    outcome := 0
    for {
        k := d.next(&name)
        if k < 0 {
            break
        }
        m := n
        if m > 0 && p[m - 1] != '/' {
            p[m] = '/'
            m++
        }
        if m + k > len(p) {
            outcome = TOO_BIG
            break
        }
        for i := 0; i < k; i++ {
            p[m + i] = name[i]
        }
        end := m + k
        var info Info
        match stat(&p[:end], &info) {
            Ok(_) => {}
            Err(_) => {
                // a broken link: visited as a zero-size file
                info = Info{}
            }
        }
        info.is_link = is_link(&p[:end])
        action := CONTINUE
        rel := root
        if rel < end && p[rel] == '/' {
            rel++
        }
        if len(pattern) == 0 || glob_match_bytes(pattern, &p[rel:end]) {
            action = visit(ctx, &p[:end], &info)
        }
        if action == STOP {
            outcome = -1
            break
        }
        if action == CONTINUE && info.is_dir && !info.is_link {
            r := walk_rec(p, root, end, depth + 1, pattern, ctx, visit)
            if r != 0 {
                outcome = r
                break
            }
        }
    }
    d.close()
    return outcome
}

// glob_match says whether path matches pattern: * matches any text without
// /, ? one character, [abc], [a-z] and [!abc] one character in the class
// (or outside it), ** any text, including / (and **/ zero or more
// directories). The rest matches itself.
pub fn glob_match(pattern string, path &[]byte) bool {
    var pat [1024]byte
    if len(pattern) > len(pat) {
        return false
    }
    k := str.copy(&pat, pattern)
    return glob_match_bytes(&pat[:k], path)
}

// glob_match_bytes is glob_match with the pattern built at run time.
pub fn glob_match_bytes(pattern &[]byte, path &[]byte) bool {
    return gmatch(pattern, 0, path, 0)
}

fn gmatch(p &[]byte, pi int, s &[]byte, si int) bool {
    for pi < len(p) {
        c := p[pi]
        if c == '*' {
            if pi + 1 < len(p) && p[pi + 1] == '*' {
                // **: anything, including /; **/ also matches nothing
                rest := pi + 2
                if rest < len(p) && p[rest] == '/' {
                    if gmatch(p, rest + 1, s, si) {
                        return true
                    }
                }
                for k := si; k <= len(s); k++ {
                    if gmatch(p, rest, s, k) {
                        return true
                    }
                }
                return false
            }
            for k := si; k <= len(s); k++ {
                if gmatch(p, pi + 1, s, k) {
                    return true
                }
                if k < len(s) && s[k] == '/' {
                    return false // * doesn't go past a directory
                }
            }
            return false
        }
        if si == len(s) {
            return false
        }
        if c == '?' {
            if s[si] == '/' {
                return false
            }
            pi++
            si++
            continue
        }
        if c == '[' {
            end := pi + 1
            if end < len(p) && (p[end] == '!' || p[end] == '^') {
                end++
            }
            if end < len(p) && p[end] == ']' {
                end++ // ] right at the start is a character
            }
            for end < len(p) && p[end] != ']' {
                end++
            }
            if end == len(p) {
                // no ]: the [ is an ordinary character
                if s[si] != '[' {
                    return false
                }
                pi++
                si++
                continue
            }
            if !in_class(p, pi + 1, end, s[si]) {
                return false
            }
            pi = end + 1
            si++
            continue
        }
        if c != s[si] {
            return false
        }
        pi++
        si++
    }
    return si == len(s)
}

// in_class says whether ch is in the class p[from:to] (without the brackets).
fn in_class(p &[]byte, from int, to int, ch byte) bool {
    neg := false
    i := from
    if i < to && (p[i] == '!' || p[i] == '^') {
        neg = true
        i++
    }
    hit := false
    first := true
    for i < to {
        lo := p[i]
        hi := lo
        if i + 2 < to && p[i + 1] == '-' {
            hi = p[i + 2]
            i += 3
        } else {
            i++
        }
        if ch >= lo && ch <= hi && (lo != ']' || first || hi != ']') {
            hit = true
        }
        first = false
    }
    return hit != neg
}

// mkdir_all creates the directory and the missing parents (like mkdir -p). A
// directory that already exists isn't an error.
pub fn mkdir_all(path &[]byte) result.Result[int, int] {
    var p [4096]byte
    if len(path) > len(p) {
        return result.Result.Err(TOO_BIG)
    }
    n := str.copy_bytes(&p, path)
    for i := 1; i <= n; i++ {
        if i < n && p[i] != '/' {
            continue
        }
        var info Info
        match stat(&p[:i], &info) {
            Ok(_) => {
                if !info.is_dir {
                    return result.Result.Err(NOT_DIR)
                }
            }
            Err(_) => {
                match mkdir(&p[:i]) {
                    Ok(_) => {}
                    Err(code) => {
                        if code != EXISTS {
                            return result.Result.Err(code)
                        }
                    }
                }
            }
        }
    }
    return result.Result.Ok(0)
}

// remove_all deletes path and everything inside it (like rm -r). Symbolic links
// are deleted, not followed: what they point to stays. A path that doesn't
// exist isn't an error.
pub fn remove_all(path &[]byte) result.Result[int, int] {
    var p [4096]byte
    if len(path) > len(p) {
        return result.Result.Err(TOO_BIG)
    }
    n := str.copy_bytes(&p, path)
    var info Info
    match stat(&p[:n], &info) {
        Ok(_) => {}
        Err(code) => {
            if code == NOT_FOUND && !is_link(&p[:n]) {
                return result.Result.Ok(0)
            }
            info = Info{}
        }
    }
    if !info.is_dir || is_link(&p[:n]) {
        return remove_file(&p[:n])
    }
    r := remove_rec(&p, n, 0)
    if r != 0 {
        return result.Result.Err(r)
    }
    return result.Result.Ok(0)
}

fn remove_rec(p &[]byte, n int, depth int) int {
    if depth >= MAX_DEPTH {
        return TOO_DEEP
    }
    err := 0
    d := open_dir(&p[:n], &err)
    if d == nil {
        return err
    }
    var name [256]byte
    code := 0
    for code == 0 {
        k := d.next(&name)
        if k < 0 {
            break
        }
        m := n
        if p[m - 1] != '/' {
            p[m] = '/'
            m++
        }
        if m + k > len(p) {
            code = TOO_BIG
            break
        }
        for i := 0; i < k; i++ {
            p[m + i] = name[i]
        }
        end := m + k
        var info Info
        dir := false
        match stat(&p[:end], &info) {
            Ok(_) => dir = info.is_dir && !is_link(&p[:end])
            Err(_) => {}
        }
        if dir {
            code = remove_rec(p, end, depth + 1)
        } else {
            match remove_file(&p[:end]) {
                Ok(_) => {}
                Err(c) => code = c
            }
        }
    }
    d.close()
    if code != 0 {
        return code
    }
    match remove_dir(&p[:n]) {
        Ok(_) => return 0
        Err(c) => return c
    }
}

// temp_dir copies the temporary files folder (TMPDIR, or /tmp).
pub fn temp_dir(dst &[]byte) int {
    match os.getenv("TMPDIR", dst) {
        Ok(n) => {
            for n > 1 && dst[n - 1] == '/' {
                n--
            }
            if n > 0 {
                return n
            }
        }
        Err(_) => {}
    }
    return str.copy(dst, "/tmp")
}

// temp_path writes into dst a new path in the temporary folder: the prefix
// followed by 16 random hex digits (rand.secure), like
// /tmp/report-3f9a0c1e5b7d2a64. To create the file, use open with
// WRITE; for a directory, mkdir.
pub fn temp_path(prefix string, dst &[]byte) int {
    n := temp_dir(dst)
    n += str.copy(&dst[n:], "/")
    n += str.copy(&dst[n:], prefix)
    var r [8]byte
    rand.secure(&r)
    digits := "0123456789abcdef"
    if n + 16 > len(dst) {
        fail("fs.temp_path: o destino é pequeno demais")
    }
    for i := 0; i < 8; i++ {
        dst[n] = digits[int(r[i] >> 4)]
        dst[n + 1] = digits[int(r[i] & 0x0F)]
        n += 2
    }
    return n
}

extern fn fail(msg string)
