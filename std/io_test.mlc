// io's formatting (Writer, Display, specs) tested through
// str.format, which writes into a buffer through the same Writer as io.printf.
import "std/io"
import "std/str"
import "std/testing"

struct Point {
    x int
    y int
}

impl auto io.Display for Point

enum Shape {
    Circle(r float64)
    Empty
}

impl auto io.Display for Shape

fn test_display_builtin() {
    b := alloc([]byte, 128)
    n := str.format(&b, "{} {} {} {} {}", -7, 2.5, true, "oi", byte(65))
    testing.eq_str(&b[:n], "-7 2.5 true oi 65")
    n = str.format(&b, "{} {}", -9223372036854775807 - 1, uint64(18446744073709551615))
    testing.eq_str(&b[:n], "-9223372036854775808 18446744073709551615")
    n = str.format(&b, "{} {}", float32(0.1), 1e21)
    testing.eq_str(&b[:n], "0.1 1e+21")
    free(b)
}

fn test_display_composite() {
    b := alloc([]byte, 128)
    a := [3]int{1, 2, 3}
    n := str.format(&b, "{} {} {} {}", Point{x: 1, y: -2}, Shape.Circle(1.5), Shape.Empty, a)
    testing.eq_str(&b[:n], "{1 -2} Circle(1.5) Empty [1 2 3]")
    free(b)
}

fn test_bases() {
    b := alloc([]byte, 128)
    n := str.format(&b, "{:x} {:X} {:b} {:o} {:x}", 255, 255, 5, 8, -255)
    testing.eq_str(&b[:n], "ff FF 101 10 -ff")
    n = str.format(&b, "{:#x} {:#b} {:#o} {:#010x}", 255, 5, 8, 255)
    testing.eq_str(&b[:n], "0xff 0b101 0o10 0x000000ff")
    n = str.format(&b, "{:x} {:x}", uint64(18446744073709551615), -9223372036854775807 - 1)
    testing.eq_str(&b[:n], "ffffffffffffffff -8000000000000000")
    n = str.format(&b, "{:08b} {:02x}", byte(5), byte(10))
    testing.eq_str(&b[:n], "00000101 0a")
    free(b)
}

fn test_width_and_align() {
    b := alloc([]byte, 128)
    n := str.format(&b, "[{:5}] [{:<5}] [{:^5}] [{:>5}]", 42, 42, 42, 42)
    testing.eq_str(&b[:n], "[   42] [42   ] [ 42  ] [   42]")
    n = str.format(&b, "[{:5}] [{:>5}] [{:^6}] [{:*^7}]", "ab", "ab", "ab", "ab")
    testing.eq_str(&b[:n], "[ab   ] [   ab] [  ab  ] [**ab***]")
    n = str.format(&b, "[{:2}] [{:-^9}]", 12345, Point{x: 1, y: 2})
    testing.eq_str(&b[:n], "[12345] [--{1 2}--]") // wider than the width: doesn't cut
    free(b)
}

fn test_zero_pad() {
    b := alloc([]byte, 64)
    n := str.format(&b, "{:05} {:05} {:03} {:08.2}", 42, -42, 12345, -3.14159)
    testing.eq_str(&b[:n], "00042 -0042 12345 -0003.14")
    free(b)
}

fn test_precision() {
    b := alloc([]byte, 64)
    n := str.format(&b, "{:.2} {:.0} {:.3} {:>8.1}", 3.14159, 2.5, float32(1.5), 9.96)
    testing.eq_str(&b[:n], "3.14 2 1.500     10.0")
    free(b)
}

fn test_text_spec() {
    name := alloc([]byte, 8)
    k := str.copy(&name, "Ana")
    b := alloc([]byte, 64)
    n := str.format(&b, "[{:s}] [{:>5s}] [{:.<6s}] {}", &name[:k], &name[:k], &name[:k], &name[:2])
    testing.eq_str(&b[:n], "[Ana] [  Ana] [Ana...] [65 110]")
    free(b)
    free(name)
}

fn test_borrowed_values() {
    x := 7
    r := &x
    b := alloc([]byte, 16)
    n := str.format(&b, "{} {:03}", r, r)
    testing.eq_str(&b[:n], "7 007")
    free(b)
}

fn test_braces() {
    b := alloc([]byte, 16)
    n := str.format(&b, "{{{}}}", 1)
    testing.eq_str(&b[:n], "{1}")
    free(b)
}

fn test_long_output_crosses_buffer() {
    // more than the Writer buffer's 256 bytes: goes through several flushes
    b := alloc([]byte, 600)
    n := str.format(&b, "{:>250}|{:<240}|", 1, 2)
    testing.eq_int(n, 492)
    testing.eq_int(int(b[248]), int(' '))
    testing.eq_int(int(b[249]), int('1'))
    testing.eq_int(int(b[251]), int('2'))
    testing.eq_int(int(b[491]), int('|'))
    testing.eq_int(str.format_len("{:>250}|{:<240}|", 1, 2), 492)
    free(b)
}

fn test_width_counts_characters() {
    b := alloc([]byte, 32)
    n := str.format(&b, "[{:6}] [{:>6}] [{:^7}]", "café", "pão", "ção")
    testing.eq_str(&b[:n], "[café  ] [   pão] [  ção  ]")
    free(b)
}

fn bench_format(b &testing.B) {
    var out [64]byte
    for i := 0; i < b.n; i++ {
        str.format(&out, "{} {:.2} {:>8} {:x}", i, 3.14159, "texto", 255)
    }
}

struct Price {
    cents int
}

// a write written with w.printf
fn (p &Price) write(w &io.Writer) {
    w.printf("R$ {}.{:02}", p.cents / 100, p.cents % 100)
}

impl io.Display for Price

fn test_writer_printf_inside_write() {
    b := alloc([]byte, 64)
    n := str.format(&b, "[{}] [{:>12}] [{:<11}] {:x}", Price{cents: 1205}, Price{cents: 99}, Price{cents: 100000}, 255)
    testing.eq_str(&b[:n], "[R$ 12.05] [     R$ 0.99] [R$ 1000.00 ] ff")
    free(b)
}

struct Pair {
    a int
    b int
}

// specs inside write, with the outer alignment around them
fn (p &Pair) write(w &io.Writer) {
    w.printf("<{:x}|{:04}>", p.a, p.b)
    w.put_int(p.a) // after w.printf, numbers go back to normal
}

impl io.Display for Pair

fn test_writer_printf_with_specs_inside() {
    b := alloc([]byte, 64)
    n := str.format(&b, "[{:>16}] [{}]", Pair{a: 255, b: 7}, Pair{a: 10, b: 12345})
    testing.eq_str(&b[:n], "[    <ff|0007>255] [<a|12345>10]")
    free(b)
}

fn test_fast_put_int_edges() {
    b := alloc([]byte, 128)
    n := str.format(&b, "{} {} {} {} {} {}", 0, 9, 10, 99, 100, -1)
    testing.eq_str(&b[:n], "0 9 10 99 100 -1")
    n = str.format(&b, "{} {}", 9223372036854775807, -9223372036854775807 - 1)
    testing.eq_str(&b[:n], "9223372036854775807 -9223372036854775808")
    n = str.format(&b, "{} {}", uint64(18446744073709551615), uint64(0))
    testing.eq_str(&b[:n], "18446744073709551615 0")
    n = str.format(&b, "{:>6} {:<5}|", -42, 7)
    testing.eq_str(&b[:n], "   -42 7    |")
    free(b)
}
