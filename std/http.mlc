// HTTP/1.1 over any Stream (net.Conn, tls.Conn, or a type of yours in tests):
// the server reads requests and writes responses, the client writes requests and reads
// responses. Nothing allocates: the received message (Message) keeps a fixed
// 8 KB buffer inside itself, holding the header and the start of the body, and
// the outgoing one (Builder) assembles the header in a 4 KB buffer. The body comes
// and goes through the caller's buffers.
//
// Server (one connection; the accept loop and the threads are up to the
// caller, see tests/run/http_servico.mlc):
//
//     var m http.Message
//     for {
//         match m.read_request(&c) {
//             Ok(_) => {}
//             Err(_) => break            // io.EOF: the client closed
//         }
//         if m.method_is("GET") && m.path_is("/health") {
//             http.respond_str(&c, 200, "text/plain", "ok\n")
//         } else {
//             http.respond_str(&c, 404, "text/plain", "not found\n")
//         }
//         if !m.keep_alive() {
//             break
//         }
//     }
//
// Client:
//
//     var b http.Builder
//     b.request("GET", "/api/items")
//     b.header("Host", "example.com")
//     b.send_str(&c, "")
//     var m http.Message
//     m.read_response(&c)                // m.status() is the code
//     match m.read_all(&c, &body) {
//         Ok(n) => ... &body[:n] ...
//         Err(code) => ...
//     }
//
// HTTPS comes from std/tls (tls.Conn, dial_tls), or from a proxy in front (nginx,
// Caddy, the cloud load balancer). Texts (method, path, headers) are
// copied into the caller's buffers, or compared without copying (method_is,
// path_is, header_is).
import "std/io"
import "std/net"
import "std/result"
import "std/str"
import "std/tls"
import "std/url"

// error codes (the source's, like net.TIMEOUT, arrive as they came)
pub const BAD_MESSAGE = 3001  // the message isn't valid HTTP/1.x
pub const HEAD_TOO_BIG = 3002 // the header doesn't fit in the 8 KB (or has more than 64 fields)
pub const TOO_BIG = 1000      // read_all: the body doesn't fit in dst

pub const MAX_HEADERS = 64

// Stream is what the message goes through: a connection.
pub interface Stream {
    fn read(self &Self, dst &[]byte) result.Result[int, int]
    fn write(self &Self, data &[]byte) result.Result[int, int]
}

impl Stream for net.Conn

impl Stream for tls.Conn

// ---------- received message ----------

struct Field {
    name_at int
    name_n int
    value_at int
    value_n int
}

// how the body ends
const BODY_NONE = 0
const BODY_LENGTH = 1
const BODY_CHUNKED = 2
const BODY_UNTIL_CLOSE = 3

// in a chunked body: what comes next
const CHUNK_SIZE = 0 // the line with the chunk's size
const CHUNK_DATA = 1 // the chunk's bytes (left)
const CHUNK_END = 2  // the \r\n after the bytes

// Message is a received request (on the server) or response (on the client).
// The zero value is ready to use; on a keep-alive connection, the same
// Message reads one request after another (the body that wasn't read is
// discarded).
pub struct Message {
    buf [8192]byte
    n int    // valid bytes in buf
    head int // end of the header (after the blank line); 0: nothing read
    pos int  // next body byte in buf
    request bool
    method_at int
    method_n int
    target_at int
    target_n int
    code int
    minor int // HTTP/1.minor
    fields [64]Field
    nfields int
    mode int
    left int // LENGTH: bytes left; CHUNKED: bytes left in the chunk
    chunk int
    done bool
    keep bool
    length int // Content-Length, or -1
}

// read_request reads a request's header. Err(io.EOF) when the connection
// closed before a request started (the normal end of a keep-alive).
pub fn (m &Message) read_request[S ref + Stream](c &S) result.Result[int, int] {
    return m.read_head(c, true)
}

// read_response reads a response's header.
pub fn (m &Message) read_response[S ref + Stream](c &S) result.Result[int, int] {
    return m.read_head(c, false)
}

fn (m &Message) read_head[S ref + Stream](c &S, request bool) result.Result[int, int] {
    if m.head > 0 {
        // the previous message: discards the rest of the body and what was used
        if !m.done {
            match m.skip_body(c) {
                Ok(_) => {}
                Err(code) => {
                    return result.Result.Err(code)
                }
            }
        }
        k := m.n - m.pos
        for i := 0; i < k; i++ {
            m.buf[i] = m.buf[m.pos + i]
        }
        m.n = k
    }
    m.head = 0
    m.pos = 0
    m.request = request
    m.nfields = 0
    m.done = false
    m.length = -1
    m.left = 0
    m.chunk = CHUNK_SIZE
    scanned := 0
    for {
        end := find_blank_line(&m.buf, scanned, m.n)
        if end > 0 {
            m.head = end
            m.pos = end
            break
        }
        if m.n > 3 {
            scanned = m.n - 3
        }
        if m.n == len(m.buf) {
            return result.Result.Err(HEAD_TOO_BIG)
        }
        match c.read(&m.buf[m.n:]) {
            Ok(k) => {
                if k == 0 {
                    if m.n == 0 {
                        return result.Result.Err(io.EOF)
                    }
                    return result.Result.Err(BAD_MESSAGE)
                }
                m.n += k
            }
            Err(code) => {
                return result.Result.Err(code)
            }
        }
    }
    code := m.parse()
    if code != 0 {
        m.head = 0 // doesn't reuse a connection with garbage
        m.n = 0
        return result.Result.Err(code)
    }
    return result.Result.Ok(m.head)
}

// find_blank_line looks for \r\n\r\n in b[from:n] and returns the position after
// it, or 0.
fn find_blank_line(b &[]byte, from int, n int) int {
    for i := from; i + 3 < n; i++ {
        if b[i] == '\r' && b[i + 1] == '\n' && b[i + 2] == '\r' && b[i + 3] == '\n' {
            return i + 4
        }
    }
    return 0
}

// parse reads the first line and the fields of buf[:head]; returns 0 or the error.
fn (m &Message) parse() int {
    i := line_end(&m.buf, 0, m.head)
    if m.request {
        // GET /path?x=1 HTTP/1.1
        sp1 := index_byte(&m.buf, ' ', 0, i)
        if sp1 <= 0 {
            return BAD_MESSAGE
        }
        sp2 := index_byte(&m.buf, ' ', sp1 + 1, i)
        if sp2 < 0 || sp2 == sp1 + 1 {
            return BAD_MESSAGE
        }
        m.method_at = 0
        m.method_n = sp1
        m.target_at = sp1 + 1
        m.target_n = sp2 - sp1 - 1
        if !m.version(sp2 + 1, i) {
            return BAD_MESSAGE
        }
    } else {
        // HTTP/1.1 200 OK
        sp := index_byte(&m.buf, ' ', 0, i)
        if sp < 0 || !m.version(0, sp) || sp + 4 > i {
            return BAD_MESSAGE
        }
        m.code = 0
        for k := sp + 1; k < sp + 4; k++ {
            d := m.buf[k]
            if d < '0' || d > '9' {
                return BAD_MESSAGE
            }
            m.code = m.code * 10 + int(d) - int('0')
        }
    }
    // the fields: name: value
    at := i + 2
    for at < m.head - 2 {
        e := line_end(&m.buf, at, m.head)
        colon := index_byte(&m.buf, ':', at, e)
        if colon <= at {
            return BAD_MESSAGE
        }
        if m.nfields == MAX_HEADERS {
            return HEAD_TOO_BIG
        }
        v := colon + 1
        for v < e && (m.buf[v] == ' ' || m.buf[v] == '\t') {
            v++
        }
        ve := e
        for ve > v && (m.buf[ve - 1] == ' ' || m.buf[ve - 1] == '\t') {
            ve--
        }
        m.fields[m.nfields] = Field{name_at: at, name_n: colon - at, value_at: v, value_n: ve - v}
        m.nfields++
        at = e + 2
    }
    return m.body_kind()
}

// version checks HTTP/1.x in buf[a:b].
fn (m &Message) version(a int, b int) bool {
    if b - a != 8 || !prefix_at(&m.buf, a, "HTTP/1.") {
        return false
    }
    d := m.buf[a + 7]
    if d != '0' && d != '1' {
        return false
    }
    m.minor = int(d) - int('0')
    return true
}

// body_kind decides how the body ends and whether the connection continues.
fn (m &Message) body_kind() int {
    m.keep = m.minor == 1
    i := m.field("Connection")
    if i >= 0 {
        if m.value_eq(i, "close") {
            m.keep = false
        } else if m.value_eq(i, "keep-alive") {
            m.keep = true
        }
    }
    te := m.field("Transfer-Encoding")
    cl := m.field("Content-Length")
    if te >= 0 {
        if !m.value_eq(te, "chunked") {
            return BAD_MESSAGE // only chunked is accepted
        }
        m.mode = BODY_CHUNKED
        return 0
    }
    if cl >= 0 {
        f := m.fields[cl]
        n := 0
        if !str.parse_int(&m.buf[f.value_at:f.value_at + f.value_n], &n) || n < 0 {
            return BAD_MESSAGE
        }
        m.length = n
        m.mode = BODY_LENGTH
        m.left = n
        m.done = n == 0
        return 0
    }
    if m.request || m.code < 200 || m.code == 204 || m.code == 304 {
        m.mode = BODY_NONE
        m.done = true
        return 0
    }
    m.mode = BODY_UNTIL_CLOSE // response without a size: until the connection closes
    m.keep = false
    return 0
}

// ---------- what came ----------

// method_is compares the method (GET, POST...).
pub fn (m &Message) method_is(s string) bool {
    return str.eq(&m.buf[m.method_at:m.method_at + m.method_n], s)
}

// method copies the method into dst.
pub fn (m &Message) method(dst &[]byte) int {
    return str.copy_bytes(dst, &m.buf[m.method_at:m.method_at + m.method_n])
}

// target copies the request's target as it came (path and query: /a/b?x=1).
pub fn (m &Message) target(dst &[]byte) int {
    return str.copy_bytes(dst, &m.buf[m.target_at:m.target_at + m.target_n])
}

// path copies the path, without the query and not decoded (/a%20b stays
// that way; use http.unescape).
pub fn (m &Message) path(dst &[]byte) int {
    return str.copy_bytes(dst, &m.buf[m.target_at:m.path_end()])
}

// path_is compares the path (without the query).
pub fn (m &Message) path_is(s string) bool {
    return str.eq(&m.buf[m.target_at:m.path_end()], s)
}

// path_has_prefix says whether the path starts with s (for routes like /api/).
pub fn (m &Message) path_has_prefix(s string) bool {
    e := m.path_end()
    return e - m.target_at >= len(s) && prefix_at(&m.buf, m.target_at, s)
}

fn (m &Message) path_end() int {
    q := index_byte(&m.buf, '?', m.target_at, m.target_at + m.target_n)
    if q < 0 {
        return m.target_at + m.target_n
    }
    return q
}

// query copies the query (what comes after the ?), not decoded.
pub fn (m &Message) query(dst &[]byte) int {
    e := m.path_end()
    end := m.target_at + m.target_n
    if e == end {
        return 0
    }
    return str.copy_bytes(dst, &m.buf[e + 1:end])
}

// query_param copies the value of the query parameter name, decoded
// (%41 and +), and returns the length; -1 if it doesn't exist (or if the encoding
// is invalid).
pub fn (m &Message) query_param(name string, dst &[]byte) int {
    e := m.path_end()
    end := m.target_at + m.target_n
    if e == end {
        return -1
    }
    return url.query_value(&m.buf[e + 1:end], name, dst)
}

// status is the response's code (200, 404...).
pub fn (m &Message) status() int {
    return m.code
}

// keep_alive says whether the connection can be used for another message.
pub fn (m &Message) keep_alive() bool {
    return m.keep
}

// content_length is the Content-Length, or -1 if absent.
pub fn (m &Message) content_length() int {
    return m.length
}

// header copies the value of the field name (case-insensitive name)
// and returns the length; -1 if absent.
pub fn (m &Message) header(name string, dst &[]byte) int {
    i := m.field(name)
    if i < 0 {
        return -1
    }
    f := m.fields[i]
    return str.copy_bytes(dst, &m.buf[f.value_at:f.value_at + f.value_n])
}

// has_header says whether the field came.
pub fn (m &Message) has_header(name string) bool {
    return m.field(name) >= 0
}

// header_is compares the field's value, case-insensitively
// (Connection: Close, application/JSON).
pub fn (m &Message) header_is(name string, value string) bool {
    i := m.field(name)
    return i >= 0 && m.value_eq(i, value)
}

// header_count, header_name and header_value walk all the fields.
pub fn (m &Message) header_count() int {
    return m.nfields
}

// header_name copies the name of field i (from 0 to header_count() - 1) into dst.
pub fn (m &Message) header_name(i int, dst &[]byte) int {
    f := m.fields[i]
    return str.copy_bytes(dst, &m.buf[f.name_at:f.name_at + f.name_n])
}

// header_value copies the value of field i (from 0 to header_count() - 1) into dst.
pub fn (m &Message) header_value(i int, dst &[]byte) int {
    f := m.fields[i]
    return str.copy_bytes(dst, &m.buf[f.value_at:f.value_at + f.value_n])
}

fn (m &Message) field(name string) int {
    for i := 0; i < m.nfields; i++ {
        f := m.fields[i]
        if f.name_n == len(name) && fold_eq(&m.buf, f.name_at, name) {
            return i
        }
    }
    return -1
}

fn (m &Message) value_eq(i int, s string) bool {
    f := m.fields[i]
    return f.value_n == len(s) && fold_eq(&m.buf, f.value_at, s)
}

// ---------- the body ----------

// read_body reads up to len(dst) bytes of the body (already de-chunked) and returns
// how many it read; Ok(0) is the end of the body. May read less than len(dst).
pub fn (m &Message) read_body[S ref + Stream](c &S, dst &[]byte) result.Result[int, int] {
    if m.done || len(dst) == 0 {
        return result.Result.Ok(0)
    }
    if m.mode == BODY_LENGTH {
        k := m.left
        if k > len(dst) {
            k = len(dst)
        }
        match m.take(c, &dst[:k], false) {
            Ok(got) => {
                m.left -= got
                m.done = m.left == 0
                return result.Result.Ok(got)
            }
            Err(code) => {
                return result.Result.Err(code)
            }
        }
    }
    if m.mode == BODY_UNTIL_CLOSE {
        match m.take(c, dst, true) {
            Ok(got) => {
                m.done = got == 0
                return result.Result.Ok(got)
            }
            Err(code) => {
                return result.Result.Err(code)
            }
        }
    }
    // chunked: size in hex, \r\n, the bytes, \r\n; a 0 chunk ends it
    for {
        if m.chunk == CHUNK_DATA {
            k := m.left
            if k > len(dst) {
                k = len(dst)
            }
            match m.take(c, &dst[:k], false) {
                Ok(got) => {
                    m.left -= got
                    if m.left == 0 {
                        m.chunk = CHUNK_END
                    }
                    return result.Result.Ok(got)
                }
                Err(code) => {
                    return result.Result.Err(code)
                }
            }
        }
        match m.line(c) {
            Ok(e) => {
                if m.chunk == CHUNK_END {
                    if e != m.pos {
                        return result.Result.Err(BAD_MESSAGE) // expected only \r\n
                    }
                    m.pos = e + 2
                    m.chunk = CHUNK_SIZE
                } else {
                    size := parse_hex(&m.buf, m.pos, e)
                    m.pos = e + 2
                    if size < 0 {
                        return result.Result.Err(BAD_MESSAGE)
                    }
                    if size == 0 {
                        // end: skips the final fields (trailers) up to the blank line
                        for {
                            match m.line(c) {
                                Ok(t) => {
                                    blank := t == m.pos
                                    m.pos = t + 2
                                    if blank {
                                        m.done = true
                                        return result.Result.Ok(0)
                                    }
                                }
                                Err(code) => {
                                    return result.Result.Err(code)
                                }
                            }
                        }
                    }
                    m.left = size
                    m.chunk = CHUNK_DATA
                }
            }
            Err(code) => {
                return result.Result.Err(code)
            }
        }
    }
}

// read_all reads the whole body into dst and returns the length; Err(TOO_BIG)
// if it doesn't fit (what fit stays in dst).
pub fn (m &Message) read_all[S ref + Stream](c &S, dst &[]byte) result.Result[int, int] {
    n := 0
    for {
        if n == len(dst) {
            var probe [1]byte
            match m.read_body(c, &probe) {
                Ok(k) => {
                    if k == 0 {
                        return result.Result.Ok(n)
                    }
                    return result.Result.Err(TOO_BIG)
                }
                Err(code) => {
                    return result.Result.Err(code)
                }
            }
        }
        match m.read_body(c, &dst[n:]) {
            Ok(k) => {
                if k == 0 {
                    return result.Result.Ok(n)
                }
                n += k
            }
            Err(code) => {
                return result.Result.Err(code)
            }
        }
    }
}

// skip_body reads and discards the rest of the body.
pub fn (m &Message) skip_body[S ref + Stream](c &S) result.Result[int, int] {
    var trash [1024]byte
    total := 0
    for {
        match m.read_body(c, &trash) {
            Ok(k) => {
                if k == 0 {
                    return result.Result.Ok(total)
                }
                total += k
            }
            Err(code) => {
                return result.Result.Err(code)
            }
        }
    }
}

// take delivers up to len(dst) bytes: first the ones in buf, otherwise a
// read from the connection straight into dst. Ok(0) only with eof_ok (body until
// close); otherwise the connection closing in the middle is BAD_MESSAGE.
fn (m &Message) take[S ref + Stream](c &S, dst &[]byte, eof_ok bool) result.Result[int, int] {
    if m.pos < m.n {
        k := m.n - m.pos
        if k > len(dst) {
            k = len(dst)
        }
        for i := 0; i < k; i++ {
            dst[i] = m.buf[m.pos + i]
        }
        m.pos += k
        return result.Result.Ok(k)
    }
    match c.read(dst) {
        Ok(k) => {
            if k == 0 && !eof_ok {
                return result.Result.Err(BAD_MESSAGE)
            }
            return result.Result.Ok(k)
        }
        Err(code) => {
            return result.Result.Err(code)
        }
    }
}

// line guarantees a whole line (up to \r\n) in buf starting at pos and
// returns the position of the \r. To read more, moves the leftovers to right
// after the header.
fn (m &Message) line[S ref + Stream](c &S) result.Result[int, int] {
    for {
        for i := m.pos; i + 1 < m.n; i++ {
            if m.buf[i] == '\r' && m.buf[i + 1] == '\n' {
                return result.Result.Ok(i)
            }
        }
        k := m.n - m.pos
        for i := 0; i < k; i++ {
            m.buf[m.head + i] = m.buf[m.pos + i]
        }
        m.pos = m.head
        m.n = m.head + k
        if m.n == len(m.buf) {
            return result.Result.Err(HEAD_TOO_BIG)
        }
        match c.read(&m.buf[m.n:]) {
            Ok(got) => {
                if got == 0 {
                    return result.Result.Err(BAD_MESSAGE)
                }
                m.n += got
            }
            Err(code) => {
                return result.Result.Err(code)
            }
        }
    }
}

// ---------- outgoing message ----------

// Builder assembles the header of a response (response) or a request
// (request) and sends it with the body (send). The Content-Length is set by
// send. The zero value is ready to use, and the same Builder serves
// several messages (response and request start over).
pub struct Builder {
    buf [4096]byte
    n int
    has_length bool
    no_body bool // 1xx, 204, 304: no body and no Content-Length
}

// response starts a response: HTTP/1.1 200 OK.
pub fn (b &Builder) response(status int) {
    b.n = str.copy(&b.buf, "HTTP/1.1 ")
    b.n += str.put_int(&b.buf[b.n:], status)
    b.n += str.copy(&b.buf[b.n:], " ")
    b.n += str.copy(&b.buf[b.n:], status_text(status))
    b.n += str.copy(&b.buf[b.n:], "\r\n")
    b.has_length = false
    b.no_body = status < 200 || status == 204 || status == 304
}

// request starts a request: GET /path HTTP/1.1. Remember the Host field.
pub fn (b &Builder) request(method string, target string) {
    b.n = str.copy(&b.buf, method)
    b.n += str.copy(&b.buf[b.n:], " ")
    b.n += str.copy(&b.buf[b.n:], target)
    b.n += str.copy(&b.buf[b.n:], " HTTP/1.1\r\n")
    b.has_length = false
    b.no_body = false
}

// request_bytes is request with the target built at run time.
pub fn (b &Builder) request_bytes(method string, target &[]byte) {
    b.n = str.copy(&b.buf, method)
    b.n += str.copy(&b.buf[b.n:], " ")
    b.n += str.copy_bytes(&b.buf[b.n:], target)
    b.n += str.copy(&b.buf[b.n:], " HTTP/1.1\r\n")
    b.has_length = false
    b.no_body = false
}

// header appends a field. A Content-Length written here replaces the
// automatic one (to send the body afterwards, with start).
pub fn (b &Builder) header(name string, value string) {
    b.name(name)
    b.n += str.copy(&b.buf[b.n:], value)
    b.n += str.copy(&b.buf[b.n:], "\r\n")
}

// header_bytes appends a field with the value built at run time.
pub fn (b &Builder) header_bytes(name string, value &[]byte) {
    b.name(name)
    b.n += str.copy_bytes(&b.buf[b.n:], value)
    b.n += str.copy(&b.buf[b.n:], "\r\n")
}

// header_int appends a field with an integer value.
pub fn (b &Builder) header_int(name string, value int) {
    b.name(name)
    b.n += str.put_int(&b.buf[b.n:], value)
    b.n += str.copy(&b.buf[b.n:], "\r\n")
}

fn (b &Builder) name(name string) {
    if b.n == 0 {
        fail("http.Builder: start with response or request")
    }
    if len(name) == len("Content-Length") && fold_eq_str(name, "Content-Length") {
        b.has_length = true
    }
    b.n += str.copy(&b.buf[b.n:], name)
    b.n += str.copy(&b.buf[b.n:], ": ")
}

// send ends the header (with the body's Content-Length) and sends the
// header and the body. A small body goes along, in a single write.
pub fn (b &Builder) send[S ref + Stream](c &S, body &[]byte) result.Result[int, int] {
    if !b.has_length && !b.no_body {
        b.header_int("Content-Length", len(body))
    }
    b.end_head()
    if b.n + len(body) <= len(b.buf) {
        b.n += str.copy_bytes(&b.buf[b.n:], body)
        return write_all(c, &b.buf[:b.n])
    }
    match write_all(c, &b.buf[:b.n]) {
        Ok(_) => {}
        Err(code) => {
            return result.Result.Err(code)
        }
    }
    return write_all(c, body)
}

// send_str is send with the body written in the program.
pub fn (b &Builder) send_str[S ref + Stream](c &S, body string) result.Result[int, int] {
    if !b.has_length && !b.no_body {
        b.header_int("Content-Length", len(body))
    }
    b.end_head()
    k := len(body)
    if b.n + k > len(b.buf) {
        match write_all(c, &b.buf[:b.n]) {
            Ok(_) => {}
            Err(code) => {
                return result.Result.Err(code)
            }
        }
        b.n = 0
    }
    b.n += str.copy(&b.buf[b.n:], body)
    return write_all(c, &b.buf[:b.n])
}

// start sends only the header, with the Content-Length length: the body goes
// afterwards, in pieces, with c.write (for large files).
pub fn (b &Builder) start[S ref + Stream](c &S, length int) result.Result[int, int] {
    if !b.has_length && !b.no_body {
        b.header_int("Content-Length", length)
    }
    b.end_head()
    return write_all(c, &b.buf[:b.n])
}

fn (b &Builder) end_head() {
    if b.n == 0 {
        fail("http.Builder: start with response or request")
    }
    b.n += str.copy(&b.buf[b.n:], "\r\n")
}

fn write_all[S ref + Stream](c &S, data &[]byte) result.Result[int, int] {
    return c.write(data)
}

// respond sends a complete response: the code, the Content-Type and the body.
pub fn respond[S ref + Stream](c &S, status int, content_type string, body &[]byte) result.Result[int, int] {
    var b Builder
    b.response(status)
    b.header("Content-Type", content_type)
    return b.send(c, body)
}

// respond_str is respond with the body written in the program.
pub fn respond_str[S ref + Stream](c &S, status int, content_type string, body string) result.Result[int, int] {
    var b Builder
    b.response(status)
    b.header("Content-Type", content_type)
    return b.send_str(c, body)
}

// status_text is a code's phrase (200: OK, 404: Not Found).
pub fn status_text(code int) string {
    match code {
        100 => return "Continue"
        101 => return "Switching Protocols"
        200 => return "OK"
        201 => return "Created"
        202 => return "Accepted"
        204 => return "No Content"
        206 => return "Partial Content"
        301 => return "Moved Permanently"
        302 => return "Found"
        303 => return "See Other"
        304 => return "Not Modified"
        307 => return "Temporary Redirect"
        308 => return "Permanent Redirect"
        400 => return "Bad Request"
        401 => return "Unauthorized"
        403 => return "Forbidden"
        404 => return "Not Found"
        405 => return "Method Not Allowed"
        408 => return "Request Timeout"
        409 => return "Conflict"
        411 => return "Length Required"
        413 => return "Content Too Large"
        414 => return "URI Too Long"
        415 => return "Unsupported Media Type"
        422 => return "Unprocessable Content"
        429 => return "Too Many Requests"
        431 => return "Request Header Fields Too Large"
        500 => return "Internal Server Error"
        501 => return "Not Implemented"
        502 => return "Bad Gateway"
        503 => return "Service Unavailable"
        504 => return "Gateway Timeout"
        _ => return "Unknown"
    }
}

// ---------- URL encoding ----------

// unescape decodes %XX and + (space) from src into dst and returns the length,
// or -1 if a % isn't followed by two hex digits (the same as
// url.unescape).
pub fn unescape(dst &[]byte, src &[]byte) int {
    return url.unescape(dst, src)
}

// escape encodes src for use in a path or a query: letters,
// digits and - _ . ~ stay, the rest becomes %XX (the same as url.escape).
pub fn escape(dst &[]byte, src &[]byte) int {
    return url.escape(dst, src)
}

// ---------- client ----------

// UNSUPPORTED_SCHEME: the URL is neither http:// nor https://.
pub const UNSUPPORTED_SCHEME = 3003

// dial opens a connection to u's host and port (http:// only; for
// https://, dial_tls). If it can't, returns nil and puts the code in err.
pub fn dial(u &url.URL, err &int) ?*net.Conn {
    if !u.scheme_is("http") {
        *err = UNSUPPORTED_SCHEME
        return nil
    }
    var h [256]byte
    n := u.dial_host(&h)
    return net.connect(&h[:n], u.port(), err)
}

// dial_tls opens a TLS connection to u's host and port (https://),
// checking the certificate. If it can't, returns nil and puts the code
// in err (tls.BAD_CERT...; tls.last_error explains).
pub fn dial_tls(u &url.URL, err &int) ?*tls.Conn {
    if !u.scheme_is("https") {
        *err = UNSUPPORTED_SCHEME
        return nil
    }
    var h [256]byte
    n := u.dial_host(&h)
    return tls.connect(&h[:n], u.port(), err)
}

// request_to starts a request to u: the request line with u's target and
// the Host header. Then come the other headers and the send.
//
//     var u url.URL
//     url.parse_str("http://api.local:8080/v1/items", &u)
//     err := 0
//     c := http.dial(&u, &err)
//     ...
//     var b http.Builder
//     b.request_to("GET", &u)
//     b.header("Authorization", "Bearer ...")
//     b.send_str(&c, "")
pub fn (b &Builder) request_to(method string, u &url.URL) {
    var t [2048]byte
    k := u.target(&t)
    b.request_bytes(method, &t[:k])
    var h [300]byte
    n := u.host(&h)
    if u.has_port() {
        n += str.copy(&h[n:], ":")
        n += str.put_int(&h[n:], u.port())
    }
    b.header_bytes("Host", &h[:n])
}

// get does a GET on rawurl and reads the whole response: m keeps the code and the
// headers (m.status(), m.header(...)), and the body goes into body. Returns the
// body's size, or Err with the code: url.BAD_URL, UNSUPPORTED_SCHEME, those
// of net.connect (NO_HOST, REFUSED...), TOO_BIG if the body doesn't fit in body.
// The connection is opened and closed here (Connection: close).
pub fn get(rawurl string, m &Message, body &[]byte) result.Result[int, int] {
    var u [2048]byte
    if len(rawurl) > len(u) {
        return result.Result.Err(url.BAD_URL)
    }
    n := str.copy(&u, rawurl)
    return request("GET", &u[:n], "", &u[:0], m, body)
}

// post does a POST on rawurl with data and the Content-Type, and reads the response
// like get.
pub fn post(rawurl string, content_type string, data &[]byte, m &Message, body &[]byte) result.Result[int, int] {
    var u [2048]byte
    if len(rawurl) > len(u) {
        return result.Result.Err(url.BAD_URL)
    }
    n := str.copy(&u, rawurl)
    return request("POST", &u[:n], content_type, data, m, body)
}

// request makes a request with any method and the URL built at run
// time, over http:// or https://. An empty content_type doesn't send the
// header. For custom headers, use dial (or dial_tls) and
// Builder.request_to.
pub fn request(method string, rawurl &[]byte, content_type string, data &[]byte, m &Message, body &[]byte) result.Result[int, int] {
    var u url.URL
    if !url.parse(rawurl, &u) {
        return result.Result.Err(url.BAD_URL)
    }
    err := 0
    if u.scheme_is("https") {
        t := dial_tls(&u, &err)
        if t == nil {
            return result.Result.Err(err)
        }
        r := exchange(&t, method, &u, content_type, data, m, body)
        t.close()
        return r
    }
    c := dial(&u, &err)
    if c == nil {
        return result.Result.Err(err)
    }
    r := exchange(&c, method, &u, content_type, data, m, body)
    c.close()
    return r
}

// exchange sends the request and reads the whole response, over any Stream.
fn exchange[S ref + Stream](c &S, method string, u &url.URL, content_type string, data &[]byte, m &Message, body &[]byte) result.Result[int, int] {
    var b Builder
    b.request_to(method, u)
    b.header("Connection", "close")
    if len(content_type) > 0 {
        b.header("Content-Type", content_type)
    }
    r := b.send(c, data)
    match r {
        Ok(_) => r = m.read_response(c)
        Err(_) => {}
    }
    match r {
        Ok(_) => r = m.read_all(c, body)
        Err(_) => {}
    }
    return r
}

// ---------- router ----------

// MAX_PARAMS is how many {name} a route can have.
pub const MAX_PARAMS = 8

// MAX_ROUTES is how many routes fit in a Router.
pub const MAX_ROUTES = 64

// Params are the pieces of the path that matched the route's {name}, already
// decoded (%20 and +), in a 1 KB buffer inside it.
pub struct Params {
    buf [1024]byte
    n int
    pattern string // the route's pattern (the names stay in it)
    name_at [8]int
    name_n [8]int
    at [8]int
    size [8]int
    count int
}

// find returns the index of parameter name, or -1.
fn (p &Params) find(name string) int {
    for i := 0; i < p.count; i++ {
        if p.name_n[i] != len(name) {
            continue
        }
        same := true
        for k := 0; k < len(name); k++ {
            if p.pattern[p.name_at[i] + k] != name[k] {
                same = false
                break
            }
        }
        if same {
            return i
        }
    }
    return -1
}

// get copies the value of parameter name into dst; -1 if the route doesn't have it.
pub fn (p &Params) get(name string, dst &[]byte) int {
    i := p.find(name)
    if i < 0 {
        return -1
    }
    return str.copy_bytes(dst, &p.buf[p.at[i]:p.at[i] + p.size[i]])
}

// is says whether parameter name is equal to s.
pub fn (p &Params) is(name string, s string) bool {
    i := p.find(name)
    return i >= 0 && str.eq(&p.buf[p.at[i]:p.at[i] + p.size[i]], s)
}

// int reads parameter name as an integer; false if it doesn't exist or isn't
// a number.
pub fn (p &Params) int(name string, out &int) bool {
    i := p.find(name)
    return i >= 0 && str.parse_int(&p.buf[p.at[i]:p.at[i] + p.size[i]], out)
}

// match_path says whether path (a request's path, without the query) matches
// pattern, and keeps the parameters in p. In the pattern, {name} matches a
// non-empty piece between slashes, and {name...} at the end matches everything else
// (including slashes):
//
//     /items                    only /items
//     /items/{id}               /items/7, not /items nor /items/7/x
//     /users/{id}/posts/{post}  /users/3/posts/9
//     /files/{path...}          /files/a/b/c.txt
pub fn match_path(pattern string, path &[]byte, p &Params) bool {
    p.count = 0
    p.n = 0
    p.pattern = pattern
    i := 0 // in the pattern
    j := 0 // in the path
    for i < len(pattern) {
        if pattern[i] != '{' {
            if j >= len(path) || path[j] != pattern[i] {
                return false
            }
            i++
            j++
            continue
        }
        end_br := i
        for end_br < len(pattern) && pattern[end_br] != '}' {
            end_br++
        }
        if end_br == len(pattern) || p.count == MAX_PARAMS {
            fail("http.match_path: invalid pattern (missing } or too many {name})")
        }
        rest := end_br - i > 4 && pattern[end_br - 3] == '.' && pattern[end_br - 2] == '.' && pattern[end_br - 1] == '.'
        name_end := end_br
        if rest {
            name_end = end_br - 3
        }
        end := j
        for end < len(path) && (rest || path[end] != '/') {
            end++
        }
        if end == j {
            return false // empty piece
        }
        k := unescape(&p.buf[p.n:], &path[j:end])
        if k < 0 {
            return false
        }
        p.name_at[p.count] = i + 1
        p.name_n[p.count] = name_end - i - 1
        p.at[p.count] = p.n
        p.size[p.count] = k
        p.count++
        p.n += k
        i = end_br + 1
        j = end
    }
    return j == len(path)
}

// Route is a route: the method ("" for any), the pattern and the function.
pub struct Route[S ref + Stream, C any] {
    method string
    pattern string
    h fn(&S, &Message, &Params, &C)
}

// Router picks the function for each request by method and path. The
// table is a fixed array (MAX_ROUTES routes), without allocation. S is the connection
// (net.Conn, or tls.Conn for HTTPS) and C is the state each function receives
// (a logger, a database connection, counters).
//
//     fn get_item(c &net.Conn, m &http.Message, p &http.Params, app &App) {
//         id := 0
//         if !p.int("id", &id) { ... 400 ... }
//         ...
//     }
//
//     var r http.Router[net.Conn, App]
//     r.handle("GET", "/items/{id}", get_item)
//     r.handle("POST", "/items", create_item)
//     ...
//     http.serve_conn(&c, &r, &app)     // in one thread per connection
pub struct Router[S ref + Stream, C any] {
    routes [64]Route[S, C]
    n int
}

// handle adds a route. Routes are tried in the order they were
// added.
pub fn (r &Router[S, C]) handle(method string, pattern string, h fn(&S, &Message, &Params, &C)) {
    if r.n == MAX_ROUTES {
        fail("http.Router: too many routes (the maximum is 64)")
    }
    r.routes[r.n] = Route[S, C]{method: method, pattern: pattern, h: h}
    r.n++
}

// dispatch calls the function of request m's route. With no route for the path,
// responds 404; with a route for the path but not for the method, 405.
pub fn (r &Router[S, C]) dispatch(c &S, m &Message, ctx &C) {
    var path [2048]byte
    n := m.path(&path)
    if n < 0 {
        n = 0
    }
    var p Params
    path_found := false
    for i := 0; i < r.n; i++ {
        rt := r.routes[i]
        if !match_path(rt.pattern, &path[:n], &p) {
            continue
        }
        path_found = true
        if len(rt.method) > 0 && !m.method_is(rt.method) {
            continue
        }
        rt.h(c, m, &p, ctx)
        return
    }
    if path_found {
        respond_str(c, 405, "text/plain", "method not allowed\n")
        return
    }
    respond_str(c, 404, "text/plain", "not found\n")
}

// serve_conn serves a connection until it closes: reads each request, calls the
// Router and discards the body the function didn't read (so the connection's next
// request arrives whole). Responds 431 to a header that's too large and 400
// to an invalid request. The timeout is up to the caller (c.set_timeout), and the
// connection stays open: the caller closes it.
pub fn serve_conn[S ref + Stream, C any](c &S, r &Router[S, C], ctx &C) {
    var m Message
    for {
        match m.read_request(c) {
            Ok(_) => {}
            Err(code) => {
                if code == HEAD_TOO_BIG {
                    respond_str(c, 431, "text/plain", "header too large\n")
                } else if code == BAD_MESSAGE {
                    respond_str(c, 400, "text/plain", "bad request\n")
                }
                return
            }
        }
        r.dispatch(c, &m, ctx)
        match m.skip_body(c) {
            Ok(_) => {}
            Err(_) => return
        }
        if !m.keep_alive() {
            return
        }
    }
}

// ---------- helpers ----------

extern fn fail(msg string)

fn line_end(b &[]byte, from int, limit int) int {
    for i := from; i + 1 < limit; i++ {
        if b[i] == '\r' && b[i + 1] == '\n' {
            return i
        }
    }
    return limit
}

fn index_byte(b &[]byte, c byte, from int, to int) int {
    for i := from; i < to; i++ {
        if b[i] == c {
            return i
        }
    }
    return -1
}

fn prefix_at(b &[]byte, at int, s string) bool {
    if at + len(s) > len(b) {
        return false
    }
    for i := 0; i < len(s); i++ {
        if b[at + i] != s[i] {
            return false
        }
    }
    return true
}

fn lower(c byte) byte {
    if c >= 'A' && c <= 'Z' {
        return c + 32
    }
    return c
}

// fold_eq compares b[at:at+len(s)] with s case-insensitively.
fn fold_eq(b &[]byte, at int, s string) bool {
    for i := 0; i < len(s); i++ {
        if lower(b[at + i]) != lower(s[i]) {
            return false
        }
    }
    return true
}

fn fold_eq_str(a string, s string) bool {
    for i := 0; i < len(s); i++ {
        if lower(a[i]) != lower(s[i]) {
            return false
        }
    }
    return true
}

fn hex_value(c byte) int {
    if c >= '0' && c <= '9' {
        return int(c) - int('0')
    }
    if c >= 'a' && c <= 'f' {
        return int(c) - int('a') + 10
    }
    if c >= 'A' && c <= 'F' {
        return int(c) - int('A') + 10
    }
    return -1
}

// parse_hex reads the size of a chunk in b[a:e] (ignoring the
// extensions after ;); -1 if it's invalid.
fn parse_hex(b &[]byte, a int, e int) int {
    n := 0
    digits := 0
    for i := a; i < e && b[i] != ';'; i++ {
        if b[i] == ' ' || b[i] == '\t' {
            continue
        }
        d := hex_value(b[i])
        if d < 0 || digits == 15 {
            return -1
        }
        n = n * 16 + d
        digits++
    }
    if digits == 0 {
        return -1
    }
    return n
}
