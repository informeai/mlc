// Hashes não criptográficos, para tabelas e checagens rápidas. As contas dão
// a volta de propósito (*%), e nada aloca.
//
//     h := hash.fnv64(&dados)

// fnv32 é o FNV-1a de 32 bits dos bytes de s.
pub fn fnv32(s &[]byte) uint32 {
    var h uint32 = 0x811C_9DC5
    for i := 0; i < len(s); i++ {
        h ^= uint32(s[i])
        h *%= 0x0100_0193
    }
    return h
}

// fnv64 é o FNV-1a de 64 bits dos bytes de s.
pub fn fnv64(s &[]byte) uint64 {
    var h uint64 = 0xCBF2_9CE4_8422_2325
    for i := 0; i < len(s); i++ {
        h ^= uint64(s[i])
        h *%= 0x0000_0100_0000_01B3
    }
    return h
}

// fnv64_str é o fnv64 de uma string fixa.
pub fn fnv64_str(s string) uint64 {
    var h uint64 = 0xCBF2_9CE4_8422_2325
    for i := 0; i < len(s); i++ {
        h ^= uint64(s[i])
        h *%= 0x0000_0100_0000_01B3
    }
    return h
}

// mix64 espalha os bits de x (o finalizador do splitmix64): bom para usar um
// inteiro como chave de tabela.
pub fn mix64(x uint64) uint64 {
    x = (x ^ (x >> 30)) *% 0xBF58_476D_1CE4_E5B9
    x = (x ^ (x >> 27)) *% 0x94D0_49BB_1331_11EB
    return x ^ (x >> 31)
}

// ---------- Hash: chaves de tabelas (std/map) ----------

// Hash é o que uma chave de map.Map precisa: um hash bem espalhado e a
// igualdade. Dois valores iguais (eq) precisam ter o mesmo hash.
pub interface Hash {
    fn hash(self &Self) uint64
    fn eq(self &Self, other &Self) bool
}

impl Hash for int {
    fn (x &int) hash() uint64 {
        return mix64(uint64(*x))
    }
    fn (x &int) eq(o &int) bool {
        return *x == *o
    }
}

impl Hash for int8 {
    fn (x &int8) hash() uint64 {
        return mix64(uint64(int(*x) +% 128))
    }
    fn (x &int8) eq(o &int8) bool {
        return *x == *o
    }
}

impl Hash for int16 {
    fn (x &int16) hash() uint64 {
        return mix64(uint64(int(*x) +% 32768))
    }
    fn (x &int16) eq(o &int16) bool {
        return *x == *o
    }
}

impl Hash for int32 {
    fn (x &int32) hash() uint64 {
        return mix64(uint64(int(*x) +% 2147483648))
    }
    fn (x &int32) eq(o &int32) bool {
        return *x == *o
    }
}

impl Hash for byte {
    fn (x &byte) hash() uint64 {
        return mix64(uint64(*x))
    }
    fn (x &byte) eq(o &byte) bool {
        return *x == *o
    }
}

impl Hash for uint16 {
    fn (x &uint16) hash() uint64 {
        return mix64(uint64(*x))
    }
    fn (x &uint16) eq(o &uint16) bool {
        return *x == *o
    }
}

impl Hash for uint32 {
    fn (x &uint32) hash() uint64 {
        return mix64(uint64(*x))
    }
    fn (x &uint32) eq(o &uint32) bool {
        return *x == *o
    }
}

impl Hash for uint64 {
    fn (x &uint64) hash() uint64 {
        return mix64(*x)
    }
    fn (x &uint64) eq(o &uint64) bool {
        return *x == *o
    }
}

impl Hash for bool {
    fn (x &bool) hash() uint64 {
        if *x {
            return mix64(1)
        }
        return mix64(0)
    }
    fn (x &bool) eq(o &bool) bool {
        return *x == *o
    }
}

impl Hash for string {
    fn (x &string) hash() uint64 {
        return fnv64_str(*x)
    }
    fn (x &string) eq(o &string) bool {
        return *x == *o
    }
}

// Um slice (como []byte, o texto lido em buffers) combina o hash dos
// elementos; dois slices são iguais se têm os mesmos elementos.
impl[T Hash] Hash for []T {
    fn (s &[]T) hash() uint64 {
        var h uint64 = 0xCBF2_9CE4_8422_2325
        for i := 0; i < len(s); i++ {
            h = (h ^ s[i].hash()) *% 0x0000_0100_0000_01B3
        }
        return mix64(h ^ uint64(len(s)))
    }
    fn (s &[]T) eq(o &[]T) bool {
        if len(s) != len(o) {
            return false
        }
        for i := 0; i < len(s); i++ {
            if !s[i].eq(&o[i]) {
                return false
            }
        }
        return true
    }
}

// ---------- CRC32 ----------

// crc32 é o CRC-32 (IEEE, o de zip, gzip e PNG) dos bytes de s.
pub fn crc32(s &[]byte) uint32 {
    return crc32_update(0, s)
}

// crc32_update continua um CRC-32 com mais bytes, para dados em pedaços:
// crc32_update(crc32(a), b) é o CRC de a seguido de b.
pub fn crc32_update(crc uint32, s &[]byte) uint32 {
    c := ^crc
    for i := 0; i < len(s); i++ {
        c ^= uint32(s[i])
        for k := 0; k < 8; k++ {
            if c & 1 != 0 {
                c = (c >> 1) ^ 0xEDB8_8320
            } else {
                c = c >> 1
            }
        }
    }
    return ^c
}

// ---------- SHA-256 ----------

// Sha256 calcula o SHA-256 de dados entregues em pedaços. O estado fica na
// pilha de quem chama; nada aloca.
//
//     h := hash.sha256()
//     h.write(&buf[:n])          // quantas vezes precisar
//     var digest [32]byte
//     h.sum(&digest)             // para texto: encoding.hex
//
// Serve para integridade e identificadores; não é, sozinho, criptografia
// (assinaturas e senhas pedem uma biblioteca própria).
pub struct Sha256 {
    h [8]uint32
    block [64]byte
    used int  // bytes em block
    total int // bytes recebidos
}

// sha256 começa um cálculo.
pub fn sha256() Sha256 {
    var s Sha256
    s.h = [8]uint32{0x6A09_E667, 0xBB67_AE85, 0x3C6E_F372, 0xA54F_F53A, 0x510E_527F, 0x9B05_688C, 0x1F83_D9AB, 0x5BE0_CD19}
    return s
}

// write acrescenta os bytes de data.
pub fn (s &Sha256) write(data &[]byte) {
    for i := 0; i < len(data); i++ {
        s.block[s.used] = data[i]
        s.used++
        if s.used == 64 {
            s.compress()
            s.used = 0
        }
    }
    s.total += len(data)
}

// sum escreve os 32 bytes do resultado no começo de dst. O cálculo pode
// continuar depois (sum não muda o estado).
pub fn (s &Sha256) sum(dst &[]byte) {
    if len(dst) < 32 {
        fail("hash.Sha256.sum: o destino precisa de 32 bytes")
    }
    c := *s // o enchimento vai numa cópia
    bits := uint64(c.total) *% 8
    var pad [72]byte
    pad[0] = 0x80
    k := 1
    for (c.used + k) % 64 != 56 {
        k++
    }
    for b := 0; b < 8; b++ {
        pad[k + b] = byte((bits >> uint64(56 - 8 * b)) & 0xFF)
    }
    c.write(&pad[:k + 8])
    for i := 0; i < 8; i++ {
        dst[4 * i] = byte(c.h[i] >> 24)
        dst[4 * i + 1] = byte((c.h[i] >> 16) & 0xFF)
        dst[4 * i + 2] = byte((c.h[i] >> 8) & 0xFF)
        dst[4 * i + 3] = byte(c.h[i] & 0xFF)
    }
}

// sha256_sum é o SHA-256 de data de uma vez, escrito em dst (32 bytes).
pub fn sha256_sum(data &[]byte, dst &[]byte) {
    s := sha256()
    s.write(data)
    s.sum(dst)
}

fn rotr(x uint32, n uint32) uint32 {
    return (x >> n) | (x << (32 - n))
}

fn (s &Sha256) compress() {
    k := [64]uint32{
        0x428A_2F98, 0x7137_4491, 0xB5C0_FBCF, 0xE9B5_DBA5, 0x3956_C25B, 0x59F1_11F1, 0x923F_82A4, 0xAB1C_5ED5,
        0xD807_AA98, 0x1283_5B01, 0x2431_85BE, 0x550C_7DC3, 0x72BE_5D74, 0x80DE_B1FE, 0x9BDC_06A7, 0xC19B_F174,
        0xE49B_69C1, 0xEFBE_4786, 0x0FC1_9DC6, 0x240C_A1CC, 0x2DE9_2C6F, 0x4A74_84AA, 0x5CB0_A9DC, 0x76F9_88DA,
        0x983E_5152, 0xA831_C66D, 0xB003_27C8, 0xBF59_7FC7, 0xC6E0_0BF3, 0xD5A7_9147, 0x06CA_6351, 0x1429_2967,
        0x27B7_0A85, 0x2E1B_2138, 0x4D2C_6DFC, 0x5338_0D13, 0x650A_7354, 0x766A_0ABB, 0x81C2_C92E, 0x9272_2C85,
        0xA2BF_E8A1, 0xA81A_664B, 0xC24B_8B70, 0xC76C_51A3, 0xD192_E819, 0xD699_0624, 0xF40E_3585, 0x106A_A070,
        0x19A4_C116, 0x1E37_6C08, 0x2748_774C, 0x34B0_BCB5, 0x391C_0CB3, 0x4ED8_AA4A, 0x5B9C_CA4F, 0x682E_6FF3,
        0x748F_82EE, 0x78A5_636F, 0x84C8_7814, 0x8CC7_0208, 0x90BE_FFFA, 0xA450_6CEB, 0xBEF9_A3F7, 0xC671_78F2,
    }
    var w [64]uint32
    for i := 0; i < 16; i++ {
        w[i] = (uint32(s.block[4 * i]) << 24) | (uint32(s.block[4 * i + 1]) << 16) | (uint32(s.block[4 * i + 2]) << 8) | uint32(s.block[4 * i + 3])
    }
    for i := 16; i < 64; i++ {
        s0 := rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3)
        s1 := rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10)
        w[i] = w[i - 16] +% s0 +% w[i - 7] +% s1
    }
    a := s.h[0]
    b := s.h[1]
    c := s.h[2]
    d := s.h[3]
    e := s.h[4]
    f := s.h[5]
    g := s.h[6]
    h := s.h[7]
    for i := 0; i < 64; i++ {
        t1 := h +% (rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)) +% ((e & f) ^ (^e & g)) +% k[i] +% w[i]
        t2 := (rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)) +% ((a & b) ^ (a & c) ^ (b & c))
        h = g
        g = f
        f = e
        e = d +% t1
        d = c
        c = b
        b = a
        a = t1 +% t2
    }
    s.h[0] +%= a
    s.h[1] +%= b
    s.h[2] +%= c
    s.h[3] +%= d
    s.h[4] +%= e
    s.h[5] +%= f
    s.h[6] +%= g
    s.h[7] +%= h
}

extern fn fail(msg string)
