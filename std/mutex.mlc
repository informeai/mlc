// Mutex: a value shared between threads, only touched under the lock.
//
//     m := mutex.new(alloc(Account{balance: 0}))  // the value goes inside the mutex
//     t := thread.spawn(deposit, m.clone(), thread.STACK_64KB)
//     g := m.lock()                             // waits for the lock
//     c := g.get()                              // &Account, borrowed from the guard
//     c.balance += 10
//     g.unlock()                                // required; using c afterwards is an error
//     thread.join(t)
//     m.close()
//
// mutex.new and the methods are built into the compiler; the mutex lives in
// the runtime.
//
// mutex.new(v) *Mutex[T]    allocates the mutex with the value v inside (v is moved);
//                           mutex.new[T](v) picks the type
//
// Mutex[T]:
//   lock() *Guard[T]        waits for the lock; locking again on the same thread,
//                           without unlocking, panics
//   clone() *Mutex[T]       another handle to the same mutex (for another thread)
//   notify(), notify_all()  wake whoever waits in wait
//   close()                 the last handle (and guard) to leave frees the value
//
// Guard[T]:
//   get() &T                borrows the value; while the borrow is used, the
//                           guard stays frozen
//   wait()                  releases the lock, waits for a notify and locks again
//   notify(), notify_all()
//   unlock()                unlocks (consumes the guard)
//
// The checker requires close on each handle and unlock on each guard. A guard
// belongs to the thread that locked: it doesn't go to another thread, fields or slices.
