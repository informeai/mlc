import "std/str"
import "std/testing"
import "std/url"

fn test_full_url() {
    var u url.URL
    testing.check(url.parse_str("HTTPS://user:pw@Api.Example.com:8443/v1/items?id=7&q=caf%C3%A9+chaud&flag#top", &u), "parse")
    var b [256]byte
    n := u.scheme(&b)
    testing.eq_str(&b[:n], "HTTPS")
    testing.check(u.scheme_is("https"), "case-insensitive scheme")
    n = u.host(&b)
    testing.eq_str(&b[:n], "Api.Example.com")
    testing.check(u.host_is("api.example.com"), "host_is")
    testing.check(u.has_port(), "written port")
    testing.eq_int(u.port(), 8443)
    n = u.user(&b)
    testing.eq_str(&b[:n], "user:pw")
    n = u.path(&b)
    testing.eq_str(&b[:n], "/v1/items")
    n = u.query(&b)
    testing.eq_str(&b[:n], "id=7&q=caf%C3%A9+chaud&flag")
    n = u.query_param("q", &b)
    testing.eq_str(&b[:n], "café chaud")
    n = u.query_param("id", &b)
    testing.eq_str(&b[:n], "7")
    testing.eq_int(u.query_param("flag", &b), 0)
    testing.eq_int(u.query_param("missing", &b), -1)
    n = u.fragment(&b)
    testing.eq_str(&b[:n], "top")
    n = u.target(&b)
    testing.eq_str(&b[:n], "/v1/items?id=7&q=caf%C3%A9+chaud&flag")
}

fn test_defaults() {
    var u url.URL
    testing.check(url.parse_str("http://example.com", &u), "parse")
    testing.check(!u.has_port(), "no port")
    testing.eq_int(u.port(), 80)
    var b [64]byte
    testing.eq_int(u.path(&b), 0)
    n := u.target(&b)
    testing.eq_str(&b[:n], "/") // a request's target is never empty
    testing.eq_int(u.query(&b), -1)
    testing.eq_int(u.fragment(&b), -1)
    testing.eq_int(u.user(&b), -1)
    testing.check(url.parse_str("https://example.com/", &u), "https")
    testing.eq_int(u.port(), 443)
    testing.check(url.parse_str("mailto://x", &u), "scheme without a known port")
    testing.eq_int(u.port(), -1)
}

fn test_ipv6_and_reference() {
    var u url.URL
    testing.check(url.parse_str("http://[::1]:8080/a", &u), "IPv6")
    var b [64]byte
    n := u.host(&b)
    testing.eq_str(&b[:n], "[::1]")
    n = u.dial_host(&b)
    testing.eq_str(&b[:n], "::1")
    testing.eq_int(u.port(), 8080)
    // only the target, as in the HTTP request
    testing.check(url.parse_str("/itens/7?x=1", &u), "reference")
    testing.eq_int(u.scheme(&b), 0)
    testing.eq_int(u.host(&b), 0)
    n = u.path(&b)
    testing.eq_str(&b[:n], "/itens/7")
    n = u.query_param("x", &b)
    testing.eq_str(&b[:n], "1")
}

fn test_invalid() {
    var u url.URL
    testing.check(!url.parse_str("http:/x", &u), "scheme without //")
    testing.check(!url.parse_str("http://x:porta/", &u), "non-numeric port")
    testing.check(!url.parse_str("http://x:70000/", &u), "port too large")
    testing.check(!url.parse_str("http://x:/", &u), "empty port")
    testing.check(!url.parse_str("http://[::1/", &u), "IPv6 without ]")
    var b [8]byte
    testing.check(url.parse_str("http://x/?q=%zz", &u), "the query is read without decoding")
    testing.eq_int(u.query_param("q", &b), -1)
}

fn test_query_builder() {
    var q url.Query
    q.add_str("search", "café au lait")
    q.add_int("page", 2)
    var v [8]byte
    k := str.copy(&v, "a&b=c")
    q.add("filter", &v[:k])
    testing.eq_str(&q.buf[:q.n], "search=caf%C3%A9%20au%20lait&page=2&filter=a%26b%3Dc")
    // and back
    var out [64]byte
    n := url.query_value(&q.buf[:q.n], "filter", &out)
    testing.eq_str(&out[:n], "a&b=c")
    n = url.query_value(&q.buf[:q.n], "search", &out)
    testing.eq_str(&out[:n], "café au lait")
}

fn test_escape() {
    var src [32]byte
    n := str.copy(&src, "a b/é?")
    var out [64]byte
    k := url.escape(&out, &src[:n])
    testing.eq_str(&out[:k], "a%20b%2F%C3%A9%3F")
    var back [32]byte
    m := url.unescape(&back, &out[:k])
    testing.eq_str(&back[:m], "a b/é?")
    n = str.copy(&src, "%4")
    testing.eq_int(url.unescape(&back, &src[:n]), -1)
}
