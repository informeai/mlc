// URLs (RFC 3986): reading the parts of an address and building queries. Nothing
// allocates: the URL keeps a copy of the text in a fixed 2 KB buffer inside
// itself, and the parts are copied into the caller's buffers (or compared
// without copying, with scheme_is and host_is).
//
//     var u url.URL
//     if !url.parse_str("https://api.example.com:8443/v1/items?id=7&q=caf%C3%A9#top", &u) {
//         return
//     }
//     var host [256]byte
//     n := u.host(&host)                 // api.example.com
//     port := u.port()                   // 8443 (443 if it weren't in the text)
//     var target [512]byte
//     k := u.target(&target)             // /v1/items?id=7&q=caf%C3%A9 (for HTTP)
//     var q [64]byte
//     m := u.query_param("q", &q)        // café (decoded)
//
// To build a query, Query writes the pairs already encoded:
//
//     var q url.Query
//     q.add_str("search", "café au lait")
//     q.add_int("page", 2)
//     // &q.buf[:q.n] is search=caf%C3%A9+au+lait&page=2
//
// It also reads a reference without a scheme or host, like /path?a=1 (the target
// of an HTTP request).
import "std/str"

// BAD_URL is the error code of a URL that couldn't be read.
pub const BAD_URL = 3101

// MAX_LEN is the longest URL text that fits in a URL.
pub const MAX_LEN = 2048

// URL is a URL read by parse: the text and where each part is.
pub struct URL {
    buf [2048]byte
    n int
    scheme_at int
    scheme_n int
    user_at int
    user_n int // -1: no userinfo
    host_at int
    host_n int
    port_n int // the port written in the text, -1 if absent
    path_at int
    path_n int
    query_at int
    query_n int // -1: no ?
    frag_at int
    frag_n int // -1: no #
}

// parse reads s into u. Returns false if s isn't a URL (scheme without //,
// a port that isn't a number, text longer than MAX_LEN).
pub fn parse(s &[]byte, u &URL) bool {
    if len(s) > MAX_LEN {
        return false
    }
    u.n = str.copy_bytes(&u.buf, s)
    u.scheme_at = 0
    u.scheme_n = 0
    u.user_at = 0
    u.user_n = -1
    u.host_at = 0
    u.host_n = 0
    u.port_n = -1
    u.query_at = 0
    u.query_n = -1
    u.frag_at = 0
    u.frag_n = -1
    i := 0
    // scheme: letters, digits, + - . and then "://"
    sc := scheme_end(&u.buf, u.n)
    if sc > 0 {
        if sc + 3 > u.n || u.buf[sc + 1] != '/' || u.buf[sc + 2] != '/' {
            return false
        }
        u.scheme_n = sc
        i = sc + 3
        // authority: up to the first / ? or #
        end := i
        for end < u.n && u.buf[end] != '/' && u.buf[end] != '?' && u.buf[end] != '#' {
            end++
        }
        if !u.authority(i, end) {
            return false
        }
        i = end
    }
    u.path_at = i
    for i < u.n && u.buf[i] != '?' && u.buf[i] != '#' {
        i++
    }
    u.path_n = i - u.path_at
    if i < u.n && u.buf[i] == '?' {
        i++
        u.query_at = i
        for i < u.n && u.buf[i] != '#' {
            i++
        }
        u.query_n = i - u.query_at
    }
    if i < u.n && u.buf[i] == '#' {
        u.frag_at = i + 1
        u.frag_n = u.n - u.frag_at
    }
    return true
}

// parse_str is parse of a fixed text in the program.
pub fn parse_str(s string, u &URL) bool {
    var b [2048]byte
    if len(s) > len(b) {
        return false
    }
    n := str.copy(&b, s)
    return parse(&b[:n], u)
}

// scheme_end returns where the scheme ends (the index of ':'), or 0 if the
// text doesn't start with one.
fn scheme_end(b &[]byte, n int) int {
    for i := 0; i < n; i++ {
        c := b[i]
        letter := (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
        ok := letter || (i > 0 && ((c >= '0' && c <= '9') || c == '+' || c == '-' || c == '.'))
        if c == ':' {
            return i
        }
        if !ok {
            return 0
        }
    }
    return 0
}

// authority reads [userinfo@]host[:port] in buf[from:to].
fn (u &URL) authority(from int, to int) bool {
    at := from
    for k := from; k < to; k++ {
        if u.buf[k] == '@' {
            u.user_at = from
            u.user_n = k - from
            at = k + 1
        }
    }
    u.host_at = at
    host_end := to
    if at < to && u.buf[at] == '[' {
        // IPv6: [::1]:8080
        end_br := at
        for end_br < to && u.buf[end_br] != ']' {
            end_br++
        }
        if end_br == to {
            return false
        }
        host_end = end_br + 1
    } else {
        for k := at; k < to; k++ {
            if u.buf[k] == ':' {
                host_end = k
                break
            }
        }
    }
    u.host_n = host_end - at
    if host_end < to {
        if u.buf[host_end] != ':' || host_end + 1 == to {
            return false
        }
        p := 0
        if !str.parse_int(&u.buf[host_end + 1:to], &p) || p < 0 || p > 65535 {
            return false
        }
        u.port_n = p
    }
    return true
}

// scheme copies the scheme (http, https...) into dst; 0 if there's none.
pub fn (u &URL) scheme(dst &[]byte) int {
    return str.copy_bytes(dst, &u.buf[u.scheme_at:u.scheme_at + u.scheme_n])
}

// scheme_is compares the scheme, case-insensitively.
pub fn (u &URL) scheme_is(s string) bool {
    return eq_fold(&u.buf[u.scheme_at:u.scheme_at + u.scheme_n], s)
}

// host copies the host into dst (an IPv6 comes with the brackets: [::1]).
pub fn (u &URL) host(dst &[]byte) int {
    return str.copy_bytes(dst, &u.buf[u.host_at:u.host_at + u.host_n])
}

// host_is compares the host, case-insensitively.
pub fn (u &URL) host_is(s string) bool {
    return eq_fold(&u.buf[u.host_at:u.host_at + u.host_n], s)
}

// dial_host copies the host as net.connect expects it (an IPv6 without the
// brackets).
pub fn (u &URL) dial_host(dst &[]byte) int {
    if u.host_n >= 2 && u.buf[u.host_at] == '[' {
        return str.copy_bytes(dst, &u.buf[u.host_at + 1:u.host_at + u.host_n - 1])
    }
    return u.host(dst)
}

// has_port says whether the port was written in the text.
pub fn (u &URL) has_port() bool {
    return u.port_n >= 0
}

// port returns the port: the text's, or the scheme's (80 for http and ws, 443
// for https and wss, 21 for ftp); -1 if there's no way to know.
pub fn (u &URL) port() int {
    if u.port_n >= 0 {
        return u.port_n
    }
    if u.scheme_is("http") || u.scheme_is("ws") {
        return 80
    }
    if u.scheme_is("https") || u.scheme_is("wss") {
        return 443
    }
    if u.scheme_is("ftp") {
        return 21
    }
    return -1
}

// user copies the userinfo (user:password, before the @), not decoded; -1
// if there's none.
pub fn (u &URL) user(dst &[]byte) int {
    if u.user_n < 0 {
        return -1
    }
    return str.copy_bytes(dst, &u.buf[u.user_at:u.user_at + u.user_n])
}

// path copies the path, not decoded (it can be empty).
pub fn (u &URL) path(dst &[]byte) int {
    return str.copy_bytes(dst, &u.buf[u.path_at:u.path_at + u.path_n])
}

// query copies the query (after the ?), not decoded; -1 if there's no ?.
pub fn (u &URL) query(dst &[]byte) int {
    if u.query_n < 0 {
        return -1
    }
    return str.copy_bytes(dst, &u.buf[u.query_at:u.query_at + u.query_n])
}

// query_param copies the value of name in the query, decoded; -1 if it
// doesn't exist (or if the encoding is invalid).
pub fn (u &URL) query_param(name string, dst &[]byte) int {
    if u.query_n < 0 {
        return -1
    }
    return query_value(&u.buf[u.query_at:u.query_at + u.query_n], name, dst)
}

// fragment copies the fragment (after the #); -1 if there's none.
pub fn (u &URL) fragment(dst &[]byte) int {
    if u.frag_n < 0 {
        return -1
    }
    return str.copy_bytes(dst, &u.buf[u.frag_at:u.frag_at + u.frag_n])
}

// target copies the target of an HTTP request: the path (/ if empty) and the
// query, without the fragment.
pub fn (u &URL) target(dst &[]byte) int {
    n := 0
    if u.path_n == 0 {
        n = str.copy(dst, "/")
    } else {
        n = str.copy_bytes(dst, &u.buf[u.path_at:u.path_at + u.path_n])
    }
    if u.query_n >= 0 {
        n += str.copy(&dst[n:], "?")
        n += str.copy_bytes(&dst[n:], &u.buf[u.query_at:u.query_at + u.query_n])
    }
    return n
}

// ---------- queries ----------

// query_value looks for name in an already separated query (a=1&b=2&flag) and
// copies the value, decoded; 0 for a name without a value (flag), -1 if it
// doesn't exist or if the encoding is invalid.
pub fn query_value(query &[]byte, name string, dst &[]byte) int {
    at := 0
    for at <= len(query) {
        amp := at
        for amp < len(query) && query[amp] != '&' {
            amp++
        }
        eq := -1
        for k := at; k < amp; k++ {
            if query[k] == '=' {
                eq = k
                break
            }
        }
        key_end := amp
        if eq >= 0 {
            key_end = eq
        }
        if str.eq(&query[at:key_end], name) {
            if eq < 0 {
                return 0
            }
            return unescape(dst, &query[eq + 1:amp])
        }
        at = amp + 1
    }
    return -1
}

// Query builds a query, already encoded, in the 2 KB buffer inside it:
// the text is &q.buf[:q.n].
pub struct Query {
    buf [2048]byte
    n int
}

// add appends name=value (both encoded).
pub fn (q &Query) add(name string, value &[]byte) {
    var nb [256]byte
    k := str.copy(&nb, name)
    if q.n > 0 {
        q.put("&")
    }
    q.n += escape(&q.buf[q.n:], &nb[:k])
    q.put("=")
    q.n += escape(&q.buf[q.n:], value)
}

// add_str appends name=value, with value a fixed text in the program.
pub fn (q &Query) add_str(name string, value string) {
    var vb [1024]byte
    k := str.copy(&vb, value)
    q.add(name, &vb[:k])
}

// add_int appends name=value, with value an integer.
pub fn (q &Query) add_int(name string, value int) {
    var vb [24]byte
    k := str.put_int(&vb, value)
    q.add(name, &vb[:k])
}

// text copies the query into dst.
pub fn (q &Query) text(dst &[]byte) int {
    return str.copy_bytes(dst, &q.buf[:q.n])
}

fn (q &Query) put(s string) {
    if q.n + len(s) > len(q.buf) {
        fail("url.Query: the query doesn't fit in 2 KB")
    }
    q.n += str.copy(&q.buf[q.n:], s)
}

// ---------- encoding ----------

// unescape decodes %XX and + (space) from src into dst and returns the length,
// or -1 if a % isn't followed by two hex digits.
pub fn unescape(dst &[]byte, src &[]byte) int {
    n := 0
    i := 0
    for i < len(src) {
        c := src[i]
        if c == '%' {
            if i + 2 >= len(src) {
                return -1
            }
            hi := hex_value(src[i + 1])
            lo := hex_value(src[i + 2])
            if hi < 0 || lo < 0 {
                return -1
            }
            c = byte(hi * 16 + lo)
            i += 2
        } else if c == '+' {
            c = ' '
        }
        if n == len(dst) {
            fail("url.unescape: the destination is too small")
        }
        dst[n] = c
        n++
        i++
    }
    return n
}

// escape encodes src for use in a path or a query: letters,
// digits and - _ . ~ stay, the rest becomes %XX.
pub fn escape(dst &[]byte, src &[]byte) int {
    n := 0
    for i := 0; i < len(src); i++ {
        c := src[i]
        if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '~' {
            if n == len(dst) {
                fail("url.escape: the destination is too small")
            }
            dst[n] = c
            n++
        } else {
            if n + 3 > len(dst) {
                fail("url.escape: the destination is too small")
            }
            dst[n] = '%'
            dst[n + 1] = HEX[int(c >> 4)]
            dst[n + 2] = HEX[int(c & 0x0F)]
            n += 3
        }
    }
    return n
}

const HEX = "0123456789ABCDEF"

fn hex_value(c byte) int {
    if c >= '0' && c <= '9' {
        return int(c - '0')
    }
    if c >= 'a' && c <= 'f' {
        return int(c - 'a') + 10
    }
    if c >= 'A' && c <= 'F' {
        return int(c - 'A') + 10
    }
    return -1
}

// eq_fold compares b with s case-insensitively (ASCII).
fn eq_fold(b &[]byte, s string) bool {
    if len(b) != len(s) {
        return false
    }
    for i := 0; i < len(b); i++ {
        x := b[i]
        y := s[i]
        if x >= 'A' && x <= 'Z' {
            x += 32
        }
        if y >= 'A' && y <= 'Z' {
            y += 32
        }
        if x != y {
            return false
        }
    }
    return true
}

extern fn fail(msg string)
