// URLs (RFC 3986): ler as partes de um endereço e montar consultas. Nada
// aloca: a URL guarda uma cópia do texto num buffer fixo de 2 KB dentro
// dela, e as partes são copiadas para buffers de quem chama (ou comparadas
// sem cópia, com scheme_is e host_is).
//
//     var u url.URL
//     if !url.parse_str("https://api.exemplo.com:8443/v1/itens?id=7&q=caf%C3%A9#topo", &u) {
//         return
//     }
//     var host [256]byte
//     n := u.host(&host)                 // api.exemplo.com
//     porta := u.port()                  // 8443 (443 se não viesse no texto)
//     var alvo [512]byte
//     k := u.target(&alvo)               // /v1/itens?id=7&q=caf%C3%A9 (para o HTTP)
//     var q [64]byte
//     m := u.query_param("q", &q)        // café (decodificado)
//
// Para montar uma consulta, Query escreve os pares já codificados:
//
//     var q url.Query
//     q.add_str("busca", "café com leite")
//     q.add_int("pagina", 2)
//     // &q.buf[:q.n] é busca=caf%C3%A9+com+leite&pagina=2
//
// Também lê uma referência sem esquema nem host, como /caminho?a=1 (o alvo
// de um pedido HTTP).
import "std/str"

// BAD_URL é o código de erro de uma URL que não pôde ser lida.
pub const BAD_URL = 3101

// MAX_LEN é o maior texto de URL que cabe numa URL.
pub const MAX_LEN = 2048

// URL é uma URL lida por parse: o texto e onde fica cada parte.
pub struct URL {
    buf [2048]byte
    n int
    scheme_at int
    scheme_n int
    user_at int
    user_n int // -1: sem userinfo
    host_at int
    host_n int
    port_n int // a porta escrita no texto, -1 se não veio
    path_at int
    path_n int
    query_at int
    query_n int // -1: sem ?
    frag_at int
    frag_n int // -1: sem #
}

// parse lê s em u. Devolve false se s não for uma URL (esquema sem //,
// porta que não é número, texto maior que MAX_LEN).
pub fn parse(s &[]byte, u &URL) bool {
    if len(s) > MAX_LEN {
        return false
    }
    u.n = str.copy_bytes(&u.buf, s)
    u.scheme_at = 0
    u.scheme_n = 0
    u.user_at = 0
    u.user_n = -1
    u.host_at = 0
    u.host_n = 0
    u.port_n = -1
    u.query_at = 0
    u.query_n = -1
    u.frag_at = 0
    u.frag_n = -1
    i := 0
    // esquema: letras, dígitos, + - . e depois "://"
    sc := scheme_end(&u.buf, u.n)
    if sc > 0 {
        if sc + 3 > u.n || u.buf[sc + 1] != '/' || u.buf[sc + 2] != '/' {
            return false
        }
        u.scheme_n = sc
        i = sc + 3
        // autoridade: até o primeiro / ? ou #
        end := i
        for end < u.n && u.buf[end] != '/' && u.buf[end] != '?' && u.buf[end] != '#' {
            end++
        }
        if !u.authority(i, end) {
            return false
        }
        i = end
    }
    u.path_at = i
    for i < u.n && u.buf[i] != '?' && u.buf[i] != '#' {
        i++
    }
    u.path_n = i - u.path_at
    if i < u.n && u.buf[i] == '?' {
        i++
        u.query_at = i
        for i < u.n && u.buf[i] != '#' {
            i++
        }
        u.query_n = i - u.query_at
    }
    if i < u.n && u.buf[i] == '#' {
        u.frag_at = i + 1
        u.frag_n = u.n - u.frag_at
    }
    return true
}

// parse_str é parse de um texto fixo do programa.
pub fn parse_str(s string, u &URL) bool {
    var b [2048]byte
    if len(s) > len(b) {
        return false
    }
    n := str.copy(&b, s)
    return parse(&b[:n], u)
}

// scheme_end devolve onde termina o esquema (o índice do ':'), ou 0 se o
// texto não começa com um.
fn scheme_end(b &[]byte, n int) int {
    for i := 0; i < n; i++ {
        c := b[i]
        letter := (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
        ok := letter || (i > 0 && ((c >= '0' && c <= '9') || c == '+' || c == '-' || c == '.'))
        if c == ':' {
            return i
        }
        if !ok {
            return 0
        }
    }
    return 0
}

// authority lê [userinfo@]host[:porta] em buf[from:to].
fn (u &URL) authority(from int, to int) bool {
    at := from
    for k := from; k < to; k++ {
        if u.buf[k] == '@' {
            u.user_at = from
            u.user_n = k - from
            at = k + 1
        }
    }
    u.host_at = at
    host_end := to
    if at < to && u.buf[at] == '[' {
        // IPv6: [::1]:8080
        end_br := at
        for end_br < to && u.buf[end_br] != ']' {
            end_br++
        }
        if end_br == to {
            return false
        }
        host_end = end_br + 1
    } else {
        for k := at; k < to; k++ {
            if u.buf[k] == ':' {
                host_end = k
                break
            }
        }
    }
    u.host_n = host_end - at
    if host_end < to {
        if u.buf[host_end] != ':' || host_end + 1 == to {
            return false
        }
        p := 0
        if !str.parse_int(&u.buf[host_end + 1:to], &p) || p < 0 || p > 65535 {
            return false
        }
        u.port_n = p
    }
    return true
}

// scheme copia o esquema (http, https...) para dst; 0 se não há.
pub fn (u &URL) scheme(dst &[]byte) int {
    return str.copy_bytes(dst, &u.buf[u.scheme_at:u.scheme_at + u.scheme_n])
}

// scheme_is compara o esquema, sem diferenciar maiúsculas.
pub fn (u &URL) scheme_is(s string) bool {
    return eq_fold(&u.buf[u.scheme_at:u.scheme_at + u.scheme_n], s)
}

// host copia o host para dst (um IPv6 vem com os colchetes: [::1]).
pub fn (u &URL) host(dst &[]byte) int {
    return str.copy_bytes(dst, &u.buf[u.host_at:u.host_at + u.host_n])
}

// host_is compara o host, sem diferenciar maiúsculas.
pub fn (u &URL) host_is(s string) bool {
    return eq_fold(&u.buf[u.host_at:u.host_at + u.host_n], s)
}

// dial_host copia o host como net.connect espera (um IPv6 sem os
// colchetes).
pub fn (u &URL) dial_host(dst &[]byte) int {
    if u.host_n >= 2 && u.buf[u.host_at] == '[' {
        return str.copy_bytes(dst, &u.buf[u.host_at + 1:u.host_at + u.host_n - 1])
    }
    return u.host(dst)
}

// has_port diz se a porta veio escrita no texto.
pub fn (u &URL) has_port() bool {
    return u.port_n >= 0
}

// port devolve a porta: a do texto, ou a do esquema (80 para http e ws, 443
// para https e wss, 21 para ftp); -1 se não há como saber.
pub fn (u &URL) port() int {
    if u.port_n >= 0 {
        return u.port_n
    }
    if u.scheme_is("http") || u.scheme_is("ws") {
        return 80
    }
    if u.scheme_is("https") || u.scheme_is("wss") {
        return 443
    }
    if u.scheme_is("ftp") {
        return 21
    }
    return -1
}

// user copia o userinfo (usuario:senha, antes do @), sem decodificar; -1
// se não há.
pub fn (u &URL) user(dst &[]byte) int {
    if u.user_n < 0 {
        return -1
    }
    return str.copy_bytes(dst, &u.buf[u.user_at:u.user_at + u.user_n])
}

// path copia o caminho, sem decodificar (pode ser vazio).
pub fn (u &URL) path(dst &[]byte) int {
    return str.copy_bytes(dst, &u.buf[u.path_at:u.path_at + u.path_n])
}

// query copia a consulta (depois do ?), sem decodificar; -1 se não há ?.
pub fn (u &URL) query(dst &[]byte) int {
    if u.query_n < 0 {
        return -1
    }
    return str.copy_bytes(dst, &u.buf[u.query_at:u.query_at + u.query_n])
}

// query_param copia o valor de name na consulta, decodificado; -1 se ele
// não existe (ou se a codificação é inválida).
pub fn (u &URL) query_param(name string, dst &[]byte) int {
    if u.query_n < 0 {
        return -1
    }
    return query_value(&u.buf[u.query_at:u.query_at + u.query_n], name, dst)
}

// fragment copia o fragmento (depois do #); -1 se não há.
pub fn (u &URL) fragment(dst &[]byte) int {
    if u.frag_n < 0 {
        return -1
    }
    return str.copy_bytes(dst, &u.buf[u.frag_at:u.frag_at + u.frag_n])
}

// target copia o alvo de um pedido HTTP: o caminho (/ se vazio) e a
// consulta, sem o fragmento.
pub fn (u &URL) target(dst &[]byte) int {
    n := 0
    if u.path_n == 0 {
        n = str.copy(dst, "/")
    } else {
        n = str.copy_bytes(dst, &u.buf[u.path_at:u.path_at + u.path_n])
    }
    if u.query_n >= 0 {
        n += str.copy(&dst[n:], "?")
        n += str.copy_bytes(&dst[n:], &u.buf[u.query_at:u.query_at + u.query_n])
    }
    return n
}

// ---------- consultas ----------

// query_value procura name numa consulta já separada (a=1&b=2&flag) e
// copia o valor, decodificado; 0 para um nome sem valor (flag), -1 se ele
// não existe ou se a codificação é inválida.
pub fn query_value(query &[]byte, name string, dst &[]byte) int {
    at := 0
    for at <= len(query) {
        amp := at
        for amp < len(query) && query[amp] != '&' {
            amp++
        }
        eq := -1
        for k := at; k < amp; k++ {
            if query[k] == '=' {
                eq = k
                break
            }
        }
        key_end := amp
        if eq >= 0 {
            key_end = eq
        }
        if str.eq(&query[at:key_end], name) {
            if eq < 0 {
                return 0
            }
            return unescape(dst, &query[eq + 1:amp])
        }
        at = amp + 1
    }
    return -1
}

// Query monta uma consulta, já codificada, no buffer de 2 KB dentro dela:
// o texto é &q.buf[:q.n].
pub struct Query {
    buf [2048]byte
    n int
}

// add acrescenta name=value (os dois codificados).
pub fn (q &Query) add(name string, value &[]byte) {
    var nb [256]byte
    k := str.copy(&nb, name)
    if q.n > 0 {
        q.put("&")
    }
    q.n += escape(&q.buf[q.n:], &nb[:k])
    q.put("=")
    q.n += escape(&q.buf[q.n:], value)
}

// add_str acrescenta name=value, com value um texto fixo do programa.
pub fn (q &Query) add_str(name string, value string) {
    var vb [1024]byte
    k := str.copy(&vb, value)
    q.add(name, &vb[:k])
}

// add_int acrescenta name=value, com value um inteiro.
pub fn (q &Query) add_int(name string, value int) {
    var vb [24]byte
    k := str.put_int(&vb, value)
    q.add(name, &vb[:k])
}

// text copia a consulta para dst.
pub fn (q &Query) text(dst &[]byte) int {
    return str.copy_bytes(dst, &q.buf[:q.n])
}

fn (q &Query) put(s string) {
    if q.n + len(s) > len(q.buf) {
        fail("url.Query: a consulta não cabe em 2 KB")
    }
    q.n += str.copy(&q.buf[q.n:], s)
}

// ---------- codificação ----------

// unescape decodifica %XX e + (espaço) de src para dst e devolve o tamanho,
// ou -1 se um % não for seguido de dois dígitos hex.
pub fn unescape(dst &[]byte, src &[]byte) int {
    n := 0
    i := 0
    for i < len(src) {
        c := src[i]
        if c == '%' {
            if i + 2 >= len(src) {
                return -1
            }
            hi := hex_value(src[i + 1])
            lo := hex_value(src[i + 2])
            if hi < 0 || lo < 0 {
                return -1
            }
            c = byte(hi * 16 + lo)
            i += 2
        } else if c == '+' {
            c = ' '
        }
        if n == len(dst) {
            fail("url.unescape: o destino é pequeno demais")
        }
        dst[n] = c
        n++
        i++
    }
    return n
}

// escape codifica src para usar num caminho ou numa consulta: letras,
// dígitos e - _ . ~ ficam, o resto vira %XX.
pub fn escape(dst &[]byte, src &[]byte) int {
    n := 0
    for i := 0; i < len(src); i++ {
        c := src[i]
        if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '~' {
            if n == len(dst) {
                fail("url.escape: o destino é pequeno demais")
            }
            dst[n] = c
            n++
        } else {
            if n + 3 > len(dst) {
                fail("url.escape: o destino é pequeno demais")
            }
            dst[n] = '%'
            dst[n + 1] = HEX[int(c >> 4)]
            dst[n + 2] = HEX[int(c & 0x0F)]
            n += 3
        }
    }
    return n
}

const HEX = "0123456789ABCDEF"

fn hex_value(c byte) int {
    if c >= '0' && c <= '9' {
        return int(c - '0')
    }
    if c >= 'a' && c <= 'f' {
        return int(c - 'a') + 10
    }
    if c >= 'A' && c <= 'F' {
        return int(c - 'A') + 10
    }
    return -1
}

// eq_fold compara b com s sem diferenciar maiúsculas (ASCII).
fn eq_fold(b &[]byte, s string) bool {
    if len(b) != len(s) {
        return false
    }
    for i := 0; i < len(b); i++ {
        x := b[i]
        y := s[i]
        if x >= 'A' && x <= 'Z' {
            x += 32
        }
        if y >= 'A' && y <= 'Z' {
            y += 32
        }
        if x != y {
            return false
        }
    }
    return true
}

extern fn fail(msg string)
