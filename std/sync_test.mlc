import "std/atomic"
import "std/sync"
import "std/testing"
import "std/thread"
import "std/time"

fn add_ten(n *atomic.Int) {
    for i := 0; i < 10; i++ {
        n.add(1)
    }
    n.close()
}

fn test_group() {
    n := atomic.new_int(0)
    g := sync.group(8)
    for i := 0; i < 8; i++ {
        g.add(thread.spawn(add_ten, n.clone(), thread.STACK_64KB))
    }
    testing.eq_int(g.len(), 8)
    g.wait()
    testing.eq_int(n.load(), 80) // wait only returns after all of them
    n.close()
}

fn test_empty_group() {
    g := sync.group(0)
    g.wait()
}

fn nothing(n int) {
}

// more threads than the capacity: add waits for a slot
fn test_more_threads_than_capacity() {
    n := atomic.new_int(0)
    g := sync.group(3)
    for i := 0; i < 50; i++ {
        g.add(thread.spawn(add_ten, n.clone(), thread.STACK_64KB))
        testing.check(g.len() <= 3, "never more than the capacity")
    }
    g.wait()
    testing.eq_int(n.load(), 500)
    n.close()
}

fn test_reap() {
    g := sync.group(4)
    g.add(thread.spawn(nothing, 1, thread.STACK_64KB))
    g.add(thread.spawn(nothing, 2, thread.STACK_64KB))
    time.sleep_ms(50) // both finish
    testing.eq_int(g.reap(), 2)
    testing.eq_int(g.len(), 0)
    testing.eq_int(g.reap(), 0)
    g.wait()
}

fn test_zero_capacity() {
    testing.expect_panic()
    g := sync.group(0)
    g.add(thread.spawn(nothing, 1, thread.STACK_64KB))
    g.wait()
}
