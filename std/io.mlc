// Entrada e saída padrão. Nada aqui aloca: read_line lê num buffer de quem
// chama, e a escrita formatada passa por um Writer com buffer fixo na pilha.
//
// io.print(a, b, ...) e io.printf("x = {}\n", x) são reescritos pelo
// compilador em chamadas aos métodos write (da interface Display) de cada
// valor, sobre um Writer. Toda a formatação está aqui, em MLC; só a dos
// números reais e a escrita no arquivo ficam no runtime C.
import "std/result"

// write escreve os bytes de s, sem quebra de linha.
pub extern fn write(s &[]byte)

// write_line escreve os bytes de s e uma quebra de linha.
pub extern fn write_line(s &[]byte)

// read_line lê uma linha (sem o \n) para o começo de dst e devolve quantos
// bytes leu. Se a linha não couber, o resto fica para a próxima chamada.
// No fim da entrada devolve -1.
pub extern fn read_line(dst &[]byte) int

// ---------- leitura genérica ----------

// EOF é o erro que os leitores com buffer (std/bufio) devolvem no fim dos
// dados.
pub const EOF = 1003

// Reader é qualquer fonte de bytes: fs.File, net.Conn, io.stdin() ou um
// tipo seu. read lê até len(dst) bytes no começo de dst e devolve quantos
// leu; Ok(0) (com dst não vazio) é o fim dos dados. Pode ler menos que
// len(dst) mesmo antes do fim. std/bufio lê linhas e blocos de qualquer
// Reader.
pub interface Reader {
    fn read(self &Self, dst &[]byte) result.Result[int, int]
}

// Stdin é a entrada padrão como Reader. Ele lê pelo mesmo buffer de
// io.read_line, então os dois podem ser misturados.
pub struct Stdin {
    fd int
}

extern fn read_stdin(dst &[]byte) int

// stdin devolve a entrada padrão como Reader (um valor na pilha, sem nada
// para liberar).
pub fn stdin() Stdin {
    return Stdin{fd: 0}
}

// read lê o que estiver disponível, até len(dst) bytes, parando depois de
// um \n (no terminal, uma linha por vez).
pub fn (s &Stdin) read(dst &[]byte) result.Result[int, int] {
    n := read_stdin(dst)
    if n < 0 {
        return result.Result.Err(-n)
    }
    return result.Result.Ok(n)
}

impl Reader for Stdin

// ---------- escrita formatada ----------

// Display é o que io.print e io.printf sabem escrever. Para structs e
// enums, impl auto io.Display for T gera o write no formato {1 2} /
// Circulo(2); ou escreva o método à mão.
pub interface Display {
    fn write(self &Self, w &Writer)
}

// Writer junta a saída num buffer fixo e a entrega quando enche ou no
// flush: num arquivo (fd 1: saída padrão, 2: erro padrão), num destino do
// str.format (SINK) ou em lugar nenhum, só contando (COUNT, para o
// str.format_len).
//
// Durante o write de um valor de io.printf ou str.format com especificação
// ({:x}, {:08.2}), os campos width, zero, prec, base, upper e alt dizem
// como escrever números; o compilador os põe antes do write e os limpa
// depois. O alinhamento ({:>8}) é feito em volta do write, por pad_before e
// pad_after.
pub struct Writer {
    buf [256]byte
    n int
    fd int    // 1 ou 2: arquivo; SINK ou COUNT
    sink int  // com fd == SINK: o destino do str.format (conferido no runtime)
    total int // bytes escritos desde a criação
    chars int // caracteres escritos (UTF-8: os bytes que não são de continuação)
    width int // largura mínima de um número com zero (o 0 de {:08})
    zero bool
    prec int   // casas decimais de um real, mais 1 (0: o menor número de dígitos)
    base int   // 16, 2 ou 8 ({:x}, {:b}, {:o}); 0: decimal
    upper bool // {:X}
    alt bool   // {:#x}: prefixo 0x, 0b ou 0o
}

const SINK = -1
const COUNT = -2

extern fn write_fd(fd int, b &[]byte)
extern fn sink_put(sink int, b &[]byte)
extern fn format_f64(dst &[]byte, x float64) int
extern fn format_f32(dst &[]byte, x float32) int
extern fn format_fixed(dst &[]byte, x float64, prec int) int

// stdout cria um Writer para a saída padrão.
pub fn stdout() Writer {
    var w Writer
    w.fd = 1
    return w
}

// stderr cria um Writer para o erro padrão.
pub fn stderr() Writer {
    var w Writer
    w.fd = 2
    return w
}

// flush entrega o que está no buffer.
pub fn (w &Writer) flush() {
    if w.n > 0 {
        if w.fd == SINK {
            sink_put(w.sink, &w.buf[:w.n])
        } else if w.fd != COUNT {
            write_fd(w.fd, &w.buf[:w.n])
        }
        w.n = 0
    }
}

pub fn (w &Writer) put_byte(b byte) {
    if w.n == len(w.buf) {
        w.flush()
    }
    w.buf[w.n] = b
    w.n++
    w.total++
    if b & 0xC0 != 0x80 {
        w.chars++
    }
}

pub fn (w &Writer) put_bytes(b &[]byte) {
    for i := 0; i < len(b); i++ {
        w.put_byte(b[i])
    }
}

pub fn (w &Writer) put_str(s string) {
    for i := 0; i < len(s); i++ {
        w.put_byte(s[i])
    }
}

// PAIRS tem os pares de dígitos de 00 a 99: o put_int rápido escreve dois
// dígitos por divisão.
const PAIRS = "00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899"

// put_int escreve n em decimal (ou na base da especificação).
pub fn (w &Writer) put_int(n int) {
    if w.base != 0 || w.zero || w.alt {
        w.put_int_spec(n)
        return
    }
    // a magnitude sem sinal, sem estourar no menor int (que não tem positivo)
    var u uint64 = 0
    if n < 0 {
        u = uint64(-(n + 1)) + 1
    } else {
        u = uint64(n)
    }
    var d [20]byte
    k := decimal(&d, u)
    if n < 0 {
        k--
        d[k] = '-'
    }
    w.put_ascii(&d[k:])
}

pub fn (w &Writer) put_uint(n uint64) {
    if w.base != 0 || w.zero || w.alt {
        w.put_uint_spec(n)
        return
    }
    var d [20]byte
    k := decimal(&d, n)
    w.put_ascii(&d[k:])
}

// decimal escreve u em decimal no fim de d (20 posições bastam para
// qualquer uint64) e devolve onde os dígitos começam. Divide por 100, uma
// constante (que o compilador C troca por uma multiplicação), e escreve dois
// dígitos por vez.
fn decimal(d &[]byte, u uint64) int {
    k := len(d)
    for u >= 100 {
        q := u / 100
        r := int(u -% q *% 100) * 2
        k -= 2
        d[k] = PAIRS[r]
        d[k + 1] = PAIRS[r + 1]
        u = q
    }
    if u >= 10 {
        r := int(u) * 2
        k -= 2
        d[k] = PAIRS[r]
        d[k + 1] = PAIRS[r + 1]
    } else {
        k--
        d[k] = byte(int('0') + int(u))
    }
    return k
}

// put_ascii escreve bytes ASCII (os dígitos e o sinal de um número): sem
// bytes de continuação de UTF-8, cada byte é um caractere, e a cópia vai
// direto para o buffer quando cabe.
fn (w &Writer) put_ascii(b &[]byte) {
    if w.n + len(b) > len(w.buf) {
        w.flush()
        if len(b) > len(w.buf) {
            w.put_bytes(b)
            return
        }
    }
    for i := 0; i < len(b); i++ {
        w.buf[w.n + i] = b[i]
    }
    w.n += len(b)
    w.total += len(b)
    w.chars += len(b)
}

// put_int_spec escreve n com a especificação ({:x}, {:08}, {:#b}). Os
// dígitos são tirados com n negativo, para o menor int funcionar também.
fn (w &Writer) put_int_spec(n int) {
    neg := n < 0
    if !neg {
        n = -n
    }
    base := w.radix()
    var d [64]byte
    k := len(d)
    for {
        k--
        d[k] = w.digit(-(n % base))
        n = n / base
        if n == 0 {
            break
        }
    }
    w.put_number(neg, &d[k:])
}

fn (w &Writer) put_uint_spec(n uint64) {
    base := uint64(w.radix())
    var d [64]byte
    k := len(d)
    for {
        k--
        d[k] = w.digit(int(n % base))
        n = n / base
        if n == 0 {
            break
        }
    }
    w.put_number(false, &d[k:])
}

fn (w &Writer) radix() int {
    if w.base == 0 {
        return 10
    }
    return w.base
}

fn (w &Writer) digit(d int) byte {
    if d < 10 {
        return byte(int('0') + d)
    }
    if w.upper {
        return byte(int('A') + d - 10)
    }
    return byte(int('a') + d - 10)
}

// put_number escreve o sinal, o prefixo ({:#x}), os zeros à esquerda ({:08})
// e os dígitos.
fn (w &Writer) put_number(neg bool, digits &[]byte) {
    k := len(digits)
    if neg {
        w.put_byte('-')
        k++
    }
    if w.alt && w.base != 0 {
        w.put_byte('0')
        if w.base == 16 {
            w.put_byte('x')
        } else if w.base == 2 {
            w.put_byte('b')
        } else {
            w.put_byte('o')
        }
        k += 2
    }
    if w.zero {
        for; k < w.width; k++ {
            w.put_byte('0')
        }
    }
    w.put_bytes(digits)
}

// put_float escreve x com o menor número de dígitos que o representa
// exatamente (0.1, 1000, 1e+21), como o Go; com {:.2}, com duas casas.
pub fn (w &Writer) put_float(x float64) {
    var d [352]byte
    k := 0
    if w.prec > 0 {
        k = format_fixed(&d, x, w.prec - 1)
    } else {
        k = format_f64(&d, x)
    }
    w.put_real(&d[:k])
}

pub fn (w &Writer) put_f32(x float32) {
    var d [352]byte
    k := 0
    if w.prec > 0 {
        k = format_fixed(&d, float64(x), w.prec - 1)
    } else {
        k = format_f32(&d, x)
    }
    w.put_real(&d[:k])
}

fn (w &Writer) put_real(d &[]byte) {
    if len(d) > 0 && d[0] == '-' {
        w.put_number(true, &d[1:])
    } else {
        w.put_number(false, d)
    }
}

pub fn (w &Writer) put_bool(b bool) {
    if b {
        w.put_str("true")
    } else {
        w.put_str("false")
    }
}

// ---------- especificação de formato ({:...}) ----------
//
// io.printf("{:>8.2}", x) vira, em essência:
//
//     w.spec_begin(8, false, 3, 0, false, false)
//     m := w.measure()              // um Writer que só conta
//     x.write(&m)
//     w.pad_before(' ', '>', 8, m.chars)
//     antes := w.chars
//     x.write(&w)
//     w.pad_after(' ', '>', 8, w.chars - antes)
//     w.spec_end()
//
// A largura conta caracteres, não bytes: "café" ocupa 4.

// spec_begin guarda a especificação para os números do próximo write.
pub fn (w &Writer) spec_begin(width int, zero bool, prec int, base int, upper bool, alt bool) {
    w.width = width
    w.zero = zero
    w.prec = prec
    w.base = base
    w.upper = upper
    w.alt = alt
}

// spec_end volta ao formato comum.
pub fn (w &Writer) spec_end() {
    w.spec_begin(0, false, 0, 0, false, false)
}

// measure devolve um Writer com a mesma especificação que só conta os
// bytes: escrever o valor nele dá o tamanho, para alinhar à direita ou no
// centro.
pub fn (w &Writer) measure() Writer {
    m := *w
    m.fd = COUNT
    m.n = 0
    m.total = 0
    m.chars = 0
    return m
}

// pad_before completa a largura antes do valor (alinhado à direita ou no
// centro); size é o tamanho do valor, em caracteres.
pub fn (w &Writer) pad_before(fill byte, align byte, width int, size int) {
    if align == '>' {
        w.pad(fill, width - size)
    } else if align == '^' {
        w.pad(fill, (width - size) / 2)
    }
}

// pad_after completa a largura depois do valor (alinhado à esquerda ou no
// centro); size é o tamanho do valor, em caracteres.
pub fn (w &Writer) pad_after(fill byte, align byte, width int, size int) {
    if align == '<' {
        w.pad(fill, width - size)
    } else if align == '^' {
        w.pad(fill, width - size - (width - size) / 2)
    }
}

fn (w &Writer) pad(fill byte, n int) {
    for i := 0; i < n; i++ {
        w.put_byte(fill)
    }
}

// ---------- Display dos tipos embutidos ----------

impl Display for int {
    fn (x &int) write(w &Writer) {
        w.put_int(*x)
    }
}

impl Display for int8 {
    fn (x &int8) write(w &Writer) {
        w.put_int(int(*x))
    }
}

impl Display for int16 {
    fn (x &int16) write(w &Writer) {
        w.put_int(int(*x))
    }
}

impl Display for int32 {
    fn (x &int32) write(w &Writer) {
        w.put_int(int(*x))
    }
}

impl Display for byte {
    fn (x &byte) write(w &Writer) {
        w.put_int(int(*x))
    }
}

impl Display for uint16 {
    fn (x &uint16) write(w &Writer) {
        w.put_uint(uint64(*x))
    }
}

impl Display for uint32 {
    fn (x &uint32) write(w &Writer) {
        w.put_uint(uint64(*x))
    }
}

impl Display for uint64 {
    fn (x &uint64) write(w &Writer) {
        w.put_uint(*x)
    }
}

impl Display for float64 {
    fn (x &float64) write(w &Writer) {
        w.put_float(*x)
    }
}

impl Display for float32 {
    fn (x &float32) write(w &Writer) {
        w.put_f32(*x)
    }
}

impl Display for bool {
    fn (x &bool) write(w &Writer) {
        w.put_bool(*x)
    }
}

impl Display for string {
    fn (x &string) write(w &Writer) {
        w.put_str(*x)
    }
}

// Um slice (ou array) é escrito como [a b c].
impl[T Display] Display for []T {
    fn (s &[]T) write(w &Writer) {
        w.put_byte('[')
        for i := 0; i < len(s); i++ {
            if i > 0 {
                w.put_byte(' ')
            }
            s[i].write(w)
        }
        w.put_byte(']')
    }
}
