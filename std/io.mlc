// Standard input and output. Nothing here allocates: read_line reads into a buffer of the
// caller's, and formatted writing goes through a Writer with a fixed buffer on the stack.
//
// io.print(a, b, ...) and io.printf("x = {}\n", x) are rewritten by the
// compiler into calls to each value's write methods (from the Display interface),
// over a Writer. All the formatting is here, in MLC; only the formatting of
// real numbers and the writing to the file stay in the C runtime.
import "std/result"

// write writes the bytes of s, without a line break.
pub extern fn write(s &[]byte)

// write_line writes the bytes of s and a line break.
pub extern fn write_line(s &[]byte)

// read_line reads a line (without the \n) into the start of dst and returns how many
// bytes it read. If the line doesn't fit, the rest is left for the next call.
// At the end of the input returns -1.
pub extern fn read_line(dst &[]byte) int

// ---------- generic reading ----------

// EOF is the error the buffered readers (std/bufio) return at the end of the
// data.
pub const EOF = 1003

// Reader is any source of bytes: fs.File, net.Conn, io.stdin() or a
// type of yours. read reads up to len(dst) bytes at the start of dst and returns how many
// it read; Ok(0) (with a non-empty dst) is the end of the data. It may read less than
// len(dst) even before the end. std/bufio reads lines and blocks from any
// Reader.
pub interface Reader {
    fn read(self &Self, dst &[]byte) result.Result[int, int]
}

// Stdin is standard input as a Reader. It reads through the same buffer as
// io.read_line, so the two can be mixed.
pub struct Stdin {
    fd int
}

extern fn read_stdin(dst &[]byte) int

// stdin returns standard input as a Reader (a value on the stack, with nothing
// to free).
pub fn stdin() Stdin {
    return Stdin{fd: 0}
}

// read reads whatever is available, up to len(dst) bytes, stopping after
// a \n (on the terminal, one line at a time).
pub fn (s &Stdin) read(dst &[]byte) result.Result[int, int] {
    n := read_stdin(dst)
    if n < 0 {
        return result.Result.Err(-n)
    }
    return result.Result.Ok(n)
}

impl Reader for Stdin

// ---------- formatted writing ----------

// Display is what io.print and io.printf know how to write. For structs and
// enums, impl auto io.Display for T generates write in the format {1 2} /
// Circle(2); or write the method by hand.
pub interface Display {
    fn write(self &Self, w &Writer)
}

// Writer gathers the output in a fixed buffer and delivers it when full or on
// flush: to a file (fd 1: standard output, 2: standard error), to a str.format
// destination (SINK) or nowhere, only counting (COUNT, for
// str.format_len).
//
// During the write of a value from io.printf or str.format with a spec
// ({:x}, {:08.2}), the fields width, zero, prec, base, upper and alt say
// how to write numbers; the compiler sets them before the write and clears them
// after. Alignment ({:>8}) is done around the write, by pad_before and
// pad_after.
pub struct Writer {
    buf [256]byte
    n int
    fd int    // 1 or 2: file; SINK or COUNT
    sink int  // with fd == SINK: the str.format destination (checked at run time)
    total int // bytes written since creation
    chars int // characters written (UTF-8: the bytes that aren't continuation bytes)
    width int // minimum width of a zero-padded number (the 0 of {:08})
    zero bool
    prec int   // decimal places of a real, plus 1 (0: the fewest digits)
    base int   // 16, 2 or 8 ({:x}, {:b}, {:o}); 0: decimal
    upper bool // {:X}
    alt bool   // {:#x}: prefix 0x, 0b or 0o
}

const SINK = -1
const COUNT = -2

extern fn write_fd(fd int, b &[]byte)
extern fn sink_put(sink int, b &[]byte)
extern fn format_f64(dst &[]byte, x float64) int
extern fn format_f32(dst &[]byte, x float32) int
extern fn format_fixed(dst &[]byte, x float64, prec int) int

// stdout creates a Writer for standard output.
pub fn stdout() Writer {
    var w Writer
    w.fd = 1
    return w
}

// stderr creates a Writer for standard error.
pub fn stderr() Writer {
    var w Writer
    w.fd = 2
    return w
}

// flush delivers what's in the buffer.
pub fn (w &Writer) flush() {
    if w.n > 0 {
        if w.fd == SINK {
            sink_put(w.sink, &w.buf[:w.n])
        } else if w.fd != COUNT {
            write_fd(w.fd, &w.buf[:w.n])
        }
        w.n = 0
    }
}

// put_byte writes a byte.
pub fn (w &Writer) put_byte(b byte) {
    if w.n == len(w.buf) {
        w.flush()
    }
    w.buf[w.n] = b
    w.n++
    w.total++
    if b & 0xC0 != 0x80 {
        w.chars++
    }
}

// put_bytes writes the bytes of b.
pub fn (w &Writer) put_bytes(b &[]byte) {
    for i := 0; i < len(b); i++ {
        w.put_byte(b[i])
    }
}

// put_str writes the text of s.
pub fn (w &Writer) put_str(s string) {
    for i := 0; i < len(s); i++ {
        w.put_byte(s[i])
    }
}

// PAIRS has the digit pairs from 00 to 99: the fast put_int writes two
// digits per division.
const PAIRS = "00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899"

// put_int writes n in decimal (or in the spec's base).
pub fn (w &Writer) put_int(n int) {
    if w.base != 0 || w.zero || w.alt {
        w.put_int_spec(n)
        return
    }
    // the unsigned magnitude, without overflowing on the smallest int (which has no positive)
    var u uint64 = 0
    if n < 0 {
        u = uint64(-(n + 1)) + 1
    } else {
        u = uint64(n)
    }
    var d [20]byte
    k := decimal(&d, u)
    if n < 0 {
        k--
        d[k] = '-'
    }
    w.put_ascii(&d[k:])
}

// put_uint writes n, unsigned, with the requested format ({:x}, {:08}...).
pub fn (w &Writer) put_uint(n uint64) {
    if w.base != 0 || w.zero || w.alt {
        w.put_uint_spec(n)
        return
    }
    var d [20]byte
    k := decimal(&d, n)
    w.put_ascii(&d[k:])
}

// decimal writes u in decimal at the end of d (20 positions are enough for
// any uint64) and returns where the digits start. It divides by 100, a
// constant (which the C compiler turns into a multiplication), and writes two
// digits at a time.
fn decimal(d &[]byte, u uint64) int {
    k := len(d)
    for u >= 100 {
        q := u / 100
        r := int(u -% q *% 100) * 2
        k -= 2
        d[k] = PAIRS[r]
        d[k + 1] = PAIRS[r + 1]
        u = q
    }
    if u >= 10 {
        r := int(u) * 2
        k -= 2
        d[k] = PAIRS[r]
        d[k + 1] = PAIRS[r + 1]
    } else {
        k--
        d[k] = byte(int('0') + int(u))
    }
    return k
}

// put_ascii writes ASCII bytes (the digits and the sign of a number): with no
// UTF-8 continuation bytes, each byte is a character, and the copy goes
// straight into the buffer when it fits.
fn (w &Writer) put_ascii(b &[]byte) {
    if w.n + len(b) > len(w.buf) {
        w.flush()
        if len(b) > len(w.buf) {
            w.put_bytes(b)
            return
        }
    }
    for i := 0; i < len(b); i++ {
        w.buf[w.n + i] = b[i]
    }
    w.n += len(b)
    w.total += len(b)
    w.chars += len(b)
}

// put_int_spec writes n with the spec ({:x}, {:08}, {:#b}). The
// digits are taken with n negative, so the smallest int works too.
fn (w &Writer) put_int_spec(n int) {
    neg := n < 0
    if !neg {
        n = -n
    }
    base := w.radix()
    var d [64]byte
    k := len(d)
    for {
        k--
        d[k] = w.digit(-(n % base))
        n = n / base
        if n == 0 {
            break
        }
    }
    w.put_number(neg, &d[k:])
}

fn (w &Writer) put_uint_spec(n uint64) {
    base := uint64(w.radix())
    var d [64]byte
    k := len(d)
    for {
        k--
        d[k] = w.digit(int(n % base))
        n = n / base
        if n == 0 {
            break
        }
    }
    w.put_number(false, &d[k:])
}

fn (w &Writer) radix() int {
    if w.base == 0 {
        return 10
    }
    return w.base
}

fn (w &Writer) digit(d int) byte {
    if d < 10 {
        return byte(int('0') + d)
    }
    if w.upper {
        return byte(int('A') + d - 10)
    }
    return byte(int('a') + d - 10)
}

// put_number writes the sign, the prefix ({:#x}), the leading zeros ({:08})
// and the digits.
fn (w &Writer) put_number(neg bool, digits &[]byte) {
    k := len(digits)
    if neg {
        w.put_byte('-')
        k++
    }
    if w.alt && w.base != 0 {
        w.put_byte('0')
        if w.base == 16 {
            w.put_byte('x')
        } else if w.base == 2 {
            w.put_byte('b')
        } else {
            w.put_byte('o')
        }
        k += 2
    }
    if w.zero {
        for; k < w.width; k++ {
            w.put_byte('0')
        }
    }
    w.put_bytes(digits)
}

// put_float writes x with the fewest digits that represent it
// exactly (0.1, 1000, 1e+21), like Go; with {:.2}, with two decimal places.
pub fn (w &Writer) put_float(x float64) {
    var d [352]byte
    k := 0
    if w.prec > 0 {
        k = format_fixed(&d, x, w.prec - 1)
    } else {
        k = format_f64(&d, x)
    }
    w.put_real(&d[:k])
}

// put_f32 writes x, with the requested format ({:.2}...).
pub fn (w &Writer) put_f32(x float32) {
    var d [352]byte
    k := 0
    if w.prec > 0 {
        k = format_fixed(&d, float64(x), w.prec - 1)
    } else {
        k = format_f32(&d, x)
    }
    w.put_real(&d[:k])
}

fn (w &Writer) put_real(d &[]byte) {
    if len(d) > 0 && d[0] == '-' {
        w.put_number(true, &d[1:])
    } else {
        w.put_number(false, d)
    }
}

// put_bool writes true or false.
pub fn (w &Writer) put_bool(b bool) {
    if b {
        w.put_str("true")
    } else {
        w.put_str("false")
    }
}

// ---------- format spec ({:...}) ----------
//
// io.printf("{:>8.2}", x) becomes, in essence:
//
//     w.spec_begin(8, false, 3, 0, false, false)
//     m := w.measure()              // a Writer that only counts
//     x.write(&m)
//     w.pad_before(' ', '>', 8, m.chars)
//     before := w.chars
//     x.write(&w)
//     w.pad_after(' ', '>', 8, w.chars - before)
//     w.spec_end()
//
// The width counts characters, not bytes: "café" takes 4.

// spec_begin keeps the spec for the numbers of the next write.
pub fn (w &Writer) spec_begin(width int, zero bool, prec int, base int, upper bool, alt bool) {
    w.width = width
    w.zero = zero
    w.prec = prec
    w.base = base
    w.upper = upper
    w.alt = alt
}

// spec_end goes back to the plain format.
pub fn (w &Writer) spec_end() {
    w.spec_begin(0, false, 0, 0, false, false)
}

// measure returns a Writer with the same spec that only counts the
// bytes: writing the value into it gives the size, to align right or
// center.
pub fn (w &Writer) measure() Writer {
    m := *w
    m.fd = COUNT
    m.n = 0
    m.total = 0
    m.chars = 0
    return m
}

// pad_before fills the width before the value (right-aligned or
// centered); size is the value's size, in characters.
pub fn (w &Writer) pad_before(fill byte, align byte, width int, size int) {
    if align == '>' {
        w.pad(fill, width - size)
    } else if align == '^' {
        w.pad(fill, (width - size) / 2)
    }
}

// pad_after fills the width after the value (left-aligned or
// centered); size is the value's size, in characters.
pub fn (w &Writer) pad_after(fill byte, align byte, width int, size int) {
    if align == '<' {
        w.pad(fill, width - size)
    } else if align == '^' {
        w.pad(fill, width - size - (width - size) / 2)
    }
}

fn (w &Writer) pad(fill byte, n int) {
    for i := 0; i < n; i++ {
        w.put_byte(fill)
    }
}

// ---------- Display of the built-in types ----------

impl Display for int {
    fn (x &int) write(w &Writer) {
        w.put_int(*x)
    }
}

impl Display for int8 {
    fn (x &int8) write(w &Writer) {
        w.put_int(int(*x))
    }
}

impl Display for int16 {
    fn (x &int16) write(w &Writer) {
        w.put_int(int(*x))
    }
}

impl Display for int32 {
    fn (x &int32) write(w &Writer) {
        w.put_int(int(*x))
    }
}

impl Display for byte {
    fn (x &byte) write(w &Writer) {
        w.put_int(int(*x))
    }
}

impl Display for uint16 {
    fn (x &uint16) write(w &Writer) {
        w.put_uint(uint64(*x))
    }
}

impl Display for uint32 {
    fn (x &uint32) write(w &Writer) {
        w.put_uint(uint64(*x))
    }
}

impl Display for uint64 {
    fn (x &uint64) write(w &Writer) {
        w.put_uint(*x)
    }
}

impl Display for float64 {
    fn (x &float64) write(w &Writer) {
        w.put_float(*x)
    }
}

impl Display for float32 {
    fn (x &float32) write(w &Writer) {
        w.put_f32(*x)
    }
}

impl Display for bool {
    fn (x &bool) write(w &Writer) {
        w.put_bool(*x)
    }
}

impl Display for string {
    fn (x &string) write(w &Writer) {
        w.put_str(*x)
    }
}

// A slice (or array) is written as [a b c].
impl[T Display] Display for []T {
    fn (s &[]T) write(w &Writer) {
        w.put_byte('[')
        for i := 0; i < len(s); i++ {
            if i > 0 {
                w.put_byte(' ')
            }
            s[i].write(w)
        }
        w.put_byte(']')
    }
}
