// Sorting of slices (and arrays, via &a), in place, without allocating.
//
// sort uses cmp.Ord's order: numbers, bool, string, slices (like
// [][]byte, lines of text) and structs with impl cmp.Ord (or impl auto
// cmp.Ord). Elements swap places by ownership, without copies, so
// owners ([]byte, ?*Node) are sorted too.
import "std/cmp"

// sort sorts s in ascending order (quicksort, with insertion sort on the small parts).
pub fn sort[T owned + cmp.Ord](s &[]T) {
    n := len(s)
    if n <= 16 {
        insertion(s)
        return
    }
    p := partition(s)
    sort(&s[:p])
    sort(&s[p + 1:])
}

// insertion takes element i out and shifts the larger ones one position to
// the right (by ownership, with take and replace), until it finds its place.
fn insertion[T owned + cmp.Ord](s &[]T) {
    for i := 1; i < len(s); i++ {
        if s[i].cmp(&s[i - 1]) >= 0 {
            continue // already in place
        }
        x := take(&s[i])
        j := i - 1
        for j >= 0 && x.cmp(&s[j]) < 0 {
            moved := take(&s[j])
            gap := replace(&s[j + 1], moved)
            drop(gap) // the zero left by the previous take
            j--
        }
        gap := replace(&s[j + 1], x)
        drop(gap)
    }
}

fn partition[T owned + cmp.Ord](s &[]T) int {
    last := len(s) - 1
    swap(s, last / 2, last) // middle pivot, against already sorted input
    i := 0
    for j := 0; j < last; j++ {
        if s[j].cmp(&s[last]) < 0 {
            swap(s, i, j)
            i++
        }
    }
    swap(s, i, last)
    return i
}

// swap swaps elements i and j (by ownership: works for owners too).
pub fn swap[T owned](s &[]T, i int, j int) {
    if i == j {
        return
    }
    a := take(&s[i])
    b := replace(&s[j], a)
    old := replace(&s[i], b)
    drop(old) // the zero left by the take
}

// is_sorted says whether s is in ascending order.
pub fn is_sorted[T owned + cmp.Ord](s &[]T) bool {
    for i := 1; i < len(s); i++ {
        if s[i].cmp(&s[i - 1]) < 0 {
            return false
        }
    }
    return true
}

// reverse reverses the order of s.
pub fn reverse[T owned](s &[]T) {
    i := 0
    j := len(s) - 1
    for i < j {
        swap(s, i, j)
        i++
        j--
    }
}

// sort_by sorts s by the order of less (less(a, b): a comes before b), for
// an order other than cmp.Ord's (descending, by another field):
//
//     fn by_age(a &Person, b &Person) bool {
//         return a.age < b.age
//     }
//     sort.sort_by(&people, by_age)
pub fn sort_by[T any](s &[]T, less fn(&T, &T) bool) {
    n := len(s)
    if n <= 16 {
        insertion_by(s, less)
        return
    }
    p := partition_by(s, less)
    sort_by(&s[:p], less)
    sort_by(&s[p + 1:], less)
}

fn insertion_by[T any](s &[]T, less fn(&T, &T) bool) {
    for i := 1; i < len(s); i++ {
        x := s[i]
        j := i - 1
        for j >= 0 && less(&x, &s[j]) {
            s[j + 1] = s[j]
            j--
        }
        s[j + 1] = x
    }
}

fn partition_by[T any](s &[]T, less fn(&T, &T) bool) int {
    last := len(s) - 1
    swap(s, last / 2, last)
    pivot := s[last]
    i := 0
    for j := 0; j < last; j++ {
        if less(&s[j], &pivot) {
            swap(s, i, j)
            i++
        }
    }
    swap(s, i, last)
    return i
}

// sort_by_with sorts s by the order of less, which also receives the context
// ctx: to compare by looking up another structure (ids by the priority kept
// in a map, for example).
pub fn sort_by_with[T owned, C ref](s &[]T, ctx &C, less fn(&C, &T, &T) bool) {
    n := len(s)
    if n <= 16 {
        insertion_with(s, ctx, less)
        return
    }
    p := partition_with(s, ctx, less)
    sort_by_with(&s[:p], ctx, less)
    sort_by_with(&s[p + 1:], ctx, less)
}

fn insertion_with[T owned, C ref](s &[]T, ctx &C, less fn(&C, &T, &T) bool) {
    for i := 1; i < len(s); i++ {
        if !less(ctx, &s[i], &s[i - 1]) {
            continue
        }
        x := take(&s[i])
        j := i - 1
        for j >= 0 && less(ctx, &x, &s[j]) {
            moved := take(&s[j])
            gap := replace(&s[j + 1], moved)
            drop(gap)
            j--
        }
        gap := replace(&s[j + 1], x)
        drop(gap)
    }
}

fn partition_with[T owned, C ref](s &[]T, ctx &C, less fn(&C, &T, &T) bool) int {
    last := len(s) - 1
    swap(s, last / 2, last)
    i := 0
    for j := 0; j < last; j++ {
        if less(ctx, &s[j], &s[last]) {
            swap(s, i, j)
            i++
        }
    }
    swap(s, i, last)
    return i
}

// is_sorted_by says whether s is already in less's order.
pub fn is_sorted_by[T any](s &[]T, less fn(&T, &T) bool) bool {
    for i := 1; i < len(s); i++ {
        if less(&s[i], &s[i - 1]) {
            return false
        }
    }
    return true
}
