// Ordenação de slices (e arrays, via &a), no lugar, sem alocar.
//
// sort usa a ordem de cmp.Ord: números, bool, string, slices (como
// [][]byte, linhas de texto) e structs com impl cmp.Ord (ou impl auto
// cmp.Ord). Os elementos são trocados de lugar por posse, sem cópias, então
// donos ([]byte, ?*No) também são ordenados.
import "std/cmp"

// sort ordena s em ordem crescente (quicksort, com inserção nas partes pequenas).
pub fn sort[T owned + cmp.Ord](s &[]T) {
    n := len(s)
    if n <= 16 {
        insertion(s)
        return
    }
    p := partition(s)
    sort(&s[:p])
    sort(&s[p + 1:])
}

// insertion tira o elemento i e desloca os maiores uma posição para a
// direita (por posse, com take e replace), até achar o lugar dele.
fn insertion[T owned + cmp.Ord](s &[]T) {
    for i := 1; i < len(s); i++ {
        if s[i].cmp(&s[i - 1]) >= 0 {
            continue // já está no lugar
        }
        x := take(&s[i])
        j := i - 1
        for j >= 0 && x.cmp(&s[j]) < 0 {
            moved := take(&s[j])
            gap := replace(&s[j + 1], moved)
            drop(gap) // o zero deixado pelo take anterior
            j--
        }
        gap := replace(&s[j + 1], x)
        drop(gap)
    }
}

fn partition[T owned + cmp.Ord](s &[]T) int {
    last := len(s) - 1
    swap(s, last / 2, last) // pivô do meio, contra entradas já ordenadas
    i := 0
    for j := 0; j < last; j++ {
        if s[j].cmp(&s[last]) < 0 {
            swap(s, i, j)
            i++
        }
    }
    swap(s, i, last)
    return i
}

// swap troca os elementos i e j (por posse: serve para donos também).
pub fn swap[T owned](s &[]T, i int, j int) {
    if i == j {
        return
    }
    a := take(&s[i])
    b := replace(&s[j], a)
    old := replace(&s[i], b)
    drop(old) // o zero deixado pelo take
}

// is_sorted diz se s está em ordem crescente.
pub fn is_sorted[T owned + cmp.Ord](s &[]T) bool {
    for i := 1; i < len(s); i++ {
        if s[i].cmp(&s[i - 1]) < 0 {
            return false
        }
    }
    return true
}

// reverse inverte a ordem de s.
pub fn reverse[T owned](s &[]T) {
    i := 0
    j := len(s) - 1
    for i < j {
        swap(s, i, j)
        i++
        j--
    }
}

// sort_by ordena s pela ordem de less (less(a, b): a vem antes de b), para
// uma ordem diferente da de cmp.Ord (decrescente, por outro campo):
//
//     fn por_idade(a &Pessoa, b &Pessoa) bool {
//         return a.idade < b.idade
//     }
//     sort.sort_by(&pessoas, por_idade)
pub fn sort_by[T any](s &[]T, less fn(&T, &T) bool) {
    n := len(s)
    if n <= 16 {
        insertion_by(s, less)
        return
    }
    p := partition_by(s, less)
    sort_by(&s[:p], less)
    sort_by(&s[p + 1:], less)
}

fn insertion_by[T any](s &[]T, less fn(&T, &T) bool) {
    for i := 1; i < len(s); i++ {
        x := s[i]
        j := i - 1
        for j >= 0 && less(&x, &s[j]) {
            s[j + 1] = s[j]
            j--
        }
        s[j + 1] = x
    }
}

fn partition_by[T any](s &[]T, less fn(&T, &T) bool) int {
    last := len(s) - 1
    swap(s, last / 2, last)
    pivot := s[last]
    i := 0
    for j := 0; j < last; j++ {
        if less(&s[j], &pivot) {
            swap(s, i, j)
            i++
        }
    }
    swap(s, i, last)
    return i
}

// sort_by_with ordena s pela ordem de less, que recebe junto o contexto ctx:
// para comparar consultando outra estrutura (os ids pela prioridade guardada
// num map, por exemplo).
pub fn sort_by_with[T owned, C ref](s &[]T, ctx &C, less fn(&C, &T, &T) bool) {
    n := len(s)
    if n <= 16 {
        insertion_with(s, ctx, less)
        return
    }
    p := partition_with(s, ctx, less)
    sort_by_with(&s[:p], ctx, less)
    sort_by_with(&s[p + 1:], ctx, less)
}

fn insertion_with[T owned, C ref](s &[]T, ctx &C, less fn(&C, &T, &T) bool) {
    for i := 1; i < len(s); i++ {
        if !less(ctx, &s[i], &s[i - 1]) {
            continue
        }
        x := take(&s[i])
        j := i - 1
        for j >= 0 && less(ctx, &x, &s[j]) {
            moved := take(&s[j])
            gap := replace(&s[j + 1], moved)
            drop(gap)
            j--
        }
        gap := replace(&s[j + 1], x)
        drop(gap)
    }
}

fn partition_with[T owned, C ref](s &[]T, ctx &C, less fn(&C, &T, &T) bool) int {
    last := len(s) - 1
    swap(s, last / 2, last)
    i := 0
    for j := 0; j < last; j++ {
        if less(ctx, &s[j], &s[last]) {
            swap(s, i, j)
            i++
        }
    }
    swap(s, i, last)
    return i
}

// is_sorted_by diz se s já está na ordem de less.
pub fn is_sorted_by[T any](s &[]T, less fn(&T, &T) bool) bool {
    for i := 1; i < len(s); i++ {
        if less(&s[i], &s[i - 1]) {
            return false
        }
    }
    return true
}
