import "std/password"
import "std/str"
import "std/testing"

fn test_hash_and_verify() {
    var pw [32]byte
    n := str.copy(&pw, "segredo123")
    var stored [password.MAX_LEN]byte
    k := password.hash_with(&pw[:n], 1000, &stored)
    testing.check(str.eq(&stored[:21], "$pbkdf2-sha256$i=1000"), "formato PHC")
    testing.check(password.verify(&pw[:n], &stored[:k]), "senha certa")
    var wrong [32]byte
    w := str.copy(&wrong, "segredo124")
    testing.check(!password.verify(&wrong[:w], &stored[:k]), "senha errada")
    testing.check(!password.verify(&pw[:0], &stored[:k]), "senha vazia")
    // the same text gives different hashes (the salt changes)
    var other [password.MAX_LEN]byte
    j := password.hash_with(&pw[:n], 1000, &other)
    testing.check(!str.eq_bytes(&stored[:k], &other[:j]), "sal diferente")
}

// a hash made by Python's hashlib (the same PHC format)
fn test_interop_python() {
    var pw [32]byte
    n := str.copy(&pw, "segredo123")
    var stored [128]byte
    k := str.copy(&stored, "$pbkdf2-sha256$i=1000$AAECAwQFBgcICQoLDA0ODw$/3OjdxA01i/gGBYst1G3DdowoNsgv3QvHCJD86Ym6Rs")
    testing.check(password.verify(&pw[:n], &stored[:k]), "aceita o hash do Python")
}

fn test_tampered_and_malformed() {
    var pw [32]byte
    n := str.copy(&pw, "segredo123")
    var s [128]byte
    k := str.copy(&s, "$pbkdf2-sha256$i=1000$AAECAwQFBgcICQoLDA0ODw$/3OjdxA01i/gGBYst1G3DdowoNsgv3QvHCJD86Ym6Rs")
    s[k - 1] = 'x'
    testing.check(!password.verify(&pw[:n], &s[:k]), "hash adulterado")
    k = str.copy(&s, "$pbkdf2-sha256$i=999$AAECAwQFBgcICQoLDA0ODw$/3OjdxA01i/gGBYst1G3DdowoNsgv3QvHCJD86Ym6Rs")
    testing.check(!password.verify(&pw[:n], &s[:k]), "iterações trocadas")
    k = str.copy(&s, "$md5$abc")
    testing.check(!password.verify(&pw[:n], &s[:k]), "outro algoritmo")
    k = str.copy(&s, "$pbkdf2-sha256$i=x$a$b")
    testing.check(!password.verify(&pw[:n], &s[:k]), "mal formado")
    testing.check(!password.verify(&pw[:n], &s[:0]), "vazio")
}

fn test_needs_rehash() {
    var s [128]byte
    k := str.copy(&s, "$pbkdf2-sha256$i=1000$AAECAwQFBgcICQoLDA0ODw$/3OjdxA01i/gGBYst1G3DdowoNsgv3QvHCJD86Ym6Rs")
    testing.check(password.needs_rehash(&s[:k], password.ITERATIONS), "1000 é pouco")
    testing.check(!password.needs_rehash(&s[:k], 1000), "igual não precisa")
    testing.check(password.needs_rehash(&s[:3], 1000), "mal formado precisa")
}

// the default (600 thousand iterations): about 0.6 s
fn test_default_iterations() {
    var pw [8]byte
    n := str.copy(&pw, "abc")
    var stored [password.MAX_LEN]byte
    k := password.hash(&pw[:n], &stored)
    testing.check(str.eq(&stored[:23], "$pbkdf2-sha256$i=600000"), "600 mil")
    testing.check(password.verify(&pw[:n], &stored[:k]), "confere")
}
