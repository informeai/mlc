import "std/password"
import "std/str"
import "std/testing"

fn test_hash_and_verify() {
    var pw [32]byte
    n := str.copy(&pw, "secret123")
    var stored [password.MAX_LEN]byte
    k := password.hash_with(&pw[:n], 1000, &stored)
    testing.check(str.eq(&stored[:21], "$pbkdf2-sha256$i=1000"), "PHC format")
    testing.check(password.verify(&pw[:n], &stored[:k]), "right password")
    var wrong [32]byte
    w := str.copy(&wrong, "secret124")
    testing.check(!password.verify(&wrong[:w], &stored[:k]), "wrong password")
    testing.check(!password.verify(&pw[:0], &stored[:k]), "empty password")
    // the same text gives different hashes (the salt changes)
    var other [password.MAX_LEN]byte
    j := password.hash_with(&pw[:n], 1000, &other)
    testing.check(!str.eq_bytes(&stored[:k], &other[:j]), "different salt")
}

// a hash made by Python's hashlib (the same PHC format)
fn test_interop_python() {
    var pw [32]byte
    n := str.copy(&pw, "secret123")
    var stored [128]byte
    k := str.copy(&stored, "$pbkdf2-sha256$i=1000$AAECAwQFBgcICQoLDA0ODw$zaBx7GE0E1lAxb6MQbVX1SY+mr4Cf6lx5kxv9F9mKWs")
    testing.check(password.verify(&pw[:n], &stored[:k]), "accepts Python's hash")
}

fn test_tampered_and_malformed() {
    var pw [32]byte
    n := str.copy(&pw, "secret123")
    var s [128]byte
    k := str.copy(&s, "$pbkdf2-sha256$i=1000$AAECAwQFBgcICQoLDA0ODw$zaBx7GE0E1lAxb6MQbVX1SY+mr4Cf6lx5kxv9F9mKWs")
    s[k - 1] = 'x'
    testing.check(!password.verify(&pw[:n], &s[:k]), "tampered hash")
    k = str.copy(&s, "$pbkdf2-sha256$i=999$AAECAwQFBgcICQoLDA0ODw$zaBx7GE0E1lAxb6MQbVX1SY+mr4Cf6lx5kxv9F9mKWs")
    testing.check(!password.verify(&pw[:n], &s[:k]), "changed iterations")
    k = str.copy(&s, "$md5$abc")
    testing.check(!password.verify(&pw[:n], &s[:k]), "another algorithm")
    k = str.copy(&s, "$pbkdf2-sha256$i=x$a$b")
    testing.check(!password.verify(&pw[:n], &s[:k]), "malformed")
    testing.check(!password.verify(&pw[:n], &s[:0]), "empty")
}

fn test_needs_rehash() {
    var s [128]byte
    k := str.copy(&s, "$pbkdf2-sha256$i=1000$AAECAwQFBgcICQoLDA0ODw$zaBx7GE0E1lAxb6MQbVX1SY+mr4Cf6lx5kxv9F9mKWs")
    testing.check(password.needs_rehash(&s[:k], password.ITERATIONS), "1000 is too few")
    testing.check(!password.needs_rehash(&s[:k], 1000), "equal doesn't need it")
    testing.check(password.needs_rehash(&s[:3], 1000), "malformed needs it")
}

// the default (600 thousand iterations): about 0.6 s
fn test_default_iterations() {
    var pw [8]byte
    n := str.copy(&pw, "abc")
    var stored [password.MAX_LEN]byte
    k := password.hash(&pw[:n], &stored)
    testing.check(str.eq(&stored[:23], "$pbkdf2-sha256$i=600000"), "600 thousand")
    testing.check(password.verify(&pw[:n], &stored[:k]), "checks")
}
