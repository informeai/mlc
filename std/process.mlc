// Running other programs. The arguments stay in a fixed buffer inside the
// Cmd (on the caller's stack), and the captured output goes into a buffer
// of the caller's: nothing allocates.
//
//     c := process.cmd("ls")
//     c.arg("-l")
//     c.arg_bytes(&dir[:n])
//     var out [4096]byte
//     status := 0
//     match c.run(&out, &status) {
//         Ok(n) => io.write(&out[:n])       // status has the exit code
//         Err(code) => ...                  // NOT_FOUND, TOO_BIG, ...
//     }
//
// The program is looked up in the PATH. The arguments go straight to it,
// without a shell: no * or $VAR, and no risk of injection.
import "std/result"

pub const NOT_FOUND = 2   // the program doesn't exist (ENOENT)
pub const TOO_BIG = 1000  // the output didn't fit in the buffer (the rest was discarded)
pub const TOO_LONG = 1002 // the arguments don't fit in the Cmd

// Cmd is the command line: the program and the arguments, separated by zero.
pub struct Cmd {
    buf [8192]byte
    n int
    count int
}

extern fn run_raw(args &[]byte, count int, out &[]byte, capture bool, status &int) int

// cmd starts a command line with the program name.
pub fn cmd(name string) Cmd {
    var c Cmd
    c.arg(name)
    return c
}

// arg appends an argument. If it doesn't fit (8 KB in total, 255
// arguments), it panics.
pub fn (c &Cmd) arg(s string) {
    if c.n + len(s) + 1 > len(c.buf) || c.count == 255 {
        fail("process: os argumentos não cabem no Cmd (8 KB, 255 argumentos)")
    }
    for i := 0; i < len(s); i++ {
        c.buf[c.n] = s[i]
        c.n++
    }
    c.buf[c.n] = 0
    c.n++
    c.count++
}

// arg_bytes appends an argument that's in a buffer.
pub fn (c &Cmd) arg_bytes(b &[]byte) {
    if c.n + len(b) + 1 > len(c.buf) || c.count == 255 {
        fail("process: os argumentos não cabem no Cmd (8 KB, 255 argumentos)")
    }
    for i := 0; i < len(b); i++ {
        c.buf[c.n] = b[i]
        c.n++
    }
    c.buf[c.n] = 0
    c.n++
    c.count++
}

// run runs the program, waits for it to finish and puts the exit code in
// status. Standard output goes into out (Ok has how many bytes); standard
// error keeps going to the terminal.
pub fn (c &Cmd) run(out &[]byte, status &int) result.Result[int, int] {
    return wrap(run_raw(&c.buf[:c.n], c.count, out, true, status))
}

// run_inherit runs the program with the output going straight to the terminal.
pub fn (c &Cmd) run_inherit(status &int) result.Result[int, int] {
    var none [1]byte
    return wrap(run_raw(&c.buf[:c.n], c.count, &none[:0], false, status))
}

extern fn fail(msg string)

fn wrap(n int) result.Result[int, int] {
    if n < 0 {
        return result.Result.Err(-n)
    }
    return result.Result.Ok(n)
}
