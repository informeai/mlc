// Senhas de usuários: guardar e conferir sem nunca guardar a senha. O hash
// é PBKDF2-HMAC-SHA256 com 600 mil iterações (a recomendação da OWASP) e um
// sal aleatório de 16 bytes (rand.secure) por senha, no formato PHC, que
// leva junto o algoritmo, as iterações e o sal:
//
//     $pbkdf2-sha256$i=600000$0nG8n3nC3B7oTq7wR3a3Ow$Kj...43 caracteres...
//
// Cada hash leva uns 0,6 s de propósito: é o que torna caro testar milhões
// de palpites se o banco vazar. Nada aloca.
//
//     var stored [password.MAX_LEN]byte
//     n := password.hash(&senha, &stored)     // grava &stored[:n] no banco
//     ...
//     if password.verify(&tentativa, &stored[:n]) {
//         // senha certa
//     }
//
// Quando a recomendação de iterações subir, needs_rehash diz quais hashes
// gravados estão abaixo dela: no próximo login certo, grave um hash novo.
import "std/encoding"
import "std/hmac"
import "std/rand"
import "std/str"

// ITERATIONS é o padrão de hash (OWASP, 2023).
pub const ITERATIONS = 600000

// MAX_LEN é o maior texto que hash escreve.
pub const MAX_LEN = 128

const SALT = 16
const KEY = 32

// hash escreve em dst o hash de password (com ITERATIONS) e devolve o
// tamanho. dst precisa de MAX_LEN bytes.
pub fn hash(password &[]byte, dst &[]byte) int {
    return hash_with(password, ITERATIONS, dst)
}

// hash_with é hash com outro número de iterações (menos só em testes).
pub fn hash_with(password &[]byte, iterations int, dst &[]byte) int {
    if len(dst) < MAX_LEN {
        fail("password.hash: o destino precisa de MAX_LEN bytes")
    }
    var salt [16]byte
    rand.secure(&salt)
    var key [32]byte
    hmac.pbkdf2(password, &salt, iterations, &key)
    n := str.copy(dst, "$pbkdf2-sha256$i=")
    n += str.put_int(&dst[n:], iterations)
    n += str.copy(&dst[n:], "$")
    n += b64(&dst[n:], &salt)
    n += str.copy(&dst[n:], "$")
    n += b64(&dst[n:], &key)
    return n
}

// verify diz se password é a senha do hash stored (escrito por hash),
// comparando em tempo constante. Um hash mal formado dá false.
pub fn verify(password &[]byte, stored &[]byte) bool {
    var salt [16]byte
    var want [32]byte
    iterations := 0
    if !parse(stored, &iterations, &salt, &want) {
        return false
    }
    var got [32]byte
    hmac.pbkdf2(password, &salt, iterations, &got)
    return hmac.equal(&got, &want)
}

// needs_rehash diz se o hash stored usa menos iterações que iterations (ou
// está mal formado): depois de um login certo, é hora de gravar um novo.
pub fn needs_rehash(stored &[]byte, iterations int) bool {
    var salt [16]byte
    var key [32]byte
    have := 0
    return !parse(stored, &have, &salt, &key) || have < iterations
}

// parse lê $pbkdf2-sha256$i=N$sal$chave.
fn parse(s &[]byte, iterations &int, salt &[]byte, key &[]byte) bool {
    prefix := "$pbkdf2-sha256$i="
    if len(s) < len(prefix) || !str.eq(&s[:len(prefix)], prefix) {
        return false
    }
    at := len(prefix)
    end := at
    for end < len(s) && s[end] != '$' {
        end++
    }
    n := 0
    if end == len(s) || !str.parse_int(&s[at:end], &n) || n < 1 {
        return false
    }
    at = end + 1
    end = at
    for end < len(s) && s[end] != '$' {
        end++
    }
    if end == len(s) {
        return false
    }
    var buf [64]byte
    if end - at > len(buf) || len(s) - end - 1 > len(buf) {
        return false
    }
    if encoding.unbase64(&buf, &s[at:end]) != SALT {
        return false
    }
    for i := 0; i < SALT; i++ {
        salt[i] = buf[i]
    }
    if encoding.unbase64(&buf, &s[end + 1:]) != KEY {
        return false
    }
    for i := 0; i < KEY; i++ {
        key[i] = buf[i]
    }
    *iterations = n
    return true
}

// b64 escreve base64 padrão sem o enchimento (o "B64" do formato PHC).
fn b64(dst &[]byte, src &[]byte) int {
    n := encoding.base64(dst, src)
    for n > 0 && dst[n - 1] == '=' {
        n--
    }
    return n
}

extern fn fail(msg string)
