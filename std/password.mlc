// User passwords: storing and checking them without ever storing the password. The hash
// is PBKDF2-HMAC-SHA256 with 600 thousand iterations (OWASP's recommendation) and a
// random 16-byte salt (rand.secure) per password, in the PHC format, which
// carries the algorithm, the iterations and the salt along:
//
//     $pbkdf2-sha256$i=600000$0nG8n3nC3B7oTq7wR3a3Ow$Kj...43 characters...
//
// Each hash takes about 0.6 s on purpose: that's what makes testing millions
// of guesses expensive if the database leaks. Nothing allocates.
//
//     var stored [password.MAX_LEN]byte
//     n := password.hash(&pw, &stored)        // save &stored[:n] in the database
//     ...
//     if password.verify(&attempt, &stored[:n]) {
//         // right password
//     }
//
// When the recommended iterations go up, needs_rehash says which stored
// hashes are below it: on the next correct login, save a new hash.
import "std/encoding"
import "std/hmac"
import "std/rand"
import "std/str"

// ITERATIONS is hash's default (OWASP, 2023).
pub const ITERATIONS = 600000

// MAX_LEN is the longest text hash writes.
pub const MAX_LEN = 128

const SALT = 16
const KEY = 32

// hash writes into dst the hash of password (with ITERATIONS) and returns the
// length. dst needs MAX_LEN bytes.
pub fn hash(password &[]byte, dst &[]byte) int {
    return hash_with(password, ITERATIONS, dst)
}

// hash_with is hash with another number of iterations (fewer only in tests).
pub fn hash_with(password &[]byte, iterations int, dst &[]byte) int {
    if len(dst) < MAX_LEN {
        fail("password.hash: o destino precisa de MAX_LEN bytes")
    }
    var salt [16]byte
    rand.secure(&salt)
    var key [32]byte
    hmac.pbkdf2(password, &salt, iterations, &key)
    n := str.copy(dst, "$pbkdf2-sha256$i=")
    n += str.put_int(&dst[n:], iterations)
    n += str.copy(&dst[n:], "$")
    n += b64(&dst[n:], &salt)
    n += str.copy(&dst[n:], "$")
    n += b64(&dst[n:], &key)
    return n
}

// verify says whether password is the password of the hash stored (written by hash),
// comparing in constant time. A malformed hash gives false.
pub fn verify(password &[]byte, stored &[]byte) bool {
    var salt [16]byte
    var want [32]byte
    iterations := 0
    if !parse(stored, &iterations, &salt, &want) {
        return false
    }
    var got [32]byte
    hmac.pbkdf2(password, &salt, iterations, &got)
    return hmac.equal(&got, &want)
}

// needs_rehash says whether the hash stored uses fewer iterations than iterations (or
// is malformed): after a correct login, it's time to save a new one.
pub fn needs_rehash(stored &[]byte, iterations int) bool {
    var salt [16]byte
    var key [32]byte
    have := 0
    return !parse(stored, &have, &salt, &key) || have < iterations
}

// parse reads $pbkdf2-sha256$i=N$salt$key.
fn parse(s &[]byte, iterations &int, salt &[]byte, key &[]byte) bool {
    prefix := "$pbkdf2-sha256$i="
    if len(s) < len(prefix) || !str.eq(&s[:len(prefix)], prefix) {
        return false
    }
    at := len(prefix)
    end := at
    for end < len(s) && s[end] != '$' {
        end++
    }
    n := 0
    if end == len(s) || !str.parse_int(&s[at:end], &n) || n < 1 {
        return false
    }
    at = end + 1
    end = at
    for end < len(s) && s[end] != '$' {
        end++
    }
    if end == len(s) {
        return false
    }
    var buf [64]byte
    if end - at > len(buf) || len(s) - end - 1 > len(buf) {
        return false
    }
    if encoding.unbase64(&buf, &s[at:end]) != SALT {
        return false
    }
    for i := 0; i < SALT; i++ {
        salt[i] = buf[i]
    }
    if encoding.unbase64(&buf, &s[end + 1:]) != KEY {
        return false
    }
    for i := 0; i < KEY; i++ {
        key[i] = buf[i]
    }
    *iterations = n
    return true
}

// b64 writes standard base64 without the padding (the PHC format's "B64").
fn b64(dst &[]byte, src &[]byte) int {
    n := encoding.base64(dst, src)
    for n > 0 && dst[n - 1] == '=' {
        n--
    }
    return n
}

extern fn fail(msg string)
