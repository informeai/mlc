// Buffered reading from any io.Reader (fs.File, net.Conn, io.stdin()
// or a type of yours). The Reader keeps a fixed 4096-byte buffer inside
// itself (on the stack, if it's a local variable): nothing here allocates. The source
// isn't stored: each call borrows it, so whoever opened the
// file stays its owner and closes it when they want.
//
//     br := bufio.new[fs.File]()
//     var line [1024]byte
//     for {
//         match br.read_line(f, &line) {
//             Ok(n) => io.printf("{:s}\n", &line[:n])
//             Err(code) => {
//                 if code != io.EOF {
//                     io.eprintf("error {}\n", code)
//                 }
//                 break
//             }
//         }
//     }
//
// The end of the data is Err(io.EOF), and the source's errors arrive as they came.
import "std/io"
import "std/result"

// TOO_LONG is the error of read_line and read_until when the piece doesn't fit in
// dst (the same code as os.TOO_LONG). What fit stays in dst and the rest
// goes to the next call.
pub const TOO_LONG = 1002

// Reader is the reading buffer: buf[start:end] are the bytes already read from the
// source and not yet delivered.
pub struct Reader[R ref + io.Reader] {
    buf [4096]byte
    start int
    end int
    err int // source error kept for the next call (0: none)
}

// new creates an empty Reader for sources of type R.
pub fn new[R ref + io.Reader]() Reader[R] {
    return Reader[R]{}
}

// buffered says how many bytes are already in the buffer, waiting to be read.
pub fn (b &Reader[R]) buffered() int {
    return b.end - b.start
}

// fill reads more from the source into the buffer (which must have room, after
// moving the leftovers to the start). Returns false at the end or on an error, which
// stays in b.err.
fn (b &Reader[R]) fill(src &R) bool {
    if b.err != 0 {
        return false
    }
    if b.start > 0 {
        k := b.end - b.start
        for i := 0; i < k; i++ {
            b.buf[i] = b.buf[b.start + i]
        }
        b.start = 0
        b.end = k
    }
    match src.read(&b.buf[b.end:]) {
        Ok(n) => {
            if n == 0 {
                b.err = io.EOF
                return false
            }
            b.end += n
            return true
        }
        Err(code) => {
            b.err = code
            return false
        }
    }
}

// take delivers the kept error and forgets it (except EOF, which keeps
// holding on the next calls).
fn (b &Reader[R]) take() int {
    code := b.err
    if code != io.EOF {
        b.err = 0
    }
    return code
}

// read_until reads up to the byte delim (inclusive, if it comes) and writes into dst.
// If delim doesn't appear before the end of the data, delivers whatever there is;
// Err(io.EOF) only when there's nothing more. If the piece doesn't fit in
// dst, fills dst and returns Err(TOO_LONG).
pub fn (b &Reader[R]) read_until(src &R, delim byte, dst &[]byte) result.Result[int, int] {
    n := 0
    for {
        for b.start < b.end {
            if n == len(dst) {
                return result.Result.Err(TOO_LONG)
            }
            c := b.buf[b.start]
            dst[n] = c
            n++
            b.start++
            if c == delim {
                return result.Result.Ok(n)
            }
        }
        if !b.fill(src) {
            if n > 0 && b.err == io.EOF {
                return result.Result.Ok(n)
            }
            return result.Result.Err(b.take())
        }
    }
}

// read_line reads a line without the \n (and without the \r of a \r\n) and returns its
// length. The last line may have no \n. If the line doesn't fit in
// dst, fills dst and returns Err(TOO_LONG); the rest of the line comes on the next
// call.
pub fn (b &Reader[R]) read_line(src &R, dst &[]byte) result.Result[int, int] {
    match b.read_until(src, '\n', dst) {
        Ok(n) => {
            if n > 0 && dst[n - 1] == '\n' {
                n--
                if n > 0 && dst[n - 1] == '\r' {
                    n--
                }
            }
            return result.Result.Ok(n)
        }
        Err(code) => {
            return result.Result.Err(code)
        }
    }
}

// read reads up to len(dst) bytes: first what's in the buffer; if it's
// empty, does one read from the source. May read less than len(dst).
pub fn (b &Reader[R]) read(src &R, dst &[]byte) result.Result[int, int] {
    if len(dst) == 0 {
        return result.Result.Ok(0)
    }
    if b.start == b.end && !b.fill(src) {
        return result.Result.Err(b.take())
    }
    n := b.end - b.start
    if n > len(dst) {
        n = len(dst)
    }
    for i := 0; i < n; i++ {
        dst[i] = b.buf[b.start + i]
    }
    b.start += n
    return result.Result.Ok(n)
}

// read_exact fills all of dst. If the data ends first, returns
// Err(io.EOF) (what arrived stays in dst, but the amount is lost: use read
// when a smaller piece will do).
pub fn (b &Reader[R]) read_exact(src &R, dst &[]byte) result.Result[int, int] {
    n := 0
    for n < len(dst) {
        match b.read(src, &dst[n:]) {
            Ok(k) => n += k
            Err(code) => {
                return result.Result.Err(code)
            }
        }
    }
    return result.Result.Ok(n)
}

// read_byte reads one byte.
pub fn (b &Reader[R]) read_byte(src &R) result.Result[byte, int] {
    if b.start == b.end && !b.fill(src) {
        return result.Result.Err(b.take())
    }
    c := b.buf[b.start]
    b.start++
    return result.Result.Ok(c)
}
