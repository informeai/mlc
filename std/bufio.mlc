// Leitura com buffer de qualquer io.Reader (fs.File, net.Conn, io.stdin()
// ou um tipo seu). O Reader guarda um buffer fixo de 4096 bytes dentro dele
// mesmo (na pilha, se ele for uma variável local): nada aqui aloca. A fonte
// não fica guardada: cada chamada a recebe emprestada, então quem abriu o
// arquivo continua dono dele e o fecha quando quiser.
//
//     br := bufio.new[fs.File]()
//     var line [1024]byte
//     for {
//         match br.read_line(f, &line) {
//             Ok(n) => io.printf("{:s}\n", &line[:n])
//             Err(code) => {
//                 if code != io.EOF {
//                     io.eprintf("erro {}\n", code)
//                 }
//                 break
//             }
//         }
//     }
//
// O fim dos dados é Err(io.EOF), e os erros da fonte chegam como vieram.
import "std/io"
import "std/result"

// TOO_LONG é o erro de read_line e read_until quando o pedaço não cabe em
// dst (o mesmo código de os.TOO_LONG). O que coube fica em dst e o resto,
// para a próxima chamada.
pub const TOO_LONG = 1002

// Reader é o buffer da leitura: buf[start:end] são os bytes já lidos da
// fonte e ainda não entregues.
pub struct Reader[R ref + io.Reader] {
    buf [4096]byte
    start int
    end int
    err int // erro da fonte guardado para a próxima chamada (0: nenhum)
}

// new cria um Reader vazio para fontes do tipo R.
pub fn new[R ref + io.Reader]() Reader[R] {
    return Reader[R]{}
}

// buffered diz quantos bytes já estão no buffer, esperando para ser lidos.
pub fn (b &Reader[R]) buffered() int {
    return b.end - b.start
}

// fill lê mais da fonte para o buffer (que precisa ter espaço, depois de
// mover o que sobrou para o começo). Devolve false no fim ou num erro, que
// fica em b.err.
fn (b &Reader[R]) fill(src &R) bool {
    if b.err != 0 {
        return false
    }
    if b.start > 0 {
        k := b.end - b.start
        for i := 0; i < k; i++ {
            b.buf[i] = b.buf[b.start + i]
        }
        b.start = 0
        b.end = k
    }
    match src.read(&b.buf[b.end:]) {
        Ok(n) => {
            if n == 0 {
                b.err = io.EOF
                return false
            }
            b.end += n
            return true
        }
        Err(code) => {
            b.err = code
            return false
        }
    }
}

// take entrega o erro guardado e o esquece (menos o EOF, que continua
// valendo nas próximas chamadas).
fn (b &Reader[R]) take() int {
    code := b.err
    if code != io.EOF {
        b.err = 0
    }
    return code
}

// read_until lê até o byte delim (inclusive, se ele vier) e escreve em dst.
// Se o delim não aparecer antes do fim dos dados, entrega o que houver;
// Err(io.EOF) só quando não houver mais nada. Se o pedaço não couber em
// dst, enche dst e devolve Err(TOO_LONG).
pub fn (b &Reader[R]) read_until(src &R, delim byte, dst &[]byte) result.Result[int, int] {
    n := 0
    for {
        for b.start < b.end {
            if n == len(dst) {
                return result.Result.Err(TOO_LONG)
            }
            c := b.buf[b.start]
            dst[n] = c
            n++
            b.start++
            if c == delim {
                return result.Result.Ok(n)
            }
        }
        if !b.fill(src) {
            if n > 0 && b.err == io.EOF {
                return result.Result.Ok(n)
            }
            return result.Result.Err(b.take())
        }
    }
}

// read_line lê uma linha sem o \n (e sem o \r de um \r\n) e devolve o
// tamanho dela. A última linha pode não ter \n. Se a linha não couber em
// dst, enche dst e devolve Err(TOO_LONG); o resto da linha vem na próxima
// chamada.
pub fn (b &Reader[R]) read_line(src &R, dst &[]byte) result.Result[int, int] {
    match b.read_until(src, '\n', dst) {
        Ok(n) => {
            if n > 0 && dst[n - 1] == '\n' {
                n--
                if n > 0 && dst[n - 1] == '\r' {
                    n--
                }
            }
            return result.Result.Ok(n)
        }
        Err(code) => {
            return result.Result.Err(code)
        }
    }
}

// read lê até len(dst) bytes: primeiro o que estiver no buffer; se ele
// estiver vazio, faz uma leitura da fonte. Pode ler menos que len(dst).
pub fn (b &Reader[R]) read(src &R, dst &[]byte) result.Result[int, int] {
    if len(dst) == 0 {
        return result.Result.Ok(0)
    }
    if b.start == b.end && !b.fill(src) {
        return result.Result.Err(b.take())
    }
    n := b.end - b.start
    if n > len(dst) {
        n = len(dst)
    }
    for i := 0; i < n; i++ {
        dst[i] = b.buf[b.start + i]
    }
    b.start += n
    return result.Result.Ok(n)
}

// read_exact enche dst inteiro. Se os dados acabarem antes, devolve
// Err(io.EOF) (o que chegou fica em dst, mas a quantidade se perde: use read
// quando um pedaço menor servir).
pub fn (b &Reader[R]) read_exact(src &R, dst &[]byte) result.Result[int, int] {
    n := 0
    for n < len(dst) {
        match b.read(src, &dst[n:]) {
            Ok(k) => n += k
            Err(code) => {
                return result.Result.Err(code)
            }
        }
    }
    return result.Result.Ok(n)
}

// read_byte lê um byte.
pub fn (b &Reader[R]) read_byte(src &R) result.Result[byte, int] {
    if b.start == b.end && !b.fill(src) {
        return result.Result.Err(b.take())
    }
    c := b.buf[b.start]
    b.start++
    return result.Result.Ok(c)
}
