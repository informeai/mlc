// Text in []byte buffers. No function allocates: the ones that write receive the
// caller's buffer (dst), return how many bytes they used and panic if the
// text doesn't fit. See docs/text.md.
//
// The ones that may panic are extern (in the C runtime), so the panic points at the
// caller's line; the others are ordinary MLC.
//
// str.format(&dst, "x = {}", x) writes a format into dst and returns how many
// bytes it used (panic if it doesn't fit); str.format_len("x = {}", x) says how many
// bytes the text has, to allocate the right size. Like io.printf, they're
// rewritten by the compiler into calls to each value's write (io.Display),
// over an io.Writer that writes into dst or only counts.
import "std/io"

// copy copies s to the start of dst and returns how many bytes it copied.
pub extern fn copy(dst &[]byte, s string) int

// copy_bytes copies src to the start of dst (they may overlap).
pub extern fn copy_bytes(dst &[]byte, src &[]byte) int

// put_int writes n in decimal at the start of dst.
pub extern fn put_int(dst &[]byte, n int) int

// put_float writes x with the fewest digits that represent it
// exactly, in the same format as io.print.
pub extern fn put_float(dst &[]byte, x float64) int

// parse_float reads a decimal (2.5, -1e9) from all of s; on success
// stores it in out and returns true.
pub extern fn parse_float(s &[]byte, out &float64) bool

// int_len says how many bytes n takes in decimal (to know how much to allocate).
pub fn int_len(n int) int {
    k := 1
    if n < 0 {
        k = 2
    }
    // n / 10 doesn't overflow even on the smallest int; digits are counted in the negative
    if n > 0 {
        n = -n
    }
    for n <= -10 {
        n = n / 10
        k++
    }
    return k
}

// eq says whether a has the same text as s.
pub fn eq(a &[]byte, s string) bool {
    if len(a) != len(s) {
        return false
    }
    for i := 0; i < len(a); i++ {
        if a[i] != s[i] {
            return false
        }
    }
    return true
}

// eq_bytes says whether a and b have the same text.
pub fn eq_bytes(a &[]byte, b &[]byte) bool {
    if len(a) != len(b) {
        return false
    }
    for i := 0; i < len(a); i++ {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

const MIN_INT = -9223372036854775807 - 1
const MIN_DIV_10 = -922337203685477580 // MIN_INT / 10

// parse_int reads a decimal integer, with an optional sign, from all of s. On
// success stores it in out and returns true; invalid text or text that doesn't fit in
// int returns false.
pub fn parse_int(s &[]byte, out &int) bool {
    i := 0
    neg := false
    if len(s) > 0 && (s[0] == '-' || s[0] == '+') {
        neg = s[0] == '-'
        i = 1
    }
    if i == len(s) {
        return false
    }
    // accumulates in the negative, to reach the smallest int without overflowing
    v := 0
    for i < len(s) {
        c := s[i]
        if c < '0' || c > '9' {
            return false
        }
        d := int(c) - int('0')
        if v < MIN_DIV_10 || (v == MIN_DIV_10 && d > 8) {
            return false
        }
        v = v * 10 - d
        i++
    }
    if !neg {
        if v == MIN_INT {
            return false
        }
        v = -v
    }
    *out = v
    return true
}

const MAX_UINT = 18446744073709551615

// parse_uint reads an unsigned decimal integer from all of s (for values
// above the largest int, like hashes and large counters). On success
// stores it in out and returns true; invalid text, a sign or overflow return
// false.
pub fn parse_uint(s &[]byte, out &uint64) bool {
    if len(s) == 0 {
        return false
    }
    var v uint64 = 0
    for i := 0; i < len(s); i++ {
        c := s[i]
        if c < '0' || c > '9' {
            return false
        }
        d := uint64(c - '0')
        if v > (MAX_UINT - d) / 10 {
            return false // v * 10 + d would go past the largest uint64
        }
        v = v * 10 + d
    }
    *out = v
    return true
}

// parse_int_base reads an integer in the given base (2 to 36; letters a to z,
// upper- or lowercase, after 9), with an optional sign, from all of s.
// With base 16, 2 or 8, the prefix 0x, 0b or 0o is accepted. With base 0, the
// prefix picks the base (0x1F, 0b1010, 0o17) and, without a prefix, it's decimal. On
// success stores it in out and returns true; invalid text, a base other than
// 0 and 2 to 36, or overflow return false.
pub fn parse_int_base(s &[]byte, base int, out &int) bool {
    if base != 0 && (base < 2 || base > 36) {
        return false
    }
    i := 0
    neg := false
    if len(s) > 0 && (s[0] == '-' || s[0] == '+') {
        neg = s[0] == '-'
        i = 1
    }
    if i + 1 < len(s) && s[i] == '0' {
        p := s[i + 1]
        prefixed := 0
        if p == 'x' || p == 'X' {
            prefixed = 16
        } else if p == 'b' || p == 'B' {
            prefixed = 2
        } else if p == 'o' || p == 'O' {
            prefixed = 8
        }
        if prefixed != 0 && (base == 0 || base == prefixed) {
            base = prefixed
            i += 2
        }
    }
    if base == 0 {
        base = 10
    }
    if i == len(s) {
        return false
    }
    // accumulates in the negative, to reach the smallest int without overflowing
    limit := MIN_INT / base
    v := 0
    for i < len(s) {
        d := digit_value(s[i])
        if d < 0 || d >= base {
            return false
        }
        if v < limit {
            return false // v * base would go past the smallest int
        }
        v = v * base
        if v < MIN_INT + d {
            return false
        }
        v = v - d
        i++
    }
    if !neg {
        if v == MIN_INT {
            return false
        }
        v = -v
    }
    *out = v
    return true
}

// digit_value is the value of a digit in any base up to 36, or -1.
fn digit_value(c byte) int {
    if c >= '0' && c <= '9' {
        return int(c) - int('0')
    }
    if c >= 'a' && c <= 'z' {
        return int(c) - int('a') + 10
    }
    if c >= 'A' && c <= 'Z' {
        return int(c) - int('A') + 10
    }
    return -1
}

// parse_bool reads "true" or "false" (exactly) from s. On success
// stores it in out and returns true; any other text returns false.
pub fn parse_bool(s &[]byte, out &bool) bool {
    if eq(s, "true") {
        *out = true
        return true
    }
    if eq(s, "false") {
        *out = false
        return true
    }
    return false
}
