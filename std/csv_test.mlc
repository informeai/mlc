import "std/csv"
import "std/io"
import "std/result"
import "std/str"
import "std/testing"

// Text is a fake source: it delivers the text in pieces of step bytes.
struct Text {
    data [2048]byte
    n int
    pos int
    step int
}

fn (t &Text) read(dst &[]byte) result.Result[int, int] {
    k := t.n - t.pos
    if k > t.step {
        k = t.step
    }
    if k > len(dst) {
        k = len(dst)
    }
    for i := 0; i < k; i++ {
        dst[i] = t.data[t.pos + i]
    }
    t.pos += k
    return result.Result.Ok(k)
}

impl io.Reader for Text

fn text(s string, step int) Text {
    t := Text{}
    t.n = str.copy(&t.data, s)
    t.step = step
    return t
}

fn want_record(r &csv.Reader[Text], src &Text, fields int) {
    match r.next(src) {
        Ok(n) => testing.eq_int(n, fields)
        Err(code) => testing.eq_int(code, 0)
    }
}

fn test_simple_and_quoted() {
    src := text("name,price,notes\r\ncafé,1250,\"with, a comma\"\n\n\"quotes \"\"inside\"\"\",7,\"two\nlines\"\nend,,\n", 3)
    r := csv.new[Text]()
    var f [64]byte
    want_record(&r, &src, 3)
    testing.check(r.is(0, "name") && r.is(2, "notes"), "header")
    want_record(&r, &src, 3)
    n := r.field(0, &f)
    testing.eq_str(&f[:n], "café")
    price := 0
    testing.check(r.int(1, &price), "int")
    testing.eq_int(price, 1250)
    n = r.field(2, &f)
    testing.eq_str(&f[:n], "with, a comma")
    want_record(&r, &src, 3) // the empty line was skipped
    n = r.field(0, &f)
    testing.eq_str(&f[:n], "quotes \"inside\"")
    n = r.field(2, &f)
    testing.eq_str(&f[:n], "two\nlines")
    want_record(&r, &src, 3)
    testing.eq_int(r.line, 6) // the two-line record takes lines 4 and 5
    testing.eq_int(r.field(1, &f), 0)
    testing.eq_int(r.field(2, &f), 0)
    testing.eq_int(r.field(3, &f), -1)
    match r.next(&src) {
        Ok(_) => testing.fail("should have ended")
        Err(code) => testing.eq_int(code, io.EOF)
    }
}

fn test_semicolon_and_no_final_newline() {
    src := text("a;b;3,5\nx;\"y;z\";1.25", 64)
    r := csv.new[Text]()
    r.sep = ';'
    want_record(&r, &src, 3)
    testing.check(r.is(2, "3,5"), "a decimal comma stays in the text")
    want_record(&r, &src, 3)
    testing.check(r.is(1, "y;z"), "separator inside quotes")
    v := 0.0
    testing.check(r.float(2, &v), "float")
    testing.eq_float(v, 1.25)
}

fn test_bad_quotes() {
    src := text("a,\"no end\n", 64)
    r := csv.new[Text]()
    match r.next(&src) {
        Ok(_) => testing.fail("open quotes")
        Err(code) => testing.eq_int(code, csv.BAD_QUOTE)
    }
    src2 := text("a,\"x\"y\n", 64)
    r2 := csv.new[Text]()
    match r2.next(&src2) {
        Ok(_) => testing.fail("text after the quote")
        Err(code) => testing.eq_int(code, csv.BAD_QUOTE)
    }
    src3 := text("a,b\"c\n", 64)
    r3 := csv.new[Text]()
    match r3.next(&src3) {
        Ok(_) => testing.fail("quote in the middle")
        Err(code) => testing.eq_int(code, csv.BAD_QUOTE)
    }
}

fn test_writer() {
    var w csv.Writer
    w.add_str("name")
    w.add_str("description, with a comma")
    w.add_str("says \"hi\"")
    w.add_str(" space")
    w.add_int(-12)
    w.add_float(2.5)
    w.end()
    w.add_str("")
    w.add_str("x")
    w.end()
    testing.eq_str(&w.buf[:w.n], "name,\"description, with a comma\",\"says \"\"hi\"\"\",\" space\",-12,2.5\n,x\n")
    // and back through the reader
    src := Text{}
    src.n = str.copy_bytes(&src.data, &w.buf[:w.n])
    src.step = 5
    r := csv.new[Text]()
    want_record(&r, &src, 6)
    var f [64]byte
    n := r.field(2, &f)
    testing.eq_str(&f[:n], "says \"hi\"")
    n = r.field(3, &f)
    testing.eq_str(&f[:n], " space")
    w.reset()
    w.sep = ';'
    w.crlf = true
    w.add_str("a;b")
    w.add_str("c")
    w.end()
    testing.eq_str(&w.buf[:w.n], "\"a;b\";c\r\n")
}
