// Growing vector. It's the part of the library that allocates, and the allocation is
// visible here: new allocates, push calls grow when room runs out, and grow doubles
// the capacity with realloc.
//
// The elements can be owners (T owned: ?*X or []X): push moves the value
// inside, pop and take return ownership, put swaps (and returns the old one), set
// puts and frees the old one, and free frees each element (drop) and the vector. get
// copies, so it only exists when T is copyable.
//
//     names := vec.new[[]byte](8)
//     names.push(copy)           // copy was moved into the vector
//     name := names.take(0)      // ownership comes back
//     names.set(0, name)         // and goes into the vector again
//     names.free()               // frees each name and the vector

// Vec is the vector: the elements in items[:count], and the capacity is len(items).
pub struct Vec[T owned] {
    items []T
    count int
}

extern fn fail(msg string)

// new allocates an empty vector with room for cap elements.
pub fn new[T owned](cap int) *Vec[T] {
    return alloc(Vec[T]{items: alloc([]T, cap), count: 0})
}

// push appends x at the end (x is moved into the vector).
pub fn (v &Vec[T]) push(x T) {
    if v.count == len(v.items) {
        v.grow()
    }
    old := replace(&v.items[v.count], x)
    drop(old) // the position after the end was empty
    v.count++
}

// grow doubles the capacity (realloc).
pub fn (v &Vec[T]) grow() {
    v.items = realloc(v.items, len(v.items) * 2 + 1)
}

// pop takes out the last element and returns its ownership.
pub fn (v &Vec[T]) pop() T {
    if v.count == 0 {
        fail("vec.pop: empty vector")
    }
    v.count--
    return take(&v.items[v.count])
}

// take takes out element i, leaving the zero value in its place, and returns ownership.
pub fn (v &Vec[T]) take(i int) T {
    if i < 0 || i >= v.count {
        fail("vec.take: index outside the vector")
    }
    return take(&v.items[i])
}

// put puts x at position i and returns the element that was there.
pub fn (v &Vec[T]) put(i int, x T) T {
    if i < 0 || i >= v.count {
        fail("vec.put: index outside the vector")
    }
    return replace(&v.items[i], x)
}

// swap swaps elements i and j.
pub fn (v &Vec[T]) swap(i int, j int) {
    if i < 0 || i >= v.count || j < 0 || j >= v.count {
        fail("vec.swap: index outside the vector")
    }
    a := take(&v.items[i])
    b := replace(&v.items[j], a)
    old := replace(&v.items[i], b)
    drop(old) // the zero left by the take
}

// at borrows element i, without taking it out of the vector. While the borrow
// is used, the vector stays frozen (it doesn't grow, it isn't freed).
//
//     x := v.at(0)
//     x.field = 3
pub fn (v &Vec[T]) at(i int) &T {
    if i < 0 || i >= v.count {
        fail("vec.at: index outside the vector")
    }
    return &v.items[i]
}

// last borrows the last element.
pub fn (v &Vec[T]) last() &T {
    if v.count == 0 {
        fail("vec.last: empty vector")
    }
    return &v.items[v.count - 1]
}

// each_with calls f with each element, in order, passing along the context
// ctx (where f keeps what it accumulates).
pub fn (v &Vec[T]) each_with[C ref](ctx &C, f fn(&C, &T)) {
    for i := 0; i < v.count; i++ {
        f(ctx, &v.items[i])
    }
}

// len returns how many elements there are in the vector.
pub fn (v &Vec[T]) len() int {
    return v.count
}

// cap returns how many elements fit before growing.
pub fn (v &Vec[T]) cap() int {
    return len(v.items)
}

// clear frees the elements (drop) and leaves the vector empty, with the same
// capacity.
pub fn (v &Vec[T]) clear() {
    for i := 0; i < v.count; i++ {
        x := take(&v.items[i])
        drop(x)
    }
    v.count = 0
}

// free frees each element (drop) and the vector.
pub fn (v *Vec[T]) free() {
    for x in drain(v.items) {
        drop(x)
    }
    free(v.items)
    free(v)
}

// get returns a copy of element i (only for copyable T).
pub fn (v &Vec[T any]) get(i int) T {
    if i < 0 || i >= v.count {
        fail("vec.get: index outside the vector")
    }
    return v.items[i]
}

// set puts x at position i (x is moved) and frees the old element (drop).
// After a take(i), it puts the element back in place.
pub fn (v &Vec[T]) set(i int, x T) {
    if i < 0 || i >= v.count {
        fail("vec.set: index outside the vector")
    }
    old := replace(&v.items[i], x)
    drop(old)
}
