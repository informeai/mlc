// UTF-8: characters (code points) inside bytes. Nothing allocates.
//
//     i := 0
//     for i < len(s) {
//         r := utf8.decode(s, i)     // r.code: the character; r.size: how many bytes
//         ...
//         i += r.size
//     }

// Rune is a decoded character and how many bytes it takes.
pub struct Rune {
    code int
    size int
}

// INVALID is the character returned for bytes that aren't valid UTF-8.
pub const INVALID = 0xFFFD

// decode reads the character that starts at s[i]. Invalid bytes give INVALID
// with size 1, so the loop always advances.
pub fn decode(s &[]byte, i int) Rune {
    b0 := int(s[i])
    if b0 < 0x80 {
        return Rune{code: b0, size: 1}
    }
    n := 0 // continuation bytes
    code := 0
    least := 0 // the smallest character that needs this size
    if (b0 & 0xE0) == 0xC0 {
        n = 1
        code = b0 & 0x1F
        least = 0x80
    } else if (b0 & 0xF0) == 0xE0 {
        n = 2
        code = b0 & 0x0F
        least = 0x800
    } else if (b0 & 0xF8) == 0xF0 {
        n = 3
        code = b0 & 0x07
        least = 0x10000
    } else {
        return Rune{code: INVALID, size: 1}
    }
    if i + n >= len(s) {
        return Rune{code: INVALID, size: 1} // cut at the end
    }
    for k := 1; k <= n; k++ {
        b := int(s[i + k])
        if (b & 0xC0) != 0x80 {
            return Rune{code: INVALID, size: 1}
        }
        code = (code << 6) | (b & 0x3F)
    }
    if code < least || code > 0x10FFFF || (code >= 0xD800 && code <= 0xDFFF) {
        return Rune{code: INVALID, size: 1} // overlong form or outside Unicode
    }
    return Rune{code: code, size: n + 1}
}

// count says how many characters there are in s (each invalid byte counts as one).
pub fn count(s &[]byte) int {
    n := 0
    i := 0
    for i < len(s) {
        i += decode(s, i).size
        n++
    }
    return n
}

// valid says whether s is valid UTF-8.
pub fn valid(s &[]byte) bool {
    i := 0
    for i < len(s) {
        r := decode(s, i)
        if r.code == INVALID && r.size == 1 {
            return false // the real U+FFFD takes 3 bytes
        }
        i += r.size
    }
    return true
}

// encode writes the character code in UTF-8 at the start of dst and returns
// how many bytes it used (1 to 4). An invalid code becomes INVALID.
pub fn encode(dst &[]byte, code int) int {
    if code < 0 || code > 0x10FFFF || (code >= 0xD800 && code <= 0xDFFF) {
        code = INVALID
    }
    if code < 0x80 {
        dst[0] = byte(code)
        return 1
    }
    if code < 0x800 {
        dst[0] = byte(0xC0 | (code >> 6))
        dst[1] = byte(0x80 | (code & 0x3F))
        return 2
    }
    if code < 0x10000 {
        dst[0] = byte(0xE0 | (code >> 12))
        dst[1] = byte(0x80 | ((code >> 6) & 0x3F))
        dst[2] = byte(0x80 | (code & 0x3F))
        return 3
    }
    dst[0] = byte(0xF0 | (code >> 18))
    dst[1] = byte(0x80 | ((code >> 12) & 0x3F))
    dst[2] = byte(0x80 | ((code >> 6) & 0x3F))
    dst[3] = byte(0x80 | (code & 0x3F))
    return 4
}
