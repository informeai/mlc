// UTF-8: caracteres (code points) dentro de bytes. Nada aloca.
//
//     i := 0
//     for i < len(s) {
//         r := utf8.decode(s, i)     // r.code: o caractere; r.size: quantos bytes
//         ...
//         i += r.size
//     }

// Rune é um caractere decodificado e quantos bytes ele ocupa.
pub struct Rune {
    code int
    size int
}

// INVALID é o caractere devolvido para bytes que não são UTF-8 válido.
pub const INVALID = 0xFFFD

// decode lê o caractere que começa em s[i]. Bytes inválidos dão INVALID com
// tamanho 1, para que o laço sempre avance.
pub fn decode(s &[]byte, i int) Rune {
    b0 := int(s[i])
    if b0 < 0x80 {
        return Rune{code: b0, size: 1}
    }
    n := 0 // bytes de continuação
    code := 0
    least := 0 // o menor caractere que precisa desse tamanho
    if (b0 & 0xE0) == 0xC0 {
        n = 1
        code = b0 & 0x1F
        least = 0x80
    } else if (b0 & 0xF0) == 0xE0 {
        n = 2
        code = b0 & 0x0F
        least = 0x800
    } else if (b0 & 0xF8) == 0xF0 {
        n = 3
        code = b0 & 0x07
        least = 0x10000
    } else {
        return Rune{code: INVALID, size: 1}
    }
    if i + n >= len(s) {
        return Rune{code: INVALID, size: 1} // cortado no fim
    }
    for k := 1; k <= n; k++ {
        b := int(s[i + k])
        if (b & 0xC0) != 0x80 {
            return Rune{code: INVALID, size: 1}
        }
        code = (code << 6) | (b & 0x3F)
    }
    if code < least || code > 0x10FFFF || (code >= 0xD800 && code <= 0xDFFF) {
        return Rune{code: INVALID, size: 1} // forma longa demais ou fora do Unicode
    }
    return Rune{code: code, size: n + 1}
}

// count diz quantos caracteres há em s (cada byte inválido conta como um).
pub fn count(s &[]byte) int {
    n := 0
    i := 0
    for i < len(s) {
        i += decode(s, i).size
        n++
    }
    return n
}

// valid diz se s é UTF-8 válido.
pub fn valid(s &[]byte) bool {
    i := 0
    for i < len(s) {
        r := decode(s, i)
        if r.code == INVALID && r.size == 1 {
            return false // o U+FFFD de verdade ocupa 3 bytes
        }
        i += r.size
    }
    return true
}

// encode escreve o caractere code em UTF-8 no começo de dst e devolve
// quantos bytes usou (1 a 4). Um code inválido vira INVALID.
pub fn encode(dst &[]byte, code int) int {
    if code < 0 || code > 0x10FFFF || (code >= 0xD800 && code <= 0xDFFF) {
        code = INVALID
    }
    if code < 0x80 {
        dst[0] = byte(code)
        return 1
    }
    if code < 0x800 {
        dst[0] = byte(0xC0 | (code >> 6))
        dst[1] = byte(0x80 | (code & 0x3F))
        return 2
    }
    if code < 0x10000 {
        dst[0] = byte(0xE0 | (code >> 12))
        dst[1] = byte(0x80 | ((code >> 6) & 0x3F))
        dst[2] = byte(0x80 | (code & 0x3F))
        return 3
    }
    dst[0] = byte(0xF0 | (code >> 18))
    dst[1] = byte(0x80 | ((code >> 12) & 0x3F))
    dst[2] = byte(0x80 | ((code >> 6) & 0x3F))
    dst[3] = byte(0x80 | (code & 0x3F))
    return 4
}
