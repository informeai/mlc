import "std/rand"
import "std/testing"

fn test_deterministic() {
    a := rand.new(42)
    b := rand.new(42)
    for i := 0; i < 10; i++ {
        testing.eq_uint(a.next(), b.next())
    }
    c := rand.new(43)
    d := rand.new(42)
    testing.check(c.next() != d.next(), "different seeds, different sequences")
}

fn test_splitmix_reference() {
    // first value of splitmix64 with seed 0
    r := rand.new(0)
    testing.eq_uint(r.next(), 0xE220_A839_7B1D_CDAF)
}

fn test_ranges() {
    r := rand.new(1)
    seen := [6]bool{}
    for i := 0; i < 1000; i++ {
        n := r.range(1, 7)
        testing.check(n >= 1 && n < 7, "range outside [1, 7)")
        seen[n - 1] = true
        f := r.float()
        testing.check(f >= 0.0 && f < 1.0, "float outside [0, 1)")
    }
    for s in seen {
        testing.check(s, "every value from 1 to 6 shows up in 1000 draws")
    }
}

fn test_secure() {
    var a [32]byte
    var b [32]byte
    rand.secure(&a)
    rand.secure(&b)
    same := true
    zero := true
    for i := 0; i < 32; i++ {
        same = same && a[i] == b[i]
        zero = zero && a[i] == 0
    }
    testing.check(!same, "two calls give different bytes")
    testing.check(!zero, "wasn't left zeroed")
    var big [1000]byte // more than the 256 bytes of one system call
    rand.secure(&big)
    zeros := 0
    for i := 0; i < len(big); i++ {
        if big[i] == 0 {
            zeros++
        }
    }
    testing.check(zeros < 30, "the bytes spread out (about 4 zeros in 1000)")
}

fn test_secure_int_n() {
    var seen [6]bool
    for i := 0; i < 600; i++ {
        n := rand.secure_int_n(6)
        testing.check(n >= 0 && n < 6, "in the range")
        seen[n] = true
    }
    for i := 0; i < 6; i++ {
        testing.check(seen[i], "every value shows up")
    }
    testing.eq_int(rand.secure_int_n(1), 0)
}

fn test_secure_int_n_zero() {
    testing.expect_panic()
    rand.secure_int_n(0)
}

fn test_seeded() {
    a := rand.seeded()
    b := rand.seeded()
    testing.check(a.next() != b.next(), "different seeds")
}
