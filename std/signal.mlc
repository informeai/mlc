// System signals: Ctrl+C (INT), the stop request from Docker,
// systemd and Kubernetes (TERM) and the others a service usually handles.
// Without listen, a signal does what it always did (INT and TERM end the program
// on the spot). With listen, the signal is only recorded: the program checks
// (received) or waits (wait) and decides what to do, at the point it chooses,
// closing connections and saving what's left.
//
//     signal.listen_shutdown()                  // INT and TERM
//     for !signal.received(signal.INT) && !signal.received(signal.TERM) {
//         ... work in pieces (accept with a timeout, for example) ...
//     }
//     ... shut down calmly ...
//
//     // or, with the work in other threads:
//     sig := signal.wait(-1)                    // sleeps until a signal arrives
//
// The real handler (in C) only marks the signal and wakes whoever is in
// wait: no allocating, locking or writing inside it. The mark applies to
// every thread and stays until clear.

// signal codes (the same on every system; the runtime translates)
pub const HUP = 1   // the terminal closed; usually asks to reload the configuration
pub const INT = 2   // Ctrl+C
pub const QUIT = 3  // Ctrl+\
pub const USR1 = 10 // free for the program
pub const USR2 = 12
pub const TERM = 15 // stop request (kill, docker stop, systemctl stop)

// listen starts recording the signal instead of doing what it normally does.
pub extern fn listen(sig int)

// listen_shutdown records INT and TERM: the two stop requests.
pub fn listen_shutdown() {
    listen(INT)
    listen(TERM)
}

// ignore makes the program not see the signal (nor record it).
pub extern fn ignore(sig int)

// restore goes back to the signal's normal behavior.
pub extern fn restore(sig int)

// received says whether the signal arrived (since the start, or since the last clear).
pub extern fn received(sig int) bool

// clear forgets that the signal arrived.
pub extern fn clear(sig int)

// wait waits until one of the signals recorded with listen arrives (or until
// ms milliseconds pass; -1: no limit) and returns its code, or 0 if time
// ran out. If one already arrived (and wasn't cleared), it returns at once.
pub extern fn wait(ms int) int

// raise sends the signal to the program itself (useful in tests).
pub extern fn raise(sig int)
