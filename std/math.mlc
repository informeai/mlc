// Math functions. The floating-point ones come from C's libm.

pub const PI = 3.141592653589793
pub const E = 2.718281828459045

// abs returns the absolute value of x.
pub fn abs[T number](x T) T {
    if x < T(0) {
        return -x
    }
    return x
}

// min returns the smaller of a and b.
pub fn min[T ordered](a T, b T) T {
    if a < b {
        return a
    }
    return b
}

// max returns the larger of a and b.
pub fn max[T ordered](a T, b T) T {
    if a > b {
        return a
    }
    return b
}

// clamp limits x to the range [lo, hi].
pub fn clamp[T ordered](x T, lo T, hi T) T {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

// sqrt returns the square root of x.
pub extern fn sqrt(x float64) float64
// pow returns x raised to y.
pub extern fn pow(x float64, y float64) float64
// floor returns the largest integer (as a real) not greater than x.
pub extern fn floor(x float64) float64
// ceil returns the smallest integer (as a real) not less than x.
pub extern fn ceil(x float64) float64
// round returns x rounded to the nearest integer (halves away from zero).
pub extern fn round(x float64) float64
// sin returns the sine of x (in radians).
pub extern fn sin(x float64) float64
// cos returns the cosine of x (in radians).
pub extern fn cos(x float64) float64
// tan returns the tangent of x (in radians).
pub extern fn tan(x float64) float64
// atan2 returns the angle, in radians, of the point (x, y): the arc tangent of y/x in the right quadrant.
pub extern fn atan2(y float64, x float64) float64
// log returns the natural logarithm of x.
pub extern fn log(x float64) float64
// exp returns e raised to x.
pub extern fn exp(x float64) float64
// is_nan says whether x is NaN.
pub extern fn is_nan(x float64) bool
// is_inf says whether x is infinite (positive or negative).
pub extern fn is_inf(x float64) bool

// float64_bits returns the bits of x in IEEE 754 format (the same value C
// keeps in memory); float64_from_bits goes the way back. They serve to
// write reals in binary (std/binary) and to compare NaN bit by bit.
pub extern fn float64_bits(x float64) uint64
// float64_from_bits builds the float64 whose IEEE 754 bits are u.
pub extern fn float64_from_bits(u uint64) float64

// float32_bits and float32_from_bits are the same for float32.
pub extern fn float32_bits(x float32) uint32
// float32_from_bits builds the float32 whose IEEE 754 bits are u.
pub extern fn float32_from_bits(u uint32) float32
