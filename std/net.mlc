// TCP. Servers and clients with handles the checker forces you to close;
// data passes through the caller's buffers, without allocating.
//
//     var host [16]byte
//     err := 0
//     l := net.listen(&host[:0], 8080, &err)       // empty host: all interfaces
//     for {
//         c := l.accept(&err)
//         if c == nil { break }
//         t := thread.spawn(handle, c, thread.STACK_64KB)   // one thread per connection
//         thread.join(t)
//     }
//     l.close()
//
//     fn handle(c *net.Conn) {
//         var buf [4096]byte
//         match c.read(&buf) {
//             Ok(n) => c.write(&buf[:n])       // n == 0: the other side closed
//             Err(code) => {}
//         }
//         c.close()
//     }
//
// The host is a name or address (localhost, 127.0.0.1, ::1, example.com).
// Writing to a connection the other side closed returns RESET, instead of
// ending the program.
import "std/io"
import "std/result"

// error codes (the others are the system's errno)
pub const REFUSED = 2001 // nobody listens on that port
pub const NO_HOST = 2002 // the name wasn't found
pub const IN_USE = 2003  // the port is already in use
pub const TIMEOUT = 2004 // set_timeout's time ran out
pub const RESET = 2005   // the other side closed or dropped the connection

// Listener waits for connections on a port (a handle): it needs a close().
pub extern "C" type Listener

// Conn is a TCP connection (a handle): it needs a close().
pub extern "C" type Conn

// listen listens on host:port (empty host: all interfaces; port 0: the
// system picks, see Listener.port). If it can't, returns nil and puts
// the code in err.
pub extern fn listen(host &[]byte, port int, err &int) ?*Listener

// connect opens a connection to host:port. If it can't, returns nil and
// puts the code in err (REFUSED, NO_HOST, ...).
pub extern fn connect(host &[]byte, port int, err &int) ?*Conn

extern fn accept_raw(l &Listener, err &int) ?*Conn
extern fn port_raw(l &Listener) int
extern fn close_listener(l *Listener)
extern fn listener_timeout_raw(l &Listener, ms int)
extern fn read_raw(c &Conn, dst &[]byte) int
extern fn write_raw(c &Conn, data &[]byte) int
extern fn timeout_raw(c &Conn, ms int) int
extern fn shutdown_raw(c &Conn) int
extern fn close_raw(c *Conn)

// accept waits for the next connection. If it fails, returns nil and puts the code in
// err.
pub fn (l &Listener) accept(err &int) ?*Conn {
    return accept_raw(l, err)
}

// port says which port the listener is on (useful with port 0).
// set_timeout limits accept's wait to ms milliseconds (-1: no
// limit). After that, accept returns nil with err TIMEOUT, and the loop
// can check something else (a signal.received, for example) before
// waiting again. A signal that arrives during the wait also returns
// TIMEOUT.
pub fn (l &Listener) set_timeout(ms int) {
    listener_timeout_raw(l, ms)
}

// port returns the port the listener listens on (useful with port 0, which the
// system picks).
pub fn (l &Listener) port() int {
    return port_raw(l)
}

// close stops listening and frees the listener.
pub fn (l *Listener) close() {
    close_listener(l)
}

// read reads what arrives, up to len(dst) bytes; Ok(0) means the other
// side closed.
pub fn (c &Conn) read(dst &[]byte) result.Result[int, int] {
    return wrap(read_raw(c, dst))
}

// write sends all the bytes of data.
pub fn (c &Conn) write(data &[]byte) result.Result[int, int] {
    return wrap(write_raw(c, data))
}

// set_timeout limits, in milliseconds, how long read and write wait (0: no
// limit). After that, the error is TIMEOUT.
pub fn (c &Conn) set_timeout(ms int) result.Result[int, int] {
    return wrap(timeout_raw(c, ms))
}

// shutdown tells the other side it won't send anything else (its read
// gets Ok(0)); reading still works.
pub fn (c &Conn) shutdown() result.Result[int, int] {
    return wrap(shutdown_raw(c))
}

// close closes the connection and frees the handle.
pub fn (c *Conn) close() {
    close_raw(c)
}

// a connection is an io.Reader: std/bufio reads lines from it
impl io.Reader for Conn

fn wrap(n int) result.Result[int, int] {
    if n < 0 {
        return result.Result.Err(-n)
    }
    return result.Result.Ok(n)
}
