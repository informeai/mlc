// Hash table (hash map), written in MLC: open addressing with
// linear probing, power-of-2 capacity and growth (realloc of the three
// parts) when it passes 3/4 occupancy.
//
// Keys and values can be owners (K owned + hash.Hash, V owned): put
// moves both inside, take_or takes a value out (the key is freed),
// remove frees the entry and free frees everything. get_or copies, so it only exists
// when V is copyable. Every allocation is here, in plain sight: new allocates the parts and
// grow swaps them for larger parts.
//
//     count := map.new[[]byte, int](16)
//     n := count.get_or(&word, 0)
//     if !count.set(&word, n + 1) {
//         count.put(key, 1)     // the new key (allocated by the caller) is moved
//     }
//     count.free()
import "std/hash"

// Map is the table: keys and values in parallel slices, and the state of each
// slot.
pub struct Map[K owned + hash.Hash, V owned] {
    keys []K
    vals []V
    state []byte // EMPTY, FULL or DELETED, per slot
    count int    // entries
    used int     // FULL or DELETED slots (they decide when to grow)
}

extern fn fail(msg string)

const EMPTY = 0
const FULL = 1
const DELETED = 2 // deleted: probing continues through it

// new allocates a map with room for about cap entries before growing.
pub fn new[K owned + hash.Hash, V owned](cap int) *Map[K, V] {
    n := 8
    for n * 3 < cap * 4 {
        n = n * 2
    }
    return alloc(Map[K, V]{keys: alloc([]K, n), vals: alloc([]V, n), state: alloc([]byte, n), count: 0, used: 0})
}

// find returns the slot of key k, or -1.
fn (m &Map[K, V]) find(k &K) int {
    mask := len(m.state) - 1
    i := int(k.hash() & uint64(mask))
    for {
        st := m.state[i]
        if st == EMPTY {
            return -1
        }
        if st == FULL && m.keys[i].eq(k) {
            return i
        }
        i = (i + 1) & mask
    }
}

// slot returns the slot of k, if it already exists, or the first free one (deleted
// or empty) on the probe path.
fn (m &Map[K, V]) slot(k &K) int {
    mask := len(m.state) - 1
    i := int(k.hash() & uint64(mask))
    first := -1
    for {
        st := m.state[i]
        if st == EMPTY {
            if first >= 0 {
                return first
            }
            return i
        }
        if st == DELETED && first < 0 {
            first = i
        }
        if st == FULL && m.keys[i].eq(k) {
            return i
        }
        i = (i + 1) & mask
    }
}

// put stores v at key k (both are moved into the map). If the key already
// existed, the old key stays, and the new key and the old value are freed
// (drop).
pub fn (m &Map[K, V]) put(k K, v V) {
    if (m.used + 1) * 4 > len(m.state) * 3 {
        m.grow()
    }
    i := m.slot(&k)
    if m.state[i] == FULL {
        drop(k)
        old := replace(&m.vals[i], v)
        drop(old)
        return
    }
    if m.state[i] == EMPTY {
        m.used++
    }
    m.state[i] = FULL
    m.count++
    oldk := replace(&m.keys[i], k)
    drop(oldk) // free slot: the zero value
    oldv := replace(&m.vals[i], v)
    drop(oldv)
}

// set replaces the value of a key that already exists (the old one is freed) and
// returns true. If the key doesn't exist, v is freed and it returns false.
pub fn (m &Map[K, V]) set(k &K, v V) bool {
    i := m.find(k)
    if i < 0 {
        drop(v)
        return false
    }
    old := replace(&m.vals[i], v)
    drop(old)
    return true
}

// has says whether key k is in the table.
pub fn (m &Map[K, V]) has(k &K) bool {
    return m.find(k) >= 0
}

// get borrows the value of k, without taking it out of the map (panics if the key doesn't
// exist: check first with has, or use index). While the borrow is
// used, the map stays frozen.
//
//     n := count.get(&word)
//     *n += 1
pub fn (m &Map[K, V]) get(k &K) &V {
    i := m.find(k)
    if i < 0 {
        fail("map.get: a chave não existe (confira com has, ou use index)")
    }
    return &m.vals[i]
}

// index returns the slot of k (for value_ref and key_ref), or -1.
pub fn (m &Map[K, V]) index(k &K) int {
    return m.find(k)
}

// value_ref borrows the value at slot i (from index or next).
pub fn (m &Map[K, V]) value_ref(i int) &V {
    if i < 0 || i >= len(m.state) || m.state[i] != FULL {
        fail("map.value_ref: posição vazia")
    }
    return &m.vals[i]
}

// key_ref borrows the key at slot i (from index or next).
pub fn (m &Map[K, V]) key_ref(i int) &K {
    if i < 0 || i >= len(m.state) || m.state[i] != FULL {
        fail("map.key_ref: posição vazia")
    }
    return &m.keys[i]
}

// get_or returns a copy of k's value, or def if it doesn't exist (only for copyable
// V).
pub fn (m &Map[K, V any]) get_or(k &K, def V) V {
    i := m.find(k)
    if i < 0 {
        return def
    }
    return m.vals[i]
}

// take_or takes out k's entry and returns ownership of the value (the key is
// freed). If k doesn't exist, returns def.
pub fn (m &Map[K, V]) take_or(k &K, def V) V {
    i := m.find(k)
    if i < 0 {
        return def
    }
    drop(def)
    m.state[i] = DELETED
    m.count--
    key := take(&m.keys[i])
    drop(key)
    return take(&m.vals[i])
}

// remove deletes k's entry (key and value are freed) and says whether it
// existed.
pub fn (m &Map[K, V]) remove(k &K) bool {
    i := m.find(k)
    if i < 0 {
        return false
    }
    m.state[i] = DELETED
    m.count--
    key := take(&m.keys[i])
    drop(key)
    val := take(&m.vals[i])
    drop(val)
    return true
}

// len returns how many entries there are in the table.
pub fn (m &Map[K, V]) len() int {
    return m.count
}

// each calls f with each entry (in any order). f receives the key and the
// value borrowed.
pub fn (m &Map[K, V]) each(f fn(&K, &V)) {
    for i := 0; i < len(m.state); i++ {
        if m.state[i] == FULL {
            f(&m.keys[i], &m.vals[i])
        }
    }
}

// each_with calls f with each entry (in any order), passing along the
// context ctx: it's where f keeps what it accumulates, since functions don't capture
// variables.
//
//     struct Sum { total int }
//     fn add(s &Sum, k &[]byte, v &int) { s.total += *v }
//
//     var s Sum
//     m.each_with(&s, add)
pub fn (m &Map[K, V]) each_with[C ref](ctx &C, f fn(&C, &K, &V)) {
    for i := 0; i < len(m.state); i++ {
        if m.state[i] == FULL {
            f(ctx, &m.keys[i], &m.vals[i])
        }
    }
}

// next returns the next occupied slot starting at i, or -1. With key_at and
// value_at, it walks the map when keys and values are copyable:
//
//     for i := m.next(0); i >= 0; i = m.next(i + 1) { ... m.key_at(i) ... }
pub fn (m &Map[K, V]) next(i int) int {
    for j := i; j < len(m.state); j++ {
        if m.state[j] == FULL {
            return j
        }
    }
    return -1
}

// key_at returns a copy of the key at slot i (only for copyable K).
pub fn (m &Map[K any, V]) key_at(i int) K {
    return m.keys[i]
}

// value_at returns a copy of the value at slot i (only for copyable V).
pub fn (m &Map[K, V any]) value_at(i int) V {
    return m.vals[i]
}

// clear frees every entry and leaves the map empty (same capacity).
pub fn (m &Map[K, V]) clear() {
    for i := 0; i < len(m.state); i++ {
        if m.state[i] == FULL {
            key := take(&m.keys[i])
            drop(key)
            val := take(&m.vals[i])
            drop(val)
        }
        m.state[i] = EMPTY
    }
    m.count = 0
    m.used = 0
}

// free frees each entry and the map.
pub fn (m *Map[K, V]) free() {
    for k in drain(m.keys) {
        drop(k)
    }
    for v in drain(m.vals) {
        drop(v)
    }
    free(m.keys)
    free(m.vals)
    free(m.state)
    free(m)
}

// grow swaps the parts for others of double the size (or the same, if
// most occupied slots are only deleted) and reinserts the entries.
fn (m &Map[K, V]) grow() {
    n := len(m.state) * 2
    if m.count * 4 < len(m.state) {
        n = len(m.state) // many deleted: only reorganizes
    }
    oldk := m.keys
    oldv := m.vals
    olds := m.state
    m.keys = alloc([]K, n)
    m.vals = alloc([]V, n)
    m.state = alloc([]byte, n)
    m.count = 0
    m.used = 0
    for i := 0; i < len(olds); i++ {
        if olds[i] == FULL {
            k := take(&oldk[i])
            v := take(&oldv[i])
            m.insert_new(k, v)
        }
    }
    for k in drain(oldk) {
        drop(k) // what's left are zero values
    }
    for v in drain(oldv) {
        drop(v)
    }
    free(oldk)
    free(oldv)
    free(olds)
}

// insert_new puts a key that isn't in the map, in a table with room.
fn (m &Map[K, V]) insert_new(k K, v V) {
    mask := len(m.state) - 1
    i := int(k.hash() & uint64(mask))
    for m.state[i] != EMPTY {
        i = (i + 1) & mask
    }
    m.state[i] = FULL
    m.count++
    m.used++
    oldk := replace(&m.keys[i], k)
    drop(oldk)
    oldv := replace(&m.vals[i], v)
    drop(oldv)
}
