// Numbers as bytes: fixed-size integers and reals, in big-endian (_be: the
// most significant byte first, the order of networks and of most
// file formats) or little-endian (_le: the least significant
// first, the order of x86 and ARM), and variable-size integers
// (varint, the protobuf and Go format).
//
// Nothing allocates: readers take a borrowed slice and read its start; writers
// write at the start of dst. The position stays with the caller, as a
// sub-slice:
//
//     var hdr [14]byte
//     binary.put_u32_be(&hdr, MAGIC)
//     binary.put_u16_le(&hdr[4:], version)
//     binary.put_f64_le(&hdr[6:], ratio)
//
//     size := binary.u32_be(&buf[off:])
//
// A slice too short for the value panics (put_f64_le(&hdr[8:], x)
// above: only 6 bytes are left).
import "std/math"

extern fn fail(msg string)

fn need(b &[]byte, n int) {
    if len(b) < n {
        fail("binary: o slice é curto demais para o valor")
    }
}

// ---------- unsigned ----------

// u16_be reads a uint16 from the first 2 bytes of src, in big-endian.
pub fn u16_be(src &[]byte) uint16 {
    need(src, 2)
    return (uint16(src[0]) << 8) | uint16(src[1])
}

// u16_le reads a uint16 from the first 2 bytes of src, in little-endian.
pub fn u16_le(src &[]byte) uint16 {
    need(src, 2)
    return uint16(src[0]) | (uint16(src[1]) << 8)
}

// put_u16_be writes v into the first 2 bytes of dst, in big-endian.
pub fn put_u16_be(dst &[]byte, v uint16) {
    need(dst, 2)
    dst[0] = byte(v >> 8)
    dst[1] = byte(v & 0xFF)
}

// put_u16_le writes v into the first 2 bytes of dst, in little-endian.
pub fn put_u16_le(dst &[]byte, v uint16) {
    need(dst, 2)
    dst[0] = byte(v & 0xFF)
    dst[1] = byte(v >> 8)
}

// u32_be reads a uint32 from the first 4 bytes of src, in big-endian.
pub fn u32_be(src &[]byte) uint32 {
    need(src, 4)
    return (uint32(src[0]) << 24) | (uint32(src[1]) << 16) | (uint32(src[2]) << 8) | uint32(src[3])
}

// u32_le reads a uint32 from the first 4 bytes of src, in little-endian.
pub fn u32_le(src &[]byte) uint32 {
    need(src, 4)
    return uint32(src[0]) | (uint32(src[1]) << 8) | (uint32(src[2]) << 16) | (uint32(src[3]) << 24)
}

// put_u32_be writes v into the first 4 bytes of dst, in big-endian.
pub fn put_u32_be(dst &[]byte, v uint32) {
    need(dst, 4)
    for i := 0; i < 4; i++ {
        dst[i] = byte((v >> (24 - 8 * i)) & 0xFF)
    }
}

// put_u32_le writes v into the first 4 bytes of dst, in little-endian.
pub fn put_u32_le(dst &[]byte, v uint32) {
    need(dst, 4)
    for i := 0; i < 4; i++ {
        dst[i] = byte((v >> (8 * i)) & 0xFF)
    }
}

// u64_be reads a uint64 from the first 8 bytes of src, in big-endian.
pub fn u64_be(src &[]byte) uint64 {
    need(src, 8)
    var v uint64 = 0
    for i := 0; i < 8; i++ {
        v = (v << 8) | uint64(src[i])
    }
    return v
}

// u64_le reads a uint64 from the first 8 bytes of src, in little-endian.
pub fn u64_le(src &[]byte) uint64 {
    need(src, 8)
    var v uint64 = 0
    for i := 7; i >= 0; i-- {
        v = (v << 8) | uint64(src[i])
    }
    return v
}

// put_u64_be writes v into the first 8 bytes of dst, in big-endian.
pub fn put_u64_be(dst &[]byte, v uint64) {
    need(dst, 8)
    for i := 0; i < 8; i++ {
        dst[i] = byte((v >> (56 - 8 * i)) & 0xFF)
    }
}

// put_u64_le writes v into the first 8 bytes of dst, in little-endian.
pub fn put_u64_le(dst &[]byte, v uint64) {
    need(dst, 8)
    for i := 0; i < 8; i++ {
        dst[i] = byte((v >> (8 * i)) & 0xFF)
    }
}

// ---------- signed (two's complement) ----------

// i16_be reads an int16 from the first 2 bytes of src, in big-endian.
pub fn i16_be(src &[]byte) int16 {
    return signed16(u16_be(src))
}

// i16_le reads an int16 from the first 2 bytes of src, in little-endian.
pub fn i16_le(src &[]byte) int16 {
    return signed16(u16_le(src))
}

// put_i16_be writes v into the first 2 bytes of dst, in big-endian.
pub fn put_i16_be(dst &[]byte, v int16) {
    put_u16_be(dst, unsigned16(v))
}

// put_i16_le writes v into the first 2 bytes of dst, in little-endian.
pub fn put_i16_le(dst &[]byte, v int16) {
    put_u16_le(dst, unsigned16(v))
}

// i32_be reads an int32 from the first 4 bytes of src, in big-endian.
pub fn i32_be(src &[]byte) int32 {
    return signed32(u32_be(src))
}

// i32_le reads an int32 from the first 4 bytes of src, in little-endian.
pub fn i32_le(src &[]byte) int32 {
    return signed32(u32_le(src))
}

// put_i32_be writes v into the first 4 bytes of dst, in big-endian.
pub fn put_i32_be(dst &[]byte, v int32) {
    put_u32_be(dst, unsigned32(v))
}

// put_i32_le writes v into the first 4 bytes of dst, in little-endian.
pub fn put_i32_le(dst &[]byte, v int32) {
    put_u32_le(dst, unsigned32(v))
}

// i64_be reads an int (64 bits) from the first 8 bytes of src, in big-endian.
pub fn i64_be(src &[]byte) int {
    return signed64(u64_be(src))
}

// i64_le reads an int (64 bits) from the first 8 bytes of src, in little-endian.
pub fn i64_le(src &[]byte) int {
    return signed64(u64_le(src))
}

// put_i64_be writes v into the first 8 bytes of dst, in big-endian.
pub fn put_i64_be(dst &[]byte, v int) {
    put_u64_be(dst, unsigned64(v))
}

// put_i64_le writes v into the first 8 bytes of dst, in little-endian.
pub fn put_i64_le(dst &[]byte, v int) {
    put_u64_le(dst, unsigned64(v))
}

// The bits of a negative in two's complement: ^x is non-negative (-x-1),
// and flipping its bits back gives x's pattern. This way no
// conversion goes out of range.
fn unsigned16(x int16) uint16 {
    if x < 0 {
        return ^uint16(^x)
    }
    return uint16(x)
}

fn signed16(u uint16) int16 {
    if u >= 0x8000 {
        return ^int16(^u)
    }
    return int16(u)
}

fn unsigned32(x int32) uint32 {
    if x < 0 {
        return ^uint32(^x)
    }
    return uint32(x)
}

fn signed32(u uint32) int32 {
    if u >= 0x8000_0000 {
        return ^int32(^u)
    }
    return int32(u)
}

fn unsigned64(x int) uint64 {
    if x < 0 {
        return ^uint64(^x)
    }
    return uint64(x)
}

fn signed64(u uint64) int {
    if u >= 0x8000_0000_0000_0000 {
        return ^int(^u)
    }
    return int(u)
}

// ---------- reals (IEEE 754) ----------

// f32_be reads a float32 from the first 4 bytes of src, in big-endian.
pub fn f32_be(src &[]byte) float32 {
    return math.float32_from_bits(u32_be(src))
}

// f32_le reads a float32 from the first 4 bytes of src, in little-endian.
pub fn f32_le(src &[]byte) float32 {
    return math.float32_from_bits(u32_le(src))
}

// put_f32_be writes v into the first 4 bytes of dst, in big-endian.
pub fn put_f32_be(dst &[]byte, x float32) {
    put_u32_be(dst, math.float32_bits(x))
}

// put_f32_le writes v into the first 4 bytes of dst, in little-endian.
pub fn put_f32_le(dst &[]byte, x float32) {
    put_u32_le(dst, math.float32_bits(x))
}

// f64_be reads a float64 from the first 8 bytes of src, in big-endian.
pub fn f64_be(src &[]byte) float64 {
    return math.float64_from_bits(u64_be(src))
}

// f64_le reads a float64 from the first 8 bytes of src, in little-endian.
pub fn f64_le(src &[]byte) float64 {
    return math.float64_from_bits(u64_le(src))
}

// put_f64_be writes v into the first 8 bytes of dst, in big-endian.
pub fn put_f64_be(dst &[]byte, x float64) {
    put_u64_be(dst, math.float64_bits(x))
}

// put_f64_le writes v into the first 8 bytes of dst, in little-endian.
pub fn put_f64_le(dst &[]byte, x float64) {
    put_u64_le(dst, math.float64_bits(x))
}

// ---------- varint ----------

// MAX_VARINT is the largest size of a 64-bit varint: a [10]byte is always
// enough.
pub const MAX_VARINT = 10

// uvarint_len says how many bytes put_uvarint uses for v (1 to 10).
pub fn uvarint_len(v uint64) int {
    n := 1
    for v >= 0x80 {
        v >>= 7
        n++
    }
    return n
}

// put_uvarint writes v at 7 bits per byte, least significant first
// (the 0x80 bit says another byte follows), and returns how many bytes it used.
pub fn put_uvarint(dst &[]byte, v uint64) int {
    need(dst, uvarint_len(v))
    i := 0
    for v >= 0x80 {
        dst[i] = byte(v & 0x7F) | 0x80
        v >>= 7
        i++
    }
    dst[i] = byte(v)
    return i + 1
}

// uvarint reads a varint from the start of src into out and returns how many bytes
// it used; 0 if src ends in the middle (bytes are missing: read more and try again) and
// -1 if the number doesn't fit in 64 bits.
pub fn uvarint(src &[]byte, out &uint64) int {
    var v uint64 = 0
    shift := 0
    for i := 0; i < len(src); i++ {
        if i == MAX_VARINT {
            return -1
        }
        b := src[i]
        if b < 0x80 {
            if i == MAX_VARINT - 1 && b > 1 {
                return -1
            }
            *out = v | (uint64(b) << shift)
            return i + 1
        }
        v |= uint64(b & 0x7F) << shift
        shift += 7
    }
    return 0
}

// Signed varints use zigzag: 0, -1, 1, -2, 2... become 0, 1, 2, 3,
// 4..., so small numbers, positive or negative, take few bytes.

// varint_len says how many bytes put_varint uses for v.
pub fn varint_len(v int) int {
    return uvarint_len(zigzag(v))
}

// put_varint writes v (signed) and returns how many bytes it used.
pub fn put_varint(dst &[]byte, v int) int {
    return put_uvarint(dst, zigzag(v))
}

// varint reads a signed varint; the return is the same as uvarint's.
pub fn varint(src &[]byte, out &int) int {
    var u uint64 = 0
    n := uvarint(src, &u)
    if n > 0 {
        v := int(u >> 1)
        if u & 1 != 0 {
            v = ^v
        }
        *out = v
    }
    return n
}

fn zigzag(v int) uint64 {
    if v < 0 {
        return (uint64(^v) << 1) | 1
    }
    return uint64(v) << 1
}
