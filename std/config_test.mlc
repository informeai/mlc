import "std/config"
import "std/fs"
import "std/os"
import "std/str"
import "std/testing"

fn parse(c &config.Config, text string) {
    var b [4096]byte
    n := str.copy(&b, text)
    match c.parse(&b[:n]) {
        Ok(_) => {}
        Err(code) => testing.eq_int(code, 0)
    }
}

fn test_env_file() {
    var c config.Config
    parse(&c, "# comment\nPORT=8080\n  NAME = Joe's Shop  \nexport DEBUG=true\nEMPTY=\nSECRET=\"a#b \\\"c\\\"\\nd\"\nRAW='no \\n escape'\nWITH=value # comment\nPORT=9090\r\n")
    var v [64]byte
    n := c.get("NAME", &v)
    testing.eq_str(&v[:n], "Joe's Shop")
    port_ := 0
    testing.check(c.int("PORT", &port_), "int")
    testing.eq_int(port_, 9090) // the last one wins
    debug := false
    testing.check(c.bool("DEBUG", &debug), "bool")
    testing.check(debug, "true")
    testing.eq_int(c.get("EMPTY", &v), 0)
    n = c.get("SECRET", &v)
    testing.eq_str(&v[:n], "a#b \"c\"\nd")
    n = c.get("RAW", &v)
    testing.eq_str(&v[:n], "no \\n escape")
    n = c.get("WITH", &v)
    testing.eq_str(&v[:n], "value")
    testing.eq_int(c.get("MISSING", &v), -1)
    fallback := 42
    testing.check(!c.int("MISSING", &fallback), "doesn't exist")
    testing.eq_int(fallback, 42) // the default stays
    testing.check(!c.int("NAME", &fallback), "isn't a number")
    testing.check(c.is("DEBUG", "true"), "is")
}

fn test_ini_sections() {
    var c config.Config
    parse(&c, "name = app\n\n[db]\npath = shop.db\ntimeout = 5 ; seconds\n\n[ http ]\nport=80\n")
    var v [64]byte
    n := c.get("name", &v)
    testing.eq_str(&v[:n], "app")
    n = c.get("db.path", &v)
    testing.eq_str(&v[:n], "shop.db")
    t := 0
    testing.check(c.int("db.timeout", &t), "; at the end is a comment")
    testing.eq_int(t, 5)
    testing.check(c.int("http.port", &t), "section with spaces")
    testing.eq_int(t, 80)
    testing.eq_int(c.get("path", &v), -1) // without the section it isn't found
    testing.eq_int(c.len(), 4)
    n = c.key(1, &v)
    testing.eq_str(&v[:n], "db.path")
}

fn test_bad_lines() {
    var c config.Config
    var b [64]byte
    n := str.copy(&b, "A=1\nno equals\n")
    match c.parse(&b[:n]) {
        Ok(_) => testing.fail("should have failed")
        Err(code) => testing.eq_int(code, config.BAD_LINE)
    }
    testing.eq_int(c.bad_line, 2)
    n = str.copy(&b, "A=\"no end\n")
    match c.parse(&b[:n]) {
        Ok(_) => testing.fail("open quotes")
        Err(code) => testing.eq_int(code, config.BAD_LINE)
    }
    n = str.copy(&b, "[secao\n")
    match c.parse(&b[:n]) {
        Ok(_) => testing.fail("section without ]")
        Err(_) => testing.eq_int(c.bad_line, 1)
    }
}

fn test_load_and_env() {
    var path [64]byte
    pn := str.copy(&path, "/tmp/mlc_config_test.env")
    var data [64]byte
    dn := str.copy(&data, "APP_NAME=file\nAPP_MODE=dev\n")
    fs.write_file(&path[:pn], &data[:dn])
    var c config.Config
    match config.load(&path[:pn], &c) {
        Ok(k) => testing.eq_int(k, 2)
        Err(code) => testing.eq_int(code, 0)
    }
    var v [64]byte
    k := str.copy(&v, "environment")
    os.setenv("APP_NAME", &v[:k])
    n := c.env("APP_NAME", &v)
    testing.eq_str(&v[:n], "environment") // the environment wins
    n = c.env("APP_MODE", &v)
    testing.eq_str(&v[:n], "dev")
    fs.remove_file(&path[:pn])
    match config.load_str("/tmp/does_not_exist_mlc.env", &c) {
        Ok(_) => testing.fail("doesn't exist")
        Err(code) => testing.eq_int(code, fs.NOT_FOUND)
    }
}

fn test_parse_flag() {
    var b [8]byte
    f := false
    n := str.copy(&b, "ON")
    testing.check(config.parse_flag(&b[:n], &f) && f, "ON")
    n = str.copy(&b, "No")
    testing.check(config.parse_flag(&b[:n], &f) && !f, "No")
    n = str.copy(&b, "maybe")
    testing.check(!config.parse_flag(&b[:n], &f), "maybe")
}
