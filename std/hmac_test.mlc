import "std/encoding"
import "std/hmac"
import "std/str"
import "std/testing"

fn hex_of(mac &[]byte) [64]byte {
    var out [64]byte
    encoding.hex(&out, mac)
    return out
}

fn check(key &[]byte, data &[]byte, want string) {
    var mac [32]byte
    hmac.sha256(key, data, &mac)
    out := hex_of(&mac)
    testing.eq_str(&out, want)
}

// the RFC 4231 vectors (cases 1, 2, 3, 6 and 7)
fn test_rfc4231() {
    var key [131]byte
    var data [160]byte
    for i := 0; i < 20; i++ {
        key[i] = 0x0B
    }
    n := str.copy(&data, "Hi There")
    check(&key[:20], &data[:n], "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")

    k := str.copy(&key, "Jefe")
    n = str.copy(&data, "what do ya want for nothing?")
    check(&key[:k], &data[:n], "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")

    for i := 0; i < 20; i++ {
        key[i] = 0xAA
    }
    for i := 0; i < 50; i++ {
        data[i] = 0xDD
    }
    check(&key[:20], &data[:50], "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe")

    for i := 0; i < 131; i++ {
        key[i] = 0xAA // key longer than a block: its SHA-256 goes in
    }
    n = str.copy(&data, "Test Using Larger Than Block-Size Key - Hash Key First")
    check(&key, &data[:n], "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54")
}

// in pieces gives the same as all at once
fn test_streaming() {
    var key [4]byte
    k := str.copy(&key, "Jefe")
    var data [64]byte
    n := str.copy(&data, "what do ya want for nothing?")
    h := hmac.new(&key[:k])
    h.write(&data[:4])
    h.write(&data[4:10])
    h.write(&data[10:n])
    var mac [32]byte
    h.sum(&mac)
    out := hex_of(&mac)
    testing.eq_str(&out, "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
}

fn test_verify_and_equal() {
    var key [16]byte
    k := str.copy(&key, "secret")
    var body [32]byte
    n := str.copy(&body, "{\"event\":\"paid\"}")
    var mac [32]byte
    hmac.sha256(&key[:k], &body[:n], &mac)
    testing.check(hmac.verify(&key[:k], &body[:n], &mac), "right signature")
    mac[31] ^= 1
    testing.check(!hmac.verify(&key[:k], &body[:n], &mac), "one flipped bit")
    testing.check(!hmac.verify(&key[:k], &body[:n], &mac[:16]), "wrong size")
    testing.check(hmac.equal(&body[:0], &key[:0]), "empty ones are equal")
}

fn pbkdf2_hex(password string, salt string, iterations int, size int) [128]byte {
    var p [32]byte
    var s [32]byte
    pn := str.copy(&p, password)
    sn := str.copy(&s, salt)
    var key [64]byte
    hmac.pbkdf2(&p[:pn], &s[:sn], iterations, &key[:size])
    var out [128]byte
    encoding.hex(&out, &key[:size])
    return out
}

// the PBKDF2-HMAC-SHA256 vectors (RFC 7914 and the commonly used ones)
fn test_pbkdf2() {
    out := pbkdf2_hex("password", "salt", 1, 32)
    testing.eq_str(&out[:64], "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b")
    out = pbkdf2_hex("password", "salt", 2, 32)
    testing.eq_str(&out[:64], "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43")
    out = pbkdf2_hex("password", "salt", 4096, 32)
    testing.eq_str(&out[:64], "c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a")
    // more than one block (64 bytes), from RFC 7914
    out = pbkdf2_hex("passwd", "salt", 1, 64)
    testing.eq_str(&out, "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783")
}
