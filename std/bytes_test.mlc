import "std/bytes"
import "std/str"
import "std/testing"

fn test_push_and_grow() {
    b := bytes.new(0) // grows from zero
    b.push_str("total: ")
    b.push_int(-42)
    b.push_byte('!')
    testing.check(b.eq("total: -42!"), "assembled text")
    for i := 0; i < 1000; i++ {
        b.push_byte('x')
    }
    testing.eq_int(b.len, 1011)
    testing.check(len(b.data) >= 1011, "a capacidade cresceu")
    b.free()
}

fn test_push_bytes_truncate_clear() {
    b := bytes.new(4)
    var s [8]byte
    n := str.copy(&s, "abcdef")
    b.push_bytes(&s[:n])
    b.truncate(3)
    testing.eq_str(&b.data[:b.len], "abc")
    cap := len(b.data)
    b.clear()
    testing.eq_int(b.len, 0)
    testing.eq_int(len(b.data), cap)
    b.free()
}

fn test_format_into_buf() {
    b := bytes.new(2)
    b.push_str("x=")
    b.reserve(str.format_len("{:>5.1}", 3.14159))
    b.len += str.format(&b.data[b.len:], "{:>5.1}", 3.14159)
    testing.check(b.eq("x=  3.1"), "formatted into the Buf")
    b.free()
}

fn test_truncate_out_of_range() {
    testing.expect_panic()
    b := bytes.new(4)
    b.truncate(5)
    b.free()
}
