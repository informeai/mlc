// A queue with both ends fast: push and pop at the front and the back in O(1).
// Underneath it's a ring buffer, and the allocation is visible here as in
// vec: new allocates, the pushes call grow when room runs out, and grow doubles the
// capacity with realloc.
//
// The elements can be owners (T owned: ?*X or []X): push moves the value
// inside, pop returns ownership, and free frees each element (drop) and the queue.
//
//     q := deque.new[int](16)
//     q.push_back(1)              // queue: take from the front, put at the back
//     q.push_back(2)
//     x := q.pop_front()          // 1
//     q.free()
//
// To keep only the last N, take out the oldest before putting:
//
//     if hist.len() == N {
//         old := hist.pop_front()
//         drop(old)
//     }
//     hist.push_back(line)

// Deque is the double-ended queue, over a ring buffer.
pub struct Deque[T owned] {
    items []T // ring buffer: the elements go from head, count positions
    head int
    count int
}

extern fn fail(msg string)

// new allocates an empty queue with room for cap elements.
pub fn new[T owned](cap int) *Deque[T] {
    return alloc(Deque[T]{items: alloc([]T, cap), head: 0, count: 0})
}

// push_back puts x at the back (x is moved into the queue).
pub fn (q &Deque[T]) push_back(x T) {
    if q.count == len(q.items) {
        q.grow()
    }
    old := replace(&q.items[q.slot(q.count)], x)
    drop(old) // the position after the end was empty
    q.count++
}

// push_front puts x at the front.
pub fn (q &Deque[T]) push_front(x T) {
    if q.count == len(q.items) {
        q.grow()
    }
    q.head = (q.head - 1 + len(q.items)) % len(q.items)
    old := replace(&q.items[q.head], x)
    drop(old)
    q.count++
}

// pop_front takes out the first element and returns its ownership.
pub fn (q &Deque[T]) pop_front() T {
    if q.count == 0 {
        fail("deque.pop_front: fila vazia")
    }
    x := take(&q.items[q.head])
    q.head = (q.head + 1) % len(q.items)
    q.count--
    return x
}

// pop_back takes out the last element and returns its ownership.
pub fn (q &Deque[T]) pop_back() T {
    if q.count == 0 {
        fail("deque.pop_back: fila vazia")
    }
    q.count--
    return take(&q.items[q.slot(q.count)])
}

// front borrows the first element, without taking it out. While the borrow is
// used, the queue stays frozen.
pub fn (q &Deque[T]) front() &T {
    if q.count == 0 {
        fail("deque.front: fila vazia")
    }
    return &q.items[q.head]
}

// back borrows the last element.
pub fn (q &Deque[T]) back() &T {
    if q.count == 0 {
        fail("deque.back: fila vazia")
    }
    return &q.items[q.slot(q.count - 1)]
}

// at borrows element i (0 is the first).
pub fn (q &Deque[T]) at(i int) &T {
    if i < 0 || i >= q.count {
        fail("deque.at: índice fora da fila")
    }
    return &q.items[q.slot(i)]
}

// get returns a copy of element i (only for copyable T).
pub fn (q &Deque[T any]) get(i int) T {
    if i < 0 || i >= q.count {
        fail("deque.get: índice fora da fila")
    }
    return q.items[q.slot(i)]
}

// len returns how many elements there are in the queue.
pub fn (q &Deque[T]) len() int {
    return q.count
}

// cap returns how many elements fit before growing.
pub fn (q &Deque[T]) cap() int {
    return len(q.items)
}

// grow doubles the capacity (realloc). If the elements wrapped around the end
// of the buffer, the front part goes after the old end, by ownership.
pub fn (q &Deque[T]) grow() {
    c := len(q.items)
    q.items = realloc(q.items, c * 2 + 1)
    wrapped := q.head + q.count - c
    for i := 0; i < wrapped; i++ {
        x := take(&q.items[i])
        old := replace(&q.items[c + i], x)
        drop(old) // the new positions were empty
    }
}

// clear frees the elements (drop) and leaves the queue empty, with the same
// capacity.
pub fn (q &Deque[T]) clear() {
    for i := 0; i < q.count; i++ {
        x := take(&q.items[q.slot(i)])
        drop(x)
    }
    q.head = 0
    q.count = 0
}

// free frees each element (drop) and the queue.
pub fn (q *Deque[T]) free() {
    for x in drain(q.items) {
        drop(x)
    }
    free(q.items)
    free(q)
}

// slot is the position in the buffer of element i.
fn (q &Deque[T]) slot(i int) int {
    return (q.head + i) % len(q.items)
}
