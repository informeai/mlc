// UUIDs (RFC 9562): identificadores de 128 bits que não se repetem, sem
// precisar de um servidor central para distribuir números. O UUID é um
// valor de 16 bytes; o texto (36 caracteres) é escrito num buffer de quem
// chama. Os bits aleatórios vêm de rand.secure.
//
//     id := uuid.v7()               // ordenado pelo tempo: bom como chave de banco
//     var buf [36]byte
//     n := id.text(&buf)            // 0192a3c4-5d6e-7f80-9a1b-2c3d4e5f6a7b
//     var lido uuid.UUID
//     ok := uuid.parse(&buf[:n], &lido)
//
// v4 é inteiro aleatório. v7 começa com o horário em milissegundos, então
// UUIDs criados depois ficam depois na ordem: índices de banco crescem no
// fim, em vez de espalhados (o que deixa as inserções bem mais rápidas).
import "std/rand"
import "std/time"

// TEXT_LEN é o tamanho do texto de um UUID (8-4-4-4-12 dígitos hex).
pub const TEXT_LEN = 36

// UUID são os 16 bytes, na ordem do texto.
pub struct UUID {
    b [16]byte
}

// v4 cria um UUID aleatório (122 bits aleatórios).
pub fn v4() UUID {
    var u UUID
    rand.secure(&u.b)
    u.b[6] = (u.b[6] & 0x0F) | 0x40 // versão 4
    u.b[8] = (u.b[8] & 0x3F) | 0x80 // variante RFC
    return u
}

// v7 cria um UUID ordenado pelo tempo: os 48 bits de cima são os
// milissegundos desde 1970 (time.now_ms), e o resto é aleatório.
pub fn v7() UUID {
    return v7_at(time.now_ms())
}

// v7_at é v7 com o horário dado (em milissegundos desde 1970).
pub fn v7_at(ms int) UUID {
    var u UUID
    rand.secure(&u.b)
    for i := 0; i < 6; i++ {
        u.b[i] = byte((ms >> (8 * (5 - i))) & 0xFF)
    }
    u.b[6] = (u.b[6] & 0x0F) | 0x70 // versão 7
    u.b[8] = (u.b[8] & 0x3F) | 0x80 // variante RFC
    return u
}

// version devolve a versão do UUID (4 ou 7 para os criados aqui).
pub fn (u &UUID) version() int {
    return int(u.b[6] >> 4)
}

// ms devolve o horário de um UUID v7, em milissegundos desde 1970.
pub fn (u &UUID) ms() int {
    v := 0
    for i := 0; i < 6; i++ {
        v = (v << 8) | int(u.b[i])
    }
    return v
}

// text escreve o UUID em dst (TEXT_LEN bytes, hex minúsculo com hífens) e
// devolve quantos bytes escreveu.
pub fn (u &UUID) text(dst &[]byte) int {
    if len(dst) < TEXT_LEN {
        fail("uuid.text: o destino precisa de 36 bytes")
    }
    digits := "0123456789abcdef"
    k := 0
    for i := 0; i < 16; i++ {
        if i == 4 || i == 6 || i == 8 || i == 10 {
            dst[k] = '-'
            k++
        }
        dst[k] = digits[int(u.b[i] >> 4)]
        dst[k + 1] = digits[int(u.b[i] & 0x0F)]
        k += 2
    }
    return k
}

// parse lê um UUID no formato de text (hex maiúsculo ou minúsculo). Devolve
// false se o texto não for um UUID.
pub fn parse(s &[]byte, out &UUID) bool {
    if len(s) != TEXT_LEN {
        return false
    }
    k := 0
    for i := 0; i < 16; i++ {
        if i == 4 || i == 6 || i == 8 || i == 10 {
            if s[k] != '-' {
                return false
            }
            k++
        }
        hi := hex_digit(s[k])
        lo := hex_digit(s[k + 1])
        if hi < 0 || lo < 0 {
            return false
        }
        out.b[i] = byte(hi * 16 + lo)
        k += 2
    }
    return true
}

fn hex_digit(c byte) int {
    if c >= '0' && c <= '9' {
        return int(c - '0')
    }
    if c >= 'a' && c <= 'f' {
        return int(c - 'a') + 10
    }
    if c >= 'A' && c <= 'F' {
        return int(c - 'A') + 10
    }
    return -1
}

// equal diz se dois UUIDs são o mesmo.
pub fn (u &UUID) equal(o &UUID) bool {
    for i := 0; i < 16; i++ {
        if u.b[i] != o.b[i] {
            return false
        }
    }
    return true
}

extern fn fail(msg string)
