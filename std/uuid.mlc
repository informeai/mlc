// UUIDs (RFC 9562): 128-bit identifiers that don't repeat, without
// needing a central server to hand out numbers. A UUID is a
// 16-byte value; the text (36 characters) is written into a buffer of the
// caller's. The random bits come from rand.secure.
//
//     id := uuid.v7()               // ordered by time: good as a database key
//     var buf [36]byte
//     n := id.text(&buf)            // 0192a3c4-5d6e-7f80-9a1b-2c3d4e5f6a7b
//     var read uuid.UUID
//     ok := uuid.parse(&buf[:n], &read)
//
// v4 is fully random. v7 starts with the time in milliseconds, so
// UUIDs created later sort later: database indexes grow at the
// end, instead of scattered (which makes inserts much faster).
import "std/rand"
import "std/time"

// TEXT_LEN is the length of a UUID's text (8-4-4-4-12 hex digits).
pub const TEXT_LEN = 36

// UUID is the 16 bytes, in the text's order.
pub struct UUID {
    b [16]byte
}

// v4 creates a random UUID (122 random bits).
pub fn v4() UUID {
    var u UUID
    rand.secure(&u.b)
    u.b[6] = (u.b[6] & 0x0F) | 0x40 // version 4
    u.b[8] = (u.b[8] & 0x3F) | 0x80 // RFC variant
    return u
}

// v7 creates a time-ordered UUID: the top 48 bits are the
// milliseconds since 1970 (time.now_ms), and the rest is random.
pub fn v7() UUID {
    return v7_at(time.now_ms())
}

// v7_at is v7 with the given time (in milliseconds since 1970).
pub fn v7_at(ms int) UUID {
    var u UUID
    rand.secure(&u.b)
    for i := 0; i < 6; i++ {
        u.b[i] = byte((ms >> (8 * (5 - i))) & 0xFF)
    }
    u.b[6] = (u.b[6] & 0x0F) | 0x70 // version 7
    u.b[8] = (u.b[8] & 0x3F) | 0x80 // RFC variant
    return u
}

// version returns the UUID's version (4 or 7 for the ones created here).
pub fn (u &UUID) version() int {
    return int(u.b[6] >> 4)
}

// ms returns the time of a v7 UUID, in milliseconds since 1970.
pub fn (u &UUID) ms() int {
    v := 0
    for i := 0; i < 6; i++ {
        v = (v << 8) | int(u.b[i])
    }
    return v
}

// text writes the UUID into dst (TEXT_LEN bytes, lowercase hex with hyphens) and
// returns how many bytes it wrote.
pub fn (u &UUID) text(dst &[]byte) int {
    if len(dst) < TEXT_LEN {
        fail("uuid.text: the destination needs 36 bytes")
    }
    digits := "0123456789abcdef"
    k := 0
    for i := 0; i < 16; i++ {
        if i == 4 || i == 6 || i == 8 || i == 10 {
            dst[k] = '-'
            k++
        }
        dst[k] = digits[int(u.b[i] >> 4)]
        dst[k + 1] = digits[int(u.b[i] & 0x0F)]
        k += 2
    }
    return k
}

// parse reads a UUID in text's format (upper- or lowercase hex). Returns
// false if the text isn't a UUID.
pub fn parse(s &[]byte, out &UUID) bool {
    if len(s) != TEXT_LEN {
        return false
    }
    k := 0
    for i := 0; i < 16; i++ {
        if i == 4 || i == 6 || i == 8 || i == 10 {
            if s[k] != '-' {
                return false
            }
            k++
        }
        hi := hex_digit(s[k])
        lo := hex_digit(s[k + 1])
        if hi < 0 || lo < 0 {
            return false
        }
        out.b[i] = byte(hi * 16 + lo)
        k += 2
    }
    return true
}

fn hex_digit(c byte) int {
    if c >= '0' && c <= '9' {
        return int(c - '0')
    }
    if c >= 'a' && c <= 'f' {
        return int(c - 'a') + 10
    }
    if c >= 'A' && c <= 'F' {
        return int(c - 'A') + 10
    }
    return -1
}

// equal says whether two UUIDs are the same.
pub fn (u &UUID) equal(o &UUID) bool {
    for i := 0; i < 16; i++ {
        if u.b[i] != o.b[i] {
            return false
        }
    }
    return true
}

extern fn fail(msg string)
