// Fixed-capacity channels, to pass values from one thread to another
// by ownership.
//
//     rx := chan.new[[]byte](16)    // allocates the channel (16 slots)
//     tx := rx.sender()             // an end that sends, tied to the channel
//     t := thread.spawn(produce, tx, thread.STACK_64KB)
//     for {
//         match rx.recv() {
//             Got(msg) => {
//                 io.write_line(&msg)
//                 free(msg)         // the message now belongs to this side
//             }
//             Closed => break       // every Sender closed
//         }
//     }
//     rx.close()
//     thread.join(t)
//
// chan.new and the methods below are built into the compiler; the channel lives in
// the runtime. Each end is an owner: it needs a close(), and the checker requires
// it. The channel is freed on the last close (with drop on whatever was left in it).
//
// chan.new[T](cap) *Receiver[T]  allocates the channel with cap slots (cap >= 1)
//
// Receiver[T]:
//   recv() Recv[T]       waits for a value: Got(v), with ownership of v, or
//                        Closed, when every Sender closed and the channel
//                        is empty
//   sender() *Sender[T]  creates an end that sends
//   clone() *Receiver[T] another end that receives (several consumers)
//   close()
//
// Sender[T]:
//   send(v T) bool       moves v into the channel; waits if it's full.
//                        With no Receiver open, frees v (drop) and
//                        returns false
//   clone() *Sender[T]   another end that sends (several producers)
//   close()
//
// There's no unbounded channel: growing on its own would be hidden allocation.

// Recv is the result of recv.
pub enum Recv[T owned] {
    Got(value T)
    Closed
}
