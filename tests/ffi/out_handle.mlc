// Out parameters (&?*X): the C function writes a handle into the variable.
// Linked with tests/ffi/counter.c by TestFFIOutHandle.
import "std/io"

link "counter"

extern "C" type Counter

extern "C" fn counter_open(start int32, out &?*Counter) int32
extern "C" fn counter_pair(a &?*Counter, b &?*Counter) int32
extern "C" fn counter_next(c &Counter) int32
extern "C" fn counter_close(c *Counter)
extern "C" fn counter_live() int32

// parameters C accepts as NULL
extern "C" fn counter_peek(c &Counter, out ?&int32) int32
extern "C" fn counter_sum(data ?&[]int, n int) int
extern "C" fn counter_maybe_open(start int32, out ?&?*Counter) int32

struct Conn {
    c ?*Counter
    uses int
}

fn main() {
    var c ?*Counter = nil
    rc := counter_open(5, &c)
    if c != nil {
        io.print("open:", rc, counter_next(&c), counter_next(&c), counter_live())
        counter_close(c)
    }

    // after it's closed, the same variable receives another handle
    rc = counter_open(-1, &c)
    io.print("failed:", rc, c == nil)
    if c != nil {
        counter_close(c)
    }

    var a ?*Counter = nil
    var b ?*Counter = nil
    counter_pair(&a, &b)
    if a != nil {
        io.print("a:", counter_next(&a))
        counter_close(a)
    }
    if b != nil {
        io.print("b:", counter_next(&b))
        counter_close(b)
    }

    // in a field
    conn := alloc(Conn{c: nil, uses: 0})
    counter_open(100, &conn.c)
    if conn.c != nil {
        conn.uses++
        io.print("field:", counter_next(&conn.c), conn.uses)
        counter_close(conn.c)
    }
    free(conn)

    for i := 0; i < 3; i++ {
        var h ?*Counter = nil
        counter_open(int32(i), &h)
        if h != nil {
            counter_close(h)
        }
    }
    // ?&T: nil becomes NULL; a borrow, the usual pointer
    var p ?*Counter = nil
    counter_open(42, &p)
    if p != nil {
        var v int32 = 0
        io.print("peek with nil:", counter_peek(&p, nil), "peek with &v:", counter_peek(&p, &v), v)
        counter_close(p)
    }
    nums := alloc([]int, 4)
    for i := 0; i < len(nums); i++ {
        nums[i] = i + 1
    }
    io.print("sum:", counter_sum(&nums, len(nums)), counter_sum(&nums[2:], 2), counter_sum(nil, 0))
    free(nums)
    io.print("without a destination:", counter_maybe_open(1, nil))
    var q ?*Counter = nil
    counter_maybe_open(7, &q) // ?&?*X: the optional handle must be closed like any other
    if q != nil {
        io.print("opened through the optional pointer:", counter_next(&q))
        counter_close(q)
    }

    io.print("open at the end:", counter_live())
}
