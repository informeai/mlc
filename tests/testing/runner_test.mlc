// Exercises mlc test: each test here has a known result, checked
// by TestTestRunner (internal/driver/driver_test.go).
import "std/io"
import "std/str"
import "std/testing"

fn test_passes() {
    testing.eq_int(1 + 1, 2)
    testing.eq_bool(true, true)
    testing.check(true, "never shows up")
}

fn test_fails() {
    io.print("the test's output")
    b := alloc([]byte, 8)
    n := str.copy(&b, "hi\n")
    testing.eq_str(&b[:n], "hello")
    testing.eq_int(3, 4) // failures don't interrupt the test
    testing.eq_uint(255, 256)
    testing.eq_float(0.1 + 0.2, 0.3)
    testing.near(0.1 + 0.2, 0.3, 1e-9)
    testing.fail("explicit")
    free(b)
}

fn test_panics() {
    b := alloc([]byte, 2)
    i := 5
    b[i] = 1
    free(b)
}

fn test_expected_panic() {
    testing.expect_panic()
    b := alloc([]byte, 2)
    i := 5
    b[i] = 1
    free(b)
}

fn test_missing_panic() {
    testing.expect_panic()
}

fn test_fails_then_panics() {
    testing.expect_panic()
    testing.eq_int(1, 2)
    b := alloc([]byte, 2)
    i := 5
    b[i] = 1
    free(b)
}

fn bench_sum(b &testing.B) {
    total := 0
    for i := 0; i < b.n; i++ {
        total += i
    }
    testing.check(total >= 0, "never fails")
}

fn bench_panics(b &testing.B) {
    v := alloc([]int, 1)
    i := b.n + 5
    v[i] = 1
    free(v)
}
