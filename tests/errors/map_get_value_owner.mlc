// error: map.Map[int, []byte].get_or requires V any ([]byte is an owner, and the method copies): use the methods that move ownership, like take or put
import "std/map"

fn main() {
    m := map.new[int, []byte](4)
    k := 1
    d := alloc([]byte, 0)
    v := m.get_or(&k, d)
    free(v)
    m.free()
}
