// error: ?*FILE doesn't satisfy owned, required by T in vec.new (a C handle needs the C function that closes it, and drop doesn't know which one)
import "std/vec"

extern "C" type FILE

extern "C" fn fopen(trail string, mode string) ?*FILE
extern "C" fn fclose(f *FILE) int32

fn main() {
    v := vec.new[?*FILE](1)
    v.free()
}
