// erro: vazamento: h.b ainda é dona da memória (linha 18) (em algum caminho)
// Cobertura do verificador (fase 5): regra de posse que nenhum teste disparava.
struct Box {
    v int
}

struct Holder {
    b ?*Box
}

fn flip() bool {
    return true
}

fn main() {
    h := alloc(Holder{})
    if flip() {
        h.b = alloc(Box{v: 1})
    }
    h.b = alloc(Box{v: 2})
    free(h.b)
    free(h)
}
