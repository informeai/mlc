// error: leak: m may hold a handle, and f would write another over it; close the old one first
extern "C" type Msg
extern "C" fn f(p ?&int, s ?&[]int, m ?&?*Msg) int32
extern "C" fn done(m *Msg)

fn main() {
    var m ?*Msg = nil
    f(nil, nil, &m)
    f(nil, nil, &m)
    if m != nil {
        done(m)
    }
}
