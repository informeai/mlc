// error: v is borrowed by a (line 12) until line 16: use a, or finish using a first
import "std/io"
import "std/vec"

struct P {
    x int
}

fn main() {
    v := vec.new[P](1)
    v.push(P{x: 1})
    a := v.at(0)
    for i := 0; i < 3; i++ {
        io.print(a.x)
        v.push(P{x: i})
    }
    v.free()
}
