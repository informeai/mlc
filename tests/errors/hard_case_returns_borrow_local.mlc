// error: ref returns &Box without taking any borrow: the result would point to something that stops existing
// Hard case (phase 5 of the verification plan): returning a borrow of a local variable.
struct Box {
    v int
}

struct Pair {
    a ?*Box
    b ?*Box
}

enum Opt {
    Nothing
    Has(b ?*Box)
}

extern "C" fn rand() int32

fn flip() bool {
    return rand() % 2 == 0
}

fn consume(b *Box) int {
    n := b.v
    free(b)
    return n
}

fn sink(n int) {
}

fn ref() &Box {
    x := alloc(Box{v: 1})
    return &x
}

fn main() {
}