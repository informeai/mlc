// error: x is borrowed by r (line 34) until line 40: use r, or finish using r first
// Hard case (phase 5 of the verification plan): a borrow made before the loop, the source freed and rebuilt in one iteration and the borrow used in the next.
struct Box {
    v int
}

struct Pair {
    a ?*Box
    b ?*Box
}

enum Opt {
    Nothing
    Has(b ?*Box)
}

extern "C" fn rand() int32

fn flip() bool {
    return rand() % 2 == 0
}

fn consume(b *Box) int {
    n := b.v
    free(b)
    return n
}

fn sink(n int) {
}

fn main() {
    x := alloc(Box{v: 1})
    r := &x
    acc := 0
    for i := 0; i < 3; i++ {
        acc += r.v
        free(x)
        x = alloc(Box{v: i})
    }
    free(x)
    sink(acc)
}