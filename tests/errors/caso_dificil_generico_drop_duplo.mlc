// Caso difícil (fase 5 do plano de verificação): código genérico que libera duas vezes (conferido com T dono, mesmo instanciado com int).
struct Box {
    v int
}

struct Par {
    a ?*Box
    b ?*Box
}

enum Opt {
    Nada
    Tem(b ?*Box)
}

extern "C" fn rand() int32

fn flip() bool {
    return rand() % 2 == 0
}

fn consume(b *Box) int {
    n := b.v
    free(b)
    return n
}

fn sink(n int) {
}

fn twice[T owned](x T) {
    drop(x)
    drop(x)
}

fn main() {
    twice(1)
}