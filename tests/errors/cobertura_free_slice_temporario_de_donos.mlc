// error: free of a temporary slice whose elements may be owners: store it in a variable and empty it with for x in drain(s)
// Cobertura do verificador (fase 5): regra de posse que nenhum teste disparava.
struct Box {
    v int
}

fn lista() []?*Box {
    return alloc([]?*Box, 2)
}

fn main() {
    free(lista())
}
