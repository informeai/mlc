    a ?*Box
    b ?*Box
}

enum Opt {
    Nada
    Tem(b ?*Box)
}

extern "C" fn rand() int32

fn flip() bool {
    return rand() % 2 == 0
}

fn consume(b *Box) int {
    n := b.v
    free(b)
    return n
}

fn sink(n int) {
}

fn main() {
