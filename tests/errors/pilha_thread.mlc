// error: the thread of work needs about 489 KB of stack, and thread.spawn asks for 64 KB (the heaviest is the variable body [500000]byte (489 KB) in fill): put the buffer on the heap with alloc([]byte, 500000), or ask for a larger stack (thread.STACK_1MB)
import "std/thread"

fn fill(n int) int {
    var body [500000]byte
    for i := 0; i < len(body); i++ {
        body[i] = byte(i % 7)
    }
    return int(body[n])
}

fn work(n int) int {
    return fill(n)
}

fn main() {
    t := thread.spawn(work, 3, thread.STACK_64KB)
    thread.join(t)
}
