// error: e was already freed or moved (line 19)
// Achado pela mutação (make mutate): &e de um enum com donos não conferia
// se e já tinha sido liberado.
enum E {
    Vazio
    Nome(b []byte)
}

fn qual(e &E) int {
    match *e {
        Vazio => return 0
        Nome(b) => return len(b)
    }
}

fn main() {
    e := E.Nome(alloc([]byte, 3))
    qual(&e)
    free(e)
    qual(&e)
}
