// erro: vazamento: h pode ter um handle, e h_open escreveria outro por cima
extern "C" type H
extern "C" type G
extern "C" fn h_open(n int32, out &?*H) int32
extern "C" fn h_pair(a &?*H, b &?*H) int32
extern "C" fn h_close(h *H) int32

fn main() {
    var h ?*H = nil
    h_open(1, &h)
    h_open(2, &h)
    if h != nil {
        h_close(h)
    }
}
