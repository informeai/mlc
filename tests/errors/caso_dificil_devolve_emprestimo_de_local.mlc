// error: ref returns &Box without taking any borrow: the result would point to something that stops existing
// Caso difícil (fase 5 do plano de verificação): devolver empréstimo de uma variável local.
struct Box {
    v int
}

struct Par {
    a ?*Box
    b ?*Box
}

enum Opt {
    Nada
    Tem(b ?*Box)
}

extern "C" fn rand() int32

fn flip() bool {
    return rand() % 2 == 0
}

fn consume(b *Box) int {
    n := b.v
    free(b)
    return n
}

fn sink(n int) {
}

fn ref() &Box {
    x := alloc(Box{v: 1})
    return &x
}

fn main() {
}