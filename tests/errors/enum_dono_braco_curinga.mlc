// error: the _ arm would take out the variant Msg, which holds owners, without freeing them: handle Msg in its own arm
enum E {
    Msg(m []byte)
    Nada
}

fn texto() []byte {
    return alloc([]byte, 2)
}

fn main() {
    e := E.Msg(texto())
    match e {
        Nada => {}
        _ => {}
    }
}
