// error: free of a temporary object with owning fields: store it in a variable and free the fields first
// Cobertura do verificador (fase 5): regra de posse que nenhum teste disparava.
struct Box {
    v int
}

struct Par {
    a ?*Box
}

fn par() *Par {
    return alloc(Par{a: alloc(Box{v: 1})})
}

fn main() {
    free(par())
}
