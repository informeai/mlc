// erro: o empréstimo devolvido vem de um valor temporário
// Cobertura do verificador (fase 5): regra de posse que nenhum teste disparava.
struct Box {
    v int
}

fn first(a &Box, b &Box) &Box {
    return a
}

fn make() *Box {
    return alloc(Box{v: 1})
}

fn pick(a &Box) &Box {
    return first(a, &*make())
}

fn main() {
}
