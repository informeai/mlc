// error: return: expected []byte, found &[]byte
enum E {
    Msg(m []byte)
    Nada
}

fn texto() []byte {
    return alloc([]byte, 2)
}

fn tira(e &E) []byte {
    match *e {
        Msg(m) => return m
        Nada => return texto()
    }
}

fn main() {
    e := E.Nada
    b := tira(&e)
    free(b)
    free(e)
}
