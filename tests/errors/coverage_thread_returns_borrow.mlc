// error: the thread's function can't return a borrow (&Box)
// Checker coverage (phase 5): an ownership rule no test triggered.
import "std/thread"

struct Box {
    v int
}

fn work(b *Box) &Box {
    return b
}

fn main() {
    t := thread.spawn(work, alloc(Box{v: 1}), thread.STACK_64KB)
    thread.join(t)
}
