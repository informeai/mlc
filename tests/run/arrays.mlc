import "std/io"
import "std/str"

const N = 4

struct Game {
    name_ [8]byte
    points [3]int
}

fn sum_(s &[]int) int {
    total := 0
    for v in s {
        total += v
    }
    return total
}

fn double_it(a &[N]int) {
    for i := 0; i < len(a); i++ {
        a[i] *= 2
    }
}

// array by value: the function receives a copy
fn reset_it(a [N]int) [N]int {
    a[0] = 0
    return a
}

fn main() {
    a := [N]int{1, 2, 3, 4}
    io.print(a, len(a), sum_(&a), sum_(&a[1:3]))
    double_it(&a)
    io.print(a)
    b := reset_it(a)
    io.print(a, b, a == b, a == [N]int{2, 4, 6, 8})

    var empty_ [3]bool
    io.print(empty_)

    m := [2][3]int{[3]int{1, 2, 3}, [3]int{4, 5, 6}}
    m[1][2] = 60
    total := 0
    for line_ in m {
        for x in line_ {
            total += x
        }
    }
    io.print(m, total)

    // a text buffer on the stack: without alloc or free
    var buf [32]byte
    k := str.copy(&buf, "hello, ")
    k += str.put_int(&buf[k:], 42)
    io.write_line(&buf[:k])

    p := Game{name_: [8]byte{}, points: [3]int{10, 20, 30}}
    n := str.copy(&p.name_, "ana")
    p.points[1] += 5
    io.write(&p.name_[:n])
    io.print("", sum_(&p.points))

    // an array inside an object on the heap
    q := alloc(Game)
    q.points[2] = 7
    io.print(q.points)
    free(q)

    slices_ := alloc([][2]float64, 2)
    slices_[1] = [2]float64{1.5, 2.5}
    io.print(slices_)
    free(slices_)
}
