import "std/io"

struct Ponto {
    x int
    y int
}

fn novo(x int, y int) *Ponto {
    p := alloc(Ponto)
    p.x = x
    p.y = y
    return p
}

fn soma(p &Ponto) int {
    return p.x + p.y
}

fn dobra(p &Ponto) {
    p.x *= 2
    p.y *= 2
}

// repassa um empréstimo recebido, sem &
fn soma_dobrada(p &Ponto) int {
    dobra(p)
    return soma(p)
}

fn destroi(p *Ponto) {
    io.print("destruindo", p.x, p.y)
    free(p)
}

fn talvez(n int) ?*Ponto {
    if n > 0 {
        return novo(n, n)
    }
    return nil
}

fn main() {
    p := novo(1, 2)
    dobra(&p)
    io.print(soma(&p), *p)
    destroi(p)

    n := alloc(41)
    *n += 1
    io.print(*n)
    free(n)

    v := alloc(Ponto{x: 3, y: 4})
    copia := *v
    v.x = 100
    io.print(copia, *v)
    free(v)

    local := Ponto{x: 5, y: 6}
    dobra(&local)
    io.print(local, soma(&local), soma_dobrada(&local))

    for i := 0; i < 3; i++ {
        q := talvez(i)
        if q != nil {
            io.print("tem", q.x)
            free(q)
        } else {
            io.print("nil")
        }
    }

    var r ?*Ponto = nil
    r = novo(7, 8)
    if r == nil {
        io.print("não deveria")
    } else {
        destroi(r)
    }

    a := novo(1, 1)
    for j := 0; j < 3; j++ {
        free(a)
        a = novo(j, j)
    }
    io.print(a.x)
    b := a
    free(b)

    s := alloc("texto")
    io.print(*s)
    free(s)

    // free de um ?*T nil não faz nada
    var vazio ?*Ponto
    free(vazio)

    c := novo(9, 9)
    for {
        if c.x > 0 {
            break
        }
    }
    destroi(c)
}
