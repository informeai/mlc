import "io"

fn primo(n int) bool {
    if n < 2 {
        return false
    }
    for d := 2; d * d <= n; d++ {
        if n % d == 0 {
            return false
        }
    }
    return true
}

fn main() {
    var contagem int
    n := 0
    for {
        n++
        if n > 50 {
            break
        }
        if !primo(n) {
            continue
        }
        contagem += 1
        io.print(n)
    }
    io.print("total:", contagem)
}
