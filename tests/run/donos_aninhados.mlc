// Donos aninhados: vetor de vetores, mapa de listas, slice de slices e uma
// árvore (como JSON) cujos nós sabem se liberar com fn (v *Valor) free().
import "std/io"
import "std/str"
import "std/vec"
import "std/map"

// árvore de JSON: cada valor guarda os filhos num vetor de ?*Valor
struct Valor {
    tipo int // 0 número, 1 texto, 2 lista
    num int
    texto []byte
    itens ?*vec.Vec[?*Valor]
}

fn (v *Valor) free() {
    free(v.texto)
    if v.itens != nil {
        v.itens.free()
    }
    v.itens = nil
    free(v)
}

fn numero(n int) ?*Valor {
    return alloc(Valor{tipo: 0, num: n, texto: alloc([]byte, 0), itens: nil})
}

fn texto(s string) ?*Valor {
    t := alloc([]byte, len(s))
    str.copy(&t, s)
    return alloc(Valor{tipo: 1, num: 0, texto: t, itens: nil})
}

fn soma(v &Valor) int {
    match v.tipo {
        0 => return v.num
        1 => return len(v.texto)
        _ => {
            total := 0
            if v.itens != nil {
                for i := 0; i < v.itens.len(); i++ {
                    total += soma(v.itens.at(i))
                }
            }
            return total
        }
    }
}

fn main() {
    // vetor de vetores
    grade := vec.new[?*vec.Vec[int]](2)
    for l := 0; l < 3; l++ {
        linha := vec.new[int](2)
        for c := 0; c < 4; c++ {
            linha.push(l * 10 + c)
        }
        grade.push(linha)
    }
    meio := grade.at(1)
    io.print("grade[1][2] =", meio.get(2))
    grade.free() // libera cada linha (free do Vec) e a grade

    // mapa de texto para lista de textos
    grupos := map.new[[]byte, ?*vec.Vec[[]byte]](4)
    k := alloc([]byte, 6)
    str.copy(&k, "frutas")
    lista := vec.new[[]byte](2)
    m := alloc([]byte, 4)
    str.copy(&m, "maca")
    lista.push(m)
    grupos.put(k, lista)
    io.print("grupos:", grupos.len())
    grupos.free()

    // slice de slices
    tabela := vec.new[[][]byte](1)
    linhas := alloc([][]byte, 2)
    a := alloc([]byte, 1)
    old := replace(&linhas[0], a)
    free(old)
    tabela.push(linhas)
    tabela.free()

    // árvore
    raiz := alloc(Valor{tipo: 2, num: 0, texto: alloc([]byte, 0), itens: vec.new[?*Valor](2)})
    if raiz.itens != nil {
        raiz.itens.push(numero(40))
        raiz.itens.push(texto("oi"))
        sub := alloc(Valor{tipo: 2, num: 0, texto: alloc([]byte, 0), itens: vec.new[?*Valor](1)})
        if sub.itens != nil {
            sub.itens.push(numero(100))
        }
        raiz.itens.push(sub)
    }
    io.print("soma da árvore:", soma(&raiz))
    raiz.free()
}
