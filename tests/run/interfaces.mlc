import "std/io"

// Static interfaces: a generic constraint, without a method table.
interface Measure {
    fn size_(self &Self) int
    fn scale(self &Self, k int) int
}

struct Square {
    side int
}

fn (q &Square) size_() int {
    return q.side * q.side
}

fn (q &Square) scale(k int) int {
    return q.size_() * k
}

// one-line form: the struct's methods satisfy the interface
impl Measure for Square

impl auto io.Display for Square

// form with a block: built-in types don't have methods of their own
impl Measure for int {
    fn (x &int) size_() int {
        return *x
    }
    fn (x &int) scale(k int) int {
        return *x * k
    }
}

// generic impl: a slice measures the sum of its elements
impl[T Measure] Measure for []T {
    fn (s &[]T) size_() int {
        total := 0
        for i := 0; i < len(s); i++ {
            total += s[i].size_()
        }
        return total
    }
    fn (s &[]T) scale(k int) int {
        return len(s) * k
    }
}

fn larger[T Measure](a &T, b &T) int {
    if a.size_() > b.size_() {
        return a.size_()
    }
    return b.size_()
}

fn scaled_sum[T Measure](items_ &[]T, k int) int {
    total := 0
    for i := 0; i < len(items_); i++ {
        total += items_[i].scale(k)
    }
    return total
}

// Display written by hand
struct Fraction {
    num int
    den int
}

fn (f &Fraction) write(w &io.Writer) {
    w.put_int(f.num)
    w.put_byte('/')
    w.put_int(f.den)
}

impl io.Display for Fraction

// generated Display
struct Point {
    x int
    y int
}

impl auto io.Display for Point

enum Shape {
    Circle(radius float64)
    Rectangle(l float64, a float64)
    Empty
}

impl auto io.Display for Shape

struct Pair[A any, B any] {
    a A
    b B
}

impl auto io.Display for Pair

fn show_it[T io.Display](x &T) {
    io.printf("<{}>\n", x)
}

fn main() {
    q := Square{side: 3}
    r := Square{side: 4}
    n := 7
    io.print(larger(&q, &r), larger(&n, &n), q.scale(2), n.scale(3))
    s := alloc([]Square, 2)
    s[0] = q
    s[1] = r
    io.print(s.size_(), scaled_sum(&s, 10))
    var a [3]int = [3]int{1, 2, 3}
    io.print(a.size_(), scaled_sum(&a, 2))

    f := Fraction{num: 1, den: 3}
    p := Point{x: 1, y: -2}
    io.print(f, p, Shape.Circle(1.5), Shape.Rectangle(2.0, 3.0), Shape.Empty)
    io.print(Pair[int, string]{a: 1, b: "one"}, Pair[Point, bool]{a: p, b: true})
    show_it(&f)
    show_it(&p)
    io.printf("{} + {} = {}; braces: {{ and }}\n", 1, 2, 1 + 2)
    io.printf("no values\n")
    io.print(s, a, "text", 'b', int8(-8), uint64(18446744073709551615), float32(0.25), 1e21)
    var m [2][2]int = [2][2]int{[2]int{1, 2}, [2]int{3, 4}}
    io.print(m)
    io.print()
    io.eprint("this goes to standard error")
    free(s)
}
