// Hard case (phase 5 of the verification plan): moving a field out and using another field of the same object.
struct Box {
    v int
}

struct Pair {
    a ?*Box
    b ?*Box
}

enum Opt {
    Nothing
    Has(b ?*Box)
}

extern "C" fn rand() int32

fn flip() bool {
    return rand() % 2 == 0
}

fn consume(b *Box) int {
    n := b.v
    free(b)
    return n
}

fn sink(n int) {
}

fn main() {
    p := alloc(Pair{a: alloc(Box{v: 1}), b: alloc(Box{v: 2})})
    a := p.a
    acc := 0
    if p.b != nil {
        acc += p.b.v
    }
    free(a)
    free(p.b)
    free(p)
    sink(acc)
}
