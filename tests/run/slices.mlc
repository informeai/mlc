import "std/io"

struct Point {
    x int
    y int
}

struct Stack {
    items_ []int
    top int
}

fn sum_(s &[]int) int {
    total := 0
    for v in s {
        total += v
    }
    return total
}

fn double_it(s &[]int) {
    for i := 0; i < len(s); i++ {
        s[i] *= 2
    }
}

fn squares(n int) []int {
    s := alloc([]int, n)
    for i := 0; i < n; i++ {
        s[i] = i * i
    }
    return s
}

fn push_item(p &Stack, v int) {
    p.items_[p.top] = v
    p.top++
}

fn pop_item(p &Stack) int {
    p.top--
    return p.items_[p.top]
}

fn first_even(s &[]int) int {
    for v in s {
        match v % 2 {
            0 => return v
            _ => continue
        }
    }
    return -1
}

fn count_all(text_ string, c byte) int {
    n := 0
    for i := 0; i < len(text_); i++ {
        if text_[i] == c {
            n++
        }
    }
    return n
}

fn main() {
    s := squares(5)
    io.print(s, len(s), sum_(&s))
    double_it(&s)
    io.print(s)
    io.print("first even:", first_even(&s))
    free(s)

    points := alloc([]Point, 3)
    for i := 0; i < len(points); i++ {
        points[i] = Point{x: i, y: i * 10}
    }
    points[1].y += 5
    io.print(points)
    total := 0
    for p in points {
        total += p.x + p.y
    }
    io.print("total:", total)
    free(points)

    p := alloc(Stack)
    p.items_ = alloc([]int, 4)
    push_item(&p, 7)
    push_item(&p, 8)
    push_item(&p, 9)
    io.print("stack:", pop_item(&p), pop_item(&p), p.top)
    free(p.items_)
    free(p)

    var empty_ []int
    io.print(empty_, len(empty_), sum_(&empty_))
    for v in empty_ {
        io.print("never", v)
    }
    zero := alloc([]bool, 0)
    io.print(zero)
    free(zero)

    names := alloc([]string, 3)
    names[0] = "ann"
    names[1] = "bea"
    names[2] = "cris"
    n := 0
    for _ in names {
        n++
    }
    io.print(names, n, names[2][0])
    free(names)

    io.print(len("née"), count_all("banana", 'a'))

    // the index with an effect is computed only once
    c := alloc([]int, 3)
    pos := 0
    c[next_one(&pos)] += 10
    c[next_one(&pos)] += 20
    io.print(c, pos)
    free(c)
}

fn next_one(p &int) int {
    v := *p
    *p += 1
    return v
}

impl auto io.Display for Point
