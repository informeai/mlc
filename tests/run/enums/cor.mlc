import "std/io"
pub enum Cor {
    Vermelho
    Verde
    Azul
    Rgb(r byte, g byte, b byte)
}

pub fn nome(c Cor) string {
    match c {
        Vermelho => return "vermelho"
        Verde => return "verde"
        Azul => return "azul"
        Rgb(_, _, _) => return "personalizada"
    }
}

impl auto io.Display for Cor
