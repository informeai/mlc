import "std/io"
import "cor"

enum Forma {
    Circulo(raio float64)
    Retangulo(largura float64, altura float64)
    Vazio
}

enum Resultado[T any] {
    Ok(valor T)
    Erro(codigo int)
}

struct Figura {
    nome string
    forma Forma
}

fn area(f Forma) float64 {
    match f {
        Circulo(r) => return 3.0 * r * r
        Retangulo(l, a) => return l * a
        Vazio => return 0.0
    }
}

fn divide(a int, b int) Resultado[int] {
    if b == 0 {
        return Resultado.Erro(1) // T deduzido do tipo de retorno
    }
    return Resultado.Ok(a / b) // T deduzido do valor
}

fn raiz_inteira(n int) Resultado[int] {
    if n < 0 {
        return Resultado[int].Erro(2) // tipo explícito
    }
    r := 0
    for (r + 1) * (r + 1) <= n {
        r++
    }
    return Resultado.Ok(r)
}

fn mostra(r Resultado[int]) {
    match r {
        Ok(v) => io.print("ok:", v)
        Erro(c) => io.print("erro:", c)
    }
}

fn main() {
    formas := alloc([]Forma, 3)
    formas[0] = Forma.Circulo(2.0)
    formas[1] = Forma.Retangulo(3.0, 4.0)
    formas[2] = Forma.Vazio
    total := 0.0
    for f in formas {
        total += area(f)
    }
    io.print("área total:", total)
    io.print(formas)
    free(formas)

    mostra(divide(10, 3))
    mostra(divide(1, 0))
    mostra(raiz_inteira(50))
    mostra(raiz_inteira(-4))

    fig := Figura{nome: "placa", forma: Forma.Retangulo(2.0, 0.5)}
    io.print(fig, area(fig.forma))

    var vazia Forma // valor zero: a primeira variante, zerada
    io.print(vazia)

    // match dentro de laço, com break saindo do for
    passos := 0
    for i := 0; i < 10; i++ {
        match divide(10, 5 - i) {
            Erro(_) => break
            Ok(_) => passos++
        }
    }
    io.print("passos antes do erro:", passos)

    c := cor.Cor.Rgb(10, 20, 30)
    io.print(cor.nome(c), cor.nome(cor.Cor.Azul), c)
    match c {
        Rgb(r, g, b) => io.print("soma:", int(r) + int(g) + int(b))
        _ => io.print("básica")
    }
}

impl auto io.Display for Forma

impl auto io.Display for Figura
