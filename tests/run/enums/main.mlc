import "std/io"
import "color"

enum Shape {
    Circle(radius float64)
    Rectangle(width_ float64, height float64)
    Empty
}

enum Outcome[T any] {
    Ok(value_ T)
    Failure(errcode int)
}

struct Figure {
    name_ string
    shape Shape
}

fn area(f Shape) float64 {
    match f {
        Circle(r) => return 3.0 * r * r
        Rectangle(l, a) => return l * a
        Empty => return 0.0
    }
}

fn split_it(a int, b int) Outcome[int] {
    if b == 0 {
        return Outcome.Failure(1) // T inferred from the return type
    }
    return Outcome.Ok(a / b) // T inferred from the value
}

fn int_sqrt(n int) Outcome[int] {
    if n < 0 {
        return Outcome[int].Failure(2) // explicit type
    }
    r := 0
    for (r + 1) * (r + 1) <= n {
        r++
    }
    return Outcome.Ok(r)
}

fn show_it(r Outcome[int]) {
    match r {
        Ok(v) => io.print("ok:", v)
        Failure(c) => io.print("error:", c)
    }
}

fn main() {
    shapes := alloc([]Shape, 3)
    shapes[0] = Shape.Circle(2.0)
    shapes[1] = Shape.Rectangle(3.0, 4.0)
    shapes[2] = Shape.Empty
    total := 0.0
    for f in shapes {
        total += area(f)
    }
    io.print("total area:", total)
    io.print(shapes)
    free(shapes)

    show_it(split_it(10, 3))
    show_it(split_it(1, 0))
    show_it(int_sqrt(50))
    show_it(int_sqrt(-4))

    fig := Figure{name_: "plate", shape: Shape.Rectangle(2.0, 0.5)}
    io.print(fig, area(fig.shape))

    var blank Shape // zero value: the first variant, zeroed
    io.print(blank)

    // match inside a loop, with break leaving the for
    steps := 0
    for i := 0; i < 10; i++ {
        match split_it(10, 5 - i) {
            Failure(_) => break
            Ok(_) => steps++
        }
    }
    io.print("steps before the error:", steps)

    c := color.Color.Rgb(10, 20, 30)
    io.print(color.name_(c), color.name_(color.Color.Blue), c)
    match c {
        Rgb(r, g, b) => io.print("sum:", int(r) + int(g) + int(b))
        _ => io.print("basic")
    }
}

impl auto io.Display for Shape

impl auto io.Display for Figure
