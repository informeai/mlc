// Caso difícil (fase 5 do plano de verificação): continue depois de liberar e dar valor novo.
struct Box {
    v int
}

struct Par {
    a ?*Box
    b ?*Box
}

enum Opt {
    Nada
    Tem(b ?*Box)
}

extern "C" fn rand() int32

fn flip() bool {
    return rand() % 2 == 0
}

fn consume(b *Box) int {
    n := b.v
    free(b)
    return n
}

fn sink(n int) {
}

fn main() {
    x := alloc(Box{v: 1})
    acc := 0
    for i := 0; i < 4; i++ {
        if flip() {
            free(x)
            x = alloc(Box{v: i})
            continue
        }
        acc += x.v
    }
    free(x)
    sink(acc)
}
