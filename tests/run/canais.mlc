import "std/chan"
import "std/io"
import "std/str"
import "std/thread"
import "std/vec"

// um trabalhador leva as duas pontas de que precisa, por posse
struct Worker {
    jobs *chan.Receiver[int]
    results *chan.Sender[int]
}

fn (w *Worker) free() {
    w.jobs.close()
    w.results.close()
    free(w)
}

fn work(w *Worker) {
    for {
        match w.jobs.recv() {
            Got(n) => w.results.send(n * n)
            Closed => break
        }
    }
    w.free()
}

fn produce(tx *chan.Sender[[]byte]) {
    for i := 0; i < 5; i++ {
        b := alloc([]byte, str.format_len("pedido {}", i))
        str.format(&b, "pedido {}", i)
        if !tx.send(b) {
            break // ninguém mais recebe: o valor já foi liberado pelo canal
        }
    }
    tx.close()
}

fn main() {
    // vários trabalhadores, um canal de tarefas e um de resultados
    jobs := chan.new[int](8)
    // os resultados só são lidos depois de todas as tarefas enviadas: o canal
    // precisa caber todos, senão os trabalhadores param e o envio trava
    results := chan.new[int](128)
    feed := jobs.sender()
    ws := alloc([]?*thread.Thread, 4)
    for i := 0; i < len(ws); i++ {
        w := alloc(Worker{jobs: jobs.clone(), results: results.sender()})
        old := replace(&ws[i], thread.spawn(work, w, thread.STACK_64KB))
        if old != nil {
            thread.join(old)
        }
    }
    jobs.close() // os trabalhadores têm as próprias pontas
    for n := 1; n <= 100; n++ {
        feed.send(n)
    }
    feed.close() // os trabalhadores recebem Closed e terminam
    total := 0
    count := 0
    for {
        match results.recv() {
            Got(r) => {
                total += r
                count++
            }
            Closed => break // todos os trabalhadores fecharam os Sender
        }
    }
    results.close()
    for t in drain(ws) {
        if t != nil {
            thread.join(t)
        }
    }
    free(ws)
    io.print("resultados:", count, "soma dos quadrados:", total)

    // o consumidor para cedo: o produtor percebe pelo false do send
    rx := chan.new[[]byte](1)
    t := thread.spawn(produce, rx.sender(), thread.STACK_64KB)
    match rx.recv() {
        Got(b) => {
            io.write_line(&b)
            free(b)
        }
        Closed => io.print("nada")
    }
    rx.close() // o que estiver no canal, e o que o produtor ainda mandar, é liberado
    thread.join(t)

    // sem nenhum Sender, recv devolve Closed na hora
    empty := chan.new[int](1)
    match empty.recv() {
        Got(n) => io.print("veio", n)
        Closed => io.print("vazio e sem Sender: Closed")
    }
    empty.close()

    // valores que sobram no canal são liberados no último close
    left := chan.new[[]byte](4)
    lt := left.sender()
    lt.send(alloc([]byte, 10))
    lt.send(alloc([]byte, 20))
    lt.close()
    left.close()

    // pontas dentro de um Vec: o free do Vec fecha cada uma (drop)
    hub := chan.new[int](4)
    senders := vec.new[?*chan.Sender[int]](2)
    senders.push(hub.sender())
    senders.push(hub.sender())
    s := senders.at(0)
    s.send(7)
    senders.free()
    match hub.recv() {
        Got(n) => io.print("do vec:", n)
        Closed => io.print("nada")
    }
    match hub.recv() {
        Got(n) => io.print("outro:", n)
        Closed => io.print("os Sender do vec foram fechados: Closed")
    }
    hub.close()
}
