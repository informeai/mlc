import "std/io"

// w.printf: io.printf's format over a reused Writer, without
// a flush on each call
fn table(w &io.Writer, n int) {
    for i := 1; i <= n; i++ {
        w.printf("{:>3} | {:>5} | {:#06x}\n", i, i * i, i * 100) // in a received &io.Writer
    }
}

fn main() {
    w := io.stdout()
    w.printf("{:>3} | {:>5} | {}\n", "n", "n²", "hex")
    table(&w, 4)
    w.flush()

    e := io.stderr()
    e.printf("warning: {}\n", 1)
    e.flush()

    p := alloc(io.stdout()) // in a *io.Writer
    p.printf("{:.2}\n", 3.14159)
    p.flush()
    free(p)
}
