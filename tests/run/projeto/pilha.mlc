pub struct No {
    valor int
    prox ?*No
}

pub struct Pilha {
    topo ?*No
    tamanho int
}

pub fn nova() *Pilha {
    return alloc(Pilha)
}

pub fn empilha(p &Pilha, v int) {
    n := alloc(No)
    n.valor = v
    n.prox = p.topo
    p.topo = n
    p.tamanho++
}

pub fn desempilha(p &Pilha) int {
    n := p.topo
    if n == nil {
        p.topo = nil
        return -1
    }
    v := n.valor
    p.topo = n.prox
    free(n)
    p.tamanho--
    return v
}

pub fn libera(p *Pilha) {
    cur := p.topo
    for cur != nil {
        prox := cur.prox
        free(cur)
        cur = prox
    }
    free(p)
}
