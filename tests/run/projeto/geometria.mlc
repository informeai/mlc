import "util/numeros"

pub const LADOS_QUADRADO = 4

pub struct Ponto {
    x int
    y int
}

pub struct Retangulo {
    canto Ponto
    largura int
    altura int
}

pub fn area(r Retangulo) int {
    return r.largura * r.altura
}

pub fn perimetro(r Retangulo) int {
    return numeros.dobro(r.largura + r.altura)
}

// privada: só este arquivo enxerga
fn valida(r Retangulo) bool {
    return r.largura > 0 && r.altura > 0
}

pub fn quadrado(lado int) Retangulo {
    r := Retangulo{canto: Ponto{x: 0, y: 0}, largura: lado, altura: lado}
    if !valida(r) {
        r.largura = 1
        r.altura = 1
    }
    return r
}

// mesmo nome de uma função de main.mlc: no C, os nomes não colidem
pub fn descreve() int {
    return 1
}
