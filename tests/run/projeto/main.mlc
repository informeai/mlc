import "io"
import "geometria"
import "pilha"
import "util/numeros"

fn descreve() int {
    return 2
}

fn tipo(lados int) string {
    match lados {
        geometria.LADOS_QUADRADO => return "quadrilátero"
        3 => return "triângulo"
        _ => return "outro"
    }
}

fn main() {
    r := geometria.Retangulo{
        canto: geometria.Ponto{x: 1, y: 2},
        largura: 3,
        altura: 4,
    }
    io.print("área:", geometria.area(r), "perímetro:", geometria.perimetro(r))
    q := geometria.quadrado(5)
    io.print("quadrado:", q, geometria.area(q))
    io.print(tipo(geometria.LADOS_QUADRADO), tipo(3))
    io.print("maior:", numeros.maior(7, 9), "dobro:", numeros.dobro(21))
    io.print("descreve:", descreve(), geometria.descreve())

    var p geometria.Ponto
    p.x = 10
    io.print(p)

    pt := alloc(geometria.Ponto)
    pt.y = 7
    io.print(*pt)
    free(pt)

    s := pilha.nova()
    for i := 1; i <= 3; i++ {
        pilha.empilha(&s, i * 10)
    }
    io.print("pilha:", s.tamanho, pilha.desempilha(&s), pilha.desempilha(&s), s.tamanho)
    pilha.libera(s)
}
