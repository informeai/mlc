import "std/io"

fn classify(n int) string {
    var r = ""
    match n {
        0 => r = "zero"
        1, 2, 3 => r = "small"
        -1 => r = "minus one"
        _ => {
            if n < 0 {
                r = "negative"
            } else {
                r = "large"
            }
        }
    }
    return r
}

fn errcode(color string) int {
    match color {
        "red" => return 1
        "green", "blue" => return 2
        "" => return 0
        _ => return -1
    }
}

fn yes_no(b bool) string {
    match b {
        true => return "yes"
        false => return "no"
    }
}

fn extreme(n int) string {
    match n {
        -9223372036854775808 => return "minimum"
        9223372036854775807 => return "maximum"
        _ => return "middle"
    }
}

fn main() {
    io.print(classify(0), classify(2), classify(-1), classify(-7), classify(99))
    io.print(errcode("red"), errcode("blue"), errcode(""), errcode("purple"))
    io.print(yes_no(true), yes_no(1 > 2))
    io.print(extreme(-9223372036854775807 - 1), extreme(9223372036854775807), extreme(0))

    total := 0
    for i := 0; i < 10; i++ {
        match i % 3 {
            0 => total += i
            _ => continue
        }
    }
    io.print("total:", total)

    // break inside a match on int leaves the for (in C it becomes goto)
    n := 0
    for {
        n++
        match n {
            5 => break
            _ => {}
        }
    }
    io.print("stopped at", n)

    // break inside a match on string (an if chain in C)
    words := 0
    for j := 0; j < 100; j++ {
        p := "x"
        if j == 3 {
            p = "end"
        }
        match p {
            "end" => break
            _ => words++
        }
    }
    io.print("words:", words)

    // match inside match, with a break of the outer for
    found := -1
    for a := 0; a < 5; a++ {
        match a % 2 {
            0 => {
                match a {
                    4 => {
                        found = a
                        break
                    }
                    _ => {}
                }
            }
            _ => continue
        }
    }
    io.print("found:", found)

    s := "abc"
    io.print(s == "abc", s != "abc", "" == "", "ab" == "abc")

    match errcode("green") {
        _ => io.print("only the wildcard")
    }
    match s {
        _ => io.print("wildcard on string")
    }
    match 1 { 2 => io.print("never"); _ => io.print("a line") }
}
