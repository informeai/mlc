import "std/io"

fn classify(n int) string {
    var r = ""
    match n {
        0 => r = "zero"
        1, 2, 3 => r = "pequeno"
        -1 => r = "menos um"
        _ => {
            if n < 0 {
                r = "negativo"
            } else {
                r = "grande"
            }
        }
    }
    return r
}

fn codigo(cor string) int {
    match cor {
        "vermelho" => return 1
        "verde", "azul" => return 2
        "" => return 0
        _ => return -1
    }
}

fn sim_nao(b bool) string {
    match b {
        true => return "sim"
        false => return "não"
    }
}

fn extremo(n int) string {
    match n {
        -9223372036854775808 => return "mínimo"
        9223372036854775807 => return "máximo"
        _ => return "meio"
    }
}

fn main() {
    io.print(classify(0), classify(2), classify(-1), classify(-7), classify(99))
    io.print(codigo("vermelho"), codigo("azul"), codigo(""), codigo("roxo"))
    io.print(sim_nao(true), sim_nao(1 > 2))
    io.print(extremo(-9223372036854775807 - 1), extremo(9223372036854775807), extremo(0))

    total := 0
    for i := 0; i < 10; i++ {
        match i % 3 {
            0 => total += i
            _ => continue
        }
    }
    io.print("total:", total)

    // break dentro de match sobre int sai do for (no C vira goto)
    n := 0
    for {
        n++
        match n {
            5 => break
            _ => {}
        }
    }
    io.print("parou em", n)

    // break dentro de match sobre string (cadeia de if no C)
    palavras := 0
    for j := 0; j < 100; j++ {
        p := "x"
        if j == 3 {
            p = "fim"
        }
        match p {
            "fim" => break
            _ => palavras++
        }
    }
    io.print("palavras:", palavras)

    // match dentro de match, com break do for de fora
    achou := -1
    for a := 0; a < 5; a++ {
        match a % 2 {
            0 => {
                match a {
                    4 => {
                        achou = a
                        break
                    }
                    _ => {}
                }
            }
            _ => continue
        }
    }
    io.print("achou:", achou)

    s := "abc"
    io.print(s == "abc", s != "abc", "" == "", "ab" == "abc")

    match codigo("verde") {
        _ => io.print("só o curinga")
    }
    match s {
        _ => io.print("curinga em string")
    }
    match 1 { 2 => io.print("nunca"); _ => io.print("uma linha") }
}
