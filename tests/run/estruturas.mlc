import "std/io"

// ---------- lista ligada ----------

struct No {
    valor int
    prox ?*No
}

struct Lista {
    cabeca ?*No
    tamanho int
}

fn push(l &Lista, v int) {
    n := alloc(No)
    n.valor = v
    n.prox = l.cabeca      // move a cabeça para o nó novo...
    l.cabeca = n           // ...e o nó novo vira a cabeça
    l.tamanho++
}

fn pop(l &Lista) int {
    n := l.cabeca
    if n == nil {
        l.cabeca = nil     // o campo emprestado precisa voltar a ter valor
        return -1
    }
    v := n.valor
    l.cabeca = n.prox
    free(n)                // aceito: o único campo dono de n já foi movido
    l.tamanho--
    return v
}

fn soma_lista(n &No) int {
    total := n.valor
    if n.prox != nil {
        total += soma_lista(&n.prox)
    }
    return total
}

fn libera_lista(l *Lista) {
    cur := l.cabeca
    for cur != nil {
        prox := cur.prox
        free(cur)
        cur = prox
    }
    free(l)
}

// ---------- árvore binária ----------

struct Arvore {
    valor int
    esq ?*Arvore
    dir ?*Arvore
}

fn insere(a ?*Arvore, v int) *Arvore {
    if a == nil {
        return alloc(Arvore{valor: v, esq: nil, dir: nil})
    }
    if v < a.valor {
        a.esq = insere(a.esq, v)
    } else {
        a.dir = insere(a.dir, v)
    }
    return a
}

fn em_ordem(a &Arvore) {
    if a.esq != nil {
        em_ordem(&a.esq)
    }
    io.print(a.valor)
    if a.dir != nil {
        em_ordem(&a.dir)
    }
}

fn altura(a ?*Arvore) int {
    if a == nil {
        return 0
    }
    // a é dona aqui: os campos são emprestados, não movidos
    e := 0
    d := 0
    if a.esq != nil && a.esq.valor >= 0 {
        e = 1
    }
    if a.dir != nil {
        d = 1
    }
    free_arvore(a)
    return e + d
}

fn free_arvore(a ?*Arvore) {
    if a == nil {
        return
    }
    free_arvore(a.esq)
    free_arvore(a.dir)
    free(a)
}

fn main() {
    l := alloc(Lista)
    for i := 1; i <= 5; i++ {
        push(&l, i * 10)
    }
    io.print("tamanho:", l.tamanho)
    if l.cabeca != nil {
        io.print("soma:", soma_lista(&l.cabeca))
    }
    io.print("pop:", pop(&l), pop(&l))
    io.print("tamanho:", l.tamanho)
    libera_lista(l)

    var raiz ?*Arvore = nil
    valores := 0
    for v := 50; valores < 7; valores++ {
        raiz = insere(raiz, v)
        v = (v * 37 + 11) % 100
    }
    if raiz != nil {
        em_ordem(&raiz)
    }
    io.print("filhos da raiz:", altura(raiz))

    vazia := alloc(Lista)
    io.print("pop vazia:", pop(&vazia))
    libera_lista(vazia)
}
