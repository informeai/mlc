import "std/io"

// A C callback: libc's qsort sorts an array of MLC structs in place and
// calls back the comparison, an MLC function, during the call.

struct Person {
    id int
    age int
}

extern "C" fn qsort(base &[]Person, n uint64, size uint64, cmp fn(&Person, &Person) int32)

fn by_age(a &Person, b &Person) int32 {
    if a.age != b.age {
        if a.age < b.age {
            return -1
        }
        return 1
    }
    if a.id < b.id {
        return -1
    }
    if a.id > b.id {
        return 1
    }
    return 0
}

fn main() {
    people := [5]Person{
        Person{id: 1, age: 41},
        Person{id: 2, age: 23},
        Person{id: 3, age: 35},
        Person{id: 4, age: 23},
        Person{id: 5, age: 7},
    }
    qsort(&people, uint64(len(people)), 16, by_age) // 16: the size of Person in C (two int64)
    for i := 0; i < len(people); i++ {
        io.print(people[i].id, people[i].age)
    }
}
