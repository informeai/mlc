import "std/bufio"
import "std/io"
import "std/os"
import "std/result"
import "std/str"

// Text is a source of its own: it delivers the text one byte at a time.
struct Text {
    data [64]byte
    n int
    pos int
}

fn (t &Text) read(dst &[]byte) result.Result[int, int] {
    if t.pos == t.n || len(dst) == 0 {
        return result.Result.Ok(0)
    }
    dst[0] = t.data[t.pos]
    t.pos++
    return result.Result.Ok(1)
}

impl io.Reader for Text

// the signature uses bufio.Reader[Text], declared in this file
fn count_lines(br &bufio.Reader[Text], src &Text) int {
    var line [16]byte
    count := 0
    for {
        match br.read_line(src, &line) {
            Ok(_) => count++
            Err(_) => break
        }
    }
    return count
}

fn main() {
    t := Text{}
    t.n = str.copy(&t.data, "a\nb\nc")
    br := bufio.new[Text]()
    io.printf("lines of the text: {}\n", count_lines(&br, &t))

    // standard input, line by line
    src := io.stdin()
    rd := bufio.new[io.Stdin]()
    var line [64]byte
    n := 0
    for {
        match rd.read_line(&src, &line) {
            Ok(k) => {
                n++
                io.printf("{}: {:s}\n", n, &line[:k])
            }
            Err(code) => {
                var msg [160]byte
                m := os.error_text(code, &msg)
                io.printf("end ({:s})\n", &msg[:m])
                break
            }
        }
    }
}
