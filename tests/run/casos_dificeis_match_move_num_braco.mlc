// Caso difícil (fase 5 do plano de verificação): dentro de um braço do match, um caminho move o dado e o outro libera.
struct Box {
    v int
}

struct Par {
    a ?*Box
    b ?*Box
}

enum Opt {
    Nada
    Tem(b ?*Box)
}

extern "C" fn rand() int32

fn flip() bool {
    return rand() % 2 == 0
}

fn consume(b *Box) int {
    n := b.v
    free(b)
    return n
}

fn sink(n int) {
}

fn main() {
    e := Opt.Tem(alloc(Box{v: 1}))
    var guardado ?*Box
    match e {
        Nada => {}
        Tem(b) => {
            if flip() {
                guardado = b
            } else {
                free(b)
            }
        }
    }
    free(guardado)
}
