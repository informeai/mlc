// Caso difícil (fase 5 do plano de verificação): mover no laço e dar valor novo antes da próxima volta.
struct Box {
    v int
}

struct Par {
    a ?*Box
    b ?*Box
}

enum Opt {
    Nada
    Tem(b ?*Box)
}

extern "C" fn rand() int32

fn flip() bool {
    return rand() % 2 == 0
}

fn consume(b *Box) int {
    n := b.v
    free(b)
    return n
}

fn sink(n int) {
}

fn main() {
    x := alloc(Box{v: 1})
    acc := 0
    for i := 0; i < 3; i++ {
        acc += consume(x)
        x = alloc(Box{v: i})
    }
    free(x)
    sink(acc)
}
