// Donos em genéricos: Vec[T owned] guarda []byte e ?*No; push move para
// dentro, take/pop devolvem a posse, set devolve ao lugar, free libera tudo.
import "std/io"
import "std/str"
import "std/vec"

struct No {
    v int
}

// guarda o maior de dois donos e libera o outro
fn maior_fica[T owned](a T, b T, a_maior bool) T {
    if a_maior {
        drop(b)
        return a
    }
    drop(a)
    return b
}

fn main() {
    nomes := vec.new[[]byte](1)
    linha := alloc([]byte, 64)
    for {
        n := io.read_line(&linha)
        if n < 0 {
            break
        }
        copia := alloc([]byte, n)
        str.copy_bytes(&copia, &linha[:n])
        nomes.push(copia)
    }
    for i := 0; i < nomes.len(); i++ {
        nome := nomes.take(i)
        io.write_line(&nome)
        nomes.set(i, nome)
    }
    ultimo := nomes.pop()
    io.print("último:", ultimo, "restam", nomes.len())
    free(ultimo)
    free(linha)
    nomes.free()

    nos := vec.new[?*No](2)
    nos.push(alloc(No{v: 1}))
    nos.push(nil)
    nos.push(alloc(No{v: 3}))
    nos.swap(0, 2)
    p := nos.take(0)
    if p != nil {
        io.print("primeiro:", p.v)
    }
    nos.set(0, p)
    nos.clear()
    io.print("vazio:", nos.len())
    nos.free()

    x := maior_fica(alloc([]byte, 3), alloc([]byte, 5), false)
    io.print(len(x))
    free(x)
    io.print(maior_fica(1, 2, true))

    // T copiável continua com get
    ns := vec.new[int](2)
    ns.push(10)
    ns.push(20)
    io.print(ns.get(1), ns.put(0, 7), ns.get(0))
    ns.free()
}
