// Vetor que cresce: a realocação está visível em cresce(), escrita em MLC.
pub struct Vetor[T any] {
    itens []T
    tam int
}

pub fn novo[T any](cap int) *Vetor[T] {
    v := alloc(Vetor[T]{itens: alloc([]T, cap), tam: 0})
    return v
}

pub fn (v &Vetor[T]) adiciona(x T) {
    if v.tam == len(v.itens) {
        v.cresce()
    }
    v.itens[v.tam] = x
    v.tam++
}

fn (v &Vetor[T]) cresce() {
    v.itens = realloc(v.itens, len(v.itens) * 2 + 1)
}

pub fn (v &Vetor[T]) pega(i int) T {
    return v.itens[i]
}

pub fn (v &Vetor[T]) tamanho() int {
    return v.tam
}

pub fn (v *Vetor[T]) libera() {
    free(v.itens)
    free(v)
}
