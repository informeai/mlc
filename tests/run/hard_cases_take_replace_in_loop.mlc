// Hard case (phase 5 of the verification plan): replace in a loop by index and drain to empty.
struct Box {
    v int
}

struct Pair {
    a ?*Box
    b ?*Box
}

enum Opt {
    Nothing
    Has(b ?*Box)
}

extern "C" fn rand() int32

fn flip() bool {
    return rand() % 2 == 0
}

fn consume(b *Box) int {
    n := b.v
    free(b)
    return n
}

fn sink(n int) {
}

fn main() {
    s := alloc([]?*Box, 3)
    for i := 0; i < len(s); i++ {
        old := replace(&s[i], alloc(Box{v: i}))
        free(old)
    }
    acc := 0
    for e in drain(s) {
        if e != nil {
            acc += e.v
        }
        free(e)
    }
    free(s)
    sink(acc)
}
