import "std/io"

struct Point {
    x int
    y int
}

fn sum_(s &[]int) int {
    total := 0
    for v in s {
        total += v
    }
    return total
}

// recursive sum: borrows the rest of the slice on each call
fn sum_rec(s &[]int) int {
    if len(s) == 0 {
        return 0
    }
    return s[0] + sum_rec(&s[1:])
}

fn reset_it(s &[]int) {
    for i := 0; i < len(s); i++ {
        s[i] = 0
    }
}

// grows doubling the capacity: the caller sees each realloc happen
fn primes_up_to(limit int) []int {
    var primes []int
    used := 0
    for n := 2; n <= limit; n++ {
        is_prime := true
        for i := 0; i < used; i++ {
            if n % primes[i] == 0 {
                is_prime = false
                break
            }
        }
        if is_prime {
            if used == len(primes) {
                fresh := len(primes) * 2
                if fresh == 0 {
                    fresh = 2
                }
                primes = realloc(primes, fresh)
            }
            primes[used] = n
            used++
        }
    }
    return realloc(primes, used) // shrinks to the exact size
}

fn main() {
    s := alloc([]int, 3)
    s[0] = 1
    s[1] = 2
    s[2] = 3
    s = realloc(s, 5)
    io.print(s, len(s))
    s[4] = 10
    s = realloc(s, 2)
    io.print(s)

    t := alloc([]int, 6)
    for i := 0; i < len(t); i++ {
        t[i] = i + 1
    }
    io.print(sum_(&t[1:4]), sum_(&t[:2]), sum_(&t[4:]), sum_(&t[:]), sum_(&t[3:3]))
    io.print(sum_rec(&t))
    reset_it(&t[2:4])
    io.print(t)

    p := primes_up_to(30)
    io.print(p, len(p))

    points := alloc([]Point, 1)
    points = realloc(points, 3)
    points[2] = Point{x: 7, y: 8}
    io.print(points)

    // realloc to zero empties; from empty, allocates again
    s = realloc(s, 0)
    io.print(s, len(s))
    s = realloc(s, 1)
    io.print(s)

    free(s)
    free(t)
    free(p)
    free(points)
}

impl auto io.Display for Point
