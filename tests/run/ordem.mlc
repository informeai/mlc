import "io"

struct Par {
    x int
    y int
}

fn marca(nome string, v int) int {
    io.print(nome)
    return v
}

fn soma(x int, y int) int {
    return x + y
}

fn texto(nome string) string {
    io.print(nome)
    return nome
}

fn main() {
    io.print("argumentos:", soma(marca("a", 1), marca("b", 2)))
    io.print("operandos:", marca("c", 3) * marca("d", 4))
    io.print("literal:", Par{x: marca("e", 5), y: marca("f", 6)})
    io.print("comparação:", marca("g", 7) < marca("h", 8))
    io.print("strings:", texto("i") == texto("j"))
    io.print("aninhado:", soma(soma(marca("k", 1), marca("l", 2)), soma(marca("m", 3), marca("n", 4))))
    io.print("curto-circuito:", marca("o", 0) == 1 && marca("nunca", 0) == 0)

    total := 0
    for i := 0; marca("p", i) < 2; i = soma(i, marca("q", 1)) {
        total += i
    }
    io.print("for:", total)
}
