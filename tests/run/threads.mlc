import "std/io"
import "std/str"
import "std/thread"

// a thread's context: everything it uses goes along, by ownership
struct Job {
    data []int
    from int
    to int
}

fn (j *Job) free() {
    free(j.data)
    free(j)
}

fn partial_sum(j *Job) int {
    t := 0
    for i := j.from; i < j.to; i++ {
        t += j.data[i]
    }
    j.free()
    return t
}

// allocates and frees a lot, at the same time as the other threads
fn churn(rounds int) int {
    kept := 0
    for i := 0; i < rounds; i++ {
        b := alloc([]byte, 64 + i % 32)
        kept += len(b)
        free(b)
    }
    return kept
}

// str.format in several threads at the same time: the result comes back by ownership
fn label(n int) []byte {
    b := alloc([]byte, str.format_len("worker-{:03}", n))
    str.format(&b, "worker-{:03}", n)
    return b
}

// a thread that creates others
fn parent(n int) int {
    a := thread.spawn(churn, n, thread.STACK_64KB)
    b := thread.spawn(churn, n * 2, thread.STACK_64KB)
    return thread.join(a) + thread.join(b)
}

fn quiet(n int) {
    if n < 0 {
        io.print("never")
    }
}

fn main() {
    // sum in 4 parts
    const PARTS = 4
    ts := alloc([]?*thread.Thread[int], PARTS)
    for p := 0; p < PARTS; p++ {
        data := alloc([]int, 1000)
        for i := 0; i < len(data); i++ {
            data[i] = i
        }
        job := alloc(Job{data: data, from: p * 250, to: (p + 1) * 250})
        old := replace(&ts[p], thread.spawn(partial_sum, job, thread.STACK_64KB))
        if old != nil {
            thread.join(old)
        }
    }
    total := 0
    for t in drain(ts) {
        if t != nil {
            total += thread.join(t)
        }
    }
    free(ts)
    io.print("sum:", total)

    // 8 threads allocating at the same time
    cs := alloc([]?*thread.Thread[int], 8)
    for i := 0; i < len(cs); i++ {
        old := replace(&cs[i], thread.spawn(churn, 20000, thread.STACK_64KB))
        if old != nil {
            thread.join(old)
        }
    }
    bytes := 0
    for t in drain(cs) {
        if t != nil {
            bytes += thread.join(t)
        }
    }
    free(cs)
    io.print("bytes:", bytes)

    // owning results, in join order
    ls := alloc([]?*thread.Thread[[]byte], 3)
    for i := 0; i < len(ls); i++ {
        old := replace(&ls[i], thread.spawn(label, i * 7, thread.STACK_64KB))
        if old != nil {
            lost := thread.join(old) // the result is an owner: it must be freed
            free(lost)
        }
    }
    for t in drain(ls) {
        if t != nil {
            name := thread.join(t)
            io.printf("{:s}\n", &name)
            free(name)
        }
    }
    free(ls)

    p := thread.spawn(parent, 100, thread.STACK_256KB)
    io.print("nested:", thread.join(p))
    q := thread.spawn(quiet, 1, thread.STACK_16KB)
    thread.join(q)
}
