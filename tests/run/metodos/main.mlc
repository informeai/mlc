import "io"
import "forma"

struct Contador {
    valor int
    passo int
}

fn (c Contador) atual() int {
    return c.valor
}

fn (c &Contador) avanca() {
    c.valor += c.passo
}

fn (c &Contador) avanca_n(n int) {
    for i := 0; i < n; i++ {
        c.avanca()          // método chamando método, através do empréstimo
    }
}

struct Pilha {
    itens []int
    topo int
}

fn nova_pilha(cap int) *Pilha {
    p := alloc(Pilha)
    p.itens = alloc([]int, cap)
    return p
}

fn (p &Pilha) empilha(v int) {
    p.itens[p.topo] = v
    p.topo++
}

fn (p &Pilha) desempilha() int {
    p.topo--
    return p.itens[p.topo]
}

fn (p &Pilha) vazia() bool {
    return p.topo == 0
}

// recebe a posse: depois de p.libera(), usar p é erro de compilação
fn (p *Pilha) libera() {
    free(p.itens)
    free(p)
}

fn main() {
    c := Contador{valor: 0, passo: 3}
    c.avanca()
    c.avanca_n(2)
    io.print("contador:", c.atual(), c)

    p := nova_pilha(4)
    p.empilha(10)
    p.empilha(20)
    p.empilha(30)
    soma := 0
    for !p.vazia() {
        soma += p.desempilha()
    }
    io.print("soma:", soma)
    p.libera()

    r := forma.Retangulo{largura: 3, altura: 4}
    io.print("área:", r.area(), r.descreve())
    r.escala(2)
    io.print("escalado:", r, r.area())

    vazio := forma.Retangulo{largura: 0, altura: 5}
    io.print(vazio.descreve())

    h := alloc(forma.Retangulo)
    h.largura = 2
    h.altura = 5
    h.escala(3)                // método por empréstimo, chamado num ponteiro dono
    io.print("no heap:", h.area())
    free(h)
}
