import "std/io"
pub struct Retangulo {
    largura int
    altura int
}

pub fn (r Retangulo) area() int {
    return r.largura * r.altura
}

pub fn (r &Retangulo) escala(k int) {
    r.largura *= k
    r.altura *= k
}

// privado: só este arquivo chama
fn (r Retangulo) valido() bool {
    return r.largura > 0 && r.altura > 0
}

pub fn (r Retangulo) descreve() string {
    if r.valido() {
        return "válido"
    }
    return "inválido"
}

impl auto io.Display for Retangulo
