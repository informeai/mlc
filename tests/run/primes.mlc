import "std/io"

fn is_prime(n int) bool {
    if n < 2 {
        return false
    }
    for d := 2; d * d <= n; d++ {
        if n % d == 0 {
            return false
        }
    }
    return true
}

fn main() {
    var counts int
    n := 0
    for {
        n++
        if n > 50 {
            break
        }
        if !is_prime(n) {
            continue
        }
        counts += 1
        io.print(n)
    }
    io.print("total:", counts)
}
