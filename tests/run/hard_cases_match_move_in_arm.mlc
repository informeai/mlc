// Hard case (phase 5 of the verification plan): inside a match arm, one path moves the data and the other frees it.
struct Box {
    v int
}

struct Pair {
    a ?*Box
    b ?*Box
}

enum Opt {
    Nothing
    Has(b ?*Box)
}

extern "C" fn rand() int32

fn flip() bool {
    return rand() % 2 == 0
}

fn consume(b *Box) int {
    n := b.v
    free(b)
    return n
}

fn sink(n int) {
}

fn main() {
    e := Opt.Has(alloc(Box{v: 1}))
    var stored ?*Box
    match e {
        Nothing => {}
        Has(b) => {
            if flip() {
                stored = b
            } else {
                free(b)
            }
        }
    }
    free(stored)
}
