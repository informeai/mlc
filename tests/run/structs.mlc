import "std/io"

const LIMIT = 3
const GREETING string = "hello"
const LARGE = 1000 * 1000
const NEGATIVE = -LIMIT * 2
const ACTIVE = LIMIT > 2 && !false

struct Point {
    x int
    y int
}

// declaration order doesn't matter: Rectangle uses Point, declared before,
// and Line uses Point too
struct Line { a Point; b Point }

struct Rectangle {
    corner Point
    width_ int
    height int
    name_ string
}

struct Empty {}

struct Words {
    default int
    char string
}

fn area(r Rectangle) int {
    return r.width_ * r.height
}

fn move(p Point, dx int, dy int) Point {
    p.x += dx
    p.y += dy
    return p
}

fn category(n int) string {
    match n {
        LIMIT => return "limit"
        0 => return "zero"
        _ => return "other"
    }
}

fn main() {
    p := Point{x: 1, y: 2}
    io.print(p.x, p.y, p)

    q := move(p, 10, 20)
    io.print(p, q)

    r := Rectangle{
        corner: Point{x: 0, y: 0},
        width_: 4,
        height: LIMIT,
        name_: "frame",
    }
    r.corner.x = 7
    r.corner.y++
    io.print(area(r), r.corner, r.name_)
    io.print(r)

    var z Rectangle
    io.print(z, z.name_ == "")

    io.print(p == Point{x: 1, y: 2}, p != q)
    if (p == Point{x: 1, y: 2}) {
        io.print("equal")
    }

    const local = LIMIT + 1
    io.print(local, GREETING, LARGE, NEGATIVE, ACTIVE)
    io.print(category(3), category(0), category(9))

    v := Empty{}
    io.print(v, v == Empty{})

    l := Line{a: Point{}, b: move(Point{}, 1, 1)}
    io.print(l, l.b.x + l.b.y)

    kw := Words{default: 1, char: "c"}
    io.print(kw)

    for i := 0; i < LIMIT; i++ {
        r.width_ += i
    }
    io.print(r.width_)
}

impl auto io.Display for Point

impl auto io.Display for Rectangle

impl auto io.Display for Words

impl auto io.Display for Empty

impl auto io.Display for Line
