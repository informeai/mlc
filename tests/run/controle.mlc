import "std/io"

fn classifica(n int) string {
    if n < 0 {
        return "negativo"
    } else if n == 0 {
        return "zero"
    } else if n < 10 {
        return "pequeno"
    } else {
        return "grande"
    }
}

fn primeiro_multiplo(n int, de int) int {
    i := n
    for {
        if i % de == 0 {
            return i
        }
        i++
    }
}

fn main() {
    io.print(classifica(-5), classifica(0), classifica(7), classifica(42))
    io.print(primeiro_multiplo(10, 7))

    var vazio string
    var zero int
    var falso bool
    io.print("[", vazio, "]", zero, falso)

    x := 1
    {
        x := x + 10
        io.print("dentro:", x)
    }
    io.print("fora:", x)

    n := 1
    for n < 100 {
        n *= 3
    }
    io.print(n)

    var msg = "oi"
    msg = "tchau"
    io.print(msg)

    total := 0
    for i := 0; i < 10; i++ {
        if i % 2 == 0 {
            continue
        }
        total += i
    }
    total -= 5
    total /= 2
    total %= 7
    io.print(total)

    for j := 3; j > 0; j-- {
        io.print("j", j)
    }
}
