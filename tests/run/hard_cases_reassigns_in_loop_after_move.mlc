// Hard case (phase 5 of the verification plan): moving in the loop and giving a new value before the next iteration.
struct Box {
    v int
}

struct Pair {
    a ?*Box
    b ?*Box
}

enum Opt {
    Nothing
    Has(b ?*Box)
}

extern "C" fn rand() int32

fn flip() bool {
    return rand() % 2 == 0
}

fn consume(b *Box) int {
    n := b.v
    free(b)
    return n
}

fn sink(n int) {
}

fn main() {
    x := alloc(Box{v: 1})
    acc := 0
    for i := 0; i < 3; i++ {
        acc += consume(x)
        x = alloc(Box{v: i})
    }
    free(x)
    sink(acc)
}
