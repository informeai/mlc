import "std/http"
import "std/io"
import "std/log"
import "std/net"
import "std/signal"
import "std/str"
import "std/sync"
import "std/thread"

// A server with a loop, a router and handlers written by hand, like Go's
// http.ListenAndServe, but with everything in plain sight: the route table is a
// fixed array, each connection has a thread with a 64 KB stack (up to 64 at the
// same time), and the limits (routes, parameter, body, timeout) are in the
// code. The client, in a thread, makes the requests and then sends TERM to the
// process itself.

// ---------- the "framework": routes, context and loop, all in plain sight ----------

// Ctx is what each handler receives besides the request: the connection's state.
struct Ctx {
    lg *log.Logger
    param [128]byte // the rest of the path after the route's prefix (the {id})
    param_n int
}

// Handler: writes the response to c from the request m.
struct Route {
    method string
    prefix string
    exact bool // true: the path equals the prefix; false: starts with it
    h fn(&net.Conn, &http.Message, &Ctx)
}

const MAX_ROUTES = 16

struct Router {
    routes [MAX_ROUTES]Route
    n int
}

fn (r &Router) handle(method string, prefix string, exact bool, h fn(&net.Conn, &http.Message, &Ctx)) {
    r.routes[r.n] = Route{method: method, prefix: prefix, exact: exact, h: h}
    r.n++
}

// dispatch finds the route: 404 if no path matches, 405 if the path matches
// but the method doesn't.
fn (r &Router) dispatch(c &net.Conn, m &http.Message, ctx &Ctx) {
    path_found := false
    for i := 0; i < r.n; i++ {
        rt := r.routes[i]
        hit := false
        if rt.exact {
            hit = m.path_is(rt.prefix)
        } else {
            hit = m.path_has_prefix(rt.prefix)
        }
        if !hit {
            continue
        }
        path_found = true
        if !m.method_is(rt.method) {
            continue
        }
        var path [256]byte
        n := m.path(&path)
        if n < 0 {
            n = 0
        }
        ctx.param_n = str.copy_bytes(&ctx.param, &path[len(rt.prefix):n])
        rt.h(c, m, ctx)
        return
    }
    if path_found {
        http.respond_str(c, 405, "text/plain", "method not allowed\n")
        return
    }
    http.respond_str(c, 404, "text/plain", "not found\n")
}

// Job is what goes to each connection's thread (moved).
struct Job {
    c *net.Conn
    lg *log.Logger
    router Router // a copy of the table: it's only texts and function addresses
}

// serve_conn is a connection's keep-alive loop.
fn serve_conn(job *Job) {
    c := job.c
    ctx := alloc(Ctx{lg: job.lg, param: [128]byte{}, param_n: 0})
    router := job.router
    free(job)
    c.set_timeout(5000) // client idle for 5 s: the connection closes
    var m http.Message
    for {
        match m.read_request(&c) {
            Ok(_) => {}
            Err(code) => {
                if code == http.HEAD_TOO_BIG {
                    http.respond_str(&c, 431, "text/plain", "header too large\n")
                } else if code == http.BAD_MESSAGE {
                    http.respond_str(&c, 400, "text/plain", "bad request\n")
                }
                break // io.EOF, timeout or error: closes
            }
        }
        router.dispatch(&c, &m, &ctx)
        match m.skip_body(&c) { // the handler may not have read the body
            Ok(_) => {}
            Err(_) => break
        }
        if !m.keep_alive() {
            break
        }
    }
    c.close()
    lg := ctx.lg
    free(ctx)
    lg.close()
}

// serve: the accept, one thread per connection (up to max_conns at the same time,
// with a 64 KB stack), and a clean shutdown with Ctrl+C or TERM.
fn serve(l &net.Listener, router &Router, max_conns int, lg &log.Logger) {
    l.set_timeout(20) // wakes up to look at the signals
    workers := sync.group(max_conns)
    err := 0
    for !signal.received(signal.TERM) && !signal.received(signal.INT) {
        c := l.accept(&err)
        if c == nil {
            continue
        }
        job := alloc(Job{c: c, lg: lg.clone(), router: *router})
        workers.add(thread.spawn(serve_conn, job, thread.STACK_64KB))
    }
    workers.wait()
}

// ---------- the application ----------

fn health(c &net.Conn, m &http.Message, ctx &Ctx) {
    http.respond_str(c, 200, "text/plain", "ok\n")
}

// GET /items/{id}
fn get_item(c &net.Conn, m &http.Message, ctx &Ctx) {
    id := 0
    if !str.parse_int(&ctx.param[:ctx.param_n], &id) {
        http.respond_str(c, 400, "application/json", "{\"error\":\"id must be a number\"}\n")
        return
    }
    var body [64]byte
    n := str.format(&body, "{{\"id\":{},\"name\":\"item {}\"}}\n", id, id)
    http.respond(c, 200, "application/json", &body[:n])
}

// POST /echo
fn echo(c &net.Conn, m &http.Message, ctx &Ctx) {
    var body [1024]byte
    match m.read_all(c, &body) {
        Ok(n) => {
            ctx.lg.info("echo of {} bytes", n)
            http.respond(c, 200, "text/plain", &body[:n])
        }
        Err(code) => {
            if code == http.TOO_BIG {
                http.respond_str(c, 413, "text/plain", "body too large\n")
            }
        }
    }
}

// ---------- the test's client ----------

// show reads the response and writes the code and the body.
fn show(c &net.Conn) {
    var m http.Message
    match m.read_response(c) {
        Ok(_) => {}
        Err(code) => {
            io.printf("error {}\n", code)
            return
        }
    }
    var out [256]byte
    match m.read_all(c, &out) {
        Ok(n) => io.printf("{} {:s}", m.status(), &out[:n])
        Err(code) => io.printf("error {}\n", code)
    }
}

fn call(c &net.Conn, method string, target string, body string) {
    var b http.Builder
    b.request(method, target)
    b.header("Host", "localhost")
    b.send_str(c, body)
    io.printf("{} {}: ", method, target)
    show(c)
}

fn connect(port int) ?*net.Conn {
    var h [16]byte
    hn := str.copy(&h, "127.0.0.1")
    err := 0
    return net.connect(&h[:hn], port, &err)
}

fn client(port int) {
    c := connect(port)
    if c != nil {
        // all on the same connection (keep-alive)
        call(&c, "GET", "/health", "")
        call(&c, "GET", "/items/42", "")
        call(&c, "GET", "/items/abc", "")
        call(&c, "POST", "/echo", "hello echo\n")
        call(&c, "DELETE", "/health", "")
        call(&c, "GET", "/nothing", "")
        c.close()
    }
    // a body larger than the handler's buffer: 413, and the connection continues
    c2 := connect(port)
    if c2 != nil {
        var big [2000]byte
        for i := 0; i < len(big); i++ {
            big[i] = 'x'
        }
        var b http.Builder
        b.request("POST", "/echo")
        b.header("Host", "localhost")
        b.send(&c2, &big)
        io.printf("POST /echo with 2000 bytes: ")
        show(&c2)
        call(&c2, "GET", "/health", "")
        c2.close()
    }
    // a 9 KB header (a large JWT): 431
    c3 := connect(port)
    if c3 != nil {
        var req [9300]byte
        n := str.copy(&req, "GET /health HTTP/1.1\r\nAuthorization: Bearer ")
        for i := 0; i < 9000; i++ {
            req[n] = 'a'
            n++
        }
        n += str.copy(&req[n:], "\r\n\r\n")
        c3.write(&req[:n])
        io.printf("9 KB header: ")
        show(&c3)
        c3.close()
    }
    signal.raise(signal.TERM)
}

fn main() {
    lg := log.new(log.STDERR, log.WARN) // only warnings and errors (the test's output stays on stdout)
    var r Router
    r.handle("GET", "/health", true, health)
    r.handle("GET", "/items/", false, get_item)
    r.handle("POST", "/echo", true, echo)
    signal.listen_shutdown()
    var h [16]byte
    hn := str.copy(&h, "127.0.0.1")
    err := 0
    l := net.listen(&h[:hn], 0, &err)
    if l == nil {
        lg.error("listen failed: {}", err)
        lg.close()
        return
    }
    cl := thread.spawn(client, l.port(), thread.STACK_64KB)
    serve(&l, &r, 64, &lg)
    thread.join(cl)
    l.close()
    lg.close()
    io.print("stopped")
}
