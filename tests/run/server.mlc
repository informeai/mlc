// A small service over TCP: each request is a JSON {"name": ..., "n": ...}
// and the response, another JSON with a greeting, the square of n and a date.
// One thread accepts the connections and each connection is handled in a thread of its own.
import "std/io"
import "std/json"
import "std/net"
import "std/str"
import "std/thread"
import "std/time"

const CLIENTS = 3

// reads the request, builds the response in out and returns the size (or -1)
fn answer(req &[]byte, out &[]byte) int {
    var name [64]byte
    name_n := 0
    n := 0
    r := json.reader()
    for {
        match r.next(req) {
            Key(a, b) => {
                if str.eq(&req[a:b], "name") {
                    match r.next(req) {
                        String(x, y) => name_n = json.unescape(&name, &req[x:y])
                        _ => return -1
                    }
                } else if str.eq(&req[a:b], "n") {
                    match r.next(req) {
                        Number(x, y) => {
                            if !str.parse_int(&req[x:y], &n) {
                                return -1
                            }
                        }
                        _ => return -1
                    }
                } else if !r.skip(req) {
                    return -1
                }
            }
            End => break
            Error(_) => return -1
            _ => {}
        }
    }
    var esc [128]byte
    e := json.escape(&esc, &name[:name_n])
    d := time.utc(1_700_000_000_000 + n * 86400000) // a date that depends on n
    var at [32]byte
    k := time.iso(&at, &d)
    return str.format(out, "{{\"hello\": \"{:s}\", \"square\": {}, \"at\": \"{:s}\"}}", &esc[:e], n * n, &at[:k])
}

fn handle(c *net.Conn) {
    var req [512]byte
    got := 0
    for {
        match c.read(&req[got:]) {
            Ok(n) => {
                if n == 0 {
                    break // the client finished the request (shutdown)
                }
                got += n
            }
            Err(_) => break
        }
    }
    var out [512]byte
    k := answer(&req[:got], &out)
    if k < 0 {
        k = str.copy(&out, "{\"error\": \"bad request\"}")
    }
    c.write(&out[:k])
    c.close()
}

// accepts CLIENTS connections, one thread for each
fn serve(l *net.Listener) int {
    ts := alloc([]?*thread.Thread, CLIENTS)
    served := 0
    for i := 0; i < CLIENTS; i++ {
        err := 0
        c := l.accept(&err)
        if c == nil {
            break
        }
        old := replace(&ts[i], thread.spawn(handle, c, thread.STACK_64KB))
        if old != nil {
            thread.join(old)
        }
        served++
    }
    for t in drain(ts) {
        if t != nil {
            thread.join(t)
        }
    }
    free(ts)
    l.close()
    return served
}

fn request(host &[]byte, port int, body string) {
    err := 0
    c := net.connect(host, port, &err)
    if c == nil {
        io.print("connect failed", err)
        return
    }
    var msg [256]byte
    k := str.copy(&msg, body)
    c.write(&msg[:k])
    c.shutdown()
    var resp [512]byte
    got := 0
    for {
        match c.read(&resp[got:]) {
            Ok(n) => {
                if n == 0 {
                    break
                }
                got += n
            }
            Err(_) => break
        }
    }
    c.close()
    io.write_line(&resp[:got])
}

fn main() {
    var host [16]byte
    h := str.copy(&host, "127.0.0.1")
    err := 0
    l := net.listen(&host[:h], 0, &err)
    if l == nil {
        io.print("listen failed", err)
        return
    }
    port := l.port()
    s := thread.spawn(serve, l, thread.STACK_64KB)
    request(&host[:h], port, "{\"name\": \"Ana\", \"n\": 3}")
    request(&host[:h], port, "{\"extra\": [1, {\"x\": null}], \"n\": 12, \"name\": \"Zé \\\"Z\\\"\"}")
    request(&host[:h], port, "{\"name\": oops}")
    io.print("served:", thread.join(s))
}
