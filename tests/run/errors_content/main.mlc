import "std/io"
import "std/result"
import "std/str"

// an error with content: the message is allocated by whoever creates the error and
// freed by whoever handles it
enum ParseError {
    Empty
    BadDigit(at int, msg []byte)
    TooLong(text []byte)
}

impl auto io.Display for ParseError

fn text(s string) []byte {
    b := alloc([]byte, len(s))
    str.copy(&b, s)
    return b
}

fn parse(s string) result.Result[int, ParseError] {
    if len(s) == 0 {
        return result.Result.Err(ParseError.Empty)
    }
    if len(s) > 4 {
        return result.Result.Err(ParseError.TooLong(text(s)))
    }
    n := 0
    for i := 0; i < len(s); i += 1 {
        d := int(s[i]) - 48
        if d < 0 || d > 9 {
            return result.Result.Err(ParseError.BadDigit(i, text("not a digit")))
        }
        n = n * 10 + d
    }
    return result.Result.Ok(n)
}

// only reads: the owning fields come borrowed and stay with the owner
fn describe(e &ParseError) int {
    match *e {
        Empty => return 0
        BadDigit(at, msg) => return at + len(msg)
        TooLong(t) => return len(t)
    }
}

// consumes: the match receives ownership of the fields and must free them
fn report(s string) {
    match parse(s) {
        Ok(n) => io.print("ok", n)
        Err(e) => {
            io.print("error", describe(&e), e)
            match e {
                Empty => io.print("  empty")
                BadDigit(at, msg) => {
                    io.print("  position", at)
                    free(msg)
                }
                TooLong(t) => free(t)
            }
        }
    }
}

// the Ok can also be an owner
fn copy_of(s string) result.Result[[]byte, int] {
    if len(s) == 0 {
        return result.Result.Err(1)
    }
    return result.Result.Ok(text(s))
}

fn main() {
    report("123")
    report("")
    report("1x3")
    report("123456")

    r := copy_of("hello")
    match r {
        Ok(b) => {
            io.print(len(b))
            free(b)
        }
        Err(code) => io.print("code", code)
    }

    // free frees the data of the current variant, without match
    e := ParseError.TooLong(text("abc"))
    io.print(describe(&e))
    free(e)
}
