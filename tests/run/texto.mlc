import "io"
import "str"

const TAM = 16

// junta "nome tem N anos" num buffer que quem chama emprestou; devolve
// quantos bytes usou
fn frase(buf &[]byte, nome &[]byte, idade int) int {
    n := 0
    n += str.copy_bytes(&buf[n:], nome)
    n += str.copy(&buf[n:], " tem ")
    n += str.put_int(&buf[n:], idade)
    n += str.copy(&buf[n:], " anos")
    return n
}

// quanto espaço a frase precisa: quem programa vê o tamanho antes de alocar
fn tamanho_frase(nome_len int, idade int) int {
    return nome_len + len(" tem ") + str.int_len(idade) + len(" anos")
}

fn conta_vogais(s &[]byte) int {
    total := 0
    for c in s {
        match c {
            'a', 'e', 'i', 'o', 'u' => total++
            _ => {}
        }
    }
    return total
}

fn maiusculas(s &[]byte) {
    for i := 0; i < len(s); i++ {
        if s[i] >= 'a' && s[i] <= 'z' {
            s[i] = byte(int(s[i]) - 32)
        }
    }
}

fn main() {
    nome := alloc([]byte, TAM)
    linha := alloc([]byte, TAM)

    io.print("nome?")
    n := io.read_line(&nome)
    io.print("idade?")
    m := io.read_line(&linha)

    var idade int
    if !str.parse_int(&linha[:m], &idade) {
        io.print("idade inválida")
        idade = 0
    }

    // o buffer da frase é alocado com o tamanho exato
    precisa := tamanho_frase(n, idade)
    buf := alloc([]byte, precisa)
    k := frase(&buf, &nome[:n], idade)
    io.write_line(&buf[:k])
    io.print("bytes:", k, "de", len(buf))

    io.print("vogais no nome:", conta_vogais(&nome[:n]))
    maiusculas(&nome[:n])
    io.write_line(&nome[:n])

    if str.eq(&nome[:n], "ANA") {
        io.print("oi, Ana!")
    }

    // a terceira linha é inválida
    m = io.read_line(&linha)
    if !str.parse_int(&linha[:m], &idade) {
        io.write(&linha[:m])
        io.print(" não é um número")
    }

    // lê o resto, crescendo o buffer com realloc quando a linha não cabe
    usados := 0
    for {
        lidos := io.read_line(&linha[usados:])
        if lidos < 0 {
            break
        }
        usados += lidos
        if usados == len(linha) {
            linha = realloc(linha, len(linha) * 2)
            io.print("cresceu para", len(linha))
            continue
        }
        io.write(&linha[:usados])
        io.print(" (", usados, "bytes )")
        usados = 0
    }

    io.print('A', byte(66), int('C'))

    free(nome)
    free(linha)
    free(buf)
}
