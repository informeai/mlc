import "std/io"

// Each call puts 4000 bytes on the stack: deep recursion stops with a panic
// before going past the guard page, instead of writing into someone else's memory.
fn deep(n int) int {
    var buf [4000]byte
    for i := 0; i < len(buf); i++ { // uses the whole buffer: C can't take it off the stack
        buf[i] = byte((i + n) % 256)
    }
    if n == 0 {
        return 0
    }
    return deep(n - 1) + int(buf[n % 4000])
}

fn main() {
    io.printf("{}\n", deep(100))
    io.printf("{}\n", deep(100000000))
}
