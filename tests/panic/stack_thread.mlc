import "std/io"
import "std/thread"

fn work(n int) int {
    var body [500000]byte
    body[n] = 1
    return int(body[n])
}

fn main() {
    // the size comes from a calculation: the checker doesn't check it, the runtime does
    stack := thread.STACK_64KB
    t := thread.spawn(work, 3, stack * 1)
    io.printf("{}\n", thread.join(t))
}
