{
  "name": "mlc",
  "displayName": "MLC (My Lang C)",
  "description": "Colors, errors as you type, formatting, hover, go to definition and completions for the MLC language, via mlc lsp",
  "version": "0.1.0",
  "publisher": "mlc-lang",
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Programming Languages", "Formatters", "Linters"],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "mlc",
        "aliases": ["MLC", "mlc"],
        "extensions": [".mlc"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      { "language": "mlc", "scopeName": "source.mlc", "path": "./syntaxes/mlc.tmLanguage.json" }
    ],
    "configuration": {
      "title": "MLC",
      "properties": {
        "mlc.path": {
          "type": "string",
          "default": "mlc",
          "description": "Path of the mlc executable (it must have the lsp command)."
        }
      }
    },
    "configurationDefaults": {
      "[mlc]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
