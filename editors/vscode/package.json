{
  "name": "mlc",
  "displayName": "MLC (My Lang C)",
  "description": "Cores, erros ao digitar, formatação, hover, ir para a definição e sugestões para a linguagem MLC, via mlc lsp",
  "version": "0.1.0",
  "publisher": "mlc-lang",
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Programming Languages", "Formatters", "Linters"],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "mlc",
        "aliases": ["MLC", "mlc"],
        "extensions": [".mlc"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      { "language": "mlc", "scopeName": "source.mlc", "path": "./syntaxes/mlc.tmLanguage.json" }
    ],
    "configuration": {
      "title": "MLC",
      "properties": {
        "mlc.path": {
          "type": "string",
          "default": "mlc",
          "description": "Caminho do executável mlc (precisa ter o comando lsp)."
        }
      }
    },
    "configurationDefaults": {
      "[mlc]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
